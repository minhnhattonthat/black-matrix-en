  {
   "id": "s498:0077e",
   "op": "15",
   "jp": "安心してもいいのですよ・・・",
   "en": ""
  },
  {
   "id": "s498:007ae",
   "op": "15",
   "jp": "この子には、不死の呪いが\n懸けられているため・・・",
   "en": ""
  },
  {
   "id": "s498:007f2",
   "op": "15",
   "jp": "その肉体はともかく・・・",
   "en": ""
  },
  {
   "id": "s498:0081e",
   "op": "15",
   "jp": "まだ、その魂そのものは、\n死んではいないのですから・・・！",
   "en": ""
  },
  {
   "id": "s498:0086e",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s498:00892",
   "op": "15",
   "jp": "生き返らせたければ\nしごく簡単な事です・・・",
   "en": ""
  },
  {
   "id": "s498:008e6",
   "op": "15",
   "jp": "彼女にこの大邪神\nガブリエルの鎧を着せ・・・",
   "en": ""
  },
  {
   "id": "s498:0092a",
   "op": "15",
   "jp": "彼にこの大邪神\nガブリエルの鎧を着せ・・・",
   "en": ""
  },
  {
   "id": "s498:00966",
   "op": "15",
   "jp": "終末の封印を解くだけでいい！！",
   "en": ""
  },
  {
   "id": "s498:009aa",
   "op": "15",
   "jp": "ですが果たしてアナタに、\nその資格があるかどうか・・・",
   "en": ""
  },
  {
   "id": "s498:009f2",
   "op": "15",
   "jp": "この私に試させて貰いましょう！",
   "en": ""
  },
  {
   "id": "s498:00a22",
   "op": "15",
   "jp": "さあ、その階段を、\n上りきってご覧なさい！！",
   "en": ""
  }
 ]
