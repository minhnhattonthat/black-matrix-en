 "strings": [
  {
   "id": "s367:006ce",
   "op": "15",
   "jp": "秘密地下組織のリーダー\nマルコに導かれた一行は、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00712",
   "op": "15",
   "jp": "ついにアンゲルス教の\n総本山があると言われている、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00756",
   "op": "15",
   "jp": "悪魔の海峡の場所を、\n特定することに成功した。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00796",
   "op": "15",
   "jp": "しかしその旅の途中、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:007be",
   "op": "15",
   "jp": "彼らはマルコの強引なまでの\n勧めによって、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:007fa",
   "op": "15",
   "jp": "切り立った巨大な山脈に閉ざされ、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:0082e",
   "op": "15",
   "jp": "異端審問官達の支配すら及ばぬ\n辺境の街、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:0086a",
   "op": "15",
   "jp": "ソドムとゴモラへと\n向かう事になった。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00912",
   "op": "15",
   "jp": "マルコの話によると、\nこの二つの街は・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:0094e",
   "op": "15",
   "jp": "奴隷制度に批判的な一部の\n黒き羽の人々と、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:0098a",
   "op": "15",
   "jp": "白き羽の人々が集まって\n創り上げた、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:009c2",
   "op": "15",
   "jp": "別名を背徳の都とも呼ばれる\n彼らの一大軍事拠点の一つで、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00a0e",
   "op": "15",
   "jp": "大罪であるはずの平等や\n人権をあえて基本理念にうたい、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00a56",
   "op": "15",
   "jp": "お互いの羽の色に関係のない\n街づくりを目指した・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00a9e",
   "op": "15",
   "jp": "白き羽の人々の理想郷だと\nいうのだ。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00b42",
   "op": "15",
   "jp": "だが、そこで彼らを待っていたのは",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00b76",
   "op": "15",
   "jp": "予測すらしえないほどに平等な",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s367:00ba6",
   "op": "15",
   "jp": "二つの正義の戦いへのいざない\nだったのだ！！",
   "en": "",
   "box": "19x2"
  },
  {
