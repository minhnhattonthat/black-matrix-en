{
 "source": "d1:SCENARIO/70",
 "copies": [
  "d1:SCENARIO/70",
  "d2:SCENARIO/70"
 ],
 "strings": [
  {
   "id": "s70:003a2",
   "op": "15",
   "jp": "おおっと！\n問題の奴隷が、\n帰ってきたようですね！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s70:0044e",
   "op": "15",
   "jp": "か、彼を・・・\n彼の手を離して！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:00492",
   "op": "15",
   "jp": "我々とて同じ黒い羽のアナタに\n手荒な真似などしたくはない\nのですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:004ea",
   "op": "15",
   "jp": "お嬢さん！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00506",
   "op": "15",
   "jp": "ただ・・・\nアナタがどうしても奴隷を、\n奴隷らしく扱わず・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00556",
   "op": "15",
   "jp": "首輪もつけずに、\n放し飼いにし続けると\nいうのであれば・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:005a6",
   "op": "15",
   "jp": "彼には死んでもらう事に\nなりますねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:005ee",
   "op": "15",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:00612",
   "op": "15",
   "jp": "だいいち周りに聞いた噂によると、\n奴隷をペットとして\n猫っ可愛がりするにしても、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00676",
   "op": "15",
   "jp": "服まで着せるなんて\nやりすぎじゃあないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:006ca",
   "op": "15",
   "jp": "奴隷？\nペット？！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:006fe",
   "op": "15",
   "jp": "か、彼は・・・\nそんなんじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:00742",
   "op": "15",
   "jp": "そりゃ自分の奴隷に\n執着心を持つのは勝手だが！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s70:00792",
   "op": "15",
   "jp": "なるほど！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:007b2",
   "op": "15",
   "jp": "人から貰った時には\n気にいらなかったコップが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:007f2",
   "op": "15",
   "jp": "毎日使っているうちに、\nだんだん良い物に思えてくるという\nアレですか！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:0085a",
   "op": "15",
   "jp": "ちがうっ！！\n私は・・・\n私は彼を・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:008a2",
   "op": "15",
   "jp": "愛・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:008ca",
   "op": "15",
   "jp": "あっ！！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s70:008e6",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s70:0090a",
   "op": "15",
   "jp": "愛だとぉ～！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s70:0092a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00946",
   "op": "15",
   "jp": "それは俗に、\nこの世界でも恋と呼ばれる\n人間の発情期の勘違いですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:0099e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:009ca",
   "op": "15",
   "jp": "発情期に入るとどんな動物でも\n動ξが激しくなって\n頭に血が上り・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00a22",
   "op": "15",
   "jp": "ときおり訳の分からない事を\n叫んで見たりするものです。",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00a6a",
   "op": "15",
   "jp": "だったらそれこそ、\nアナタが彼を\n好きにすればいいんです！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00aba",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s70:00ae6",
   "op": "15",
   "jp": "自分が奴隷に対して\n欲情した事を\n恥じてはいけませんよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00b32",
   "op": "15",
   "jp": "誰かに欲情するという事は・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00b62",
   "op": "15",
   "jp": "全ての動物にとって\n種族の保存に繋がる\n根元的な行為なのです！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00bb2",
   "op": "15",
   "jp": "だいいちそんな・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00bda",
   "op": "15",
   "jp": "愛などという、\n実際にはこの世にはありもしない\n妄想を口にすることが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00c32",
   "op": "15",
   "jp": "七つの大罪の一つである事を\nアナタはご存じないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s70:00c8e",
   "op": "15",
   "jp": "貴方達のいうように、\n私の想いは・・・\n一方的な物かもしれない。",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:00ce2",
   "op": "15",
   "jp": "でも・・・！\nそれがどんなに罪深くても、\n私は・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s70:00d2a",
   "op": "15",
   "jp": "私は彼を・・・\n愛しています！！",
   "en": "",
   "box": "17x3",
   "face": 7
  }
 ]
}
