{
 "source": "d1:SCENARIO/486",
 "copies": [
  "d1:SCENARIO/486",
  "d2:SCENARIO/486"
 ],
 "strings": [
  {
   "id": "s486:00b4a",
   "op": "15",
   "jp": "来たか、大邪神の使徒どもめ！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s486:00b8a",
   "op": "15",
   "jp": "ケルビムさん、\n嘘ですよね！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s486:00bba",
   "op": "15",
   "jp": "あなたが教団の一員だなんて、\n大天使だなんて！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s486:00cd6",
   "op": "15",
   "jp": "バッ・・バアル貴様！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s486:00cfe",
   "op": "15",
   "jp": "きっ、貴様だけは\n何としても、このオレが\nその体ごと灰じんに帰してやる！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s486:00d66",
   "op": "15",
   "jp": "それとも、\nルカと一緒に\n合い挽きの方がいいかな！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s486:00dba",
   "op": "15",
   "jp": "ふん、お前の方こそ\n生きたままイスに縛り付けて\nその肉を根こそぎ削いでやる！",
   "en": "",
   "box": "17x3",
   "face": 33
  },
  {
   "id": "s486:00f2e",
   "op": "15",
   "jp": "ユダよ、まさかお主までが\n大天使だったとはな。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s486:00f7e",
   "op": "15",
   "jp": "あ～ら、嫉妬だったら\nもっとしてもいいわよ。",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s486:00fca",
   "op": "15",
   "jp": "その鎧で復活するまでは、\nただのオカマだったくせに！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s486:01012",
   "op": "15",
   "jp": "そうだ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s486:0102e",
   "op": "15",
   "jp": "忘れてるだろうから\nアンタが私にしたことを\n思い出させてあげるわ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s486:010fa",
   "op": "15",
   "jp": "７月６日\nお師匠さまのことを教えると言って\n私に近づく、体が目当てか？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s486:01152",
   "op": "15",
   "jp": "７月７日\n私の服を勝手に・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s486:01192",
   "op": "15",
   "jp": "ええい、黙りなさい！\nうるさい小娘ね！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s486:0132a",
   "op": "15",
   "jp": "これ以上、\n貴様らの戯れ言に付き合う\n気は無い！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s486:0137a",
   "op": "15",
   "jp": "邪神を称える罪人どもめ！\nその罪の重さを知れ！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s486:01476",
   "op": "15",
   "jp": "うわぁぁぁぁぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s486:014ae",
   "op": "15",
   "jp": "ぐ、ぐわああぁぁぁぁ！！\nな、何だこりゃぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s486:01502",
   "op": "15",
   "jp": "フハハハハハハハ！！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s486:0152a",
   "op": "15",
   "jp": "創世記戦争の時と同じワナに\nはまるとは・・・\n愚かなやつらめ！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s486:0169e",
   "op": "15",
   "jp": "か、体が動かない・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s486:016d6",
   "op": "15",
   "jp": "フハハハハハハハ！！",
   "en": "",
   "box": "17x3",
   "face": 33
  },
  {
   "id": "s486:016fe",
   "op": "15",
   "jp": "自分からのこのこワナに\nかかりに来るとは・・・\n愚かなやつらめ！！",
   "en": "",
   "box": "17x3",
   "face": 33
  },
  {
   "id": "s486:01752",
   "op": "15",
   "jp": "この教皇庁には、メフィスト様が\nその昔に張られた・・・\n強力な結界が存在するのだ！！",
   "en": "",
   "box": "17x3",
   "face": 33
  },
  {
   "id": "s486:017c6",
   "op": "15",
   "jp": "きっ・・きさまら・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s486:01902",
   "op": "15",
   "jp": "まんまと引っかかったわね\nヨハネ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s486:0193a",
   "op": "15",
   "jp": "アタシは始めっから、アンタが\nあの偉大なるメフィスト様の\n生まれ変わりだなんて・・・",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s486:019a2",
   "op": "15",
   "jp": "信じてなかったのよ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s486:019da",
   "op": "15",
   "jp": "この結界の中で・・・\n蒸発して消えうせるがいい！！",
   "en": "",
   "box": "17x3",
   "face": 13
  }
 ]
}
