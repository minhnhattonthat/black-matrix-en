{
 "source": "d1:SCENARIO/502",
 "copies": [
  "d1:SCENARIO/502",
  "d2:SCENARIO/502"
 ],
 "strings": [
  {
   "id": "s502:00a3e",
   "op": "15",
   "jp": "どっ、どうしたってんだよ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:00a6e",
   "op": "15",
   "jp": "マモンやそこの\n色ぼけ姉ちゃんはともかく、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:00aaa",
   "op": "15",
   "jp": "な、なんでアンタまでが！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:00af6",
   "op": "15",
   "jp": "フッフッフッフッ・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00b1e",
   "op": "15",
   "jp": "汚らしい白き羽の奴隷の分際で\nわし等に軽々しく\n口を利くんじゃねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00b7a",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:00ba2",
   "op": "15",
   "jp": "お前達は知らんだろうが、",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00bce",
   "op": "15",
   "jp": "今や地上では、\n白き羽の地下組織の連中が",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00c0a",
   "op": "15",
   "jp": "無謀にも黒き羽の軍隊に対して\n大規模な革命運動を\n起こしているはずだ！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00c82",
   "op": "15",
   "jp": "くっくっくっ・・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00caa",
   "op": "15",
   "jp": "そのすべての戦闘計画が、\nすでに教団にばれているとも\n知らずにな！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00d0e",
   "op": "15",
   "jp": "そんな！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:00d3a",
   "op": "15",
   "jp": "待ち伏せにあった奴等は\n今頃、一網打尽にされているはずだ！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00d96",
   "op": "15",
   "jp": "なっ、何故なんですか？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:00dbe",
   "op": "15",
   "jp": "あんなに、",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:00dda",
   "op": "15",
   "jp": "あんなに優しかった、\nケルビムさんが？！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:00e32",
   "op": "15",
   "jp": "その汚らしい口で、\n私の名を呼ぶな！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00e6a",
   "op": "15",
   "jp": "キサマが・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00eaa",
   "op": "15",
   "jp": "キサマ達、汚らわしい\n白き羽の奴隷どもが・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00eea",
   "op": "15",
   "jp": "息子と我が家を\n破滅に追い込んだのだ！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00f26",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:00f52",
   "op": "15",
   "jp": "私は息子のセラフィムが\n死んで以来、",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00f8a",
   "op": "15",
   "jp": "長い間この怨みを\nはらす機会を待ち望み・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:00fca",
   "op": "15",
   "jp": "そのためにワザワザ、\nあの秘密地下組織を再建して\nきたのだ！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s502:0103a",
   "op": "15",
   "jp": "なっ、なんで、\nそんなまわりくどい事を！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:01076",
   "op": "15",
   "jp": "だったら最初っから、\n俺達白き羽の者達を\n皆殺しにすりゃいいじゃねえか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:011aa",
   "op": "15",
   "jp": "ウフフフフフ・・・\nそれじゃあ困るんですよ！",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:011ea",
   "op": "15",
   "jp": "いつの時代にも、\nつねに世の中というものは、",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:0122a",
   "op": "15",
   "jp": "少数の権力者の手によって、\n大多数の弱者達が搾取される\n構造になっているのです。",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:0128e",
   "op": "15",
   "jp": "つまり、搾取される人々に\nいなくなられては、",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:012ce",
   "op": "15",
   "jp": "私達、搾取する側も\n困るのですよ！！",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:01306",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s502:01332",
   "op": "15",
   "jp": "生かさず殺さず\nまあ仲良く行きましょうや！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s502:0136e",
   "op": "15",
   "jp": "あくまで、\n白き羽の奴隷あっての、\n黒き羽の世の中なんだから！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s502:013ce",
   "op": "15",
   "jp": "い、言いたいことは、\nそれだけかぁっつ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:0141a",
   "op": "15",
   "jp": "あらあら、いきり立っちゃって、\n聞いてるわよ！",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:0145a",
   "op": "15",
   "jp": "ホントはたいして\n強くもないくせに！",
   "en": "",
   "box": "17x3",
   "face": 17
  },
  {
   "id": "s502:01492",
   "op": "14",
   "jp": "・・・・・？！",
   "en": "...?!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:0161a",
   "op": "15",
   "jp": "ケガは有りませんか\nお師匠様・・・？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0165e",
   "op": "15",
   "jp": "ゲホッゲホッゴホッ・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:01696",
   "op": "15",
   "jp": "大丈夫だ、\nそれよりお前こそ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:016d6",
   "op": "15",
   "jp": "私は・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:016f2",
   "op": "15",
   "jp": "死んでも絶対に、お師匠様と\n離れたりなんかしません！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0175a",
   "op": "15",
   "jp": "きぃいいぃ～～っつ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01782",
   "op": "15",
   "jp": "相変わらずイチャイチャと\n臭い芝居を見せつけて\nくれるじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:017d6",
   "op": "15",
   "jp": "だけど・・・\nその女も所詮、言葉を喋る\nオサル達の子孫なのよ！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:0182a",
   "op": "14",
   "jp": "！！",
   "en": "!!",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0184e",
   "op": "15",
   "jp": "だからなんだというんじゃ・・・？！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:01882",
   "op": "15",
   "jp": "寿命の長さと魔力の差以外に・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:018c2",
   "op": "15",
   "jp": "わしら大天使と彼らに、\nなんの違いがあるというんじゃ！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0190e",
   "op": "15",
   "jp": "だいいち、\n大本までたどってゆけば・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0194a",
   "op": "15",
   "jp": "どちらも創造主が創り出した、\n神の子で有る事に違いは有るまい！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:019aa",
   "op": "15",
   "jp": "おやおや・・・",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:019ca",
   "op": "15",
   "jp": "それだけ違えば、\n十分じゃないですか～～！？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01a0a",
   "op": "15",
   "jp": "しかしアナタもずいぶん、\n邪教の教えに染まってしまったん\nですねぇ・・・",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01a66",
   "op": "15",
   "jp": "こちら側につくのなら、\n命ぐらいは助けてあげようと\n思っていたのにぃ・・・！？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01be6",
   "op": "15",
   "jp": "座興もここまでね！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01c0a",
   "op": "15",
   "jp": "大邪神の使徒達よ、\n創世記戦争の時と同じように、\nこの結界に押しつぶされて・・・",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01c6e",
   "op": "15",
   "jp": "この天界から滅び去るがいい！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s502:01dae",
   "op": "15",
   "jp": "きゃぁぁぁぁぁぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:01de6",
   "op": "15",
   "jp": "ぐ、ぐおぉぉぉぉぉぉぉぉ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:02016",
   "op": "15",
   "jp": "くそっ、\nバアルめ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s502:0204e",
   "op": "15",
   "jp": "ぐわあぁぁぁぁぁぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s502:023b2",
   "op": "15",
   "jp": "うわああぁぁぁぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:023de",
   "op": "15",
   "jp": "も、もう\nうわあぁぁぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s502:0241e",
   "op": "15",
   "jp": "ぐおぉぉ、\nた、耐えられそうも\nぐあぁぁぁぁぁ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:026aa",
   "op": "15",
   "jp": "このままじゃ、ダメ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:026d2",
   "op": "15",
   "jp": "みんなが、\nみんなが死んじゃう・・・！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0271a",
   "op": "15",
   "jp": "なんとか、\nみんなを助けなきゃ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0277a",
   "op": "15",
   "jp": "鎧よお願い！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0279a",
   "op": "15",
   "jp": "私の命を・・・\n全部あげる！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:028c6",
   "op": "15",
   "jp": "なっ・・・！？\n何をするんじゃルピルピ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:02a0e",
   "op": "15",
   "jp": "ル、ルピルピ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s502:02a32",
   "op": "15",
   "jp": "やめろーーーーっ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s502:02b26",
   "op": "15",
   "jp": "私の知識は・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:02b4a",
   "op": "15",
   "jp": "いつでもお師匠様と\nと・も・に・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0316e",
   "op": "15",
   "jp": "ごめんなさい、\nお師匠さま。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:031aa",
   "op": "15",
   "jp": "もういい、\nもういいんじゃよ、ルピルピ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:031e6",
   "op": "15",
   "jp": "わしがメタトロンの鎧に眠る\nアヤツの魂の封印を解こうと、\nあせったバッカリに・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0325a",
   "op": "15",
   "jp": "ねぇ\nお師匠さま知ってました？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0328a",
   "op": "15",
   "jp": "私、お師匠さまのことを\n愛していたんですよ。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:032d6",
   "op": "15",
   "jp": "き・・・気付いておったよ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:03302",
   "op": "15",
   "jp": "だがわしは、\nこんな年寄りじゃし・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0333a",
   "op": "15",
   "jp": "なによりこの体では、\nお前を幸せには出来んのじゃよ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0338e",
   "op": "15",
   "jp": "そんな事、関係ありませんよ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:033be",
   "op": "15",
   "jp": "でも良かった、\nちゃんと解っていてくれたんだ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0340e",
   "op": "15",
   "jp": "ワシもお前のことを・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0343a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:0345a",
   "op": "15",
   "jp": "悲しまないでください。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:03482",
   "op": "15",
   "jp": "これからは、\nずっと、ずっと一緒だから・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s502:036da",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s502:03706",
   "op": "15",
   "jp": "爺さんルピルピは・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s502:03742",
   "op": "15",
   "jp": "ルピルピはおるよ・・・\nいつまでもわしと一緒じゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:0379a",
   "op": "15",
   "jp": "皆の者！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:037b6",
   "op": "15",
   "jp": "奴等はおそらくこの上の\n大広間におる・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s502:037f2",
   "op": "15",
   "jp": "気をつけてかかれよ・・・！",
   "en": "",
   "box": "17x3",
   "face": 5
