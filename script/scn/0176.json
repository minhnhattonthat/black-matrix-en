 "strings": [
  {
   "id": "s176:0069e",
   "op": "15",
   "jp": "なんだよ、\n誰もいねぇじゃねぇか・・・",
   "en": ""
  },
  {
   "id": "s176:006e6",
   "op": "15",
   "jp": "この神殿の封印の間には、\n色々な神官魔法を使う連中が、\n多く存在しておる、",
   "en": ""
  },
  {
   "id": "s176:00742",
   "op": "15",
   "jp": "気を付けねばならんぞ！",
   "en": ""
  },
  {
   "id": "s176:0077a",
   "op": "15",
   "jp": "でも、ガイさんとルピルピさんが、\nまだ合流できてないよ。",
   "en": ""
  },
  {
   "id": "s176:007f6",
   "op": "15",
   "jp": "うむ・・・",
   "en": ""
  },
  {
   "id": "s176:008b2",
   "op": "15",
   "jp": "そんなの関係ねぇ！！",
   "en": ""
  },
  {
   "id": "s176:008da",
   "op": "15",
   "jp": "２人ぐれぇ足らなくても\n俺様が全部、\nぶっ倒してやるからよ！",
   "en": ""
  },
  {
   "id": "s176:00936",
   "op": "15",
   "jp": "でっ・・でも・・・",
   "en": ""
  },
  {
   "id": "s176:00982",
   "op": "15",
   "jp": "まったく！\n単純なのにもほどがあるわね！",
   "en": ""
  },
  {
   "id": "s176:009e2",
   "op": "15",
   "jp": "おにいちゃん、おにいちゃん！\nこの人、頭に・・・",
   "en": ""
  },
  {
   "id": "s176:00a26",
   "op": "15",
   "jp": "虫でも飼ってるのかなぁ？！",
   "en": ""
  },
  {
   "id": "s176:00a62",
   "op": "15",
   "jp": "うるせぇっ！\nごちゃごちゃ言う前に行動だ！",
   "en": ""
  },
  {
   "id": "s176:00ada",
   "op": "15",
   "jp": "おら行くぞ！！\nうおおおおおおおおおりゃああ！！",
   "en": ""
  }
 ]
}
