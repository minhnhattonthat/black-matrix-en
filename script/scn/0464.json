{
 "source": "d1:SCENARIO/464",
 "copies": [
  "d1:SCENARIO/464",
  "d2:SCENARIO/464"
 ],
 "strings": [
  {
   "id": "s464:00fae",
   "op": "15",
   "jp": "おい、爺さん！！",
   "en": ""
  },
  {
   "id": "s464:00fd2",
   "op": "15",
   "jp": "アンタは天国の門とか言う\n聖域の前ですら、自分の名を\n名乗ろうとはしなかった！",
   "en": ""
  },
  {
   "id": "s464:01032",
   "op": "15",
   "jp": "アンタの正体は・・・\nいったい何なんだ！？",
   "en": ""
  },
  {
   "id": "s464:01072",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s464:0108a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s464:010da",
   "op": "15",
   "jp": "わしはかつて、\nこの上空にある約束の地で、\n生命の樹を守護していた者・・・",
   "en": ""
  },
  {
   "id": "s464:0113a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s464:011b6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:011fa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:0123e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:0127a",
   "op": "15",
   "jp": "すまんが、\n今はまだそれしか言えんのじゃ。",
   "en": ""
  },
  {
   "id": "s464:012c6",
   "op": "15",
   "jp": "そないに勿体つけへんで、\n素直に教えてあげはったら\nどないどす！？",
   "en": ""
  },
  {
   "id": "s464:01622",
   "op": "15",
   "jp": "あーーーっ！\nこのムカツク声ーーっつ！！",
   "en": ""
  },
  {
   "id": "s464:0167a",
   "op": "15",
   "jp": "こっ、この声は！？",
   "en": ""
  },
  {
   "id": "s464:0181a",
   "op": "15",
   "jp": "例の色っぽい姉ちゃん！？",
   "en": ""
  },
  {
   "id": "s464:01946",
   "op": "15",
   "jp": "ぷんぷんバキーーン！！",
   "en": ""
  },
  {
   "id": "s464:0246a",
   "op": "15",
   "jp": "そういえば、\nいまだに名前すら教えて\n無かったんやねぇ！？",
   "en": ""
  },
  {
   "id": "s464:024ba",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s464:024e6",
   "op": "15",
   "jp": "うちの名は、\n放浪の大神官・ルカ！！",
   "en": ""
  },
  {
   "id": "s464:0251e",
   "op": "15",
   "jp": "たしかヨハネはんも・・・\n元々は大神官の出身\nやったわねぇ～！？",
   "en": ""
  },
  {
   "id": "s464:02572",
   "op": "15",
   "jp": "でも、\nお互いにそれは仮の姿・・・",
   "en": ""
  },
  {
   "id": "s464:025aa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:025d6",
   "op": "15",
   "jp": "そう、この世界最強の魔力を誇る\n黒き羽の大神官、\nしかしてその実体は・・・",
   "en": ""
  },
  {
   "id": "s464:02632",
   "op": "15",
   "jp": "我ら、創世記戦争で勝ち残った、\n黒き羽の大天使達が・・・",
   "en": ""
  },
  {
   "id": "s464:0267e",
   "op": "15",
   "jp": "現代に転生した姿なんよ！！",
   "en": ""
  },
  {
   "id": "s464:0289e",
   "op": "15",
   "jp": "だっ、大天使だとぉ？",
   "en": ""
  },
  {
   "id": "s464:028c6",
   "op": "15",
   "jp": "きっ、キサマ等自分達が\n神に仕える・・・",
   "en": ""
  },
  {
   "id": "s464:02902",
   "op": "15",
   "jp": "大天使だっていうのか！？",
   "en": ""
  },
  {
   "id": "s464:0292e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:0295a",
   "op": "15",
   "jp": "どうやら、うちが\n転生する為の依り代やった\nルカと同じように・・・",
   "en": ""
  },
  {
   "id": "s464:029ae",
   "op": "15",
   "jp": "ヨハネはんも、\n薄々は感づいとったみたいやねぇ！？",
   "en": ""
  },
  {
   "id": "s464:029f6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:02a22",
   "op": "15",
   "jp": "今の自分の体が・・・",
   "en": ""
  },
  {
   "id": "s464:02a4a",
   "op": "15",
   "jp": "大天使の魂を転生させる為に\n選ばれた・・・",
   "en": ""
  },
  {
   "id": "s464:02a86",
   "op": "15",
   "jp": "単なる器に過ぎないって事に！！",
   "en": ""
  },
  {
   "id": "s464:02aba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:02ae6",
   "op": "15",
   "jp": "覚醒したうちの本当の名は・・・",
   "en": ""
  },
  {
   "id": "s464:02b16",
   "op": "15",
   "jp": "娯楽と快楽を司る\n大天使リリス！！",
   "en": ""
  },
  {
   "id": "s464:02d02",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:02d2e",
   "op": "15",
   "jp": "そ、創世記戦争といえば\nたしか、何千年も昔の出来事のはず！",
   "en": ""
  },
  {
   "id": "s464:02d7a",
   "op": "15",
   "jp": "貴女やヨハネさんが、",
   "en": ""
  },
  {
   "id": "s464:02da2",
   "op": "15",
   "jp": "そんな神にも等しい\n存在だというのですか？！",
   "en": ""
  },
  {
   "id": "s464:02dee",
   "op": "15",
   "jp": "ふふん、わずか２～３００年しか\n寿命のない下級なる天使達とは\nちごうて、うちら大天使は、",
   "en": ""
  },
  {
   "id": "s464:02e5a",
   "op": "15",
   "jp": "この鎧を受け継ぐに相応しい\n強い意思を持った依り代さえ\n見つかれば・・・",
   "en": ""
  },
  {
   "id": "s464:02eb6",
   "op": "15",
   "jp": "自分の魂を鎧に移しかえて、\n何度でも転生を繰り返す事が\n出来るんよ！！",
   "en": ""
  },
  {
   "id": "s464:02f12",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:02f3e",
   "op": "15",
   "jp": "そ、それじゃあ、\nヨハネのお爺さんも・・・\nボクらの敵なの！？",
   "en": ""
  },
  {
   "id": "s464:0318e",
   "op": "15",
   "jp": "オ～ッホッホッホッホッ・・",
   "en": ""
  },
  {
   "id": "s464:031ba",
   "op": "15",
   "jp": "ヨハネが\nアンタはん達の味方！？\n何も分かっとらんようどすなぁ。",
   "en": ""
  },
  {
   "id": "s464:0320e",
   "op": "15",
   "jp": "ヨハネはん！本当のことを\n教えてあげたらどないどす？",
   "en": ""
  },
  {
   "id": "s464:03792",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s464:037be",
   "op": "15",
   "jp": "まぁ、よろしい、\nうちが言うたげるわ。",
   "en": ""
  },
  {
   "id": "s464:03806",
   "op": "15",
   "jp": "アンタはん達はなぁ・・・",
   "en": ""
  },
  {
   "id": "s464:03832",
   "op": "15",
   "jp": "エデンの園と呼ばれる大陸が\nまだ健在やった\n時分に地上に降りていった・・・",
   "en": ""
  },
  {
   "id": "s464:0388e",
   "op": "15",
   "jp": "罪深き白と黒の下級天使と・・・",
   "en": ""
  },
  {
   "id": "s464:038be",
   "op": "15",
   "jp": "言葉を喋るオサル達との\n間に産まれた・・・",
   "en": ""
  },
  {
   "id": "s464:038fa",
   "op": "15",
   "jp": "いわば・・・\n呪われたオサルの子孫達なんよ！！",
   "en": ""
  },
  {
   "id": "s464:03afe",
   "op": "15",
   "jp": "さっ、サル！？",
   "en": ""
  },
  {
   "id": "s464:03b2e",
   "op": "15",
   "jp": "俺達がサルの子孫だと！？",
   "en": ""
  },
  {
   "id": "s464:03b66",
   "op": "15",
   "jp": "何をバカな事を言ってやがる！！",
   "en": ""
  },
  {
   "id": "s464:03ba6",
   "op": "15",
   "jp": "ウフフフフフ\nまぁ、知らんのも無理はおへんなぁ。",
   "en": ""
  },
  {
   "id": "s464:03bea",
   "op": "15",
   "jp": "なにせアンタはん達\nオサルの御先祖は・・・",
   "en": ""
  },
  {
   "id": "s464:03c26",
   "op": "15",
   "jp": "大悪神ゴッドの怒りを買うて、\n大洪水でみぃ～んな絶滅して\nしもうたんやからねぇ！！",
   "en": ""
  },
  {
   "id": "s464:03e42",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:03e62",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s464:03f4e",
   "op": "15",
   "jp": "お師匠さま・・・\n本当・・・なのですか？",
   "en": ""
  },
  {
   "id": "s464:03f8a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:0407a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:040a6",
   "op": "15",
   "jp": "あらあら、お可哀想に・・・",
   "en": ""
  },
  {
   "id": "s464:040d2",
   "op": "15",
   "jp": "オサルの子孫のアンタと\n大天使となられる\nヨハネ殿とでは・・・",
   "en": ""
  },
  {
   "id": "s464:04122",
   "op": "15",
   "jp": "どんなに罪深く愛しても、\nその想いが受け入れられることは、\n無いんやねぇ！？",
   "en": ""
  },
  {
   "id": "s464:04182",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:041ae",
   "op": "15",
   "jp": "せやけど、そんなに\n気ぃ落とさんといて！",
   "en": ""
  },
  {
   "id": "s464:041ea",
   "op": "15",
   "jp": "アンタのように\n僅かな魔力や・・・",
   "en": ""
  },
  {
   "id": "s464:0421e",
   "op": "15",
   "jp": "頭に小さな角が残ってる\nオサルの神官達は・・・",
   "en": ""
  },
  {
   "id": "s464:0425e",
   "op": "15",
   "jp": "比較的下級天使の血を、\n強く受け継いだ・・・",
   "en": ""
  },
  {
   "id": "s464:0429e",
   "op": "15",
   "jp": "いわば遠い親戚みたいな\nもんなんやから！",
   "en": ""
  },
  {
   "id": "s464:042e6",
   "op": "15",
   "jp": "じゃ、邪教徒達め！\nみつけたぞ！！",
   "en": ""
  },
  {
   "id": "s464:0517a",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s464:0519e",
   "op": "15",
   "jp": "あらあら、見つかってもうた。",
   "en": ""
  },
  {
   "id": "s464:051ce",
   "op": "15",
   "jp": "どのみち彼らじゃ相手に\nならへんやろうけど、",
   "en": ""
  },
  {
   "id": "s464:0520e",
   "op": "15",
   "jp": "お先に上で、\n待たせて貰いますわ！",
   "en": ""
  },
  {
   "id": "s464:0548a",
   "op": "15",
   "jp": "おい！こら！ちょっと待てっ！！",
   "en": ""
  },
  {
   "id": "s464:054f6",
   "op": "15",
   "jp": "邪教の教えを語る\n愚か者どもよ！",
   "en": ""
  },
  {
   "id": "s464:0552a",
   "op": "15",
   "jp": "世界を混乱と破壊に導く為に\nついに現れおったか！！",
   "en": ""
  },
  {
   "id": "s464:05572",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s464:0565a",
   "op": "15",
   "jp": "よいか神の御子達よ。",
   "en": ""
  },
  {
   "id": "s464:05682",
   "op": "15",
   "jp": "我らに大神サタン様の\nご加護がある限り、\n恐れる事など何もない！！",
   "en": ""
  },
  {
   "id": "s464:056d6",
   "op": "15",
   "jp": "奴らに天罰を下すのだっ！！",
   "en": ""
  }
 ]
}
