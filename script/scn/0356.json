 "strings": [
  {
   "id": "s356:00582",
   "op": "14",
   "jp": "ああ～らっ！いい男ねぇ～ん！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:005a8",
   "op": "14",
   "jp": "ここは欲情の街・ベギルドよ！\nゆっくりしていってね！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:0061e",
   "op": "14",
   "jp": "いらっしゃぁ～～い！\nうちの商品は\nいい物取りそろえてるわよぉ～",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:006ae",
   "op": "14",
   "jp": "あ～ら、アナタなんだか、\nとぉ～っても強そうね！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00722",
   "op": "14",
   "jp": "いやぁ～～ん！この街に\nアタシを知らない男が\nいるなんてぇ～！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:007a2",
   "op": "14",
   "jp": "ようこそ、ベギルドの街へ。\nこの街はお気に召しまして？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:007e0",
   "op": "14",
   "jp": "気に入られたのでしたら、\nお住まいになっても\nよろしいのですよ",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00826",
   "op": "14",
   "jp": "強い方なら・・・くすっ！\n羽の色など気にしませんもの・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00866",
   "op": "14",
   "jp": "なんと言ってもこの街は・・\n素晴らしき欲情の街\nなんですから・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:008ea",
   "op": "14",
   "jp": "何だよ、俺は何も悪い事なんか\nして無いぞ・・・たぶん。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00928",
   "op": "14",
   "jp": "なにせこの街で働いてるのは、\n女性だけなのさ・・・、\nってそうでもないか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:009b6",
   "op": "14",
   "jp": "この間グザファン様の私設軍隊が\nどこかに出征したらしいけど",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:009f8",
   "op": "14",
   "jp": "あれからどうなったのかな？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00a6e",
   "op": "14",
   "jp": "あら、この街に来て\nウチによらないなんてウソよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00aa6",
   "op": "14",
   "jp": "ちょっと寄ってく？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s356:00ada",
   "op": "1d",
   "jp": "寄っていく",
   "en": "",
   "max": 15
  },
  {
   "id": "s356:00aec",
   "op": "1d",
   "jp": "寄っていかない",
   "en": "",
   "max": 15
  },
  {
   "id": "s356:00b08",
   "op": "14",
   "jp": "だれが行きますか？",
