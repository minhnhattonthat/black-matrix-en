{
 "source": "d1:SCENARIO/338",
 "copies": [
  "d1:SCENARIO/338",
  "d2:SCENARIO/338"
 ],
 "strings": [
  {
   "id": "s338:00782",
   "op": "14",
   "jp": "・・・鎧の力とやらは、\nこの程度のものなのか・・・",
   "en": ""
  },
  {
   "id": "s338:007fe",
   "op": "14",
   "jp": "鎧の力なんざ関係ねぇ！！",
   "en": ""
  },
  {
   "id": "s338:0086a",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": ""
  },
  {
   "id": "s338:008ee",
   "op": "14",
   "jp": "力なき白い羽どもに\n忠告する。",
   "en": ""
  },
  {
   "id": "s338:0096e",
   "op": "14",
   "jp": "くっ！！",
   "en": ""
  },
  {
   "id": "s338:0098a",
   "op": "14",
   "jp": "貴様らごときを殺すのは簡単だ。",
   "en": ""
  },
  {
   "id": "s338:00a0a",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s338:00a22",
   "op": "14",
   "jp": "お前らの、くだらん考え方に\n興味はないが・・・",
   "en": ""
  },
  {
   "id": "s338:00a58",
   "op": "14",
   "jp": "それを追い求める限り、\n奴との衝突は\n避けられんだろう。",
   "en": ""
  },
  {
   "id": "s338:00af2",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s338:00afe",
   "op": "14",
   "jp": "（教団の上層部を知っている！？）",
   "en": ""
  },
  {
   "id": "s338:00b32",
   "op": "14",
   "jp": "だが、俺と同じ力を\n求めるだけでは、\n奴を倒すことはできん。",
   "en": ""
  },
  {
   "id": "s338:00b76",
   "op": "14",
   "jp": "貴様らが持つ、\nまだ見ぬ力・・・",
   "en": ""
  },
  {
   "id": "s338:00b9e",
   "op": "14",
   "jp": "その力を理解することだな。",
   "en": ""
  },
  {
   "id": "s338:00c1a",
   "op": "14",
   "jp": "（・・・あやつ・・・）",
   "en": ""
  },
  {
   "id": "s338:00c92",
   "op": "14",
   "jp": "（・・・何を言っている？）",
   "en": ""
  },
  {
   "id": "s338:00cc2",
   "op": "14",
   "jp": "貴様らが、俺に代わって\n奴を倒したそのときには・・",
   "en": ""
  },
  {
   "id": "s338:00cfc",
   "op": "14",
   "jp": "俺が改めて、\n貴様らを殺してやろう。",
   "en": ""
  },
  {
   "id": "s338:00d82",
   "op": "14",
   "jp": "くそがぁッ！！",
   "en": ""
  },
  {
   "id": "s338:00db6",
   "op": "14",
   "jp": "（なぜ奴が、この程度の\n　鎧にこだわるのか・・・）",
   "en": ""
  },
  {
   "id": "s338:00df0",
   "op": "14",
   "jp": "（時代の先を見るのも、\n　面白いかも知れんな・・・）",
   "en": ""
  },
  {
   "id": "s338:00e9e",
   "op": "14",
   "jp": "このやろう！！\nよそ見してんじゃねぇ！！",
   "en": ""
  },
  {
   "id": "s338:00fc2",
   "op": "14",
   "jp": "よぉ、会いたかったぜ！！",
   "en": ""
  },
  {
   "id": "s338:00fee",
   "op": "14",
   "jp": "・・・この程度の力すら\n押さえ込むこともできんとは・・\n教団も衰えたな・・・",
   "en": ""
  },
  {
   "id": "s338:0104e",
   "op": "14",
   "jp": "なんだとぉ！！",
   "en": ""
  },
  {
   "id": "s338:01146",
   "op": "14",
   "jp": "貴様ほどの力を持つ者が、\nなぜ、奴らに従う必要がある？",
   "en": ""
  },
  {
   "id": "s338:01192",
   "op": "14",
   "jp": "従う？",
   "en": ""
  },
  {
   "id": "s338:011a0",
   "op": "14",
   "jp": "ふっ、俺が生きていた時代では、\n聞いたこともない言葉だな・・・",
   "en": ""
  },
  {
   "id": "s338:011e6",
   "op": "14",
   "jp": "それもまた、時代の流れか・・・",
   "en": ""
  },
  {
   "id": "s338:0121a",
   "op": "14",
   "jp": "時代・・・だと？",
   "en": ""
  },
  {
   "id": "s338:0153a",
   "op": "14",
   "jp": "（なぜ奴が、この程度の\n　鎧にこだわるのか・・・）",
   "en": ""
  },
  {
   "id": "s338:01574",
   "op": "14",
   "jp": "（時代の先を見るのも、\n　面白いかも知れんな・・・）",
   "en": ""
  }
 ]
}
