   "face": 0
  },
  {
   "id": "s512:00802",
   "op": "15",
   "jp": "やはりルカには・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:0082a",
   "op": "15",
   "jp": "かつて愛を語りあった\n彼の者と戦う事など・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:0086a",
   "op": "15",
   "jp": "出来なかったようですね！",
