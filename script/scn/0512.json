 "strings": [
  {
   "id": "s512:00786",
   "op": "15",
   "jp": "教皇様・・・！\nも、申し訳ありません・・・",
   "en": "Pope-sama...! F-forgive me...",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s512:007c6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s512:00802",
   "op": "15",
   "jp": "やはりルカには・・・",
   "en": "As I thought, for Luca...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:0082a",
   "op": "15",
   "jp": "かつて愛を語りあった\n彼の者と戦う事など・・・",
   "en": "to fight the one with whom she once spoke of love...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:0086a",
   "op": "15",
   "jp": "出来なかったようですね！",
   "en": "was not possible, it seems!",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00896",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s512:008ba",
   "op": "15",
   "jp": "ルカの魂は元々・・・",
   "en": "Luca's soul was, at its origin...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:008e2",
   "op": "15",
   "jp": "メフィスト様との禁断の愛を選び、",
   "en": "she who chose forbidden love with Mephisto-sama,",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00916",
   "op": "15",
   "jp": "自分の最初の夫であった\nアダムを裏切った・・・",
   "en": "and betrayed Adam, her first husband...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00956",
   "op": "15",
   "jp": "人類最初の女リリス！！",
   "en": "Lilith, the first woman of humankind!!",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00996",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s512:009ba",
   "op": "15",
   "jp": "その後メフィスト様のお力で\n大天使の一人に加えられ・・・",
   "en": "Thereafter, by Mephisto-sama's power, she was made one of the archangels...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00a06",
   "op": "15",
   "jp": "今までは、この世界の道徳を\n守る為に尽くして来たのですが・・・",
   "en": "and until now she has devoted herself to upholding this world's morals, but...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00a56",
   "op": "15",
   "jp": "やはり・・・",
   "en": "As I thought...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00a76",
   "op": "15",
   "jp": "かつて愛したメフィスト様の\n魂を宿せし者と戦えと\n言ったのは・・・",
   "en": "to order her to fight one who holds the soul of Mephisto-sama, whom she once loved...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00aca",
   "op": "15",
   "jp": "少し酷だったようです・・・",
   "en": "was somewhat cruel...",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00afa",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s512:00b1a",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s512:00b3e",
   "op": "15",
   "jp": "まだ、\n思い出せませんか！？",
   "en": "Do you still not remember!?",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00b6e",
   "op": "15",
   "jp": "幼き日のアナタが、",
   "en": "You, in your early days,",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s512:00b92",
   "op": "15",
   "jp": "メフィスト様の\n心臓を移植された・・・\nあの日のことを！！",
   "en": "the day Mephisto-sama's heart was transplanted into you!!",
   "box": "17x3",
   "face": 19
  }
 ]
}
