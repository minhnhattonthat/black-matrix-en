{
 "source": "d1:SCENARIO/505",
 "copies": [
  "d1:SCENARIO/505",
  "d2:SCENARIO/505"
 ],
 "strings": [
  {
   "id": "s505:00966",
   "op": "15",
   "jp": "愚かな奴らめ！！",
   "en": ""
  },
  {
   "id": "s505:0098a",
   "op": "15",
   "jp": "愛や正義などと言う\nまやかしを信じているからこそ、",
   "en": ""
  },
  {
   "id": "s505:009ce",
   "op": "15",
   "jp": "あのようなワナにも\n簡単にかかりおる。",
   "en": ""
  },
  {
   "id": "s505:00a16",
   "op": "15",
   "jp": "今頃奴らは蒸発し、\n鎧だけになっているはず！！",
   "en": ""
  },
  {
   "id": "s505:00a5a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s505:00a96",
   "op": "15",
   "jp": "あとは残った大邪神の鎧を\n回収し・・・",
   "en": ""
  },
  {
   "id": "s505:00ace",
   "op": "15",
   "jp": "再び封印して、\nこの世界をつなぐ鎖を\n元に戻せば・・・",
   "en": ""
  },
  {
   "id": "s505:00b16",
   "op": "15",
   "jp": "この世は再び、七つの美徳で\n満たされた、偽善や\nキレイゴトのない世界となる！！",
   "en": ""
  },
  {
   "id": "s505:00b96",
   "op": "15",
   "jp": "おっと、そいつはどうかな？",
   "en": ""
  },
  {
   "id": "s505:0106e",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s505:01086",
   "op": "15",
   "jp": "き、貴様ら！！",
   "en": ""
  },
  {
   "id": "s505:010c6",
   "op": "15",
   "jp": "悪いが、お前達の言う美徳\nとやらには、虫酸が走るんでね！！",
   "en": ""
  },
  {
   "id": "s505:01132",
   "op": "15",
   "jp": "許さん！\n許さんぞ！！",
   "en": ""
  },
  {
   "id": "s505:0115a",
   "op": "15",
   "jp": "弱者の権利を踏みにじるお主たちの\n神の名を借りた、\nごう慢で冷徹な数々の行い！",
   "en": ""
  },
  {
   "id": "s505:011ba",
   "op": "15",
   "jp": "たとえ大天使である\nお主達とはいえ・・・",
   "en": ""
  },
  {
   "id": "s505:011f6",
   "op": "15",
   "jp": "誰も他人の\n生きる権利を・・・",
   "en": ""
  },
  {
   "id": "s505:01226",
   "op": "15",
   "jp": "勝手に決めることなど\nできんはずじゃ・・・",
   "en": ""
  },
  {
   "id": "s505:01266",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:01292",
   "op": "15",
   "jp": "ましてや年齢や身分・・・",
   "en": ""
  },
  {
   "id": "s505:012be",
   "op": "15",
   "jp": "羽の色や性別などで\n迫害する権利など・・・",
   "en": ""
  },
  {
   "id": "s505:012fa",
   "op": "15",
   "jp": "貴様達にあるはずが無いではないか！",
   "en": ""
  },
  {
   "id": "s505:013e2",
   "op": "15",
   "jp": "そっ、その６枚の羽はっ！？",
   "en": ""
  },
  {
   "id": "s505:01412",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:0143e",
   "op": "15",
   "jp": "こっ・・これ・で、\n全てが・・解りましたよ・・・",
   "en": ""
  },
  {
   "id": "s505:01482",
   "op": "15",
   "jp": "なぜ、メフィスト様が\nこのワタクシではなく・・・",
   "en": ""
  },
  {
   "id": "s505:014c6",
   "op": "15",
   "jp": "何処の馬の骨とも解らない、\nアナタを、あの街の支配者に\n仕立て上げたのか・・・",
   "en": ""
  },
  {
   "id": "s505:0152a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:01556",
   "op": "15",
   "jp": "アナタの正体は・・・",
   "en": ""
  },
  {
   "id": "s505:0157e",
   "op": "15",
   "jp": "大悪神・ゴッドの手によって\n絶滅させられるはずだった、\nサル共に同情し・・・",
   "en": ""
  },
  {
   "id": "s505:015de",
   "op": "15",
   "jp": "奴等を救うために、\n創世記戦争への参戦を放棄した・・・",
   "en": ""
  },
  {
   "id": "s505:01626",
   "op": "15",
   "jp": "６枚羽の大邪神ラファエル！！",
   "en": ""
  },
  {
   "id": "s505:01702",
   "op": "15",
   "jp": "ですが・・・\nアナタはあの戦争の後\nサタン様に服従して、",
   "en": ""
  },
  {
   "id": "s505:0174e",
   "op": "15",
   "jp": "この世界の新たなる再生に\n貢献されたはず・・・",
   "en": ""
  },
  {
   "id": "s505:0178e",
   "op": "15",
   "jp": "なのに今度は我々までを・・・",
   "en": ""
  },
  {
   "id": "s505:017be",
   "op": "15",
   "jp": "裏切ろうと言うのですか！？",
   "en": ""
  },
  {
   "id": "s505:017ee",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s505:0180e",
   "op": "15",
   "jp": "わしがあの時、\nゴッドを裏切ったのは・・・",
   "en": ""
  },
  {
   "id": "s505:0184a",
   "op": "15",
   "jp": "「言葉や火の使い方を覚えた」\nというだけの、くだらない理由で・・",
   "en": ""
  },
  {
   "id": "s505:0189e",
   "op": "15",
   "jp": "自らが作り出したサル達、\n全てを絶滅させようとした・・・",
   "en": ""
  },
  {
   "id": "s505:018ea",
   "op": "15",
   "jp": "そんなゴッドのやり方が\n気に入らなかったからじゃ！！",
   "en": ""
  },
  {
   "id": "s505:01932",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:0195e",
   "op": "15",
   "jp": "しかし、お前達に味方して手に入れた現在の彼らの生活も・・・",
   "en": ""
  },
  {
   "id": "s505:019aa",
   "op": "15",
   "jp": "もはや完全に目に余る！！",
   "en": ""
  },
  {
   "id": "s505:019e2",
   "op": "15",
   "jp": "あんがいメフィストは、\n初めからこうなる事を承知の上で\nわしを大神官にし・・・",
   "en": ""
  },
  {
   "id": "s505:01a42",
   "op": "15",
   "jp": "自分自身の魂が宿る鎧を、\n託したのかもしれんな・・・",
   "en": ""
  },
  {
   "id": "s505:01a96",
   "op": "15",
   "jp": "ばっ・・・バカな・・・！！",
   "en": ""
  },
  {
   "id": "s505:01ac2",
   "op": "15",
   "jp": "自分の大邪神の鎧も無しに・・・",
   "en": ""
  },
  {
   "id": "s505:01af2",
   "op": "15",
   "jp": "この私達に勝てるとでも・・・",
   "en": ""
  },
  {
   "id": "s505:01b22",
   "op": "15",
   "jp": "思ってるん・・ですか！？",
   "en": ""
  },
  {
   "id": "s505:01b4e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:01b6a",
   "op": "15",
   "jp": "鎧なら此処に有るではないか！",
   "en": ""
  },
  {
   "id": "s505:01b9a",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s505:01bbe",
   "op": "15",
   "jp": "そもそも、お主達が着ておる\nその鎧の真の役割は・・・",
   "en": ""
  },
  {
   "id": "s505:01c06",
   "op": "15",
   "jp": "突然の戦闘で自分が\n死んでしまった時の用心の為に・・・",
   "en": ""
  },
  {
   "id": "s505:01c4e",
   "op": "15",
   "jp": "事前に己の魂の複製品を、\n鎧に記憶させておけるという\n部分にこそ存在するのじゃ！！",
   "en": ""
  },
  {
   "id": "s505:01cb6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:01ce2",
   "op": "15",
   "jp": "つまりその鎧の力の強弱は、",
   "en": ""
  },
  {
   "id": "s505:01d0e",
   "op": "15",
   "jp": "本来の鎧の持ち主の力に、\n正比例しておるのじゃよ・・・",
   "en": ""
  },
  {
   "id": "s505:01d56",
   "op": "15",
   "jp": "だからこそ・・・",
   "en": ""
  },
  {
   "id": "s505:01d7a",
   "op": "15",
   "jp": "その鎧を着た人物を、",
   "en": ""
  },
  {
   "id": "s505:01da2",
   "op": "15",
   "jp": "鎧本来の持ち主の魂が\n認めなかった場合・・・",
   "en": ""
  },
  {
   "id": "s505:01de2",
   "op": "15",
   "jp": "鎧が暴走して、着用者を\n内側から食い尽くすのじゃ・・・！",
   "en": ""
  },
  {
   "id": "s505:01e2e",
   "op": "15",
   "jp": "言い換えれば天使達の着る\n鎧には・・・",
   "en": ""
  },
  {
   "id": "s505:01e66",
   "op": "15",
   "jp": "本来なんのランク分けも\nないということじゃよ・・・",
   "en": ""
  },
  {
   "id": "s505:01eae",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:01eea",
   "op": "15",
   "jp": "お主達のような、なんども転生を\nくり返してきた大天使達とは違い、",
   "en": ""
  },
  {
   "id": "s505:01f3e",
   "op": "15",
   "jp": "あの戦争以前から一度も転生して\nいないわしにとって・・・",
   "en": ""
  },
  {
   "id": "s505:01f8a",
   "op": "15",
   "jp": "このルピルピの魂が宿る\n邪道騎士の鎧も・・・",
   "en": ""
  },
  {
   "id": "s505:01fd6",
   "op": "15",
   "jp": "わしが着る事によって、本物の\n大邪神の鎧になりうるのじゃ！！",
   "en": ""
  },
  {
   "id": "s505:02042",
   "op": "15",
   "jp": "今こそはっきり言うことが出来る",
   "en": ""
  },
  {
   "id": "s505:02072",
   "op": "15",
   "jp": "ルピルピ、\nお前のことを愛しておると！",
   "en": ""
  },
  {
   "id": "s505:020be",
   "op": "15",
   "jp": "お師匠さま・・・！",
   "en": ""
  },
  {
   "id": "s505:02266",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s505:02282",
   "op": "15",
   "jp": "さぁ！！\n創世記戦争とやらの再開だ！！\n決着を、つけようぜ！！",
   "en": ""
  }
 ]
}
