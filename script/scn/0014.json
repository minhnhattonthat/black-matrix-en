{
 "source": "d1:SCENARIO/14",
 "copies": [
  "d1:SCENARIO/14",
  "d2:SCENARIO/14"
 ],
 "strings": [
  {
   "id": "s14:0020e",
   "op": "15",
   "jp": "目が覚めたからって、\nまだ動いちゃダメよ！",
   "en": ""
  },
  {
   "id": "s14:0024a",
   "op": "15",
   "jp": "ずっと眠ったままだったんだもん、\n体がびっくりしちゃうから。",
   "en": ""
  },
  {
   "id": "s14:0029a",
   "op": "15",
   "jp": "退屈しないように、\n私がお話をしてあげるね。",
   "en": ""
  },
  {
   "id": "s14:002da",
   "op": "15",
   "jp": "あの大きな落雷があった日・・・\nあ、といっても覚えてないよね。",
   "en": ""
  },
  {
   "id": "s14:0032a",
   "op": "15",
   "jp": "アナタは私のために山へ入って、\n薬草を取ってくれていたの。",
   "en": ""
  },
  {
   "id": "s14:00386",
   "op": "15",
   "jp": "何故医者にいかなかったのかって？\nそれは・・・",
   "en": ""
  },
  {
   "id": "s14:003d6",
   "op": "15",
   "jp": "ちょっとね、\nいけない事情があったの・・・",
   "en": ""
  },
  {
   "id": "s14:00412",
   "op": "15",
   "jp": "とにかく・・・\n山の奥へと入っていったアナタは、",
   "en": ""
  },
  {
   "id": "s14:00456",
   "op": "15",
   "jp": "何かの事故に\n巻き込まれたみたいなの。",
   "en": ""
  },
  {
   "id": "s14:0048e",
   "op": "15",
   "jp": "それはとても\n大きな事故だったと思うわ。",
   "en": ""
  },
  {
   "id": "s14:0053a",
   "op": "15",
   "jp": "（だって、私は見たんだもの。）",
   "en": ""
  },
  {
   "id": "s14:0056a",
   "op": "15",
   "jp": "（雨が止んだあの日、\n　やっと動けるようになって\n　入っていった山の中に、）",
   "en": ""
  },
  {
   "id": "s14:005ca",
   "op": "15",
   "jp": "（アナタを囲むようにして倒れる\n　大勢の人の死体を！！）",
   "en": ""
  },
  {
   "id": "s14:00622",
   "op": "15",
   "jp": "かすかな息しかしていない、\n血だらけのアナタを見たとき、",
   "en": ""
  },
  {
   "id": "s14:0066e",
   "op": "15",
   "jp": "私、絶望で・・・\nもう何も考えられなかった。",
   "en": ""
  },
  {
   "id": "s14:006ba",
   "op": "15",
   "jp": "（この世界に一人で残されたら、\n　私・・・）",
   "en": ""
  },
  {
   "id": "s14:006fa",
   "op": "15",
   "jp": "（不安で、心細くて・・・）",
   "en": ""
  },
  {
   "id": "s14:00726",
   "op": "15",
   "jp": "グスッ・・・",
   "en": ""
  },
  {
   "id": "s14:007a2",
   "op": "15",
   "jp": "さあ、もう休んで！",
   "en": ""
  },
  {
   "id": "s14:007c6",
   "op": "15",
   "jp": "無理はしない方がいいと思うの。",
   "en": ""
  },
  {
   "id": "s14:00806",
   "op": "15",
   "jp": "早く元気になってね。",
   "en": ""
  },
  {
   "id": "s14:00a6e",
   "op": "15",
   "jp": "私ね・・・\nアナタが目を覚まさなかったとき、\nとっても心細かったのよ。",
   "en": ""
  },
  {
   "id": "s14:00ad6",
   "op": "15",
   "jp": "だって私、\nアナタの瞳が大好きなの。",
   "en": ""
  },
  {
   "id": "s14:00b0e",
   "op": "15",
   "jp": "アナタに見つめられると・・・",
   "en": ""
  },
  {
   "id": "s14:00b3e",
   "op": "15",
   "jp": "忘れていた気持ちが、\nなんだかよみがえりそうで！",
   "en": ""
  },
  {
   "id": "s14:00b82",
   "op": "15",
   "jp": "例えどんなに嫌われようと・・・\nこの気持ちは変わらないわ。",
   "en": ""
  },
  {
   "id": "s14:00f5e",
   "op": "15",
   "jp": "だっ大丈夫！？目が覚めてから、\nまだ一週間しか経ってないのに\n起きたりして。",
   "en": ""
  },
  {
   "id": "s14:00fbe",
   "op": "15",
   "jp": "でも無理はしない方がいいわ、\nまだ本調子じゃないみたいだもの。",
   "en": ""
  },
  {
   "id": "s14:01012",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s14:0103e",
   "op": "15",
   "jp": "それと、\n一つだけ大事なお願いがあるの。",
   "en": ""
  },
  {
   "id": "s14:0107a",
   "op": "15",
   "jp": "これは重要な事だから、\n絶対に忘れないでね。",
   "en": ""
  },
  {
   "id": "s14:010ba",
   "op": "15",
   "jp": "アナタはこの世界での記憶を\n無くしてしまっていて、",
   "en": ""
  },
  {
   "id": "s14:010fe",
   "op": "15",
   "jp": "この世界の常識に、\n慣れてないはずでしょ？！",
   "en": ""
  },
  {
   "id": "s14:0113e",
   "op": "15",
   "jp": "だから私が安心してアナタを、\n家の外に送り出せるようになるまで、",
   "en": ""
  },
  {
   "id": "s14:01192",
   "op": "15",
   "jp": "勝手に家の柵の外には、\n出ないで欲しいの。",
   "en": ""
  },
  {
   "id": "s14:011ce",
   "op": "15",
   "jp": "いい？\n外に出ちゃダメよ！",
   "en": ""
  },
  {
   "id": "s14:011fa",
   "op": "15",
   "jp": "二人だけの約束。",
   "en": ""
  },
  {
   "id": "s14:0122a",
   "op": "15",
   "jp": "しばらくは、\nちゃんとリハビリしなくっちゃね！",
   "en": ""
  }
 ]
}
