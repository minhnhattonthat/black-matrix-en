 "strings": [
  {
   "id": "s354:0118e",
   "op": "15",
   "jp": "・・・・・セラフィムは\nお前と付き合い出してから\nドンドンおかしくなっちまった！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:011f2",
   "op": "15",
   "jp": "白い羽の奴隷達を解放するとか、\nみんなが平等で\nあるべきだとか！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:01246",
   "op": "15",
   "jp": "あまつさえ\n付き合っても何の価値もない・・・",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:01286",
   "op": "15",
   "jp": "奴隷のお前のことを\n親友などと言い出すなんて！！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:012ca",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s354:012f6",
   "op": "15",
   "jp": "友情なんて単なる\n感情の貸し借りじゃないか！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:01336",
   "op": "15",
   "jp": "みんな自分に利益があるから\n付き合ってるだけさ・・・",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:0137e",
   "op": "15",
   "jp": "そんなものに\n一体何の意味があるっていうんだ！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:013f2",
   "op": "15",
   "jp": "僕と・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s354:0141e",
   "op": "15",
   "jp": "僕と\nセラフィムさんとの関係は\nそんなんじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s354:0154e",
   "op": "15",
   "jp": "じゃあ友情って何なんだ！？\nはっきりと言ってみろよ！！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:01722",
   "op": "15",
   "jp": "何だよ、\n今更そんな事をして、",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:01752",
   "op": "15",
   "jp": "へっ！今度は俺に\n気に入られようっていうのか！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:017c6",
   "op": "15",
   "jp": "違う！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s354:01812",
   "op": "15",
   "jp": "ただ勝手に・・・\n勝手に身体が動いたんだ！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s354:0185e",
   "op": "15",
   "jp": "そんな芝居をしたって\n無駄だぜ。",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:01892",
   "op": "15",
   "jp": "俺はセラフィムみたいに、\nダマされたりはしないからな！！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:018de",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s354:0192e",
   "op": "15",
   "jp": "それは違うぞグザファン！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s354:023aa",
   "op": "15",
   "jp": "ケ、ケルビムの親爺！！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:0242e",
   "op": "15",
   "jp": "ルピルピ、無事じゃったか？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s354:0248e",
   "op": "15",
   "jp": "えぇ、なんとか。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s354:024be",
   "op": "15",
   "jp": "グザファン！！\nお前は小さい時から\n何も変わってはおらんな・・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s354:02516",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:02542",
   "op": "15",
   "jp": "お前の憎悪の裏に隠れているもの",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s354:02572",
   "op": "15",
   "jp": "それは、\nマルコとセラフィムとの\n友情に対する妬みであろう！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s354:025f2",
   "op": "15",
   "jp": "くっ！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s354:0261a",
   "op": "15",
   "jp": "そう、\nお前はあの時もそうだった。",
   "en": "",
   "box": "17x3",
   "face": 16
  }
 ]
}
