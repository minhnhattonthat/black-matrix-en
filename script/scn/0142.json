{
 "source": "d1:SCENARIO/142",
 "copies": [
  "d1:SCENARIO/142",
  "d2:SCENARIO/142"
 ],
 "strings": [
  {
   "id": "s142:0077a",
   "op": "14",
   "jp": "わしが考えるに・・・\nこれ以上、魔法は使えん・・・",
   "en": ""
  },
  {
   "id": "s142:007b4",
   "op": "14",
   "jp": "しからば、お先に失礼するぞ！",
   "en": ""
  },
  {
   "id": "s142:0081a",
   "op": "14",
   "jp": "げぇっ！\n（こっ・・・これが・・）",
   "en": ""
  },
  {
   "id": "s142:00844",
   "op": "14",
   "jp": "（大神官ヨハネの・・\n　魔法なのか・・！？）",
   "en": ""
  },
  {
   "id": "s142:00886",
   "op": "14",
   "jp": "そうじゃ！\n戦う前に、お主達に言って\nおかねばならんことがある。",
   "en": ""
  },
  {
   "id": "s142:008de",
   "op": "14",
   "jp": "あぁ！？",
   "en": ""
  },
  {
   "id": "s142:008fe",
   "op": "14",
   "jp": "わしは暗黒魔法という、\nお主達では想像できぬ程の力を\nもっておる・・・",
   "en": ""
  },
  {
   "id": "s142:0094c",
   "op": "14",
   "jp": "じゃが、この世界に存在する\n魔法は一つの例外もなく・・・",
   "en": ""
  },
  {
   "id": "s142:0098c",
   "op": "14",
   "jp": "時間による影響を\n受けておるのじゃ・・・！",
   "en": ""
  },
  {
   "id": "s142:009be",
   "op": "14",
   "jp": "つまり、お主達の戦い方次第で、\nわしの魔法が生きもすれば、\n死にもするという事・・・",
   "en": ""
  },
  {
   "id": "s142:00a1a",
   "op": "14",
   "jp": "その辺をよく考えながら・・・\n行動することじゃな！",
   "en": ""
  },
  {
   "id": "s142:00a66",
   "op": "14",
   "jp": "けっ！そんな事まで、\nいちいち考えながら・・・",
   "en": ""
  },
  {
   "id": "s142:00a9c",
   "op": "14",
   "jp": "戦ってられっかよ！",
   "en": ""
  },
  {
   "id": "s142:00b32",
   "op": "14",
   "jp": "看守兵！！",
   "en": ""
  },
  {
   "id": "s142:00b44",
   "op": "14",
   "jp": "こいつ等を、簡単に殺したり\nするんじゃあないわよ・・・！",
   "en": ""
  },
  {
   "id": "s142:00b84",
   "op": "14",
   "jp": "痛めつけて痛めつけて・・・",
   "en": ""
  },
  {
   "id": "s142:00ba6",
   "op": "14",
   "jp": "「お願いだから殺して下さい」と\n土下座しながら、地面の血を舌で\nなめ取るようになるまで・・・",
   "en": ""
  },
  {
   "id": "s142:00c0a",
   "op": "14",
   "jp": "徹底的に痛めつけておやりなさい！",
   "en": ""
  },
  {
   "id": "s142:00c3e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s142:00c66",
   "op": "14",
   "jp": "かわいい奴等よ",
   "en": ""
  },
  {
   "id": "s142:00c7c",
   "op": "14",
   "jp": "邪神の生けにえよりも、\n我が手に掛かって死を望むか！",
   "en": ""
  },
  {
   "id": "s142:00cb8",
   "op": "14",
   "jp": "かまわねぇから、\nその辺の奴らも\nてきとうにぶっ殺しちまえ！！",
   "en": ""
  },
  {
   "id": "s142:00eb2",
   "op": "14",
   "jp": "た、助けてくれ！\n俺は命令に従っていただけなんだ！",
   "en": ""
  },
  {
   "id": "s142:01102",
   "op": "14",
   "jp": "何処に行く貴様！\nさっさと壁にならんか！",
   "en": ""
  },
  {
   "id": "s142:011c6",
   "op": "14",
   "jp": "こう見えても俺も神官の端くれ、\nこうなったら魔法で！",
   "en": ""
  },
  {
   "id": "s142:012d2",
   "op": "14",
   "jp": "へへっ、\nここから逃げ出せた所で・・・",
   "en": ""
  },
  {
   "id": "s142:01300",
   "op": "14",
   "jp": "貴様ら白い羽の逃亡奴隷に、\n安住の地などあるものか！",
   "en": ""
  },
  {
   "id": "s142:013f6",
   "op": "14",
   "jp": "奴らは七つの大罪を犯した、\n醜悪なる邪神の手先だ！！",
   "en": ""
  },
  {
   "id": "s142:01502",
   "op": "14",
   "jp": "囚人ふぜいが逆らうんじゃねえ！",
   "en": ""
  },
  {
   "id": "s142:015a6",
   "op": "14",
   "jp": "やられた～～っ！\nゲフッ・・・！！",
   "en": ""
  },
  {
   "id": "s142:0168a",
   "op": "14",
   "jp": "ば・バカなっ・・・？！\n何でこんな奴等が強いんだ！？",
   "en": ""
  },
  {
   "id": "s142:0177e",
   "op": "14",
   "jp": "それほどの力がありながら・・・",
   "en": ""
  },
  {
   "id": "s142:017a4",
   "op": "14",
   "jp": "なぜアンタは、自らの意志で\n自分の大切な者を守り抜こうと\nしなかった・・・",
   "en": ""
  },
  {
   "id": "s142:01836",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s142:0185a",
   "op": "14",
   "jp": "アンタがもし本当に、この世を\n滅ぼそうとする大邪神の生まれ\n変わりで・・・",
   "en": ""
  },
  {
   "id": "s142:018ac",
   "op": "14",
   "jp": "愛とやらを信じる救世主だ\nというのなら・・・",
   "en": ""
  },
  {
   "id": "s142:018e0",
   "op": "14",
   "jp": "なぜ、自らの命を賭けてでも、\n自分の愛する者を守り抜こうと\nしなかった・・・！？",
   "en": ""
  },
  {
   "id": "s142:01938",
   "op": "14",
   "jp": "愛とは、そのように・・・",
   "en": ""
  },
  {
   "id": "s142:01966",
   "op": "14",
   "jp": "理性で、なんとか押さえつけられる\nような物なのかぁ～っ！？",
   "en": ""
  },
  {
   "id": "s142:019ea",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s142:01a5a",
   "op": "14",
   "jp": "ええぃ、どいつもこいつも・・・\nこうなったら、\n俺様の底力を見せてくれるわ！！",
   "en": ""
  },
  {
   "id": "s142:01bb6",
   "op": "14",
   "jp": "こいつらを殺れば・・・\nここを出られるかもしれねえ！！",
   "en": ""
  },
  {
   "id": "s142:01ce2",
   "op": "14",
   "jp": "どうせコイツらだって・・・\n長くは生きられねぇんだ！！",
   "en": ""
  },
  {
   "id": "s142:01d20",
   "op": "14",
   "jp": "とっとと、死にさらせぇ！！",
   "en": ""
  },
  {
   "id": "s142:01fe6",
   "op": "14",
   "jp": "おっとっと。わしを狙うでない！\n戦いは若い者に任せとるんじゃ",
   "en": ""
  },
  {
   "id": "s142:0207a",
   "op": "14",
   "jp": "こら！くそジジイ！！",
   "en": ""
  },
  {
   "id": "s142:02096",
   "op": "14",
   "jp": "何とか出来るんなら、\n早く何とかしろぃ！！",
   "en": ""
  },
  {
   "id": "s142:020d6",
   "op": "14",
   "jp": "やれやれ、\n土から産まれ出で早くも土に帰るのか",
   "en": ""
  },
  {
   "id": "s142:0210c",
   "op": "14",
   "jp": "だが、そなた達の身体・・・\nわしが決して無駄にはせんぞ！",
   "en": ""
  },
  {
   "id": "s142:0214c",
   "op": "14",
   "jp": "我ら大神官が魔道の力を使うためには必ずその触媒として、\n大量の血の生けにえを必要とする。",
   "en": ""
  },
  {
   "id": "s142:021ac",
   "op": "14",
   "jp": "そしてその血（ＢＰ）の量が、\n満ちた時・・・",
   "en": ""
  },
  {
   "id": "s142:021e0",
   "op": "14",
   "jp": "良く見ておくがいい！\nこれが古より伝わる聖なる力\n神聖ゾンビ魔法じゃ！！",
   "en": ""
  },
  {
   "id": "s142:02272",
   "op": "14",
   "jp": "げぇっ！し・死体が！\n勝手に・・動き出すだとぉ～！？",
   "en": ""
  },
  {
   "id": "s142:022ee",
   "op": "14",
   "jp": "さらに、このゾンビ達の体を使って、こんな真似も出来る！！",
   "en": ""
  },
  {
   "id": "s142:0232e",
   "op": "14",
   "jp": "いにしえの究極魔法！",
   "en": ""
  },
  {
   "id": "s142:0234a",
   "op": "14",
   "jp": "ゾンビ爆！！",
   "en": ""
  },
  {
   "id": "s142:023b6",
   "op": "14",
   "jp": "こっ・・・\nこれが大神官ヨハネの・・・",
   "en": ""
  },
  {
   "id": "s142:023e4",
   "op": "14",
   "jp": "ゾンビ・・・魔法・・・・？！",
   "en": ""
  },
  {
   "id": "s142:0241e",
   "op": "14",
   "jp": "げぇっ！\nこっ・・・これが・・",
   "en": ""
  },
  {
   "id": "s142:02444",
   "op": "14",
   "jp": "大神官ヨハネの・・真の力・・？！",
   "en": ""
  }
 ]
}
