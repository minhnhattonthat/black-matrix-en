{
 "source": "d1:SCENARIO/259",
 "copies": [
  "d1:SCENARIO/259",
  "d2:SCENARIO/259"
 ],
 "strings": [
  {
   "id": "s259:007d6",
   "op": "15",
   "jp": "おやおや、逃げちまったよ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s259:008b2",
   "op": "15",
   "jp": "金だけが目的で戦ってる奴らは、\n所詮本当の勇気なんて\n持ち合わせちゃあいねぇって事か！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s259:0093a",
   "op": "15",
   "jp": "あいつら、結構強かったのに。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:0098e",
   "op": "15",
   "jp": "それでも金のある奴らに\nヘコヘコ従うしか、\n生きる術を知らないなんて、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:009e6",
   "op": "15",
   "jp": "強いだけでは・・・\n必ずしも自由には\nなれないって事なのか？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:00a36",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s259:00a62",
   "op": "15",
   "jp": "おそらく、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s259:00a7e",
   "op": "15",
   "jp": "それが、本当の強さでは\nないという事なんじゃろう・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s259:00ad6",
   "op": "15",
   "jp": "自分の強さに自信がない奴等は、\n必ず腕力や金や権力\nといったなにかに頼ろうとし、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s259:00b3a",
   "op": "15",
   "jp": "それが自分自身の自由を・・・\n結果的に奪ってゆく事に\nなるんだろうな",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s259:00bc2",
   "op": "15",
   "jp": "ボクも自分に自信が無いけど・・・\nそれじゃあ、自由っていったい\nどんな事なのかなぁ？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s259:00c36",
   "op": "15",
   "jp": "そりゃ、つまりよぉ、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:00c5e",
   "op": "15",
   "jp": "自分がしたい事ができ、\n「好きなように生きられる」\nって事だと思うんだが！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:00cda",
   "op": "15",
   "jp": "自由なんてモノが、\n本当にこの世の中に\n有ると思っとること自体が・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s259:00d32",
   "op": "15",
   "jp": "そもそも大間違いなんだよ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s259:00dce",
   "op": "15",
   "jp": "なっ、なんだぁ？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s259:00f16",
   "op": "15",
   "jp": "偽善にあふれ、\n邪教の教えを信じる罰当たりな、\nどぶネズミ共が！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:00f6a",
   "op": "15",
   "jp": "この世の何処に、\n自分がやりたい事だけをやって、",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:00fae",
   "op": "15",
   "jp": "好きな事だけをやれている人物が\nおるというのだ！？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:01002",
   "op": "15",
   "jp": "テメェ達黒い羽の奴らは、\n俺達白い羽のように生まれた時から\n奴隷なんてことはねぇ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:01066",
   "op": "15",
   "jp": "それは\n自由ってやつなんじゃねぇのか？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:010ae",
   "op": "15",
   "jp": "ハアッハッハッハッ・・・そうか、\n貴様はそれを妬んでおったか。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:0110e",
   "op": "15",
   "jp": "なにぃ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:0113a",
   "op": "15",
   "jp": "ならばなおさらのこと、\n貴様の求めるものなど、\n未来永劫手には入らん！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:01192",
   "op": "15",
   "jp": "所詮白い羽のお前達は、\n一生奴隷として、\nもがき苦しむしかないんだよ！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:011ee",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s259:01212",
   "op": "15",
   "jp": "お主がこの街の領主\n強欲のマモンか・・・！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s259:0125e",
   "op": "15",
   "jp": "お前達を殺せば教皇庁より\nさらに莫大な大金が手に入る。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:012a6",
   "op": "15",
   "jp": "さあ、兵士達よ！\n払った金に見合う働きをしなっ！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s259:012fa",
   "op": "15",
   "jp": "金こそ魔性、常に人の心を惑わす\n魔物って事か・・・！？",
   "en": "",
   "box": "17x3",
   "face": 1
  }
 ]
}
