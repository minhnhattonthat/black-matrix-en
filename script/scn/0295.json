{
 "source": "d1:SCENARIO/295",
 "copies": [
  "d1:SCENARIO/295",
  "d2:SCENARIO/295"
 ],
 "strings": [
  {
   "id": "s295:00c02",
   "op": "15",
   "jp": "ようこそ、いらっしゃいました！",
   "en": ""
  },
  {
   "id": "s295:00c32",
   "op": "15",
   "jp": "私が、この街を治めている\nバアル・ゼブルです！",
   "en": ""
  },
  {
   "id": "s295:00c96",
   "op": "15",
   "jp": "驚いたな！！",
   "en": ""
  },
  {
   "id": "s295:00cb6",
   "op": "15",
   "jp": "この街の領主だって言うから、\nてっきりブヨブヨのブニョべニョ！\nだと思ってたのに！？",
   "en": ""
  },
  {
   "id": "s295:00d2a",
   "op": "15",
   "jp": "お尋ね者のわし等を\n自ら食事に招くとは、",
   "en": ""
  },
  {
   "id": "s295:00d66",
   "op": "15",
   "jp": "いったい\nどういうつもりじゃな！？",
   "en": ""
  },
  {
   "id": "s295:00daa",
   "op": "15",
   "jp": "私は、同じ大邪神の力を\n信じる者として、\nあなた方とは戦いたくないのです！",
   "en": ""
  },
  {
   "id": "s295:00e1e",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s295:00e42",
   "op": "15",
   "jp": "私が大邪神ミカエルの鎧を\n手に入れている事は、\nすでにご存じでしょう！？",
   "en": ""
  },
  {
   "id": "s295:00e9e",
   "op": "15",
   "jp": "不肖、この私自身も不本意ながら\n教団から追われる立場に\n変わりは無いのです。",
   "en": ""
  },
  {
   "id": "s295:00efe",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s295:00f26",
   "op": "15",
   "jp": "私が手に入れた鎧のもとの持ち主\n大邪神ミカエルは、\n別名アヌビスとも呼ばれ、",
   "en": ""
  },
  {
   "id": "s295:00f86",
   "op": "15",
   "jp": "最後の審判が訪れたときに\n人々を選別する、",
   "en": ""
  },
  {
   "id": "s295:00fc2",
   "op": "15",
   "jp": "地獄の裁判官のような存在だと\n伝えられています。",
   "en": ""
  },
  {
   "id": "s295:01006",
   "op": "15",
   "jp": "この世界の正義を守る、\n法の執行官を自認していた私は、",
   "en": ""
  },
  {
   "id": "s295:0104e",
   "op": "15",
   "jp": "つね日頃から、\n罪人は神の前で平等に\n裁かれるべきと考えておりました。",
   "en": ""
  },
  {
   "id": "s295:010a6",
   "op": "15",
   "jp": "つまり私は物事を常に理性的に\n解決したいのですよ！！",
   "en": ""
  },
  {
   "id": "s295:010fa",
   "op": "15",
   "jp": "び、平等なんて言葉を\n口にするなんて・・・！？",
   "en": ""
  },
  {
   "id": "s295:0114a",
   "op": "15",
   "jp": "むぅ、しかしバアル殿よ、",
   "en": ""
  },
  {
   "id": "s295:01176",
   "op": "15",
   "jp": "大邪神の鎧をめぐる教団との\n確執を、お主はどのように解決\nするというのだ！？",
   "en": ""
  },
  {
   "id": "s295:01206",
   "op": "15",
   "jp": "そうですなぁ、まずは、\nこの街の白い羽の者達を、\n全員奴隷階級から解放し・・・",
   "en": ""
  },
  {
   "id": "s295:01266",
   "op": "15",
   "jp": "彼のご主人と呼ばれる娘も、\n助け出して差し上げましょう！！",
   "en": ""
  },
  {
   "id": "s295:012ca",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s295:012ee",
   "op": "15",
   "jp": "もっとも、この街に居た\n奴隷達のほとんどは、",
   "en": ""
  },
  {
   "id": "s295:0132e",
   "op": "15",
   "jp": "私が街の人々から買い上げて、",
   "en": ""
  },
  {
   "id": "s295:0135e",
   "op": "15",
   "jp": "いま、この屋敷にいる者達以外は、",
   "en": ""
  },
  {
   "id": "s295:01392",
   "op": "15",
   "jp": "解放奴隷としてすでに実家に\n帰ってもらっています・・・",
   "en": ""
  },
  {
   "id": "s295:01426",
   "op": "15",
   "jp": "そんなっ！",
   "en": ""
  },
  {
   "id": "s295:01442",
   "op": "15",
   "jp": "それって偽善でしょう！？\n私たち黒い羽の者が、\nそんな大罪を犯すなんて！？",
   "en": ""
  },
  {
   "id": "s295:014a2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:014ce",
   "op": "15",
   "jp": "ですから、私は邪神達が語る\n正義とやらを信じていると\n言ったではないですか！？",
   "en": ""
  },
  {
   "id": "s295:0152e",
   "op": "15",
   "jp": "だいいち\nアナタ達のやっている事こそ\n偽善ではないのですか！？",
   "en": ""
  },
  {
   "id": "s295:015a2",
   "op": "15",
   "jp": "なっ！",
   "en": ""
  },
  {
   "id": "s295:015ca",
   "op": "15",
   "jp": "どんな世界にも必ず法律が\nあります。",
   "en": ""
  },
  {
   "id": "s295:01602",
   "op": "15",
   "jp": "たとえそれが、\nどんな悪法だったにせよ、",
   "en": ""
  },
  {
   "id": "s295:0163e",
   "op": "15",
   "jp": "その世界の法を守る事が、\nその時代の正義というものでは\nないでしょうか！？",
   "en": ""
  },
  {
   "id": "s295:0169e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:016ca",
   "op": "15",
   "jp": "あなた方は、すでに脱獄と言う\n大罪を犯してはいますが・・・",
   "en": ""
  },
  {
   "id": "s295:01716",
   "op": "15",
   "jp": "幸い、私は教団の実力者の方々と\n懇意にしております。",
   "en": ""
  },
  {
   "id": "s295:0175e",
   "op": "15",
   "jp": "こちらの出す条件をのんで\n頂ければ、あなた方の罪、\n赦免してさしあげましょう！！",
   "en": ""
  },
  {
   "id": "s295:017c2",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s295:017e6",
   "op": "15",
   "jp": "して、その条件とは？",
   "en": ""
  },
  {
   "id": "s295:0181a",
   "op": "15",
   "jp": "ひとつ。",
   "en": ""
  },
  {
   "id": "s295:01836",
   "op": "15",
   "jp": "これ以上、殺Τを\n繰り返さないこと。",
   "en": ""
  },
  {
   "id": "s295:0187a",
   "op": "15",
   "jp": "別に好きでやっていたわけじゃ\nありませんもの。",
   "en": ""
  },
  {
   "id": "s295:018ba",
   "op": "15",
   "jp": "教団の方々がけしかけて\nこなければ、はじめから無用な\n戦いなどしてませんわ！！",
   "en": ""
  },
  {
   "id": "s295:01936",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:0196e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:0199a",
   "op": "15",
   "jp": "ふたつ、",
   "en": ""
  },
  {
   "id": "s295:019b6",
   "op": "15",
   "jp": "大邪神の鎧を着た方々の、\n教団への自首！！",
   "en": ""
  },
  {
   "id": "s295:01a0a",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s295:01a52",
   "op": "15",
   "jp": "アナタ方には、教団側が主催する\n裁判を受けていただきます・・・",
   "en": ""
  },
  {
   "id": "s295:01aa2",
   "op": "15",
   "jp": "大丈夫！私が働きかけて、\nなるべく公平なる裁判になるよう\n手配しましょう・・・",
   "en": ""
  },
  {
   "id": "s295:01b02",
   "op": "15",
   "jp": "今後その鎧の力を、\n教団の為にのみ使う事を誓えば・・・",
   "en": ""
  },
  {
   "id": "s295:01b4a",
   "op": "15",
   "jp": "おそらくはみなさんも極刑だけは、\n免れることができるはずです・・・！",
   "en": ""
  },
  {
   "id": "s295:01ba2",
   "op": "15",
   "jp": "なぜならアナタ達は・・・",
   "en": ""
  },
  {
   "id": "s295:01bce",
   "op": "15",
   "jp": "この世界でも最強の魔力を誇る、\n大邪神の鎧の正当なる\n後継者達なのですから・・・！",
   "en": ""
  },
  {
   "id": "s295:01c4e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:01c86",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:01ca6",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s295:01cc2",
   "op": "15",
   "jp": "とりあえず話の筋は通って\n聞こえるが・・・",
   "en": ""
  },
  {
   "id": "s295:01cfe",
   "op": "15",
   "jp": "本当にお主にそんな権限が\nあると言うのか！？",
   "en": ""
  },
  {
   "id": "s295:01d6e",
   "op": "15",
   "jp": "そこは、私を信じて頂く以外、\n他に道は有りませんね。",
   "en": ""
  },
  {
   "id": "s295:01dda",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s295:01e26",
   "op": "15",
   "jp": "愛を語る少年よ。",
   "en": ""
  },
  {
   "id": "s295:01e4a",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s295:01e6e",
   "op": "15",
   "jp": "このままでは、\nあなたの愛する\nご主人の命だけではなく、",
   "en": ""
  },
  {
   "id": "s295:01eba",
   "op": "15",
   "jp": "仲間達の命までもが\n危険に晒され続け・・・",
   "en": ""
  },
  {
   "id": "s295:01ef6",
   "op": "15",
   "jp": "これからも、\n多くの尊い人命が\n奪われ続けるのですよ！",
   "en": ""
  },
  {
   "id": "s295:01fca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:01fe6",
   "op": "15",
   "jp": "みなさん・・・",
   "en": ""
  },
  {
   "id": "s295:02006",
   "op": "15",
   "jp": "この方の意見には私・・・\n少なからず心を動かされました！",
   "en": ""
  },
  {
   "id": "s295:02052",
   "op": "15",
   "jp": "たしかに・・・",
   "en": ""
  },
  {
   "id": "s295:02072",
   "op": "15",
   "jp": "争いを避ける道を模索してこそ、\n新しい道が開けるんじゃ\nないでしょうか・・・！？",
   "en": ""
  },
  {
   "id": "s295:0211e",
   "op": "15",
   "jp": "なにを怪しい事言ってるのよ、\nこのおっちゃん！！",
   "en": ""
  },
  {
   "id": "s295:02162",
   "op": "15",
   "jp": "どう考えてもアンタの話は\nインチキ臭くてしょうがないわ！",
   "en": ""
  },
  {
   "id": "s295:021ae",
   "op": "15",
   "jp": "だいいちアンタの話がウソじゃない\nって証拠が・・・\nどこにあるのよ！？",
   "en": ""
  },
  {
   "id": "s295:0220a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:0227e",
   "op": "15",
   "jp": "いいぜ、お前が決めちまってもよ！",
   "en": ""
  },
  {
   "id": "s295:022b2",
   "op": "15",
   "jp": "俺は、しち面倒くせェ事を\n考えるのは苦手だし・・・",
   "en": ""
  },
  {
   "id": "s295:022f6",
   "op": "15",
   "jp": "だいいち、俺はお前ぇの\nご主人様とやらを・・・\n助け出したいだけだからな！",
   "en": ""
  },
  {
   "id": "s295:02352",
   "op": "15",
   "jp": "どの道、\nこの鎧を着ちまった以上、\nそう長くは、生きられねぇしよ！",
   "en": ""
  },
  {
   "id": "s295:023da",
   "op": "15",
   "jp": "ボクの事も気にしなくて良いよ！",
   "en": ""
  },
  {
   "id": "s295:0240a",
   "op": "15",
   "jp": "ボクのこの旅の目的は・・・\nきみのご主人様を・・・\n助けだすことなんだから！！",
   "en": ""
  },
  {
   "id": "s295:02492",
   "op": "15",
   "jp": "ボクは・・・\nボクはキミ達の判断に任せるよ・・・",
   "en": ""
  },
  {
   "id": "s295:0251e",
   "op": "15",
   "jp": "オレはお前達がどんな選択を\nしようと・・・",
   "en": ""
  },
  {
   "id": "s295:0255a",
   "op": "15",
   "jp": "あくまでも自分の道を\n進ませて貰う・・・・・",
   "en": ""
  },
  {
   "id": "s295:025fa",
   "op": "15",
   "jp": "アタシは自分の妹さえ\n助け出せれば・・・・・",
   "en": ""
  },
  {
   "id": "s295:0263a",
   "op": "15",
   "jp": "それで文句はないわ！！",
   "en": ""
  },
  {
   "id": "s295:0267a",
   "op": "15",
   "jp": "アタシは自分の弟さえ\n助け出せれば・・・・・",
   "en": ""
  },
  {
   "id": "s295:026ba",
   "op": "15",
   "jp": "それで文句はないわ！！",
   "en": ""
  },
  {
   "id": "s295:0277a",
   "op": "15",
   "jp": "ねえおにいちゃん・・・",
   "en": ""
  },
  {
   "id": "s295:027a2",
   "op": "15",
   "jp": "プリカはおにいちゃんさえ\n元気ならそれでいいけど・・・",
   "en": ""
  },
  {
   "id": "s295:027ea",
   "op": "15",
   "jp": "おにいちゃんと離ればなれに\nなるのだけは・・・ヤダよ！！",
   "en": ""
  },
  {
   "id": "s295:02866",
   "op": "15",
   "jp": "どうやらみんなは、\nお主にこの決断を託すようじゃ。",
   "en": ""
  },
  {
   "id": "s295:028aa",
   "op": "15",
   "jp": "さぁ、どうする？",
   "en": ""
  },
  {
   "id": "s295:028ce",
   "op": "15",
   "jp": "お主の主や、みんなのためにも・・\n自首をするのか？",
   "en": ""
  },
  {
   "id": "s295:02922",
   "op": "1d",
   "jp": "自首する！",
   "en": "",
   "max": 15
  },
  {
   "id": "s295:02934",
   "op": "1d",
   "jp": "自首しない！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s295:02996",
   "op": "15",
   "jp": "そうか、それもよかろう。",
   "en": ""
  },
  {
   "id": "s295:029c2",
   "op": "15",
   "jp": "ただし、わしも自首してでるぞ！！",
   "en": ""
  },
  {
   "id": "s295:029f6",
   "op": "15",
   "jp": "バアル殿の言った\n平等という言葉が気に入った！",
   "en": ""
  },
  {
   "id": "s295:02a36",
   "op": "15",
   "jp": "わしは、生まれてこの方\nそのような邪悪な言葉は、\n聞いたことがない！！",
   "en": ""
  },
  {
   "id": "s295:02a8e",
   "op": "15",
   "jp": "わしも平等に\n法の裁きを受けさせて貰うぞ！！",
   "en": ""
  },
  {
   "id": "s295:02b22",
   "op": "15",
   "jp": "お師匠様が\n自首なさるのなら私も！！",
   "en": ""
  },
  {
   "id": "s295:02b5a",
   "op": "15",
   "jp": "私の知識は、\n常にお師匠様と共にあります！",
   "en": ""
  },
  {
   "id": "s295:02b96",
   "op": "15",
   "jp": "もっとも・・\nいつまでご一緒できるかは、\n自信がありませんけど。",
   "en": ""
  },
  {
   "id": "s295:02bea",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s295:02c7e",
   "op": "15",
   "jp": "はっ、どいつもこいつも\n奴の言葉に軽くダマされやがって！",
   "en": ""
  },
  {
   "id": "s295:02e3e",
   "op": "15",
   "jp": "正義なんて言葉を口にする奴を、\n簡単に信用するっていうのか？",
   "en": ""
  },
  {
   "id": "s295:02e8e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:02eba",
   "op": "15",
   "jp": "まったく、\n正気の沙汰とは思えねぇ。",
   "en": ""
  },
  {
   "id": "s295:02ef2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s295:02f1e",
   "op": "15",
   "jp": "どちらにしろ\n鎧を着てねぇオレには、",
   "en": ""
  },
  {
   "id": "s295:02f7a",
   "op": "15",
   "jp": "お優しい領主閣下は\n用が無ぇようだ・・・",
   "en": ""
  },
  {
   "id": "s295:02ffa",
   "op": "15",
   "jp": "オレはお先に失礼するぜ！！",
   "en": ""
  },
  {
   "id": "s295:03096",
   "op": "15",
   "jp": "オレも同感だ・・・",
   "en": ""
  },
  {
   "id": "s295:030ba",
   "op": "15",
   "jp": "お前達の言う最強の敵とやらと\n闘う気が無いんなら・・・",
   "en": ""
  },
  {
   "id": "s295:03102",
   "op": "15",
   "jp": "オレも失礼させて貰う・・・",
   "en": ""
  },
  {
   "id": "s295:0317a",
   "op": "15",
   "jp": "あっ！ちょっと待ってよ！！",
