{
 "source": "d1:SCENARIO/288",
 "copies": [
  "d1:SCENARIO/288",
  "d2:SCENARIO/288"
 ],
 "strings": [
  {
   "id": "s288:00c7a",
   "op": "15",
   "jp": "ここが、ユダが言っておった、\n邪神の鎧を買った領主が居ると\nいうカナンの街じゃな！",
   "en": ""
  },
  {
   "id": "s288:00cde",
   "op": "15",
   "jp": "皆、真面目に教会に通い\n聖書の教えを守って\n怠惰な生活をしとるようじゃ！",
   "en": ""
  },
  {
   "id": "s288:00d3a",
   "op": "15",
   "jp": "結構、結構！！",
   "en": ""
  },
  {
   "id": "s288:00d6a",
   "op": "15",
   "jp": "休みたいときには休み、\n食べたいときに食べる。",
   "en": ""
  },
  {
   "id": "s288:00daa",
   "op": "15",
   "jp": "これこそが我々の聖書にも\n書かれている自然の摂理ですわ！",
   "en": ""
  },
  {
   "id": "s288:00e6e",
   "op": "15",
   "jp": "おいおい。",
   "en": ""
  },
  {
   "id": "s288:00e8a",
   "op": "15",
   "jp": "この街の連中はみんな生きる屍、\n腐る前のゾンビって感じだぜ！？",
   "en": ""
  },
  {
   "id": "s288:00eda",
   "op": "15",
   "jp": "爺さんもルピルピも、\nもとはと言やぁ\n教団の神官出身だから・・・",
   "en": ""
  },
  {
   "id": "s288:00f2e",
   "op": "15",
   "jp": "一皮むきゃ、教団の連中と、\n同じ穴のムジナって事か！？",
   "en": ""
  },
  {
   "id": "s288:00fda",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s288:0101e",
   "op": "15",
   "jp": "おい！\nそんな言い方は無いだろう！？",
   "en": ""
  },
  {
   "id": "s288:01056",
   "op": "15",
   "jp": "どんな世界にだって、それなりの\n秩序って物が必要なもんさ！",
   "en": ""
  },
  {
   "id": "s288:010a2",
   "op": "15",
   "jp": "たとえそれらが多少・・・\n自分の意に添わなかったとしてもだ！",
   "en": ""
  },
  {
   "id": "s288:010f2",
   "op": "15",
   "jp": "オマエにだって・・・\nそれぐらいの事は理解できるだろう？",
   "en": ""
  },
  {
   "id": "s288:01162",
   "op": "15",
   "jp": "どうでもいいけど・・・\nなんかこの街、臭くってイヤーーッ！",
   "en": ""
  },
  {
   "id": "s288:011ae",
   "op": "15",
   "jp": "ねえねえカイン君！\n早く別の街に行こうよぉ～～！",
   "en": ""
  },
  {
   "id": "s288:01222",
   "op": "15",
   "jp": "だからコイツはカインじゃ\nなくってぇ・・・",
   "en": ""
  },
  {
   "id": "s288:0126e",
   "op": "15",
   "jp": "なによアンタ！",
   "en": ""
  },
  {
   "id": "s288:0128e",
   "op": "15",
   "jp": "彼がカイン君じゃないっていう\n証拠でもあるの・・・！？",
   "en": ""
  },
  {
   "id": "s288:012da",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s288:01306",
   "op": "15",
   "jp": "アタシがカイン君だって言ったら\nカイン君に間違いないんだから、",
   "en": ""
  },
  {
   "id": "s288:01356",
   "op": "15",
   "jp": "アンタ達もカイン君て呼びなさいよ！",
   "en": ""
  },
  {
   "id": "s288:0138a",
   "op": "15",
   "jp": "ねぇ～～っカインく～ん！！",
   "en": ""
  },
  {
   "id": "s288:013ba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s288:0140a",
   "op": "15",
   "jp": "なんだか昔のぼくと似たような\n人達ばっかりで、落ち着く街だなぁ！",
   "en": ""
  },
  {
   "id": "s288:01482",
   "op": "15",
   "jp": "なんか、いいにおいですね～\n私もお腹が空いてきちゃいました！",
   "en": ""
  },
  {
   "id": "s288:014f6",
   "op": "15",
   "jp": "わーーい！ご飯だご飯だぁ～！",
   "en": ""
  },
  {
   "id": "s288:01526",
   "op": "15",
   "jp": "プリカはコーン入りの\nハンバーグにねぇ・・・！",
   "en": ""
  },
  {
   "id": "s288:0159a",
   "op": "15",
   "jp": "オイ！肉ドロボウ！！",
   "en": ""
  },
  {
   "id": "s288:015c2",
   "op": "15",
   "jp": "オマエ、ハンバーグってなんで\n出来てるか知ってんのか？",
   "en": ""
  },
  {
   "id": "s288:01632",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s288:0165e",
   "op": "15",
   "jp": "どうでもいいけど、この街の肉屋で\nまた盗みを働いたりするんじゃ\nねえぞ！？",
   "en": ""
  },
  {
   "id": "s288:016e2",
   "op": "15",
   "jp": "釘差しとかねえと・・・\nこの先の旅が１０１匹動物大行進に\nなりかねねぇからなぁ・・・！",
   "en": ""
  },
  {
   "id": "s288:01772",
   "op": "15",
   "jp": "ってオイこら！！",
   "en": ""
  },
  {
   "id": "s288:01796",
   "op": "15",
   "jp": "なにオマエまで\n日記つけてんだよ！！",
   "en": ""
  },
  {
   "id": "s288:017ce",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  }
 ]
}
