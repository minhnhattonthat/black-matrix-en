{
 "source": "d1:SCENARIO/46",
 "copies": [
  "d1:SCENARIO/46",
  "d2:SCENARIO/46"
 ],
 "strings": [
  {
   "id": "s46:0007a",
   "op": "15",
   "jp": "どぉしたの？おにいちゃん・・・",
   "en": ""
  },
  {
   "id": "s46:000aa",
   "op": "15",
   "jp": "ひょっとして、\n体の具合でも悪いの？",
   "en": ""
  },
  {
   "id": "s46:000f6",
   "op": "15",
   "jp": "はいはい！おにいちゃん\nわたしに甘えたいのかなぁ～？",
   "en": ""
  },
  {
   "id": "s46:0013e",
   "op": "15",
   "jp": "でもでも頑張ってリハビリも\nしてきてね！！",
   "en": ""
  },
  {
   "id": "s46:001ca",
   "op": "15",
   "jp": "春はほのぼの・・・\nおはよ～！気分はどう？",
   "en": ""
  },
  {
   "id": "s46:00206",
   "op": "15",
   "jp": "おにいちゃん！",
   "en": ""
  },
  {
   "id": "s46:00226",
   "op": "15",
   "jp": "なんか冬眠からさめた\nかえるさんみたいな顔してるよ～！？",
   "en": ""
  },
  {
   "id": "s46:0028e",
   "op": "15",
   "jp": "うっわぁ～～気っ持ちい～\n朝だね～！",
   "en": ""
  },
  {
   "id": "s46:002c6",
   "op": "15",
   "jp": "今日も一日、\nお仕事頑張ってね！\nおにいちゃん！",
   "en": ""
  },
  {
   "id": "s46:00336",
   "op": "15",
   "jp": "おはようおにいぢゃん・・・・",
   "en": ""
  },
  {
   "id": "s46:00366",
   "op": "15",
   "jp": "あたしぎのうは暑ぐって・・・\nよぐ眠れながったよぉ・・・・",
   "en": ""
  },
  {
   "id": "s46:003e2",
   "op": "15",
   "jp": "うっひゃ～～！\n今日も朝から暑くなりそうだね～！",
   "en": ""
  },
  {
   "id": "s46:00452",
   "op": "15",
   "jp": "今日もクレヨン持って\nお山にでも出かけようかなぁ・・・",
   "en": ""
  },
  {
   "id": "s46:0049a",
   "op": "15",
   "jp": "だってそろそろあたしの大好きな\nお絵かきの季節だモンね！",
   "en": ""
  },
  {
   "id": "s46:00512",
   "op": "15",
   "jp": "おっはよぉ～おにいちゃ～ん！",
   "en": ""
  },
  {
   "id": "s46:00542",
   "op": "15",
   "jp": "そろそろ風が\nすずしくなってきたね～！",
   "en": ""
  },
  {
   "id": "s46:005aa",
   "op": "15",
   "jp": "おはよ～う。",
   "en": ""
  },
  {
   "id": "s46:005ca",
   "op": "15",
   "jp": "はぁぁぁぁ～っと、\nみてみて！息がこんなに白いよ！",
   "en": ""
  },
  {
   "id": "s46:0060e",
   "op": "15",
   "jp": "こんなに寒いけど～、",
   "en": ""
  },
  {
   "id": "s46:00636",
   "op": "15",
   "jp": "今日もいちにち頑張ろうね～",
   "en": ""
  },
  {
   "id": "s46:00682",
   "op": "15",
   "jp": "おはよぅ。\nふぅ～しゃぶい・・・",
   "en": ""
  },
  {
   "id": "s46:006b6",
   "op": "15",
   "jp": "ねえねえおにいちゃん、\nそろそろ一緒のベッドで寝ても\n・・・イイぃ？",
   "en": ""
  }
 ]
}
