{
 "source": "d1:SCENARIO/355",
 "copies": [
  "d1:SCENARIO/355",
  "d2:SCENARIO/355"
 ],
 "strings": [
  {
   "id": "s355:0028a",
   "op": "15",
   "jp": "お前はあの日、",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:002aa",
   "op": "15",
   "jp": "教会に封印されていた大邪神の鎧を\n盗みだし",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:002e6",
   "op": "15",
   "jp": "それを・・\nマルコの部屋へと運び込んだ・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:00d8a",
   "op": "15",
   "jp": "ご禁制であった\n大邪神の鎧を利用して・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:014ba",
   "op": "15",
   "jp": "お前はマルコを異端審問官の審議に\nかけようとしたのだ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:017c6",
   "op": "15",
   "jp": "それはお前が・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:017ea",
   "op": "15",
   "jp": "邪魔だったマルコを謀殺しようと\n考えていたからに違いあるまい！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:0183e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s355:0186a",
   "op": "15",
   "jp": "だが・・お前には\n思いもよらなかったんだろう・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:018f6",
   "op": "15",
   "jp": "マルコのえん罪をかばい\nあのセラフィムが・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:01936",
   "op": "15",
   "jp": "自らの死をもって、\nその罪を償おうとするなどとは！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:0289a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s355:028c6",
   "op": "15",
   "jp": "あの二人の友情は、\nあくまでも自己犠牲の\n上に成り立っている！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:0291a",
   "op": "15",
   "jp": "だからこそ\n私も、彼らに力を貸すことを\n決心したのだ！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:02966",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s355:02992",
   "op": "15",
   "jp": "だいいち、\nマルコがしている\nその行為のどこに、",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:029d6",
   "op": "15",
   "jp": "マルコ自身の\n利益があると言うのだ？",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:02a0e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s355:02a2e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s355:02a66",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s355:02a9e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s355:02aca",
   "op": "15",
   "jp": "けっ！\n俺はそんなΨ弁で\nダマされたりはしないぜ！！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s355:02b36",
   "op": "15",
   "jp": "へっ、だいいち白い羽の奴隷が\n黒い羽の俺を助けるのは、\n至極当然の事だからな！！",
   "en": "",
   "box": "17x3",
   "face": 44
  },
  {
   "id": "s355:02c02",
   "op": "15",
   "jp": "おいマルコ、\nこのまま奴を\nいかせちまっていいのか？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:02c7a",
   "op": "15",
   "jp": "所詮、黒き羽の者を\n改心させようと言うのが\n土台無理なのじゃろう・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s355:02cee",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s355:02d26",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s355:02d5e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s355:02d8a",
   "op": "15",
   "jp": "ですが、\n彼もあそこまで\n自分を犠牲にした以上・・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:02dfa",
   "op": "15",
   "jp": "彼もまた\nセラフィムさんの親友・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:02e32",
   "op": "15",
   "jp": "なのではないでしょうか！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:02eb6",
   "op": "15",
   "jp": "おい、爺さん！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:02ed6",
   "op": "15",
   "jp": "黒い羽を持った連中の中にも、\n親友って言葉を使うにふさわしい\n邪悪な連中がいるって事は・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:02f46",
   "op": "15",
   "jp": "俺達自身も\n結構知ってるつもりだぜ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:02f8a",
   "op": "15",
   "jp": "お、お前達！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s355:02fce",
   "op": "15",
   "jp": "あっ！\nこの爺ちゃん\n赤くなってる～！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s355:0302e",
   "op": "15",
   "jp": "うふっ、うふうふっ・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s355:03066",
   "op": "15",
   "jp": "くすっ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s355:0308e",
   "op": "15",
   "jp": "そうじゃ、ルピルピ・・・\nお主、体の方は？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s355:03112",
   "op": "15",
   "jp": "ヨハネ様、\nルピルピさんはもう・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:031a2",
   "op": "15",
   "jp": "えぇ！！\nこの通りもう何ともありませんわ。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s355:031e2",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:0325a",
   "op": "15",
   "jp": "よおおおし、\nこの地下組織とやらも\nなくなっちまったことだし・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:032ae",
   "op": "15",
   "jp": "そろそろ、鎧の情報を追って\n旅を続けるとするか！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:032f2",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:033a6",
   "op": "15",
   "jp": "ぼっ、僕も・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:033ca",
   "op": "15",
   "jp": "僕もその旅に付いて行っては\nいけませんか！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:0343a",
   "op": "15",
   "jp": "よくぞ言ったぞ、\nマルコよ！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:03492",
   "op": "15",
   "jp": "あっ、いや、マルコ様！！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:034be",
   "op": "15",
   "jp": "私はここで、再び組織を\n作り直さねばなりません。",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:03502",
   "op": "15",
   "jp": "ご一緒させて頂く事は\n出来かねますが・・・",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:03566",
   "op": "15",
   "jp": "救世主様！",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:03582",
   "op": "15",
   "jp": "救世主様、私の息子を\nなにとぞ宜しくお願いします。",
   "en": "",
   "box": "17x3",
   "face": 16
  },
  {
   "id": "s355:035ea",
   "op": "15",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:035f6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:036a2",
   "op": "15",
   "jp": "なかなか強引な親父だが、\nまぁいいか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s355:036ea",
   "op": "15",
   "jp": "（白き羽の僕を・・・・）",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:03716",
   "op": "15",
   "jp": "（僕を息子と\n　呼んでくれるだなんて・・・）",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s355:03d02",
   "op": "15",
   "jp": "あの～～っ\nできればアタシも連れていって\n欲しいんですけどぉ～～！？",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s355:041ae",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s355:041d2",
   "op": "15",
   "jp": "アタシは\nここの地下組織の兵士ですから、\n少しはお役にたてると思いますぅ。",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s355:0423e",
   "op": "15",
   "jp": "どうする救世主様！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s355:04272",
   "op": "1d",
   "jp": "仲間にする！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s355:04288",
   "op": "1d",
   "jp": "仲間にしない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s355:042be",
   "op": "15",
   "jp": "あっ！ありがとうございますぅ～\n組織の仲間も\nアタシ一人になっちゃって、",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s355:0431a",
   "op": "15",
   "jp": "あの爺ちゃんと二人っきりで\nお留守番するのは、",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s355:0435a",
   "op": "15",
   "jp": "正直嫌だったんですぅ～っ！！",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s355:04398",
   "op": "14",
   "jp": "デュナが仲間になった！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s355:043fe",
   "op": "15",
   "jp": "ちえっ！アタシ一人で、\nあの爺ちゃんとお留守番かぁ～～",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s355:04446",
   "op": "15",
   "jp": "アタシの操は・・・・\nホントに大丈夫なのかしらぁ～！？",
   "en": "",
   "box": "17x3",
   "face": 23
  }
 ]
}
