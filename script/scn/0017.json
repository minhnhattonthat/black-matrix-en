{
 "source": "d1:SCENARIO/17",
 "copies": [
  "d1:SCENARIO/17",
  "d2:SCENARIO/17"
 ],
 "strings": [
  {
   "id": "s17:0020e",
   "op": "15",
   "jp": "目が覚めたからってまだ、\n動いちゃダメーー！",
   "en": ""
  },
  {
   "id": "s17:0024e",
   "op": "15",
   "jp": "ずっと眠ったままだったんだから、\n体がビキビキッ！\nてなっちゃうよぉ？！",
   "en": ""
  },
  {
   "id": "s17:002aa",
   "op": "15",
   "jp": "ま、安心して眠ってなさいよ！",
   "en": ""
  },
  {
   "id": "s17:002da",
   "op": "15",
   "jp": "退屈しないように・・・\n私がお話でもしてあげるからさ！",
   "en": ""
  },
  {
   "id": "s17:00322",
   "op": "15",
   "jp": "あの大きな落雷があった日・・・",
   "en": ""
  },
  {
   "id": "s17:00352",
   "op": "15",
   "jp": "あ、といっても\n覚えてないかぁ！？",
   "en": ""
  },
  {
   "id": "s17:00386",
   "op": "15",
   "jp": "キミは風邪をひいた私のために、\n一人で山に薬草を取りに\n行ってくれたんだぁ・・・！",
   "en": ""
  },
  {
   "id": "s17:003ea",
   "op": "15",
   "jp": "何故医者に連れて\n行かなかったのかって・・・？",
   "en": ""
  },
  {
   "id": "s17:0042a",
   "op": "15",
   "jp": "そっ、それは・・・",
   "en": ""
  },
  {
   "id": "s17:0044e",
   "op": "15",
   "jp": "い、イイじゃんそんな事ぉ！",
   "en": ""
  },
  {
   "id": "s17:0047a",
   "op": "15",
   "jp": "ちょっとね！\n行けない事情があったの！！\nはい、理由おしまい！！",
   "en": ""
  },
  {
   "id": "s17:004ce",
   "op": "15",
   "jp": "まぁ、それは置いておくとして、",
   "en": ""
  },
  {
   "id": "s17:004fe",
   "op": "15",
   "jp": "とにかく、山奥へと入って行った\nキミは、何かの事故に巻き込まれて\nしまったらしいの・・・！",
   "en": ""
  },
  {
   "id": "s17:0056a",
   "op": "15",
   "jp": "それはとっても\n大きな事故だったと思うよ・・・",
   "en": ""
  },
  {
   "id": "s17:0061e",
   "op": "15",
   "jp": "（だって・・・\n　私見ちゃったんだもん・・・）",
   "en": ""
  },
  {
   "id": "s17:0065e",
   "op": "15",
   "jp": "（雨が止んだあの日・・・）",
   "en": ""
  },
  {
   "id": "s17:0068a",
   "op": "15",
   "jp": "（私がやっと動けるようになって\n　入って行った山の中に・・・）",
   "en": ""
  },
  {
   "id": "s17:006da",
   "op": "15",
   "jp": "（キミを囲むようにして倒れている\n　大勢の兵士達の死体を・・！！）",
   "en": ""
  },
  {
   "id": "s17:00724",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s17:00742",
   "op": "15",
   "jp": "かすかな息しかしていない、\n血だらけのキミを見たとき・・・",
   "en": ""
  },
  {
   "id": "s17:0078e",
   "op": "15",
   "jp": "私は・・・",
   "en": ""
  },
  {
   "id": "s17:007aa",
   "op": "15",
   "jp": "一瞬何も考えられなく\nなっちゃったんだ・・・",
   "en": ""
  },
  {
   "id": "s17:007ea",
   "op": "15",
   "jp": "（だって、私のたくさんのお友達の\n　中で、ちゃんとお話が出来るのは\n　キミだけだったんだもん・・・）",
   "en": ""
  },
  {
   "id": "s17:00862",
   "op": "15",
   "jp": "グスッ・・・・",
   "en": ""
  },
  {
   "id": "s17:00882",
   "op": "15",
   "jp": "あ、あれ・・・？\nいま私何喋ってたんだろぉ・・・",
   "en": ""
  },
  {
   "id": "s17:008c6",
   "op": "15",
   "jp": "ひょっとして、っていうか\nキミ・・・今の話・・・",
   "en": ""
  },
  {
   "id": "s17:0090a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s17:00986",
   "op": "15",
   "jp": "あーっ！あーっ！\n忘れて忘れて！！",
   "en": ""
  },
  {
   "id": "s17:009ba",
   "op": "15",
   "jp": "いまのぜーんぶ忘れて！！",
   "en": ""
  },
  {
   "id": "s17:009e6",
   "op": "15",
   "jp": "って、もともとキミは、\n記憶喪失だったっけか・・・\nアハハハハハハハ・ハ・・・",
   "en": ""
  },
  {
   "id": "s17:00a46",
   "op": "15",
   "jp": "じゃっ！\nバイバイっ！！",
   "en": ""
  },
  {
   "id": "s17:00cb2",
   "op": "15",
   "jp": "私さぁ・・・\nなぁんかキミに・・・",
   "en": ""
  },
  {
   "id": "s17:00ce6",
   "op": "15",
   "jp": "文句ばっかりいってるじゃん・・",
   "en": ""
  },
  {
   "id": "s17:00d16",
   "op": "15",
   "jp": "やっぱ・・・\n嫌われちゃってるのかなぁ・・・？",
   "en": ""
  },
  {
   "id": "s17:00d56",
   "op": "15",
   "jp": "キミは覚えてないかも知れないけど、今までだって、ずうぅ～っとワガママばっかり言ってきたもんねぇ・・・",
   "en": ""
  },
  {
   "id": "s17:00dce",
   "op": "15",
   "jp": "い・いまだって・・あんまり・・\nその・・や、優しくないし・・・",
   "en": ""
  },
  {
   "id": "s17:00e1e",
   "op": "15",
   "jp": "で・・でもさ！\nキミが・・・\n眼を覚まさなかったとき・・・",
   "en": ""
  },
  {
   "id": "s17:00e7a",
   "op": "15",
   "jp": "私これでも、\nちょっとは不安だったんだよ！",
   "en": ""
  },
  {
   "id": "s17:00eb6",
   "op": "15",
   "jp": "だ、だってほら・・・\n私の身の回りのことは・・・\nキミが全部やってたわけじゃない！",
   "en": ""
  },
  {
   "id": "s17:00f1a",
   "op": "15",
   "jp": "そ・・それが全部、\n自分に降りかかってくると・・・",
   "en": ""
  },
  {
   "id": "s17:00f5e",
   "op": "15",
   "jp": "そ・・それって超メンドくさいなぁ、なぁ～んて・・・！",
   "en": ""
  },
  {
   "id": "s17:00fb2",
   "op": "15",
   "jp": "やっぱ、こんな私じゃあ・・\n嫌われちゃって当然かぁ・・・！",
   "en": ""
  },
  {
   "id": "s17:0100e",
   "op": "15",
   "jp": "ねぇ・・起きなよ・・・！",
   "en": ""
  },
  {
   "id": "s17:0103a",
   "op": "15",
   "jp": "ねぇ・・ねぇったら！！",
   "en": ""
  },
  {
   "id": "s17:01062",
   "op": "15",
   "jp": "キミに言いたいことが\nあるのよ！！",
   "en": ""
  },
  {
   "id": "s17:0109a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s17:010ba",
   "op": "15",
   "jp": "私・・・キミの瞳が好きなの・・・",
   "en": ""
  },
  {
   "id": "s17:010ee",
   "op": "15",
   "jp": "その瞳に見つめられてると・・・\nなんだか・・忘れていた記憶が\nよみがえってきそうで・・・",
   "en": ""
  },
  {
   "id": "s17:0115a",
   "op": "15",
   "jp": "だから・・だからつい\n素直じゃなくなっちゃうのよぉ・・・",
   "en": ""
  },
  {
   "id": "s17:011a6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s17:011d2",
   "op": "15",
   "jp": "いつもの私は・・・\nホントの私じゃないの・・・！",
   "en": ""
  },
  {
   "id": "s17:01216",
   "op": "15",
   "jp": "ねぇ・・・\nホントは気づいてるんでしょ？",
   "en": ""
  },
  {
   "id": "s17:01252",
   "op": "15",
   "jp": "私がイジワルしたから・・・\n仕返ししてるだけなんでしょ？",
   "en": ""
  },
  {
   "id": "s17:0129e",
   "op": "15",
   "jp": "私の気持ちに・・気づいてるって、\n私を嫌ってないって言ってよ！！",
   "en": ""
  },
  {
   "id": "s17:01682",
   "op": "15",
   "jp": "だっ、大丈夫！？",
   "en": ""
  },
  {
   "id": "s17:016a6",
   "op": "15",
   "jp": "まだ目覚めてから、一週間しか\n経ってないのに起きたりして・・・",
   "en": ""
  },
  {
   "id": "s17:016f6",
   "op": "15",
   "jp": "でも無理はしない方がいいよぉ・・・まだ本調子じゃないみたいだもの。",
   "en": ""
  },
  {
   "id": "s17:0174e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s17:0177a",
   "op": "15",
   "jp": "そ・・・それと、\nキミに一つだけ大事なお願いが・・・",
   "en": ""
  },
  {
   "id": "s17:017c2",
   "op": "15",
   "jp": "これは重要な事だから、\n絶対に忘れないでね・・・！！",
   "en": ""
  },
  {
   "id": "s17:0180a",
   "op": "15",
   "jp": "キミはこの世界での記憶を無くして\nしまっていて・・・",
   "en": ""
  },
  {
   "id": "s17:01852",
   "op": "15",
   "jp": "この世界の常識には、\nまだ慣れてないでしょ・・・？！",
   "en": ""
  },
  {
   "id": "s17:0189a",
   "op": "15",
   "jp": "だから私が安心してキミを、\n家の外に送り出せるようになるまで、",
   "en": ""
  },
  {
   "id": "s17:018ea",
   "op": "15",
   "jp": "勝手に家の柵の外には、\n絶対に出ないで欲しいの・・・！！",
   "en": ""
  },
  {
   "id": "s17:01936",
   "op": "15",
   "jp": "いい？絶対に勝手に外に出ちゃ、\nダメだからね！！",
   "en": ""
  },
  {
   "id": "s17:0197a",
   "op": "15",
   "jp": "私とキミと・・・\nカインくんだけの約束だよ！！",
   "en": ""
  }
 ]
}
