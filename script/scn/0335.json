{
 "source": "d1:SCENARIO/335",
 "copies": [
  "d1:SCENARIO/335",
  "d2:SCENARIO/335"
 ],
 "strings": [
  {
   "id": "s335:01202",
   "op": "15",
   "jp": "みんな無事のようじゃな。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s335:0123a",
   "op": "15",
   "jp": "助かったぜ、\nと言いたいところだが・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s335:0145e",
   "op": "15",
   "jp": "ど～～ぉお！ダーリン！\nうちらの着てる、\nこの新しいオベベ・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:014c6",
   "op": "14",
   "jp": "・・・・！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s335:014f2",
   "op": "15",
   "jp": "何を隠そう、うちらのこの鎧は\nダーリン達が着ている\n大邪神の鎧とはおそろいの、",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:0156a",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s335:0158e",
   "op": "15",
   "jp": "いわくつきの、\n古の鎧なんえ！！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:015ce",
   "op": "15",
   "jp": "もっ、もしやお前達のその鎧は、\n神々達の戦いで\n大邪神達と戦った・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s335:01636",
   "op": "15",
   "jp": "我らがサタン様の守護天使・・・\n大天使の鎧なんよ！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01692",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s335:016b6",
   "op": "15",
   "jp": "鎧同士の性能が互角な上に、\nガイたらいうお調子もんが\nいてへんおかげで、",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01712",
   "op": "15",
   "jp": "鎧の戦力比はすでに\n４対３以上・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:0174a",
   "op": "15",
   "jp": "ダーリンもそろそろ諦めて\n素直に降伏しぃや！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:0178a",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s335:0180e",
   "op": "15",
   "jp": "うううぅ～ん！\nなんも心配せんでええのんぇ！！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:0184e",
   "op": "15",
   "jp": "ダーリンには、とりあえず\nうちのマイスィートホームに\n住んでもろうてぇ・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:018ae",
   "op": "15",
   "jp": "うちが疲れて眠とうなるまで、\n毎日たぁ～っぷりと、\n頑張って貰う予定なんよ！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01922",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s335:01952",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s335:0198a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s335:019b6",
   "op": "15",
   "jp": "ああぁ～～ん！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:019ee",
   "op": "15",
   "jp": "他の女を好きやなんて\n言うてる男をうちの奴隷に\n出来るやなんて・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01a4a",
   "op": "15",
   "jp": "他の男を好きやなんて\n言うてる男をうちの奴隷に\n出来るやなんて・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01aa2",
   "op": "15",
   "jp": "考えただけでもゾクゾクするわ！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01ae2",
   "op": "15",
   "jp": "なっ、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s335:01b0a",
   "op": "15",
   "jp": "（なんなんだこの女！？）",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:01b5a",
   "op": "15",
   "jp": "もお～っ！あったま来た～！！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s335:01bae",
   "op": "15",
   "jp": "ぷんぷんばきーーーん！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s335:01c2e",
   "op": "15",
   "jp": "さぁ・・・ダーリン！\n今度はうちが直接、\n手にかけてあげまひょ。",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01c82",
   "op": "15",
   "jp": "黒い羽の赤ちゃんが\n産まれるまでは・・・\n簡単には寝かせはせぇへんえ！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01d26",
   "op": "15",
   "jp": "そこまでだっ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s335:01d5e",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s335:01da6",
   "op": "15",
   "jp": "あわ・・わわわわわっ！！\nいっいぃぃ、今のは誰っ？！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:01dee",
   "op": "15",
   "jp": "ま、まさか！？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:01e0e",
   "op": "15",
   "jp": "あのガイがまた後ろから\n現れようっていうの？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:01e7e",
   "op": "15",
   "jp": "簡単にうろたえるんや無い！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01ef6",
   "op": "15",
   "jp": "たとえ、\nあのガキが生きていようと\n増える戦力はたかだか一人",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01f46",
   "op": "15",
   "jp": "しかも残った連中はすでに\nズタボロなんや！\n数の原理でうちらが勝つ！！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:01fa2",
   "op": "14",
   "jp": "・・・・・？？？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:0201a",
   "op": "15",
   "jp": "この程度のアクシデント、\n大勢に影響あらしまへん！！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:0206e",
   "op": "15",
   "jp": "フッハッハッハッ・・・\nはたして計算どおりに、\nそう、うまくいくかな！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s335:026f6",
   "op": "15",
   "jp": "そ、その鎧は！？",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:02726",
   "op": "15",
   "jp": "おおっと！\n自分達の廻りも\nよく見回してみるんだな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s335:02922",
   "op": "15",
   "jp": "し、しまった！！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:02946",
   "op": "15",
   "jp": "くっ！勝利の賢者が揃わぬ今は、\n総当たり戦のような博打は打てへん。",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:0299a",
   "op": "15",
   "jp": "戦略的撤退といくしか\n手が無さそうやねぇ。",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:029d6",
   "op": "15",
   "jp": "ユダ！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:02a5a",
   "op": "15",
   "jp": "ははっ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:02a86",
   "op": "15",
   "jp": "我々はいったん避難し、\n戦力の増強をはかります！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:02aca",
   "op": "15",
   "jp": "お前は例の男を・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:02b22",
   "op": "15",
   "jp": "心得ておりますわ。",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s335:02b9e",
   "op": "15",
   "jp": "ダーリン！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s335:02bba",
   "op": "15",
   "jp": "残念やけど、しばしのお別れや・・\nせいぜいきばりなはれ！！",
   "en": "",
   "box": "17x3",
   "face": 18
  }
 ]
}
