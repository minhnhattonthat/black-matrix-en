{
 "source": "d1:SCENARIO/127",
 "copies": [
  "d1:SCENARIO/127",
  "d2:SCENARIO/127"
 ],
 "strings": [
  {
   "id": "s127:00406",
   "op": "14",
   "jp": "正面切っての攻撃で、\nはたしてこの俺が倒せるかな！？",
   "en": ""
  },
  {
   "id": "s127:004a2",
   "op": "14",
   "jp": "ほう！\n側面に回り込んでからの攻撃とは\n少しはやるな！",
   "en": ""
  },
  {
   "id": "s127:004e0",
   "op": "14",
   "jp": "今のは俺でも・・・\n少しは、かゆいぜ！",
   "en": ""
  },
  {
   "id": "s127:0055e",
   "op": "14",
   "jp": "案外素早い動きだ・・・！！",
   "en": ""
  },
  {
   "id": "s127:00580",
   "op": "14",
   "jp": "だがこういった事も\n覚えておく事だ！！",
   "en": ""
  },
  {
   "id": "s127:005ae",
   "op": "14",
   "jp": "高低差のある戦場では\n行動力（ＭＯＶ）が、\nその勝敗の鍵を握る！",
   "en": ""
  },
  {
   "id": "s127:005f6",
   "op": "14",
   "jp": "つまり行動力が高い奴ならいきなり\n高い所へ上ったり、崖から下に飛び\n降りる事だって出来るんだぜ！！",
   "en": ""
  },
  {
   "id": "s127:006c2",
   "op": "14",
   "jp": "くそっ突然後ろに回り込むとはな！",
   "en": ""
  },
  {
   "id": "s127:006ea",
   "op": "14",
   "jp": "今のは、背中にズバッときたぜ！！\nだがな・・・",
   "en": ""
  },
  {
   "id": "s127:00720",
   "op": "14",
   "jp": "周りに邪魔になる敵や味方がいる\n実際の戦場では・・・",
   "en": ""
  },
  {
   "id": "s127:0075c",
   "op": "14",
   "jp": "そう簡単には、\n相手の後ろに回り込めないもんさ！",
   "en": ""
  },
  {
   "id": "s127:00794",
   "op": "14",
   "jp": "今は、お互いこんな棒っきれを\n使って戦っているが・・・",
   "en": ""
  },
  {
   "id": "s127:007d2",
   "op": "14",
   "jp": "武器にはそれぞれ\n特性ってもんがある・・・",
   "en": ""
  },
  {
   "id": "s127:00804",
   "op": "14",
   "jp": "弓や槍やムチが使えれば、\n敵の反撃を喰らわずに離れた\n場所からも攻撃する事が出来るし",
   "en": ""
  },
  {
   "id": "s127:00860",
   "op": "14",
   "jp": "うまく使えば、敵をこちらに引き\n寄せたり、遠くにいるやっかいな\n敵から先に倒す事もできるんだ！",
   "en": ""
  },
  {
   "id": "s127:008c6",
   "op": "14",
   "jp": "もっとも俺は・・・",
   "en": ""
  },
  {
   "id": "s127:008e0",
   "op": "14",
   "jp": "普段から斧や剣しか\n使わん性分だから、そんな戦法には\nあんまり興味がないがな！！",
   "en": ""
  },
  {
   "id": "s127:00938",
   "op": "14",
   "jp": "本来、人にはそれぞれ得意な武器や\n攻撃方法ってもんがある物さ！",
   "en": ""
  },
  {
   "id": "s127:0097e",
   "op": "14",
   "jp": "つまり人によって装備できる武器\n出来ない武器がある事を・・・、\nしっかり肝に銘じておく事だ！！",
   "en": ""
  },
  {
   "id": "s127:00a36",
   "op": "14",
   "jp": "オイオイ！味方もそうだが・・・",
   "en": ""
  },
  {
   "id": "s127:00a5c",
   "op": "14",
   "jp": "敵をまたいで移動する事なんて\n誰にも出来やしないんだぜ！？",
   "en": ""
  },
  {
   "id": "s127:00a9e",
   "op": "14",
   "jp": "俺の背後を取りたいんなら\n多少遠回りでも、動ける範囲内で\n回り込むしか方法はあるまい！？",
   "en": ""
  },
  {
   "id": "s127:00afe",
   "op": "14",
   "jp": "それに移動した後には、必ず\n有利な方向に自分の向きを変えて\n置くことが重要なのさ・・・",
   "en": ""
  },
  {
   "id": "s127:00b5c",
   "op": "14",
   "jp": "むやみに敵に後ろを見せると、\n戦場では命取りになるからな！",
   "en": ""
  },
  {
   "id": "s127:00bee",
   "op": "14",
   "jp": "なんだなんだその戦い方は？！\n敵の攻撃対抗する方法にも\n色々あるってのに・・・？！",
   "en": ""
  },
  {
   "id": "s127:00c48",
   "op": "14",
   "jp": "反撃、防御、回避の３つを\nいかに戦況に合わせて使い分けるかがプロとアマの違いなのさ！",
   "en": ""
  },
  {
   "id": "s127:00ca4",
   "op": "14",
   "jp": "ちなみに敵の攻撃中でも、\nやりようによっては色々と戦法を\n変える事だって出来るんだぜ！？",
   "en": ""
  },
  {
   "id": "s127:00d04",
   "op": "14",
   "jp": "実際の戦闘では、敵がぶっ倒れた\nからと言って油断せず・・・",
   "en": ""
  },
  {
   "id": "s127:00d46",
   "op": "14",
   "jp": "トドメを刺すのを忘れない事だ！！",
   "en": ""
  },
  {
   "id": "s127:00d6e",
   "op": "14",
   "jp": "へたに敵を瀕死の状態で放置\nしておくと仲間が回復薬なんかを\n使って・・・",
   "en": ""
  },
  {
   "id": "s127:00dbe",
   "op": "14",
   "jp": "よみがえらせやがるからな！",
   "en": ""
  },
  {
   "id": "s127:00de0",
   "op": "14",
   "jp": "だが逆にわざと敵を\n死滅させないでおいて防壁がわりに\n使うという手もある・・・",
   "en": ""
  },
  {
   "id": "s127:00e36",
   "op": "14",
   "jp": "狭い場所ではこれも有効な戦闘\n手段の一つなのさ・・・",
   "en": ""
  },
  {
   "id": "s127:00e72",
   "op": "14",
   "jp": "それとココだけの話だが、人間の\n返り血（ＢＰ）を使って剣血という\n儀式を行うと・・・",
   "en": ""
  },
  {
   "id": "s127:00ece",
   "op": "14",
   "jp": "武器に隠された潜在能力が発揮され、より強力な武器になる事があるって\nもっぱらの噂だ・・・",
   "en": ""
  },
  {
   "id": "s127:00f2e",
   "op": "14",
   "jp": "ただし場合によってはその武器が\n呪われる可能性もあるらしいから",
   "en": ""
  },
  {
   "id": "s127:00f74",
   "op": "14",
   "jp": "せいぜい気をつけることだな！",
   "en": ""
  },
  {
   "id": "s127:0100e",
   "op": "14",
   "jp": "お前、案外やるじゃねぇか！",
   "en": ""
  },
  {
   "id": "s127:01050",
   "op": "14",
   "jp": "まあまあだな・・・！",
   "en": ""
  },
  {
   "id": "s127:01074",
   "op": "14",
   "jp": "お前、弱ぇなぁ・・・・！",
   "en": ""
  }
 ]
}
