{
 "source": "d1:SCENARIO/330",
 "copies": [
  "d1:SCENARIO/330",
  "d2:SCENARIO/330"
 ],
 "strings": [
  {
   "id": "s330:001f6",
   "op": "15",
   "jp": "またしても・・・",
   "en": ""
  },
  {
   "id": "s330:0021a",
   "op": "15",
   "jp": "この世界を支える\n七つの封印の鎖の\n一つが・・・",
   "en": ""
  },
  {
   "id": "s330:0025e",
   "op": "15",
   "jp": "砕かれてしまいました・・・",
   "en": ""
  },
  {
   "id": "s330:0028e",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s330:002b6",
   "op": "15",
   "jp": "いったい、私はいつまで・・・",
   "en": ""
  },
  {
   "id": "s330:002e6",
   "op": "15",
   "jp": "いつまで、\nアナタ方を許すという罪を\n続けなければならないのですか！？",
   "en": ""
  },
  {
   "id": "s330:0034e",
   "op": "15",
   "jp": "我らが教皇様にまで\nご心配をさせてしもうて、ほんに\n申し訳なく思うとりますんぇ。",
   "en": ""
  },
  {
   "id": "s330:003b2",
   "op": "15",
   "jp": "例の大邪神の鎧とやらの\n戦力分析に気を使こぅて、",
   "en": ""
  },
  {
   "id": "s330:003f6",
   "op": "15",
   "jp": "少々奴等を泳がせ過ぎて\nしまいましたワ！",
   "en": ""
  },
  {
   "id": "s330:00432",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s330:0044e",
   "op": "15",
   "jp": "ところで、私が頼んでおいた\n大邪神の力に対抗するための\n例の人材の方は？",
   "en": ""
  },
  {
   "id": "s330:004b6",
   "op": "15",
   "jp": "ハイ！",
   "en": ""
  },
  {
   "id": "s330:004ce",
   "op": "15",
   "jp": "この世界でもいずれ劣らぬ\n情念の持ち主達を\n既に選りすぐってございます！",
   "en": ""
  },
  {
   "id": "s330:0052a",
   "op": "15",
   "jp": "せやけどぉ・・・",
   "en": ""
  },
  {
   "id": "s330:0054e",
   "op": "15",
   "jp": "すでに鎧を着た敵が、\n４人になってしもうた以上・・・",
   "en": ""
  },
  {
   "id": "s330:00596",
   "op": "15",
   "jp": "今のままでは、\n戦力の頭数が一人か二人\n足りしまへんのやないかと・・・",
   "en": ""
  },
  {
   "id": "s330:005fe",
   "op": "15",
   "jp": "もはや一刻の猶予もありません！",
   "en": ""
  },
  {
   "id": "s330:0062e",
   "op": "15",
   "jp": "このまま、さらなる邪神の復活を\n放置すれば、この世界全体に\n未曾有の大災害が訪れるのは必定！",
   "en": ""
  },
  {
   "id": "s330:0069e",
   "op": "15",
   "jp": "ルカよ、こうなっては、\nあなた自身にも\n働いて貰うしかありませんね！",
   "en": ""
  },
  {
   "id": "s330:018ce",
   "op": "15",
   "jp": "まったく、ひでぇ所だな。",
   "en": ""
  },
  {
   "id": "s330:0192a",
   "op": "15",
   "jp": "おやおや！\n力自慢の筋肉バカも、\n山登りは苦手って事かい？",
   "en": ""
  },
  {
   "id": "s330:019aa",
   "op": "15",
   "jp": "うるせえ！！",
   "en": ""
  },
  {
   "id": "s330:019ca",
   "op": "15",
   "jp": "こおいうのは\n俺の力の使いどころとは、\n根本的に違うんだよ！",
   "en": ""
  },
  {
   "id": "s330:01a26",
   "op": "15",
   "jp": "すまん、そうだったな！",
   "en": ""
  },
  {
   "id": "s330:01a4e",
   "op": "15",
   "jp": "壊したり、持ち上げたり\nする事だけが・・・\n得意なんだよな！",
   "en": ""
  },
  {
   "id": "s330:01b0e",
   "op": "15",
   "jp": "やぁーいやぁーい！\nレブちゃん、かなちぃ～～い！！",
   "en": ""
  },
  {
   "id": "s330:01b56",
   "op": "14",
   "jp": "○▼×△■！！",
   "en": ""
  },
  {
   "id": "s330:01b86",
   "op": "15",
   "jp": "我慢せんか！",
   "en": ""
  },
  {
   "id": "s330:020b6",
   "op": "15",
   "jp": "追われる者の身としては、\n悠長に街道を通るわけにも\nいかんじゃろう？",
   "en": ""
  },
  {
   "id": "s330:02126",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s330:02152",
   "op": "15",
   "jp": "だがなぁ、爺さん。",
   "en": ""
  },
  {
   "id": "s330:02176",
   "op": "15",
   "jp": "俺達はともかく・・・\nルピルピはすでに限界みたいだぜ。",
   "en": ""
  },
  {
   "id": "s330:0221a",
   "op": "15",
   "jp": "ボクも限界だよ・・・",
   "en": ""
  },
  {
   "id": "s330:0224e",
   "op": "15",
   "jp": "仕方がない、この谷を降りたら\nしばらく休憩にするかのう。",
   "en": ""
  },
  {
   "id": "s330:022a6",
   "op": "15",
   "jp": "じゃあ元気な俺は、\n少し先の方を偵察してくるぜ！",
   "en": ""
  },
  {
   "id": "s330:02996",
   "op": "15",
   "jp": "ルピルピよ・・・お主顔色が\nひどく悪いようじゃが・・・",
   "en": ""
  },
  {
   "id": "s330:029e2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s330:029fe",
   "op": "15",
   "jp": "ヨハネ様こそ、\n結構きつそうに見えますわよ！",
   "en": ""
  },
  {
   "id": "s330:02a4a",
   "op": "15",
   "jp": "ふっ、\nわしももう歳じゃからのう。",
   "en": ""
  },
  {
   "id": "s330:02a8e",
   "op": "15",
   "jp": "爺さん、\n俺達も先に行くぜ。",
   "en": ""
  },
  {
   "id": "s330:02aca",
   "op": "15",
   "jp": "そうか、すまんな！",
   "en": ""
  },
  {
   "id": "s330:02afe",
   "op": "15",
   "jp": "どうして？\n一緒に行けばいいのに！？",
   "en": ""
  },
  {
   "id": "s330:02b36",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s330:02b62",
   "op": "15",
   "jp": "こやつは邪悪な奴じゃからな、\nわしらに気をつかってくれて\nおるのじゃ・・・",
   "en": ""
  },
  {
   "id": "s330:02bce",
   "op": "15",
   "jp": "そうなの？",
   "en": ""
  },
  {
   "id": "s330:02bfa",
   "op": "15",
   "jp": "あ～ら、\n主人殺しのレブロブスさんが\n随分とおやさしいこと。",
   "en": ""
  },
  {
   "id": "s330:02c92",
   "op": "15",
   "jp": "それに、私ならこの通り！\n全然平気ですわよ！",
   "en": ""
  },
  {
   "id": "s330:02d22",
   "op": "15",
   "jp": "ばっ、馬鹿野郎！！\nちっ・・行くぞ！",
   "en": ""
  },
  {
   "id": "s330:02dd6",
   "op": "15",
   "jp": "ヨハネ達は\nゆっくり来ればいいからよ。",
   "en": ""
  },
  {
   "id": "s330:02e8e",
   "op": "15",
   "jp": "そんな事、言っていいの？",
   "en": ""
  },
  {
   "id": "s330:02ec6",
   "op": "15",
   "jp": "うるせぇ！！",
   "en": ""
  }
 ]
}
