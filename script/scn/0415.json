 "strings": [
  {
   "id": "s415:00dda",
   "op": "15",
   "jp": "見事です。\n大邪神の鎧の力を論理的かつ、",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:00e16",
   "op": "15",
   "jp": "効率的に使いこなすとは・・・\nそれでは、次の設問です。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:01576",
   "op": "15",
   "jp": "ちょ・・ちょっと待て！\nこっ・・こいつら！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s415:017be",
   "op": "15",
   "jp": "どうかしましたか？",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:017e2",
   "op": "15",
   "jp": "彼らは、先ほど戦った\n黒き羽の傭兵と同じく、",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:01822",
   "op": "15",
   "jp": "幾ばくかの報酬を目的として\nアナタ方に明確な殺意を\n持っているのです。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:0187a",
   "op": "15",
   "jp": "それともアナタ方も\n羽の色で人間を差別し、",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:018b6",
   "op": "15",
   "jp": "黒き羽の兵隊なら殺せても\n白き羽の兵隊は殺せない\nと言うのですか！？",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:0190e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s415:0193a",
   "op": "15",
   "jp": "くっ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s415:01966",
   "op": "15",
   "jp": "何かを成す為には強じんな肉体と\nそれに見合った意志の力が\n不可欠なのです。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s415:01a4e",
   "op": "15",
   "jp": "おい、どうする！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s415:01a82",
   "op": "1d",
   "jp": "このまま戦う！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s415:01a9c",
   "op": "1d",
   "jp": "逃げるように努力する",
   "en": "",
   "max": 15
  },
  {
   "id": "s415:01ab8",
   "op": "1d",
   "jp": "彼らに殺される！",
   "en": "",
   "max": 15
  },
  {
   "id": "s415:01b0e",
   "op": "15",
   "jp": "それもやむを得ないか。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s415:01b7e",
   "op": "15",
   "jp": "確かに、それも\n一つの真理ですからね・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s415:01bf6",
   "op": "15",
   "jp": "それもやむを得ないか。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s415:01c66",
   "op": "15",
   "jp": "確かに、それも\n一つの真理ですからね・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s415:01d2e",
   "op": "15",
   "jp": "確かに、奴が言う事を\nそのまま信用するのは\n危険すぎる。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s415:01e9e",
   "op": "15",
   "jp": "とにかく全員で、\nここを突破するんじゃ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s415:01eda",
   "op": "15",
   "jp": "だが最悪、\n戦うこともあり得ると、\n覚悟しておくのじゃぞ！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s415:01f66",
   "op": "15",
   "jp": "それもやむを得ないか。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s415:01fd6",
   "op": "15",
   "jp": "確かに、それも\n一つの真理ですからね・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s415:0207e",
   "op": "15",
   "jp": "俺達、このまま本当に・・・\n反撃もしないで死んじまうのか？",
   "en": "",
   "box": "17x3",
   "face": 2
  }
 ]
