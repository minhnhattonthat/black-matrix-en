 "strings": [
  {
   "id": "s480:005c2",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00692",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00762",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:009ba",
   "op": "14",
   "jp": "つ、強ぇえ・・・\nなんて・・強さだ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s480:00a0c",
   "op": "14",
   "jp": "だが、なぜオレ達を、\n一気に殺そうとしない！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s480:00a4e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00a60",
   "op": "14",
   "jp": "「俺は猫に似て、食べる前に\nネズミと少し遊ぶのが\n好きなのだ・・・」",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00aac",
   "op": "14",
   "jp": "もっとも・・・\n今のは、メフィストの\n受け売りだがな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00b6a",
   "op": "14",
   "jp": "俺でさえ、お前達の\n悲しみの日々を\n気の毒に思う・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00ba8",
   "op": "14",
   "jp": "哀れな者達を悩ます・・・\n快楽のほとんどを\nやめたくなるほどに・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00c36",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s480:00cc6",
   "op": "14",
   "jp": "悠久の時を生きる俺にとって、",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00cea",
   "op": "14",
   "jp": "すでに強さなど\nなんの価値もない・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00d18",
   "op": "14",
   "jp": "腕を上げる時間など・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00d38",
   "op": "14",
   "jp": "今までに飽きるほど\n存在したのだから・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00d6a",
   "op": "14",
   "jp": "だが限られた時間を生きる\nお前達よ・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:00d9a",
   "op": "14",
   "jp": "果たしてお前達は\nその時間を有効に・・・\n使っているのかな！？",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:0111a",
   "op": "14",
   "jp": "お前達は・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:01130",
   "op": "14",
   "jp": "奴等がサルと呼んでいる\n連中の子孫達か・・・！？",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:01168",
   "op": "14",
   "jp": "くっ・・・\n俺もかつては・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:0118e",
   "op": "14",
   "jp": "大悪神ゴッドに滅ぼされた",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:011ae",
   "op": "14",
   "jp": "呪われた羽のない一族の\n一人だった・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:011de",
   "op": "14",
   "jp": "しかし俺はメフィストと契約を\n交わして永遠の生命を\n手に入れたかわりに・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:01232",
   "op": "14",
   "jp": "自分では死ぬことすら\n出来なくなってしまった・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:0126c",
   "op": "14",
   "jp": "お前達のおかげで、\nやっと眠りにつく事が出来る・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:012c0",
   "op": "14",
   "jp": "お前達に・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:012d6",
   "op": "14",
   "jp": "なにか礼をせねば・・\nなるまいな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s480:01346",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s480:01358",
   "op": "14",
   "jp": "この友愛の剣を\n持っていくがいい・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s480:01386",
   "op": "14",
   "jp": "この剣は・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s480:0139c",
   "op": "14",
   "jp": "俺がメフィストと契約した\n証しとして、\n奴から譲り受けた物だ・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s480:01426",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  }
 ]
}
