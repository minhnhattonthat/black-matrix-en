{
 "source": "d1:SCENARIO/237",
 "copies": [
  "d1:SCENARIO/237",
  "d2:SCENARIO/237"
 ],
 "strings": [
  {
   "id": "s237:00b12",
   "op": "15",
   "jp": "ピリポよ・・・\nこうなっては致し方あるまい！",
   "en": ""
  },
  {
   "id": "s237:00b52",
   "op": "15",
   "jp": "どうしても両親に会いたいなら、\n勇気を出して、正面から向き合うしか他に手はないと思うぞ・・・",
   "en": ""
  },
  {
   "id": "s237:00be6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s237:00c06",
   "op": "15",
   "jp": "だっ・・だけど・・・",
   "en": ""
  },
  {
   "id": "s237:00c3a",
   "op": "15",
   "jp": "どうでもいいから、早いとこ\n会いに行っちまえよ・・・",
   "en": ""
  },
  {
   "id": "s237:00c82",
   "op": "15",
   "jp": "なんだかんだ言ったって、\nオマエの実の肉親なんだろう！？",
   "en": ""
  },
  {
   "id": "s237:00cce",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s237:00dc2",
   "op": "15",
   "jp": "うるさいぞキサマ等！！",
   "en": ""
  },
  {
   "id": "s237:00dea",
   "op": "15",
   "jp": "ココをこの村の村長の館としって\n騒いでおるのか・・・！？",
   "en": ""
  },
  {
   "id": "s237:00e36",
   "op": "15",
   "jp": "んんっ！？なんだお前達は・・・",
   "en": ""
  },
  {
   "id": "s237:00e66",
   "op": "15",
   "jp": "この、首輪も着けずに、しかも立って歩いている奴隷は・・・",
   "en": ""
  },
  {
   "id": "s237:00eb2",
   "op": "15",
   "jp": "お前達の飼っている奴隷達なのか！？",
   "en": ""
  },
  {
   "id": "s237:00f02",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s237:00f46",
   "op": "15",
   "jp": "ハーイ！このお兄ちゃんは\nアタシの奴隷だよ～ん！",
   "en": ""
  },
  {
   "id": "s237:00fa2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s237:00fe6",
   "op": "15",
   "jp": "だったらなんだっていうのよぉ～！！",
   "en": ""
  },
  {
   "id": "s237:0101e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s237:0103a",
   "op": "15",
   "jp": "この家の主人に・・・",
   "en": ""
  },
  {
   "id": "s237:01062",
   "op": "15",
   "jp": "内密に、ちと話したい事が\nあってな・・・",
   "en": ""
  },
  {
   "id": "s237:0109e",
   "op": "15",
   "jp": "商売の話じゃ・・・",
   "en": ""
  },
  {
   "id": "s237:010c2",
   "op": "15",
   "jp": "ピリポが来たと伝えれば\nわかるじゃろうて・・・！",
   "en": ""
  },
  {
   "id": "s237:011f6",
   "op": "15",
   "jp": "・・・なんじゃ騒々しい！！",
   "en": ""
  },
  {
   "id": "s237:01232",
   "op": "15",
   "jp": "これは旦那様・・・\nこちらのピリポ殿と\n呼ばれる神官の方が・・・",
   "en": ""
  },
  {
   "id": "s237:01292",
   "op": "15",
   "jp": "ピリポじゃと・・・！？",
   "en": ""
  },
  {
   "id": "s237:0132e",
   "op": "15",
   "jp": "きっ・・・キサマ・・・\nさては、ユスリたかりの類か！？",
   "en": ""
  },
  {
   "id": "s237:0137a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s237:013a6",
   "op": "15",
   "jp": "あ・・・あのう・・・・",
   "en": ""
  },
  {
   "id": "s237:013e6",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s237:013fe",
   "op": "15",
   "jp": "おっ・・・オマエ・・・\nその白き羽は・・・・！？",
   "en": ""
  },
  {
   "id": "s237:0144e",
   "op": "15",
   "jp": "旦那様・・・\nやはり、お知り合いの方で！？",
   "en": ""
  },
  {
   "id": "s237:0149a",
   "op": "15",
   "jp": "し・・しらん！！",
   "en": ""
  },
  {
   "id": "s237:014be",
   "op": "15",
   "jp": "知らんぞこんな奴らは！！",
   "en": ""
  },
  {
   "id": "s237:014ea",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s237:01516",
   "op": "15",
   "jp": "おそらくは、我が家の家系に\n難癖をつけに来た・・・",
   "en": ""
  },
  {
   "id": "s237:0155a",
   "op": "15",
   "jp": "ユスリ屋の類であろう！！",
   "en": ""
  },
  {
   "id": "s237:01586",
   "op": "15",
   "jp": "用心棒の先生がた・・・",
   "en": ""
  },
  {
   "id": "s237:015ae",
   "op": "15",
   "jp": "奴等が何を言おうと構う事はない！",
   "en": ""
  },
  {
   "id": "s237:015e2",
   "op": "15",
   "jp": "さっさとかたずけて下さい！！",
   "en": ""
  },
  {
   "id": "s237:0161e",
   "op": "15",
   "jp": "くそぉ・・・・\nやっぱりこういう展開になんのかよ！",
   "en": ""
  },
  {
   "id": "s237:01672",
   "op": "15",
   "jp": "ちっ！！",
   "en": ""
  },
  {
   "id": "s237:0168e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  }
 ]
}
