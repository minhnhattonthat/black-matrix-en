{
 "source": "d1:SCENARIO/169",
 "copies": [
  "d1:SCENARIO/169",
  "d2:SCENARIO/169"
 ],
 "strings": [
  {
   "id": "s169:00822",
   "op": "15",
   "jp": "それにしてもお師匠様\nよくぞ・・・",
   "en": ""
  },
  {
   "id": "s169:008ca",
   "op": "15",
   "jp": "よくぞご無事で！！",
   "en": ""
  },
  {
   "id": "s169:008ee",
   "op": "15",
   "jp": "ああっ、この喜ばしい出来事を、\n私の日記にぜひ、\n書きとめておかなくっちゃ！",
   "en": ""
  },
  {
   "id": "s169:0098a",
   "op": "15",
   "jp": "お師匠様はやめんか！",
   "en": ""
  },
  {
   "id": "s169:009b2",
   "op": "15",
   "jp": "今の我が輩は・・・",
   "en": ""
  },
  {
   "id": "s169:009d6",
   "op": "15",
   "jp": "邪神の光臨を信じる、\nただの邪教徒にすぎん！",
   "en": ""
  },
  {
   "id": "s169:00aea",
   "op": "15",
   "jp": "と言われますと、\nもしや！？",
   "en": ""
  },
  {
   "id": "s169:00b26",
   "op": "15",
   "jp": "ついに大邪神の鎧を\n解放する術を、\n見つけられたのですか！？",
   "en": ""
  },
  {
   "id": "s169:00b82",
   "op": "15",
   "jp": "おい爺さん、\nさっきからなんだい、その・・・",
   "en": ""
  },
  {
   "id": "s169:00c52",
   "op": "15",
   "jp": "鎧がどうのこうのってぇのは？",
   "en": ""
  },
  {
   "id": "s169:00c82",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s169:00ca2",
   "op": "15",
   "jp": "我々黒き羽の者達の、\n言い伝えによると、",
   "en": ""
  },
  {
   "id": "s169:00cfa",
   "op": "15",
   "jp": "遥かなる神話の時代\nこの世界全体は、愛や\n偽善や自由を信じる、",
   "en": ""
  },
  {
   "id": "s169:00d4a",
   "op": "15",
   "jp": "大悪神・ゴッドによって\n支配されていた。",
   "en": ""
  },
  {
   "id": "s169:00e2a",
   "op": "15",
   "jp": "しかしある時、",
   "en": ""
  },
  {
   "id": "s169:00e4a",
   "op": "15",
   "jp": "我らが救世主であらせられる、\n偉大なる大天使メフィスト様が・・・",
   "en": ""
  },
  {
   "id": "s169:00e9e",
   "op": "15",
   "jp": "父なる大神サタン様の旗の下、\n聖戦を始められ・・・",
   "en": ""
  },
  {
   "id": "s169:00ee2",
   "op": "15",
   "jp": "白き悪魔達と６６６日間の\n永きに渡る戦争を行ったと\n伝えられている・・・！",
   "en": ""
  },
  {
   "id": "s169:00f4e",
   "op": "15",
   "jp": "俗にいう神々達の戦い、\n創世記戦争って呼ばれている\nやつだな。",
   "en": ""
  },
  {
   "id": "s169:00fba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s169:01016",
   "op": "15",
   "jp": "そして、その戦争で敗れさった\n白き悪魔達は・・・",
   "en": ""
  },
  {
   "id": "s169:0105a",
   "op": "15",
   "jp": "朽ち果てた鎧を\n残して死んでいったのだ・・・",
   "en": ""
  },
  {
   "id": "s169:0109a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s169:010c6",
   "op": "15",
   "jp": "だが、死んだはずの\n白き悪魔のちからは、\nその後も鎧に宿り続け・・・",
   "en": ""
  },
  {
   "id": "s169:0111e",
   "op": "15",
   "jp": "それを手にした者達に、\n強大なるちからを与え続けておると\n言われておる・・・",
   "en": ""
  },
  {
   "id": "s169:0118a",
   "op": "15",
   "jp": "それが噂に聞く邪道騎士の\n悪魔の鎧の正体って訳か・・・",
   "en": ""
  },
  {
   "id": "s169:011ee",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s169:01232",
   "op": "15",
   "jp": "ねぇねぇおにいちゃん！",
   "en": ""
  },
  {
   "id": "s169:0125a",
   "op": "15",
   "jp": "（プリカなんだか・・・\n　よくわかんないや！）",
   "en": ""
  },
  {
   "id": "s169:012ba",
   "op": "15",
   "jp": "ところがかつて",
   "en": ""
  },
  {
   "id": "s169:012da",
   "op": "15",
   "jp": "そんな白き羽の悪魔達よりも、\nはるかに強大な力を誇る、\n七人の大邪神達がいた・・・",
   "en": ""
  },
  {
   "id": "s169:01372",
   "op": "15",
   "jp": "すなわち・・・",
   "en": ""
  },
  {
   "id": "s169:013c2",
   "op": "15",
   "jp": "大地の大邪神ミカエル！",
   "en": ""
  },
  {
   "id": "s169:0140a",
   "op": "15",
   "jp": "生命の大邪神ガブリエル！",
   "en": ""
  },
  {
   "id": "s169:01452",
   "op": "15",
   "jp": "太陽の大邪神ラファエル！",
   "en": ""
  },
  {
   "id": "s169:0149a",
   "op": "15",
   "jp": "炎の大邪神ウリエル！",
   "en": ""
  },
  {
   "id": "s169:014de",
   "op": "15",
   "jp": "水の大邪神サリエル！",
   "en": ""
  },
  {
   "id": "s169:01522",
   "op": "15",
   "jp": "大気の大邪神ラグエル！",
   "en": ""
  },
  {
   "id": "s169:0156a",
   "op": "15",
   "jp": "そして、\n中でも最も恐れられていた、",
   "en": ""
  },
  {
   "id": "s169:015a2",
   "op": "15",
   "jp": "地獄の大邪神メタトロン！！",
   "en": ""
  },
  {
   "id": "s169:015ee",
   "op": "15",
   "jp": "その大邪神メタトロンが\n創世記戦争で着ていたという、\n伝説の大邪神の鎧が・・・",
   "en": ""
  },
  {
   "id": "s169:0164e",
   "op": "15",
   "jp": "このわしが\nかつて統治しておった、",
   "en": ""
  },
  {
   "id": "s169:01682",
   "op": "15",
   "jp": "太陽の神殿に\n封印されておったのじゃ！",
   "en": ""
  },
  {
   "id": "s169:016be",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s169:0171a",
   "op": "15",
   "jp": "大邪神の鎧を発見したわしは、\n狂喜にむせかえった。",
   "en": ""
  },
  {
   "id": "s169:0175e",
   "op": "15",
   "jp": "地獄の大邪神とうたわれた\nメタトロンの鎧じゃ！！",
   "en": ""
  },
  {
   "id": "s169:017a2",
   "op": "15",
   "jp": "その強大なる魔力は、\n邪道騎士達の低俗なる悪魔の鎧など\n及ぶべくもない・・・！",
   "en": ""
  },
  {
   "id": "s169:01802",
   "op": "15",
   "jp": "わしが牢に入れられたのも、",
   "en": ""
  },
  {
   "id": "s169:0182e",
   "op": "15",
   "jp": "元はと言えばご禁制だった\nその大邪神の鎧の研究を、\n始めたせいだったのじゃ！！",
   "en": ""
  },
  {
   "id": "s169:018fe",
   "op": "15",
   "jp": "ようするに爺さんは、\nその鎧とやらの魅力に惹かれて、",
   "en": ""
  },
  {
   "id": "s169:0199a",
   "op": "15",
   "jp": "自分を見失っちまったワケだ！",
   "en": ""
  },
  {
   "id": "s169:01a06",
   "op": "15",
   "jp": "この世の基本は弱肉強食！",
   "en": ""
  },
  {
   "id": "s169:01a32",
   "op": "15",
   "jp": "たとえ血塗られた\n大邪神の鎧であったとしても、",
   "en": ""
  },
  {
   "id": "s169:01a72",
   "op": "15",
   "jp": "強い力を持つ物は使わんと、\n絶対に損だとは思わんか・・・！？",
   "en": ""
  },
  {
   "id": "s169:01b16",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s169:01b3e",
   "op": "15",
   "jp": "その後もわしは、\nこのルピルピと研究を続け、",
   "en": ""
  },
  {
   "id": "s169:01b7e",
   "op": "15",
   "jp": "なんとか封印を解き、\nその大邪神の鎧を、\n着用しようと試みたが・・・",
   "en": ""
  },
  {
   "id": "s169:01bd6",
   "op": "15",
   "jp": "どうしても着ることが出来ずに、\nあと一歩という所で失敗して、\n奴等に捕まってしまったのじゃ！",
   "en": ""
  },
  {
   "id": "s169:01c52",
   "op": "15",
   "jp": "何で・・・失敗したんだろう！？",
   "en": ""
  },
  {
   "id": "s169:01cc2",
   "op": "15",
   "jp": "それは、\n実際に実物の大邪神の鎧を、\n見れば解るじゃろうて。",
   "en": ""
  },
  {
   "id": "s169:01d4e",
   "op": "15",
   "jp": "それが・・・\n大邪神の鎧は既に・・・",
   "en": ""
  },
  {
   "id": "s169:01de2",
   "op": "15",
   "jp": "ユダに奪われたというのか！",
   "en": ""
  },
  {
   "id": "s169:01e1e",
   "op": "15",
   "jp": "アヤツいったい何のつもりで！？",
   "en": ""
  },
  {
   "id": "s169:01e62",
   "op": "15",
   "jp": "なんだかよくわかんねえが、\n俺達が自由になるには、\nどのみち避けては通れねぇんだろ！",
   "en": ""
  },
  {
   "id": "s169:01f36",
   "op": "15",
   "jp": "ともかく大邪神の鎧じゃ！",
   "en": ""
  },
  {
   "id": "s169:01f62",
   "op": "15",
   "jp": "それさえ手中におさめれば、\n強大なちからが蘇る。",
   "en": ""
  },
  {
   "id": "s169:01fb2",
   "op": "15",
   "jp": "え？彼のご主人様を助けるのは、\nどうするの？",
   "en": ""
  },
  {
   "id": "s169:0207e",
   "op": "15",
   "jp": "おっ、おぉそうじゃったな、\nそれも忘れてはいかん。",
   "en": ""
  },
  {
   "id": "s169:02102",
   "op": "15",
   "jp": "ふっ、なにやらやけに\nうさん臭い話だ。",
   "en": ""
  },
  {
   "id": "s169:02252",
   "op": "15",
   "jp": "私の名はルピルピ！！",
   "en": ""
  },
  {
   "id": "s169:0227a",
   "op": "15",
   "jp": "私の趣味は\n日記を付ける事なんです！",
   "en": ""
  },
  {
   "id": "s169:022be",
   "op": "15",
   "jp": "いまの言い方、ちょこ～っと\nカチン！ときたから、",
   "en": ""
  },
  {
   "id": "s169:0233e",
   "op": "15",
   "jp": "アナタの事も日記に\n書いちゃいますね！！",
   "en": ""
  },
  {
   "id": "s169:0239a",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s169:0241e",
   "op": "15",
   "jp": "そ、それにしても、\n俺はこんな小娘相手に、\n遅れをとっていたのかあぁ。",
   "en": ""
  },
  {
   "id": "s169:0261e",
   "op": "1d",
   "jp": "封印の間に向かう！",
   "en": "",
   "max": 15
  },
  {
   "id": "s169:02638",
   "op": "1d",
   "jp": "いったん街に戻る！！",
   "en": "",
   "max": 15
  }
 ]
}
