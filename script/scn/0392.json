 "strings": [
  {
   "id": "s392:00e9a",
   "op": "15",
   "jp": "やはり、我々と共に・・・",
   "en": "",
   "box": "17x3",
   "face": 47
  },
  {
   "id": "s392:00ec6",
   "op": "15",
   "jp": "ゴモラの奴らと戦ってくれる気に\nなってくれたんですね！！",
   "en": "",
   "box": "17x3",
   "face": 47
  },
  {
   "id": "s392:00f72",
   "op": "15",
   "jp": "いや、わしらはお主達の考え方に\n賛同できんと判断したのじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s392:00fc6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 47
  },
  {
   "id": "s392:01016",
   "op": "15",
   "jp": "その前に聞いときたいんだが、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s392:01046",
   "op": "15",
   "jp": "この街では働けなくなった者を\nスラム街に押し込むって話は、\n本当なのか！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s392:010b2",
   "op": "15",
   "jp": "さてはゴモラの奴らに、\n何か吹き込まれましたね！！",
   "en": "",
   "box": "17x3",
   "face": 47
  },
  {
   "id": "s392:010f6",
   "op": "15",
   "jp": "確かに、スラムはありますが・・・",
   "en": "",
   "box": "17x3",
   "face": 47
  },
  {
   "id": "s392:0118a",
   "op": "15",
   "jp": "やっぱり弱者をいじめてるんだ！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s392:011fe",
   "op": "15",
   "jp": "何を言う！我が街のやり方に\nケチを付ける気かっ！？",
   "en": "",
   "box": "17x3",
   "face": 52
  },
  {
   "id": "s392:012d6",
   "op": "15",
   "jp": "最初から、働き口が無くて\n働けないんならまだしも、",
   "en": "",
   "box": "17x3",
   "face": 52
  },
  {
   "id": "s392:0132a",
   "op": "15",
   "jp": "やる気が無くて働かない\n怠け者達の面倒までは、\n見られないだろ！？",
   "en": "",
   "box": "17x3",
   "face": 52
  },
  {
   "id": "s392:013e2",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s392:0140e",
   "op": "15",
   "jp": "こいつら、さてはゴモラの\n連中に丸め込まれたんだ！！",
   "en": "",
   "box": "17x3",
   "face": 52
  },
  {
   "id": "s392:01456",
   "op": "15",
   "jp": "こうなったら力づくで、\nみんなやっちまえ！！",
   "en": "",
   "box": "17x3",
   "face": 52
  },
  {
   "id": "s392:0151e",
   "op": "15",
   "jp": "ま、待て！みんな！！",
   "en": "",
   "box": "17x3",
   "face": 47
  }
 ]
}
