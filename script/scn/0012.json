{
 "source": "d1:SCENARIO/12",
 "copies": [
  "d1:SCENARIO/12",
  "d2:SCENARIO/12"
 ],
 "strings": [
  {
   "id": "s12:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s12:0060e",
   "op": "15",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00632",
   "op": "15",
   "jp": "よかった！\nあ！ふん！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:0066a",
   "op": "15",
   "jp": "全く、アンタはアタシに\nどれだけ心配させれば気がすむの！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:006b6",
   "op": "15",
   "jp": "十ヶ月以上も寝込まれたら\nこっちがたまらないわ！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:006fa",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s12:00722",
   "op": "15",
   "jp": "えっ、何？\nまだどこか痛むの！？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00756",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s12:00782",
   "op": "15",
   "jp": "まっ、まさか・・・\nアンタ、アタシの事を\n忘れたわけじゃ？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:007de",
   "op": "15",
   "jp": "えっ！？\nまさか自分のことまで・・・？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00826",
   "op": "15",
   "jp": "アンタの名前は・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:008ca",
   "op": "15",
   "jp": "どうやらようやく思いだしたようね。じゃあ、アタシの名前は？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00992",
   "op": "15",
   "jp": "そう、よぉく覚えておきなさい、\nアタシがアンタの飼い主よ！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:009ee",
   "op": "15",
   "jp": "でも良かった・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00a22",
   "op": "15",
   "jp": "あ、アタシは飼い主として\n心配してただけ、\nただそれだけよ！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00a72",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s12:00a9e",
   "op": "15",
   "jp": "ここはアタシと奴隷のアンタの\nふたりだけの家。",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00ade",
   "op": "15",
   "jp": "他には誰もいやしないわ！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00b0a",
   "op": "15",
   "jp": "アンタは事故で大ケガをしたのよ！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00b4a",
   "op": "15",
   "jp": "まぁ？！\n覚えていないっていうの？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00b8e",
   "op": "15",
   "jp": "雨の日に雷が落ちて、\n傷の手当はしたけど、\nずっと眠ったまま・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00bf2",
   "op": "15",
   "jp": "全く、世話のやける！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00c1e",
   "op": "14",
   "jp": "・・・・！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s12:00d36",
   "op": "15",
   "jp": "背中の羽？\nそれがどうしたっていうのよ！？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00d72",
   "op": "15",
   "jp": "誰にでも生えてる物じゃない！\nアンタにも、アタシにも・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00dc2",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s12:00dea",
   "op": "15",
   "jp": "ホントに忘れちゃったのね、\nもう、世話がやけるんだから！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00e42",
   "op": "15",
   "jp": "ふん、まぁいいわ・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00e6a",
   "op": "15",
   "jp": "アンタが全てを思い出すまで、\nアタシが付き合ってあげるわ。",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00ec6",
   "op": "15",
   "jp": "でも早く思い出しなさいね！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00f02",
   "op": "15",
   "jp": "アンタのこと、そして・・・\nアタシ達のことを・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s12:00f9e",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "",
   "max": 15
  },
  {
   "id": "s12:00fb4",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "",
   "max": 15
  }
 ]
}
