 "strings": [
  {
   "id": "s349:007ce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s349:007ea",
   "op": "15",
   "jp": "なぁマルコ・・・",
   "en": ""
  },
  {
   "id": "s349:0080e",
   "op": "15",
   "jp": "みんなはお前の事を個性が無いって\n苛めてるみたいだけど・・・・",
   "en": ""
  },
  {
   "id": "s349:0085e",
   "op": "15",
   "jp": "俺は別段そうは思わないぜ！",
   "en": ""
  },
  {
   "id": "s349:008fe",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s349:0092a",
   "op": "15",
   "jp": "お前はみんなと仲良くしたいし、",
   "en": ""
  },
  {
   "id": "s349:0095a",
   "op": "15",
   "jp": "誰にも嫌われたくないと\n思ってるだけなんだよな",
   "en": ""
  },
  {
   "id": "s349:0099e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s349:009ca",
   "op": "15",
   "jp": "多分・・そいつは太古の昔に失われた協調性とかっていうやつで・・・・",
   "en": ""
  },
  {
   "id": "s349:00a1e",
   "op": "15",
   "jp": "それこそがお前の\n個性だと思うんだ。",
   "en": ""
  },
  {
   "id": "s349:00a56",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s349:00a7a",
   "op": "15",
   "jp": "俺も「誰かが誰かを支配する」\nっていう考え方は\nどこか間違っていると思うし、",
   "en": ""
  },
  {
   "id": "s349:00ada",
   "op": "15",
   "jp": "だいいち、俺はそういうお前を・・\n結構気に入ってるんだぜ！",
   "en": ""
  }
 ]
}
