{
 "source": "d1:SCENARIO/383",
 "copies": [
  "d1:SCENARIO/383",
  "d2:SCENARIO/383"
 ],
 "strings": [
  {
   "id": "s383:0086a",
   "op": "15",
   "jp": "ほう、\nこの街の街並は・・・",
   "en": ""
  },
  {
   "id": "s383:00906",
   "op": "15",
   "jp": "実に無理なく自然と調和して\n作られておるのう！！",
   "en": ""
  },
  {
   "id": "s383:0097a",
   "op": "15",
   "jp": "ええ、機能的で\n実に無駄がないですね。",
   "en": ""
  },
  {
   "id": "s383:009e6",
   "op": "15",
   "jp": "しかしその分、\n冷たい印象がありますね！",
   "en": ""
  },
  {
   "id": "s383:00aae",
   "op": "15",
   "jp": "おい、あっちにいるのは\n街の連中じゃねぇか？",
   "en": ""
  },
  {
   "id": "s383:0111a",
   "op": "15",
   "jp": "ようこそ、\n我らがゴモラの街へ！",
   "en": ""
  },
  {
   "id": "s383:0114e",
   "op": "15",
   "jp": "親愛なる同志、\n救世主御一行！！",
   "en": ""
  },
  {
   "id": "s383:01182",
   "op": "15",
   "jp": "私がこの街の代表、\nベルフェと申します！！",
   "en": ""
  },
  {
   "id": "s383:01216",
   "op": "15",
   "jp": "ケルビム殿から連絡を受け、\n皆様が来るのを\n心待ちにしておりました！！",
   "en": ""
  },
  {
   "id": "s383:01296",
   "op": "15",
   "jp": "どうです？\nゴモラの街はすばらしいでしょう？",
   "en": ""
  },
  {
   "id": "s383:012d6",
   "op": "15",
   "jp": "この街では全ての人が\n街のために働いているから、",
   "en": ""
  },
  {
   "id": "s383:0133e",
   "op": "15",
   "jp": "このような調和のとれた\n街並みになるのです！",
   "en": ""
  },
  {
   "id": "s383:0137e",
   "op": "15",
   "jp": "当然、羽の色に関係なく\n学校や病院といった施設が、\n全て無料になっています！",
   "en": ""
  },
  {
   "id": "s383:013de",
   "op": "15",
   "jp": "ささっ！どうぞこちらへ\n街をご案内いたしましょう！！",
   "en": ""
  }
 ]
}
