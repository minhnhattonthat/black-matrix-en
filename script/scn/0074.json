{
 "source": "d1:SCENARIO/74",
 "copies": [
  "d1:SCENARIO/74",
  "d2:SCENARIO/74"
 ],
 "strings": [
  {
   "id": "s74:003a2",
   "op": "15",
   "jp": "おおっと！\n問題の奴隷が、\n帰ってきたようですね！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s74:0044e",
   "op": "15",
   "jp": "か、彼を・・・\n彼の手を離しなさい！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:00496",
   "op": "15",
   "jp": "我々とて同じ黒い羽のアナタに\n手荒な真似などしたくはない\nのですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:004ee",
   "op": "15",
   "jp": "お嬢さん！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:0050a",
   "op": "15",
   "jp": "ただ・・・\nアナタがどうしても奴隷を、\n奴隷らしく扱わず・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:0055a",
   "op": "15",
   "jp": "首輪もつけずに、\n放し飼いにし続けると\nいうのであれば・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:005aa",
   "op": "15",
   "jp": "彼には死んでもらう事に\nなりますねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:005e6",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:0060a",
   "op": "15",
   "jp": "だいいち周りに聞いた噂によると、\n奴隷をペットとして\n猫っ可愛がりするにしても、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:0066e",
   "op": "15",
   "jp": "服まで着せるなんて\nやりすぎじゃあないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:006c2",
   "op": "15",
   "jp": "た、確かにアンタ達にとっては\nただの奴隷・・・ペットかも\nしれないけど・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:00722",
   "op": "15",
   "jp": "私にとっては・・・\nか、彼はそんなんじゃないわ！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:00776",
   "op": "15",
   "jp": "そりゃ自分の奴隷に\n執着心を持つのは勝手だが！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s74:007c6",
   "op": "15",
   "jp": "なるほど！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:007e6",
   "op": "15",
   "jp": "人から貰った時には\n気にいらなかったコップが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00826",
   "op": "15",
   "jp": "毎日使っているうちに、\nだんだん良い物に思えてくるという\nアレですか！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:0088e",
   "op": "15",
   "jp": "ちがうっ！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:008ba",
   "op": "15",
   "jp": "私は、私は彼を\n愛・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:008f2",
   "op": "15",
   "jp": "あっ！！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s74:0090e",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s74:00932",
   "op": "15",
   "jp": "愛だとぉ～！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s74:00952",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:0096e",
   "op": "15",
   "jp": "それは俗に、\nこの世界でも恋と呼ばれる\n人間の発情期の勘違いですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:009c6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:009f2",
   "op": "15",
   "jp": "発情期に入るとどんな動物でも\n動ξが激しくなって\n頭に血が上り・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00a4a",
   "op": "15",
   "jp": "ときおり訳の分からない事を\n叫んで見たりするものです。",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00a92",
   "op": "15",
   "jp": "だったらそれこそ、\nアナタが彼を\n好きにすればいいんです！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00ae2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s74:00b0e",
   "op": "15",
   "jp": "自分が奴隷に対して\n欲情した事を\n恥じてはいけませんよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00b5a",
   "op": "15",
   "jp": "誰かに欲情するという事は・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00b8a",
   "op": "15",
   "jp": "全ての動物にとって\n種族の保存に繋がる\n根元的な行為なのです！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00bda",
   "op": "15",
   "jp": "だいいちそんな・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00c02",
   "op": "15",
   "jp": "愛などという、\n実際にはこの世にはありもしない\n妄想を口にすることが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00c5a",
   "op": "15",
   "jp": "七つの大罪の一つである事を\nアナタはご存じないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s74:00cb6",
   "op": "15",
   "jp": "貴方達のいうように、\n私の想いは一方的な物かもしれない。",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:00d02",
   "op": "15",
   "jp": "でも・・・！\nそれがどんなに罪深くても\n私は・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s74:00d46",
   "op": "15",
   "jp": "私は彼を、\n愛してるのよ！！",
   "en": "",
   "box": "17x3",
   "face": 11
  }
 ]
}
