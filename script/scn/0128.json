{
 "source": "d1:SCENARIO/128",
 "copies": [
  "d1:SCENARIO/128",
  "d2:SCENARIO/128"
 ],
 "strings": [
  {
   "id": "s128:00576",
   "op": "15",
   "jp": "俺の名はレブロブス",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:0059a",
   "op": "15",
   "jp": "シャバに居た時には、\n最強の白き羽、なんて\n呼ばれた事もあったがな・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:005f6",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:0061e",
   "op": "15",
   "jp": "お前もこの待合室に\n入れられたって事は・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:0065e",
   "op": "15",
   "jp": "俺と同じ七つの大罪を\n犯した死刑囚なんだろう？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:006b6",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:006da",
   "op": "15",
   "jp": "なんだ！知らなかったのか？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00706",
   "op": "15",
   "jp": "この場所は、\n生けにえの待合室と呼ばれる、\n死刑囚達の吹き溜まりなんだぜ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:0082a",
   "op": "15",
   "jp": "そこのデカブツさんよ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00852",
   "op": "15",
   "jp": "「知る者は言わず、言う者は知らず」　って言葉、知ってるかい？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:008a2",
   "op": "15",
   "jp": "真実なんてものは・・・\nいつも事件の当事者は、\n知らねぇ方が幸せなもんさ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:009c6",
   "op": "15",
   "jp": "なんだてめぇは！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:009fa",
   "op": "15",
   "jp": "俺の名はガイウス！\n人は俺を疾風のガイと呼ぶ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00a8e",
   "op": "15",
   "jp": "さては貴様！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00ad2",
   "op": "15",
   "jp": "貧乏人から正義の味方だなどと\nおだてられ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00b12",
   "op": "15",
   "jp": "二百人以上もの権力者の家を\n襲っては斬殺を繰り返し・・・、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00b5e",
   "op": "15",
   "jp": "あまつさえ、その盗んだ金を、\nくだらない貧乏人どもに\nめぐんで歩いたって噂の・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00bc2",
   "op": "15",
   "jp": "あの偽善者のガイか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00bfa",
   "op": "15",
   "jp": "仰ぎて天に恥じず。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00c1e",
   "op": "15",
   "jp": "本来捕まりさえしなければ\n盗みも殺しも黒き羽の連中が\n賞賛している行いさ・・・！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00c82",
   "op": "15",
   "jp": "問題は俺の羽の色が白だという\n現実があるだけにすぎん・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00cce",
   "op": "15",
   "jp": "俺は今まで自分の行動を\n少しも恥じた事はねぇ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00d0e",
   "op": "15",
   "jp": "だが、俺も前に聞いた事があるぜ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00d42",
   "op": "15",
   "jp": "パンデモニウムの街に居た\n奴隷の分際で、自分の主人である\n領主をも殺し・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00da2",
   "op": "15",
   "jp": "この世には、初めから\nありもしない、自由とか言う物を\n追い求めてさまよい歩く、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00e02",
   "op": "15",
   "jp": "腕力バカの逃亡奴隷、\nレブロブスとか言う\n世間知らずの名前をな！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:00ede",
   "op": "15",
   "jp": "なんだと、貴様ぁ～！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:00f16",
   "op": "15",
   "jp": "うるさいぞ、貴様ら！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s128:0250e",
   "op": "15",
   "jp": "だいたいこの房の警備をするはずの\nピリポのバカはどこにいるんだ！？",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:025fe",
   "op": "15",
   "jp": "ボクは・・ここにいます！",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s128:026b2",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:026ca",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:026e2",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:02bba",
   "op": "15",
   "jp": "きさまっ！\nまた脅えて隠れてやがったのか！？",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:02bfa",
   "op": "15",
   "jp": "てめぇはどうして\nそう臆病者なんだ！？",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:02c32",
   "op": "15",
   "jp": "こっちまでイラついちまうぜ！",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:02e0a",
   "op": "15",
   "jp": "あのピリポって看守はよぉ、\n生まれついての臆病者なんで、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:02e56",
   "op": "15",
   "jp": "他の看守達から、いつも\n手ひどく虐められてるのさ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:02e9e",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:02ec6",
   "op": "15",
   "jp": "ちっ！弱虫野郎め！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:02eee",
   "op": "15",
   "jp": "いつもいいようにやられやがって、\n虫酸が走るぜ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:02f9a",
   "op": "15",
   "jp": "フッ、黒い羽を持つ奴らに\nとっちゃあ、弱者である事自体が、\nすでに罪深い事なのさ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:03002",
   "op": "15",
   "jp": "俺達は牢獄に入れられるような\n犯罪者だが、あの弱虫のピリポに\n比べりゃ、百倍はマシかもな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:03096",
   "op": "15",
   "jp": "流石は七つの大罪を\nあえて犯すような・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s128:030d2",
   "op": "15",
   "jp": "モラルの低い極悪人どもね！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s128:0310e",
   "op": "15",
   "jp": "このプラハ様が獄長を務める\n牢獄内で騒ぎ立てるとは・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:0315a",
   "op": "15",
   "jp": "いい度胸してるじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:0319e",
   "op": "15",
   "jp": "ぐわっはっはははっ！！\n気分はどうかね？諸君！",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:03a96",
   "op": "15",
   "jp": "けっ！\n殺すんならさっさと殺しやがれ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:03b42",
   "op": "15",
   "jp": "殺せですって？！\nふん！世の中殺されるより・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03b92",
   "op": "15",
   "jp": "あえて生き続けなければ\nいけない事の方が\nよっぽど、苦しみが多いものよ！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03bee",
   "op": "15",
   "jp": "それに、今この瞬間にも飢餓や戦さで世界中の人間が何百万人もボロクズのように死んでいっている・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03c6e",
   "op": "15",
   "jp": "人の命なんて・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03ca2",
   "op": "15",
   "jp": "ましてやオマエ達、白き羽の奴隷の\n命なんて・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03ce6",
   "op": "15",
   "jp": "パン一枚の価値すら\n無いというのに・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03d22",
   "op": "15",
   "jp": "アンタ達が死刑なんて\n軽い刑罰で・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03d5a",
   "op": "15",
   "jp": "すまされるわけがないじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03d8e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:03dba",
   "op": "15",
   "jp": "正義・・・？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03dda",
   "op": "15",
   "jp": "自由？？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03df6",
   "op": "15",
   "jp": "あげくに愛ですって・・・？！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03e26",
   "op": "15",
   "jp": "この世のどこを探せば、\nそんな物が有るって言うのよ？！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03e72",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:03e9e",
   "op": "15",
   "jp": "中でも愛なんていう目に見えない\n最大の偽善を、自分の飼い主に\n信じ込ませ・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03efe",
   "op": "15",
   "jp": "破滅の道に追い込んだアンタの罪は、万死に値するわ！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03f76",
   "op": "15",
   "jp": "看守兵！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03f92",
   "op": "15",
   "jp": "これ以上、彼らが騒がないよう\nしっかり見張っておきなさい！！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s128:03ffe",
   "op": "15",
   "jp": "あれだけの大罪を犯しておいて、\n簡単に殺してもらおうとは・・・",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:0404e",
   "op": "15",
   "jp": "それは虫が良すぎるというもの。",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:0407e",
   "op": "15",
   "jp": "諸君らは大悪神を封じ込める\n生けにえとして、無限に続く\n地獄の苦しみを味わうのだ！",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:040e2",
   "op": "15",
   "jp": "愛や自由などと、たわごとを語る\n愚か者よ！",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:0411e",
   "op": "15",
   "jp": "身に余る待遇を、\n我に感謝するが良い！\nぐわっはっはっはっはっ！",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:04172",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:041ba",
   "op": "15",
   "jp": "看守兵！",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:041d6",
   "op": "15",
   "jp": "これ以上この者らが騒がんよう\nしっかり見張っておけ！！",
   "en": "",
   "box": "17x3",
   "face": 34
  },
  {
   "id": "s128:04fe6",
   "op": "15",
   "jp": "いいか、生けにえども！！",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:05012",
   "op": "15",
   "jp": "この奥の独房には、お前達など、\n本来なら足下にも及ばないような、",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:05066",
   "op": "15",
   "jp": "やんごとなき身分のお方が、\n入っていらっしゃるのだ！",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:050ae",
   "op": "15",
   "jp": "これ以上、騒ぎ立てるようなら、\n容赦はせんぞ！！",
   "en": "",
   "box": "17x3",
   "face": 35
  },
  {
   "id": "s128:0567a",
   "op": "15",
   "jp": "けっ！\nやんごとなきお方だとぉ～？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:056ae",
   "op": "15",
   "jp": "くだらねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:0574a",
   "op": "15",
   "jp": "そういやぁ聞いた事がある・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:0577a",
   "op": "15",
   "jp": "確か何年か前に、\n太陽の神殿と呼ばれる神殿の\n大神官が権力争いに敗れ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:057d6",
   "op": "15",
   "jp": "このゴルゴダの牢獄の中に\n閉じこめられたって噂だ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:0582a",
   "op": "15",
   "jp": "あぁっ？\n大神官だぁ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:05856",
   "op": "15",
   "jp": "神官がどれだけ\n偉ぇってんだ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s128:0588a",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:058a6",
   "op": "15",
   "jp": "そこの筋肉バカは\n知らねぇだろうが、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:058de",
   "op": "15",
   "jp": "黒き羽の連中は自分達を、\n神話の中に出てくる\n創世記戦争で勝ち残った、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:05936",
   "op": "15",
   "jp": "神の子孫だと考えてやがる。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:05966",
   "op": "14",
   "jp": "・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s128:0598e",
   "op": "15",
   "jp": "そんな黒き羽の連中の中でも、\n特に大神官と呼ばれる奴らは、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s128:059da",
   "op": "15",
   "jp": "神々に最も近い存在として、\n驚異と戦りつの対象だ。",
