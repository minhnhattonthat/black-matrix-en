 "strings": [
  {
   "id": "s175:00772",
   "op": "15",
   "jp": "神官達の動きが気になる。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s175:0079e",
   "op": "15",
   "jp": "悪いが、\n俺は別行動をとらせてもらうぜ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s175:0086a",
   "op": "15",
   "jp": "うむ、\n神殿の中は入り組んでおる。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s175:0089e",
   "op": "15",
   "jp": "ルピルピ、\n一緒についていってやりなさい。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s175:00952",
   "op": "15",
   "jp": "え～っ、\nこの嫌みなキザ男とですかぁ～。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s175:009ca",
   "op": "15",
   "jp": "なんだとこいつ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s175:00a5e",
   "op": "15",
   "jp": "爺さん、俺は一人でも大丈夫だ。\nこんな女はかえって\n足手まといだぜ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s175:00aea",
   "op": "15",
   "jp": "そう言うな。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s175:00b46",
   "op": "15",
   "jp": "ルピルピも、コラ！\n日記に書くんじゃない！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s175:00b92",
   "op": "15",
   "jp": "喧嘩するほど仲が悪い\nって言うことかな？",
   "en": "",
   "box": "17x3",
   "face": 3
  }
 ]
}
