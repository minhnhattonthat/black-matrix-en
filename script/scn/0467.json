{
 "source": "d1:SCENARIO/467",
 "copies": [
  "d1:SCENARIO/467",
  "d2:SCENARIO/467"
 ],
 "strings": [
  {
   "id": "s467:00c72",
   "op": "15",
   "jp": "どうやらここに居る限り、\n奴らとの戦いは避けられねぇ\nみてぇだな。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:00cc6",
   "op": "15",
   "jp": "早いとこ、\nこの塔の上まで登って、\nここから出るしか無さそうだぜ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:00d1e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:00d3e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:00dd2",
   "op": "15",
   "jp": "どう考えてもワナの臭いが\nぷんぷんするぜ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:00e82",
   "op": "15",
   "jp": "爺さん、あんたこの先\nオレ達をどうするつもりだ！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:00eca",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:00ef6",
   "op": "15",
   "jp": "みんなはまだ、この黒い羽の\n爺さんの道案内を\n信用する気でいるのか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:00f4e",
   "op": "14",
   "jp": "・・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:00f72",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:00f9e",
   "op": "15",
   "jp": "だけど、さっきのバカ女が\n言ってた話を、本当に鵜呑みに\nしちまってもいいのか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:01126",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:0119a",
   "op": "15",
   "jp": "だけどそれじゃあ、\n誰の言う事を信じれば\n良いのかな？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:011e6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01212",
   "op": "15",
   "jp": "結局、信じられるのは、\n己自身の判断力のみって事だな。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:0126a",
   "op": "15",
   "jp": "僕は、僕はこの世界の真実を\nこの目で確かめ、",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:012aa",
   "op": "15",
   "jp": "虐げられた人々を救う道を\n模索する事！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:01342",
   "op": "15",
   "jp": "それこそが\nこの旅の目的なんです！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:0137a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s467:01432",
   "op": "15",
   "jp": "弱虫のボクは・・・\nもし、みんなと逢えなかったら",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:01476",
   "op": "15",
   "jp": "きっと今でもあの薄暗い牢屋で\n何も出来ずにずっと震えてたよ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:014fa",
   "op": "15",
   "jp": "ボクはあんまり頭が良くないから\n難しいことはよく分かんないけど、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:0157e",
   "op": "15",
   "jp": "愛って、愛って言うものが\nどんなものなのか、ずっと・・・\nずっとそれが知りたかったんだ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:015ee",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s467:0162a",
   "op": "15",
   "jp": "だけど、それって結局・・・\n教団のやってる事と、\nいっしょじゃないのかしら！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:017fa",
   "op": "15",
   "jp": "愛を求めて、\n自由を求めて、",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:018d6",
   "op": "15",
   "jp": "一見、教団の教えに\n背いてはいるけど、\nその目的のために何をしたのよ！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:0193e",
   "op": "15",
   "jp": "自分の欲しいものの為に闘う\nなんて、",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01976",
   "op": "15",
   "jp": "アイツ等のやり方と\n何も変わらないじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:019ba",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:019e2",
   "op": "15",
   "jp": "その目的の為に・・・\n私達は人だって殺したのよ！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01a5a",
   "op": "15",
   "jp": "それなのに・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01a7e",
   "op": "15",
   "jp": "私はただお師匠さまの役に\n立ちたかっただけ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01af2",
   "op": "15",
   "jp": "それ以外はどうでも良かったのよ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01b26",
   "op": "15",
   "jp": "真理なんて本当は\nもうどうでもいいの！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01d8a",
   "op": "15",
   "jp": "あっ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:01db2",
   "op": "15",
   "jp": "それは違うぞ・・・\nルピルピ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01df2",
   "op": "15",
   "jp": "何故なら、\n彼らは本能に忠実なのでは無く・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01e32",
   "op": "15",
   "jp": "あくまでも、\n自分の信ずる信念に\n忠実なのじゃから・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01e7e",
   "op": "15",
   "jp": "人を救う事が罪になる\nこの世界で・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01eb6",
   "op": "15",
   "jp": "自分の力のみが\n頼りのこの世界で・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01eee",
   "op": "15",
   "jp": "人が、自分の信念を\n追求しようとしたとして、\n何を恥じらうことがあろう！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:01f4e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:0205e",
   "op": "15",
   "jp": "フッ、考えてみりゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:0208a",
   "op": "15",
   "jp": "俺達は\nこんなことも話さないまま、\nここまで旅してきたんだなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:02136",
   "op": "15",
   "jp": "だけどよ爺さん、\nオレは少なくともアンタのことを\nまだ信用出来たわけじゃねえんだ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:021c2",
   "op": "15",
   "jp": "結局オレだってテメェらの事を\n利用してただけに過ぎないんだぜ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:02212",
   "op": "15",
   "jp": "そんなのが、\n仲間だなんて言えるのかよ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:0225a",
   "op": "15",
   "jp": "俺も、同感だな。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:0229a",
   "op": "15",
   "jp": "ガイさんまで、何を言うんです！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:022da",
   "op": "15",
   "jp": "甘いなお坊ちゃん！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:022fe",
   "op": "15",
   "jp": "ここにいるみんなは、\n助け合って生きているとでも\n思ったか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:0235a",
   "op": "15",
   "jp": "もちろんです！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:0238a",
   "op": "15",
   "jp": "違うな！\n俺達が行動を共にする理由は何だ？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:023c6",
   "op": "15",
   "jp": "そう、生き延びるためだよ！\nお前だってみんなを利用してきたに\n過ぎないんじゃないのか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:0243e",
   "op": "15",
   "jp": "！！",
   "en": "!!",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:02472",
   "op": "15",
   "jp": "ガイとレブロブスの\n言うとおりじゃなぁ・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:024ee",
   "op": "15",
   "jp": "ヨハネさん！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s467:025c6",
   "op": "15",
   "jp": "じゃが、わしはお主等にひとつ\n聞きたいことがある。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:0260a",
   "op": "15",
   "jp": "結局みな、それぞれ自分は\nどうしたいのじゃ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:0264a",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s467:0266e",
   "op": "15",
   "jp": "わしがどうであろうと、\n皆一人一人求めるものが\nあるのじゃろう・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:026c6",
   "op": "15",
   "jp": "それとも何か・・・？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:026ee",
   "op": "15",
   "jp": "この集まり自体が、\n自らの求めるものであれば良い\nなどと考えておったのか？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:0274e",
   "op": "14",
   "jp": "！！",
   "en": "!!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:02772",
   "op": "15",
   "jp": "生き抜きたいのであろう！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:0279e",
   "op": "15",
   "jp": "誰かを救いたいのであろう！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:027ca",
   "op": "15",
   "jp": "それとも、これまでお主達が\nやってきたことは、お主達が\n自らを否定する様なものなのか？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:02832",
   "op": "15",
   "jp": "もう一度聞こう、\nお主達はどうしたいのじゃ？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:02872",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s467:028ce",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s467:0293e",
   "op": "15",
   "jp": "はっ、そうだな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02992",
   "op": "15",
   "jp": "俺達は、\n一人一人じゃどうしようもねぇ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:029ce",
   "op": "15",
   "jp": "結局、バラバラになっちまっちゃ\nやりたいこともままならねぇんだ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02a5e",
   "op": "15",
   "jp": "ちっ、やっぱそうなるのかよ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s467:02a9a",
   "op": "15",
   "jp": "さすがはこの爺さん、\n長いこと大神官を務めていた\nだけのことはありやがる。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02b2a",
   "op": "15",
   "jp": "気をつけてねぇと、\nうまく煙にまかれそうだ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02b86",
   "op": "15",
   "jp": "爺さん、\n今度はオレから質問するぜ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02bbe",
   "op": "15",
   "jp": "真実は、この上にあるんだな！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02bfe",
   "op": "15",
   "jp": "ああ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:02c36",
   "op": "15",
   "jp": "決まりだ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02c56",
   "op": "15",
   "jp": "ここに居ても始まらねぇ！\nこの世界そのものに、\n俺達の想いをぶつけてやる！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s467:02cc6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:02d72",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s467:02db6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s467:02dfa",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s467:02e3e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s467:02e82",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s467:02ec6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s467:03112",
   "op": "15",
   "jp": "ルピルピよ・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:03136",
   "op": "15",
   "jp": "わしは先刻ガイに、\n真実はこの上にあると言ったが・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:0317e",
   "op": "15",
   "jp": "だがしかし、それは少し\n間違っておるのかもしれん。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:031c2",
   "op": "15",
   "jp": "真実はすでに・・・\nもう、それぞれの心の中に\nあるのではないかな！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:0321a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s467:03256",
   "op": "15",
   "jp": "さぁ、行くぞ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s467:03276",
   "op": "15",
   "jp": "わし等はまだ、\nこの世界の行き着く先を\n見届けてはおらんのだ！",
   "en": "",
   "box": "17x3",
   "face": 5
  }
 ]
}
