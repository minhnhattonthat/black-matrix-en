 "strings": [
  {
   "id": "s544:0152a",
   "op": "15",
   "jp": "我らはすでに・・・",
   "en": "We have already...",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s544:0154e",
   "op": "15",
   "jp": "この黒き聖母の体内で・・・",
   "en": "within this Black Madonna's body...",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s544:0157a",
   "op": "15",
   "jp": "完全なるかつての記憶を\n取り戻しました！！",
   "en": "regained our former memories, complete!!",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s544:015ca",
   "op": "14",
   "jp": "つまり今の私達は・・・・\nこの世界の、唯一の神に\n忠実に仕えし・・・、",
   "en": "In other words, we are now.... faithful servants of this world's one and only God...,",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s544:01618",
   "op": "14",
   "jp": "完全なる大天使！！",
   "en": "perfect archangels!!",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s544:016ca",
   "op": "14",
   "jp": "！！",
   "en": "!!",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s544:016ee",
   "op": "15",
   "jp": "なっ、何をするんじゃ！？",
   "en": "Wh-what are you doing, eh!?",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s544:01726",
   "op": "15",
   "jp": "どうやらこの宇宙を創られし\n唯一の神である",
   "en": "It seems the one God who created this universe...",
   "box": "17x3",
   "face": 61
  },
  {
   "id": "s544:01762",
   "op": "15",
   "jp": "創造主の御心は・・・・",
   "en": "the Creator himself....",
   "box": "17x3",
   "face": 61
  },
  {
   "id": "s544:0178a",
   "op": "15",
   "jp": "この世界全体の\n新たなる創造にあるようです",
   "en": "wishes to create this entire world anew",
   "box": "17x3",
   "face": 61
  },
  {
   "id": "s544:017e6",
   "op": "15",
   "jp": "ば・・ばかな！\nそんな事をしたら・・！！",
   "en": "Th-that's absurd! If you do that...!!",
   "box": "17x3",
   "face": 5
  }
 ]
