 ],
 "strings": [
  {
   "id": "s66:00282",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s66:0039e",
   "op": "15",
   "jp": "最近は顔色もいいし、\n食欲もバッチリだね！",
   "en": ""
  },
  {
   "id": "s66:003da",
   "op": "15",
   "jp": "すっかり元気になって・・・！",
   "en": ""
  },
  {
   "id": "s66:0040a",
   "op": "15",
   "jp": "ボクもうれしいよ！",
   "en": ""
  },
  {
   "id": "s66:0042e",
   "op": "15",
   "jp": "だけど・・・\nいつかはキミが\n言い出すんじゃないかと・・・",
   "en": ""
  },
  {
   "id": "s66:0047a",
   "op": "15",
   "jp": "そう思ってはいたんだけど・・・",
   "en": ""
  },
  {
   "id": "s66:004aa",
   "op": "15",
   "jp": "やっぱり・・・\nそろそろ外へ出たい？",
   "en": ""
  },
  {
   "id": "s66:004ee",
   "op": "15",
   "jp": "（でも、ボクの気持ちも・・・）",
   "en": ""
  },
  {
   "id": "s66:0052e",
   "op": "15",
   "jp": "ご免！！",
   "en": ""
  },
  {
   "id": "s66:0054a",
   "op": "15",
   "jp": "キミを縛ることなんて\n誰にもできないもんね・・・",
   "en": ""
  },
  {
   "id": "s66:0058e",
   "op": "15",
   "jp": "本当に外に出たい！？",
   "en": ""
  },
  {
   "id": "s66:005c2",
   "op": "1d",
   "jp": "外へ出たい！",
   "en": "",
   "max": 15
  },
  {
   "id": "s66:005d8",
   "op": "1d",
   "jp": "外へ出たくない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s66:0060e",
   "op": "15",
   "jp": "そ、そうだよね・・・\nキミが記憶を早く取り戻すためにも、",
   "en": ""
  },
  {
   "id": "s66:0065a",
   "op": "15",
   "jp": "それに・・・\nキミはボクの駕ρの鳥なんかじゃ、",
   "en": ""
  },
  {
   "id": "s66:0069a",
   "op": "15",
   "jp": "無いもんね・・・",
   "en": ""
  },
  {
   "id": "s66:006be",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s66:006ea",
   "op": "15",
   "jp": "で、でもね！\n外に出るんなら・・・\nこれだけは覚えておいてね・・・",
   "en": ""
  },
  {
   "id": "s66:0073e",
   "op": "15",
   "jp": "街にはいろんな人達が居るけど、\n羽の色が黒い人達には乱暴な人が\n多いから・・・",
   "en": ""
  },
  {
   "id": "s66:0079e",
   "op": "15",
   "jp": "くれぐれも気を付けて・・・",
   "en": ""
  },
  {
   "id": "s66:007ce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s66:007fa",
   "op": "15",
   "jp": "それから・・・",
   "en": ""
  },
  {
   "id": "s66:0081a",
   "op": "15",
   "jp": "このネックレスはボクからの\nお守りだと思って・・・",
   "en": ""
  },
  {
   "id": "s66:0085e",
   "op": "15",
   "jp": "必ず身に着けておいて！",
   "en": ""
  },
  {
   "id": "s66:008b2",
   "op": "15",
   "jp": "そ・・そうだよね！\nまだ早いよね。",
   "en": ""
  },
  {
   "id": "s66:008e6",
   "op": "15",
   "jp": "まったく～！！",
   "en": ""
  },
  {
   "id": "s66:00906",
   "op": "15",
   "jp": "もう・・・\n心配させちゃやだよぉ～！",
   "en": ""
  },
  {
   "id": "s66:0093e",
   "op": "15",
   "jp": "ああよかった・・・！",
   "en": ""
  },
  {
   "id": "s66:00966",
   "op": "15",
   "jp": "なんだかキミと離ればなれに\nなりそうな、悪い予感がして・・・",
   "en": ""
  },
  {
   "id": "s66:009b6",
   "op": "15",
   "jp": "ちょっと心配だったんだ・・・！",
   "en": ""
  },
  {
   "id": "s66:009e6",
   "op": "15",
   "jp": "でも、\nもしも外に出たくなったら・・・",
   "en": ""
  }
 ]
}
