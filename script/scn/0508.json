{
 "source": "d1:SCENARIO/508",
 "copies": [
  "d1:SCENARIO/508",
  "d2:SCENARIO/508"
 ],
 "strings": [
  {
   "id": "s508:008b6",
   "op": "15",
   "jp": "なっ、なんだ！\n今の馬鹿でかい音は！？",
   "en": ""
  },
  {
   "id": "s508:008fe",
   "op": "15",
   "jp": "今まさに、\nこの世界全体を支える、",
   "en": ""
  },
  {
   "id": "s508:00932",
   "op": "15",
   "jp": "６本目の封印の鎖が、\n解き放たれました！！",
   "en": ""
  },
  {
   "id": "s508:00b22",
   "op": "15",
   "jp": "だれだ、この声は？",
   "en": ""
  },
  {
   "id": "s508:00b66",
   "op": "15",
   "jp": "私はこの世界で唯一",
   "en": ""
  },
  {
   "id": "s508:00b8a",
   "op": "15",
   "jp": "神と呼ばれる者の御言葉を、\n伝える事が出来る、",
   "en": ""
  },
  {
   "id": "s508:00bca",
   "op": "15",
   "jp": "アンゲルス教の教皇にして、\n黒き聖母と呼ばれる者！！",
   "en": ""
  },
  {
   "id": "s508:00c12",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s508:00c3e",
   "op": "15",
   "jp": "アナタ方は、\nそれほどまでに",
   "en": ""
  },
  {
   "id": "s508:00c6e",
   "op": "15",
   "jp": "この世界を破滅させたいの\nですか！？",
   "en": ""
  },
  {
   "id": "s508:00cc2",
   "op": "15",
   "jp": "天界の玉座にある７つの封印が\n解かれない限り・・・",
   "en": ""
  },
  {
   "id": "s508:00d06",
   "op": "15",
   "jp": "世界は悪しき状態のままに\n継続するが・・・",
   "en": ""
  },
  {
   "id": "s508:00d42",
   "op": "15",
   "jp": "神の子羊が順次その封印を\n解いたとき・・・",
   "en": ""
  },
  {
   "id": "s508:00d7e",
   "op": "15",
   "jp": "様々な災いや死、\n闘争などが\n世界中へと広がり・・・",
   "en": ""
  },
  {
   "id": "s508:00dc6",
   "op": "15",
   "jp": "地上は未曾有の混乱と災厄に\n見舞われる・・・",
   "en": ""
  },
  {
   "id": "s508:00e06",
   "op": "15",
   "jp": "人類の終末を予言する・・・\nハルマゲドンと呼ばれる、\n有名な予言書の一節です・・・",
   "en": ""
  },
  {
   "id": "s508:00e6e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s508:00e9a",
   "op": "15",
   "jp": "その窓から地上をよく\n見てご覧なさい！！",
   "en": ""
  },
  {
   "id": "s508:00ed6",
   "op": "15",
   "jp": "アナタ方が、鎧の封印を解き\nはじめて以来・・・",
   "en": ""
  },
  {
   "id": "s508:00f16",
   "op": "15",
   "jp": "地上には干ばつ・冷害・大地震\n噴火や津波といった、\nありとあらゆる災害が広がり・・・",
   "en": ""
  },
  {
   "id": "s508:0102e",
   "op": "15",
   "jp": "さらには、この非常時につけ込んだ、革命組織とやらが暴動を起こし・・・",
   "en": ""
  },
  {
   "id": "s508:01092",
   "op": "15",
   "jp": "今や地上では白と黒の羽を\n２分する大戦争にまで・・・",
   "en": ""
  },
  {
   "id": "s508:010e6",
   "op": "15",
   "jp": "事態は発展しています！！",
   "en": ""
  },
  {
   "id": "s508:01122",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s508:01162",
   "op": "15",
   "jp": "おおっ！我らが\n大神・サタン様の御言葉を、\n教皇様が告げておられるぞ！！",
   "en": ""
  },
  {
   "id": "s508:011ca",
   "op": "15",
   "jp": "なんとお懐かしい・・・",
   "en": ""
  },
  {
   "id": "s508:01202",
   "op": "15",
   "jp": "おおっ！！\nこの神々しいお声を聞いて、",
   "en": ""
  },
  {
   "id": "s508:0123a",
   "op": "15",
   "jp": "我々は、かつての大天使だった頃の\n記憶を取り戻せたのだ！！",
   "en": ""
  },
  {
   "id": "s508:01296",
   "op": "15",
   "jp": "そうだ！！",
   "en": ""
  },
  {
   "id": "s508:012b2",
   "op": "15",
   "jp": "我らは、たとえそのご尊顔を\n拝謁することが出来なくとも",
   "en": ""
  },
  {
   "id": "s508:0130a",
   "op": "15",
   "jp": "アタシ達には、いつでも",
   "en": ""
  },
  {
   "id": "s508:01332",
   "op": "15",
   "jp": "大神サタン様の\nご加護が付いているのよ！！",
   "en": ""
  },
  {
   "id": "s508:0159a",
   "op": "15",
   "jp": "ぐ、\nぐあぁぁぁぁぁぁっ！！",
   "en": ""
  },
  {
   "id": "s508:015e6",
   "op": "15",
   "jp": "グフッ・・・",
   "en": ""
  },
  {
   "id": "s508:01606",
   "op": "15",
   "jp": "たまたま勝ったからって・・・\n安心しないでほしいわねぇ・・・",
   "en": ""
  },
  {
   "id": "s508:01656",
   "op": "15",
   "jp": "アタシ達に・・・\nこの大天使の鎧があるかぎり・・・",
   "en": ""
  },
  {
   "id": "s508:0169a",
   "op": "15",
   "jp": "また、何度でも・・・\n復活・・してみせるわ！！",
   "en": ""
  },
  {
   "id": "s508:01a52",
   "op": "15",
   "jp": "それはわしらとて、\n同じ事じゃ・・・",
   "en": ""
  },
  {
   "id": "s508:01a8a",
   "op": "15",
   "jp": "わしの中で今も生きる、\nルピルピと同じようにな・・・",
   "en": ""
  }
 ]
}
