 "strings": [
  {
   "id": "s292:00bda",
   "op": "15",
   "jp": "突然のことで\n失礼とは存じますが、",
   "en": ""
  },
  {
   "id": "s292:00c0e",
   "op": "15",
   "jp": "あなた様が有名な\nヨハネ様でございますか！？",
   "en": ""
  },
  {
   "id": "s292:00c4e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s292:00c7a",
   "op": "15",
   "jp": "この街の領主であらせられる\nバアル様が、あなた様方をぜひ、",
   "en": ""
  },
  {
   "id": "s292:00cc6",
   "op": "15",
   "jp": "お食事にご招待したいと\n申しております。",
   "en": ""
  },
  {
   "id": "s292:00d0e",
   "op": "15",
   "jp": "むう・・・・",
   "en": ""
  },
  {
   "id": "s292:00d2e",
   "op": "15",
   "jp": "たとえワナだったにせよ\nどの道、領主の館には\nいかねばなるまい・・・",
   "en": ""
  },
  {
   "id": "s292:00d92",
   "op": "15",
   "jp": "「虎穴に入らずんば」\nと言う事か！？",
   "en": ""
  },
  {
   "id": "s292:00de2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  }
 ]
