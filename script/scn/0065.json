{
 "source": "d1:SCENARIO/65",
 "copies": [
  "d1:SCENARIO/65",
  "d2:SCENARIO/65"
 ],
 "strings": [
  {
   "id": "s65:00282",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s65:0039e",
   "op": "15",
   "jp": "最近は顔色もいいし、\n食欲もばっちりだね、\nおにいちゃん！",
   "en": ""
  },
  {
   "id": "s65:003ea",
   "op": "15",
   "jp": "すっかり元気になってゴーゴー！！",
   "en": ""
  },
  {
   "id": "s65:0042a",
   "op": "15",
   "jp": "あたしもすっごく嬉しいよ・・・\nエヘヘ・・・",
   "en": ""
  },
  {
   "id": "s65:00476",
   "op": "15",
   "jp": "だけど・・・\nいつかは言い出すんじゃないかと、",
   "en": ""
  },
  {
   "id": "s65:004b6",
   "op": "15",
   "jp": "そうは思ってはいたんだけど・・・",
   "en": ""
  },
  {
   "id": "s65:004ea",
   "op": "15",
   "jp": "やっぱり・・・",
   "en": ""
  },
  {
   "id": "s65:0050a",
   "op": "15",
   "jp": "おにいちゃんは外へ出たい！？",
   "en": ""
  },
  {
   "id": "s65:00546",
   "op": "15",
   "jp": "そうだよね・・・",
   "en": ""
  },
  {
   "id": "s65:00576",
   "op": "15",
   "jp": "おにいちゃんを縛ることなんて、\n誰にもできやしないんだもん！",
   "en": ""
  },
  {
   "id": "s65:005c6",
   "op": "15",
   "jp": "外に出るのだって、\nおにいちゃんの自由・・・",
   "en": ""
  },
  {
   "id": "s65:00612",
   "op": "15",
   "jp": "でも、ねぇおにいちゃん！！",
   "en": ""
  },
  {
   "id": "s65:0064e",
   "op": "15",
   "jp": "（あ・・あたしの気持ちも・・・！）",
   "en": ""
  },
  {
   "id": "s65:00692",
   "op": "15",
   "jp": "ごめんね・・おにいちゃん！",
   "en": ""
  },
  {
   "id": "s65:006be",
   "op": "15",
   "jp": "本当に・・・外に出たい！？",
   "en": ""
  },
  {
   "id": "s65:006fa",
   "op": "1d",
   "jp": "外へ出たい！",
   "en": "",
   "max": 15
  },
  {
   "id": "s65:00710",
   "op": "1d",
   "jp": "外へ出たくない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s65:00746",
   "op": "15",
   "jp": "そ・・そうだよね・・・",
   "en": ""
  },
  {
   "id": "s65:0076e",
   "op": "15",
   "jp": "お・おにいちゃんが・・・\n早く思い出を取り戻すためにも、",
   "en": ""
  },
  {
   "id": "s65:007c6",
   "op": "15",
   "jp": "それに・・・",
   "en": ""
  },
  {
   "id": "s65:007e6",
   "op": "15",
   "jp": "色々見といた方が、\n良いかもしれないね・・・",
   "en": ""
  },
  {
   "id": "s65:00826",
   "op": "15",
   "jp": "おにいちゃんは・・・",
   "en": ""
  },
  {
   "id": "s65:0084e",
   "op": "15",
   "jp": "あたしのペットなんかじゃ\n無いんだもん・・・・",
   "en": ""
  },
  {
   "id": "s65:00892",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s65:008be",
   "op": "15",
   "jp": "でもね、おにいちゃん・・・",
   "en": ""
  },
  {
   "id": "s65:008fa",
   "op": "15",
   "jp": "お外に出るんなら、\nこれだけは、おぼえといて欲しいの、",
   "en": ""
  },
  {
   "id": "s65:00942",
   "op": "15",
   "jp": "街にはいろんな人が居るけど、\n羽の色が黒い人たちには乱暴な人が\n多いから・・・",
   "en": ""
  },
  {
   "id": "s65:009a2",
   "op": "15",
   "jp": "おにいちゃんは、\n特に気を付けてね！！",
   "en": ""
  },
  {
   "id": "s65:009de",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s65:00a0a",
   "op": "15",
   "jp": "それから、\nこのネックレスをあたしだと思って、",
   "en": ""
  },
  {
   "id": "s65:00a4a",
   "op": "15",
   "jp": "かならず身に着けておいてね！",
   "en": ""
  },
  {
   "id": "s65:00a7a",
   "op": "15",
   "jp": "や・約束だよ！\nね、おにいちゃん！！",
   "en": ""
  },
  {
   "id": "s65:00ada",
   "op": "15",
   "jp": "そうだよね・・・！！\n外に出るのは・・・まだ早いよね！",
   "en": ""
  },
  {
   "id": "s65:00b32",
   "op": "15",
   "jp": "ああ、よかったぁあぁぁあ！！",
   "en": ""
  },
  {
   "id": "s65:00b6e",
   "op": "15",
   "jp": "なんだか・・・おにいちゃんと\n離れ離れになりそうな気がして、\nちょっと・・・",
   "en": ""
  },
  {
   "id": "s65:00bce",
   "op": "15",
   "jp": "ううぅん！とっても心配だったの！",
   "en": ""
  },
  {
   "id": "s65:00c0e",
   "op": "15",
   "jp": "（でも・・・もしもおにいちゃん\n　外に出たくなったら・・・）",
   "en": ""
  },
  {
   "id": "s65:00c6a",
   "op": "15",
   "jp": "もう・・・\n心配させちゃあ・・・嫌だよぉ！",
   "en": ""
  },
  {
   "id": "s65:00cb6",
   "op": "15",
   "jp": "ふひゃええぇえぇえぇえぇぇえん！！",
   "en": ""
  }
 ]
}
