 "strings": [
  {
   "id": "s166:009ee",
   "op": "15",
   "jp": "こうなっては仕方がありません・・・こちらも召喚魔法で！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:00b92",
   "op": "15",
   "jp": "やはり！！",
   "en": "",
   "box": "17x3",
   "face": 30
  },
  {
   "id": "s166:00cf6",
   "op": "15",
   "jp": "やはりお主ルピルピではないか！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:00d76",
   "op": "15",
   "jp": "お師匠様・・・？",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:00d9a",
   "op": "15",
   "jp": "本当に・・・お師匠様なのですか？！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:00e66",
   "op": "15",
   "jp": "やはりルピルピであったか・・・\nすまぬ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:00eae",
   "op": "15",
   "jp": "二度とお主に、合わせる顔など・・\n無いと言うのに・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:00f16",
   "op": "15",
   "jp": "しっ・・しかし、\nこんな所で何を！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:00f5a",
   "op": "15",
   "jp": "ユダ殿に言われて、\nお尋ね者を倒すようにと、",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:00fd6",
   "op": "15",
   "jp": "そうであったか・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:00ffe",
   "op": "15",
   "jp": "やはりわし等は、\n戦わねばならんのか・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:0106a",
   "op": "15",
   "jp": "ちょっと、\nちょっとお師匠さま！！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:0109e",
   "op": "15",
   "jp": "もう、\n失礼しちゃうなぁ～！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:010ce",
   "op": "15",
   "jp": "昔っから私の気持ちを、\nちっとも理解してくれて\nないんだから！！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:01122",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:0114e",
   "op": "15",
   "jp": "言うまでもありません！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:01176",
   "op": "15",
   "jp": "私の知識は、\nいつでも、お師匠様の知識と\n共にあります！！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:011d4",
   "op": "14",
   "jp": "ルピルピが仲間になった！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s166:0120e",
   "op": "15",
   "jp": "しかし、お師匠さま。",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:01236",
   "op": "15",
   "jp": "私が帰らないと、\nユダはすぐにもこちらに、\n追っ手を向かわせる筈です！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:0129e",
   "op": "15",
   "jp": "迷うことはねぇ！！\nそんな奴ら返り討ちにしてやる！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s166:01322",
   "op": "15",
   "jp": "本当に良いのか？\nルピルピよ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s166:01362",
   "op": "15",
   "jp": "あらあら、それこそ愚問ですわ、\nお師匠さま！！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:0145e",
   "op": "15",
   "jp": "ルピルピ殿、\nこれはいったいどういうことです。",
   "en": "",
   "box": "17x3",
   "face": 37
  },
  {
   "id": "s166:014be",
   "op": "15",
   "jp": "お師匠さまが帰られたのです、\n弟子の私が同行するのは、\n当たり前のこと！",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:015ca",
   "op": "15",
   "jp": "ユダ様を\n裏切るおつもりか！",
   "en": "",
   "box": "17x3",
   "face": 37
  },
  {
   "id": "s166:01606",
   "op": "15",
   "jp": "もともと私はユダの仲間になど、\nなったつもりはありません。",
   "en": "",
   "box": "17x3",
   "face": 31
  },
  {
   "id": "s166:01682",
   "op": "15",
   "jp": "愚かな・・・",
   "en": "",
   "box": "17x3",
   "face": 37
  },
  {
   "id": "s166:016a2",
   "op": "15",
   "jp": "ならばここで殺してやろう！",
   "en": "",
   "box": "17x3",
   "face": 37
  }
 ]
}
