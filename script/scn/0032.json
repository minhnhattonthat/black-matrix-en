{
 "source": "d1:SCENARIO/32",
 "copies": [
  "d1:SCENARIO/32",
  "d2:SCENARIO/32"
 ],
 "strings": [
  {
   "id": "s32:00030",
   "op": "14",
   "jp": "○月×日　雨",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00044",
   "op": "14",
   "jp": "冷たい雨が降っている・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00066",
   "op": "14",
   "jp": "今日で５ヶ月・・・\nまだお前は目覚めない・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0009c",
   "op": "14",
   "jp": "お前の体を拭くたびに、\n浮き出た鎖骨が、俺の目をつく・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:000de",
   "op": "14",
   "jp": "俺と一緒に過ごした日々は・・・\nお前にとって幸せだったのか・・・？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00128",
   "op": "14",
   "jp": "俺の声は届いているのか・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0014c",
   "op": "14",
   "jp": "お前に想いは届いているのか・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00174",
   "op": "14",
   "jp": "お前と過ごした幾多の日々が、\n凍てつくような雨を、\n今夜も降らせる・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:001c4",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "19x3"
  },
  {
   "id": "s32:001f8",
   "op": "14",
   "jp": "△月○日　雨",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0020c",
   "op": "14",
   "jp": "昨夜から続いた熱は、\nなんとかおさまったようだ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00248",
   "op": "14",
   "jp": "俺の口の中にも、苦い薬が広がる・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00274",
   "op": "14",
   "jp": "後で知ったら、お前は嫌がるのかも\nしれないな・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:002ae",
   "op": "14",
   "jp": "暖炉で暖めても、どうにもならない程に\n冷え切ったお前の体とは裏腹に・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:002fe",
   "op": "14",
   "jp": "額の熱さは、お前の瞳のようだった・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0032c",
   "op": "14",
   "jp": "お前の虚ろな瞳の中には、\n俺しか映っていなくて・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0036a",
   "op": "14",
   "jp": "いや、むしろ俺の姿は\n写っていなかったのかも知れない・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:003ac",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "19x3"
  },
  {
   "id": "s32:003c0",
   "op": "14",
   "jp": "本当に・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:003d4",
   "op": "14",
   "jp": "いつまでこんな日が続けば\nお前は目覚めるんだ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0042c",
   "op": "14",
   "jp": "◇月◎日　曇り",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00442",
   "op": "14",
   "jp": "ここ１ヶ月も降り続いた雨が、\nようやくあがった・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0047e",
   "op": "14",
   "jp": "お前の病状も、\nようやく落ち着きを取り戻し、\n安定した日々が続いている。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:004ce",
   "op": "14",
   "jp": "だがそれでもお前の目には\n俺の姿は写っていない・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0050c",
   "op": "14",
   "jp": "薄暗い部屋の中で、\n息を殺したように眠るお前には・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0054a",
   "op": "14",
   "jp": "この日常が、\nどんな意味を持っているかなんて・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00584",
   "op": "14",
   "jp": "きっと分かりはしないだろう・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:005ac",
   "op": "14",
   "jp": "だが、そのほうがかえって俺も、\n気が楽かもしれないな・・・？！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:005f2",
   "op": "14",
   "jp": "もしもお前が覚えていて、\n俺に・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0061e",
   "op": "14",
   "jp": "バカバカしい！なにを考えてるんだ\n俺は・・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00678",
   "op": "14",
   "jp": "□月×日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0068e",
   "op": "14",
   "jp": "最近のお前は・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:006a8",
   "op": "14",
   "jp": "すっかり元気に\nなってきたみたいだ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:006d8",
   "op": "14",
   "jp": "今日は久しぶりの快晴だったので、\n溜まっていた洗濯物を干すことも、\n出来たし、晴れやかな気分だ・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00748",
   "op": "14",
   "jp": "今日はお前も洗い立てのシャツに、\n太陽の匂いがするシーツで、\n気分がいいんじゃないのか・・・？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:007ae",
   "op": "14",
   "jp": "夏はすぐそこだし",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:007c6",
   "op": "14",
   "jp": "なぁ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:007d8",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "19x3"
  },
  {
   "id": "s32:007ec",
   "op": "14",
   "jp": "そろそろ起きてもいいころだぜ！？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00834",
   "op": "14",
   "jp": "○月■日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0084a",
   "op": "14",
   "jp": "ここのところ、",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00860",
   "op": "14",
   "jp": "お前が寝返りをうつほどまでに、\n回復してきているから・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:008a2",
   "op": "14",
   "jp": "かえって俺は夜も寝れない・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:008ca",
   "op": "14",
   "jp": "俺が寝てる間にお前が眼を\n覚ますんじゃないかと思って・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0090c",
   "op": "14",
   "jp": "バカみたいだろ！？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00926",
   "op": "14",
   "jp": "毎日同じ事の繰り返しさ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:0094a",
   "op": "14",
   "jp": "それでも・・・\n俺は結構楽しんでるんだぜ・・・！？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:00984",
   "op": "14",
   "jp": "お前の顔色が良くなるたびに・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s32:009ac",
   "op": "14",
   "jp": "あしたこそお前の声を\n聞けるんじゃないかと思って・・・！",
   "en": "",
   "box": "19x3"
  }
 ]
}
