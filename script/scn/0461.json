  {
   "id": "s461:000ce",
   "op": "15",
   "jp": "悪魔の海峡\nその海原を割き進み、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:0016e",
   "op": "15",
   "jp": "冥界の門、天国の門\nそれぞれの封印を解いた一行は、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:001b2",
   "op": "15",
   "jp": "ついに約束の地ディアボロスへと繋がる",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:001ea",
   "op": "15",
   "jp": "バベルの塔の内部へと侵入した。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:00262",
   "op": "15",
   "jp": "しかしその場所で彼らが見たものは、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:00296",
   "op": "15",
   "jp": "何千何万というおびただしい数の、\n魂を搾り取るようなうめき声と",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:002e6",
   "op": "15",
   "jp": "ヨハネに向けられた、\n仲間達の疑惑の眼差しであった。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:00356",
   "op": "15",
   "jp": "初めて投げかけられた小さな石は、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:0038a",
   "op": "15",
   "jp": "やがてはクサビとなって、\n水面に大きな波紋を拡げ・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s461:003d2",
   "op": "15",
   "jp": "ついには濁流となって、\n大海へと流れ出すのであろうか？",
