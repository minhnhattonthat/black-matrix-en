 ],
 "strings": [
  {
   "id": "s484:007c2",
   "op": "15",
   "jp": "あなたなら・・・\n何かこの世界について\n知っているのでしょう！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s484:008d2",
   "op": "15",
   "jp": "・・・・\n太陽とこの世界について\n語るべき事など知らぬ・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s484:00922",
   "op": "15",
   "jp": "お前達が自ら苦しんでいる事を\n知っているだけだ・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s484:0096a",
   "op": "15",
   "jp": "もっとも・・・\nこれも・奴の・・\n受け売りだがな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s484:01fb2",
   "op": "15",
   "jp": "これがアンゲルス教団の\n総本山、教皇庁！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s484:01ffe",
   "op": "15",
   "jp": "ここに、\nこの世界の真実が！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s484:0203a",
   "op": "15",
   "jp": "ユダやバアルの野郎も\nこの先にいるに違ぇねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s484:0208a",
   "op": "15",
   "jp": "そう！\nケルビムさんにどうしても会って、\n真偽を確かめなきゃ！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s484:0215a",
   "op": "15",
   "jp": "お主はルカ、あ、いや\nあのリリスを追うのじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s484:0219e",
   "op": "15",
   "jp": "あ奴の行く先に、\nお主の探す御主人様のいる\n可能性が高い！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s484:021fa",
   "op": "15",
   "jp": "それに上手くすれば・・・\nあの女が教皇の所まで・・・\n連れてってくれるぜ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s484:0225a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s484:024a2",
   "op": "15",
   "jp": "アタシもお供します！！",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s484:024ca",
   "op": "15",
   "jp": "少しでも、ご主人様に・・・\nご恩をお返ししたいんです！",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s484:025e6",
   "op": "15",
   "jp": "あたしも連れていって下さい・・・\nお金を拾うことぐらいしかお役に\n立てないかも知れませんけど",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s484:0272a",
   "op": "15",
   "jp": "ご主人様！！",
   "en": "",
   "box": "17x3",
   "face": 109
  },
  {
   "id": "s484:0274a",
   "op": "15",
   "jp": "私の力を・・・、\nこの際ぜひお役立て下さい！",
   "en": "",
   "box": "17x3",
   "face": 109
  },
  {
   "id": "s484:0285e",
   "op": "15",
   "jp": "なぁ～ご主人様～！！\nおらもついて行かせておくれよ！",
   "en": "",
   "box": "17x3",
   "face": 110
  },
  {
   "id": "s484:0297a",
   "op": "15",
   "jp": "私も・・・\nぜひ旅の道づれにお加え下さい！！",
   "en": "",
   "box": "17x3",
   "face": 111
  },
  {
   "id": "s484:02a8e",
   "op": "15",
   "jp": "この老いぼれにも・・・\nまだこの世界のために、\nやれる事があるはずじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s484:02bbe",
   "op": "15",
   "jp": "なんだか・・・！\n金になりそうな匂いがするぜ！",
   "en": "",
   "box": "17x3",
   "face": 108
  },
  {
   "id": "s484:02cd2",
   "op": "15",
   "jp": "ご主人様ぁ～あたしも～\nつれてってくださ～い～！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s484:02dea",
   "op": "15",
   "jp": "ネェネェ～いいよねぇ～\nついてっいっても・・・",
   "en": "",
   "box": "17x3",
   "face": 23
  },
  {
   "id": "s484:02efe",
   "op": "15",
   "jp": "アナタをお役に・・・\nたたせて差し上げるのが\n私の仕事です・・・",
   "en": "",
   "box": "17x3",
   "face": 24
  },
  {
   "id": "s484:03026",
   "op": "15",
   "jp": "あたし？\nあたしは勝手についてきま～す！！",
   "en": "",
   "box": "17x3",
   "face": 25
  },
  {
   "id": "s484:03136",
   "op": "15",
   "jp": "私もご一緒させて下さい・・・",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s484:03166",
   "op": "15",
   "jp": "ごめんなさいレブロブス様・・・",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s484:0326a",
   "op": "15",
   "jp": "ねぇねえご主人様～！！\nいいでしょ！？ついてっても・・・",
   "en": "",
   "box": "17x3",
   "face": 27
  },
  {
   "id": "s484:0338a",
   "op": "15",
   "jp": "今こそ、ご恩を・・・\nお返しさせていただきます！！",
   "en": "",
   "box": "17x3",
   "face": 28
  },
  {
   "id": "s484:033f2",
   "op": "15",
   "jp": "私は・・・・\n古の盟約に従うだけだ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s484:0352a",
   "op": "15",
   "jp": "ようしわかった！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s484:0354e",
   "op": "15",
   "jp": "急げ、奴らの行動が気になる！",
   "en": "",
   "box": "17x3",
   "face": 5
  }
 ]
}
