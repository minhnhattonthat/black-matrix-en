 ],
 "strings": [
  {
   "id": "s265:00a82",
   "op": "15",
   "jp": "くっ、貴様らごとき貧乏人に\nよもやアレを使う事になるとは！",
   "en": ""
  },
  {
   "id": "s265:00ade",
   "op": "15",
   "jp": "なんじゃと！？",
   "en": ""
  },
  {
   "id": "s265:00b3a",
   "op": "15",
   "jp": "な、何、大邪神の鎧っ！？",
   "en": ""
  },
  {
   "id": "s265:00b72",
   "op": "15",
   "jp": "しかも、誰かが既に装備してますわ！",
   "en": ""
  },
  {
   "id": "s265:00c06",
   "op": "15",
   "jp": "おいジジイ、話が違うぜ！！",
   "en": ""
  },
  {
   "id": "s265:00c32",
   "op": "15",
   "jp": "あの鎧は誰にでも着れるのか？！",
   "en": ""
  },
  {
   "id": "s265:00c7e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s265:00cb6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s265:00cee",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s265:00d1a",
   "op": "15",
   "jp": "そんなことはありえん！！",
   "en": ""
  },
  {
   "id": "s265:00d46",
   "op": "15",
   "jp": "大邪神の鎧を着るためには・・\nまず、自らの羽を剥ぎ取る事が\n不可欠じゃし・・・",
   "en": ""
  },
  {
   "id": "s265:00da6",
   "op": "15",
   "jp": "またその力を使いこなすためには、\nこやつのように\n大邪神の力を示す・・・",
   "en": ""
  },
  {
   "id": "s265:00e3a",
   "op": "15",
   "jp": "特別な資質が、\n必要なはずなんじゃ！！",
   "en": ""
  },
  {
   "id": "s265:00ea6",
   "op": "15",
   "jp": "そんな人、ボクがこの近くに\n住んで居た頃には・・・",
   "en": ""
  },
  {
   "id": "s265:00eea",
   "op": "15",
   "jp": "いなかったよ！！",
   "en": ""
  },
  {
   "id": "s265:00f1a",
   "op": "15",
   "jp": "おそらくあの二人の体・・・\nただでは済まんぞ！！",
   "en": ""
  },
  {
   "id": "s265:00f9a",
   "op": "15",
   "jp": "ふっふっふっ、その程度の事で\nアイツらを倒せれば、うちも\n楽させて貰えるんやけどぉ！",
   "en": ""
  },
  {
   "id": "s265:01026",
   "op": "15",
   "jp": "（たとえマモンが殺られても、\n　邪神の鎧同士の戦いの力を\n　知ることは出来るはず！！）",
   "en": ""
  },
  {
   "id": "s265:010b6",
   "op": "15",
   "jp": "まあせいぜいがとこ、\nあんじょう気張りぃや！",
   "en": ""
  }
 ]
}
