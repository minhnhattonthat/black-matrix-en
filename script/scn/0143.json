{
 "source": "d1:SCENARIO/143",
 "copies": [
  "d1:SCENARIO/143",
  "d2:SCENARIO/143"
 ],
 "strings": [
  {
   "id": "s143:00626",
   "op": "15",
   "jp": "・・・なぜだ？！",
   "en": ""
  },
  {
   "id": "s143:0066e",
   "op": "15",
   "jp": "なぜアタシを殺さなかった？！",
   "en": ""
  },
  {
   "id": "s143:006aa",
   "op": "15",
   "jp": "なにせこやつは邪悪なる大邪神の\n生まれ変わりともいえる・・・",
   "en": ""
  },
  {
   "id": "s143:006fa",
   "op": "15",
   "jp": "救世主じゃからのう！",
   "en": ""
  },
  {
   "id": "s143:00722",
   "op": "15",
   "jp": "おそらくは、自分のご主人の\n姉だと名乗る人間を・・・",
   "en": ""
  },
  {
   "id": "s143:0076a",
   "op": "15",
   "jp": "簡単には殺す事などできん！！\nとかいう甘っちょろい感傷が\n原因じゃろうて・・・",
   "en": ""
  },
  {
   "id": "s143:007ce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:007fa",
   "op": "15",
   "jp": "それよりも、どうじゃ！？",
   "en": ""
  },
  {
   "id": "s143:0083a",
   "op": "15",
   "jp": "お主も、いっその事・・・\nわし等と一緒にお主の妹とやらを\n助けに向かわぬか！？",
   "en": ""
  },
  {
   "id": "s143:008a2",
   "op": "15",
   "jp": "お主も、いっその事・・・\nわし等と一緒にお主の弟とやらを\n助けに向かわぬか！？",
   "en": ""
  },
  {
   "id": "s143:0091a",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s143:0093e",
   "op": "15",
   "jp": "・・どのみちわし等に、この牢獄から脱走されてしまっては、立場上お主もそう長くは生きていられまいて・・・",
   "en": ""
  },
  {
   "id": "s143:009b6",
   "op": "15",
   "jp": "ならばいっそ・・・",
   "en": ""
  },
  {
   "id": "s143:009da",
   "op": "15",
   "jp": "わし等を利用して、自分の肉親を\n助け出して見せるのも、また一興！！",
   "en": ""
  },
  {
   "id": "s143:00a2e",
   "op": "15",
   "jp": "わし等とてお主を自分達の戦力\nとして存分に利用させてもらおう\nという・・・いわば取引じゃ！",
   "en": ""
  },
  {
   "id": "s143:00a9a",
   "op": "15",
   "jp": "どうじゃな、悪い話でもあるまい！？",
   "en": ""
  },
  {
   "id": "s143:00ad2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:00afe",
   "op": "15",
   "jp": "それにさっきのそぶりじゃあ、\nお前自身も・・・",
   "en": ""
  },
  {
   "id": "s143:00b3e",
   "op": "15",
   "jp": "愛とかいう邪教の教えを、\n心の底では信じたがってる\nみたいだったぜ！？",
   "en": ""
  },
  {
   "id": "s143:00bba",
   "op": "15",
   "jp": "なっ・・！？",
   "en": ""
  },
  {
   "id": "s143:00bce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:00bea",
   "op": "15",
   "jp": "解った・・・あくまでも・・・\n生き抜く為の取引としてなら、",
   "en": ""
  },
  {
   "id": "s143:00c36",
   "op": "15",
   "jp": "協力しよう・・・",
   "en": ""
  },
  {
   "id": "s143:00c9e",
   "op": "15",
   "jp": "おいおい！本気でこんな奴を仲間に\nする気かぁ・・・！？",
   "en": ""
  },
  {
   "id": "s143:00d3e",
   "op": "1d",
   "jp": "仲間にする",
   "en": "",
   "max": 15
  },
  {
   "id": "s143:00d50",
   "op": "1d",
   "jp": "仲間にしない",
   "en": "",
   "max": 15
  },
  {
   "id": "s143:00dca",
   "op": "15",
   "jp": "おいおい！本気かよ！？",
   "en": ""
  },
  {
   "id": "s143:00df2",
   "op": "15",
   "jp": "こんな奴と一緒じゃあ、\nいつ後ろから斬りつけられるか\n解ったもんじゃねえぜ！って・・・",
   "en": ""
  },
  {
   "id": "s143:00e7e",
   "op": "15",
   "jp": "よく考えたらそいつはそこの\nキザ野郎でも、変わりはねえか！",
   "en": ""
  },
  {
   "id": "s143:00ece",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:00eea",
   "op": "15",
   "jp": "解ったら、なるべく俺の前だけは\n歩かないようにする事だ！！",
   "en": ""
  },
  {
   "id": "s143:00f36",
   "op": "15",
   "jp": "だからって後ろも歩くんじゃねえぞ！",
   "en": ""
  },
  {
   "id": "s143:00f7a",
   "op": "15",
   "jp": "なんだとキサマぁ～！！",
   "en": ""
  },
  {
   "id": "s143:00fb8",
   "op": "14",
   "jp": "プラハが仲間になった！",
   "en": ""
  },
  {
   "id": "s143:01032",
   "op": "15",
   "jp": "なっ・・！？",
   "en": ""
  },
  {
   "id": "s143:01052",
   "op": "15",
   "jp": "ならばなぜ・・・アタシを助けた！",
   "en": ""
  },
  {
   "id": "s143:01086",
   "op": "15",
   "jp": "・・・・・解った！",
   "en": ""
  },
  {
   "id": "s143:010aa",
   "op": "15",
   "jp": "ならばアタシを助けたことを・・・\nいつの日か後悔するがいい・・・",
   "en": ""
  },
  {
   "id": "s143:010fe",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:019ae",
   "op": "15",
   "jp": "あっ！そう言えば",
   "en": ""
  },
  {
   "id": "s143:019d2",
   "op": "15",
   "jp": "この奥の独房の中に黒き羽の\n小さな女の子が閉じこめられてる\nって話を聞いた事が・・・",
   "en": ""
  },
  {
   "id": "s143:01a46",
   "op": "15",
   "jp": "なんだとぉ～？！",
   "en": ""
  },
  {
   "id": "s143:01a76",
   "op": "15",
   "jp": "何でもソコに入れられてる女の子は\nお肉屋さんに夜な夜な忍び込んでは\n大量の動物を盗み出して・・・",
   "en": ""
  },
  {
   "id": "s143:01aea",
   "op": "15",
   "jp": "自分の家まで、連れ帰っちゃってた\nらしいんだ・・・",
   "en": ""
  },
  {
   "id": "s143:01b3e",
   "op": "15",
   "jp": "だけどその程度の盗みなら、\n普通は捕まってその場で殺されて\n終わりだろうによぉ～！？",
   "en": ""
  },
  {
   "id": "s143:01bb2",
   "op": "15",
   "jp": "ところがその女の子は捕まった時に、お肉屋さんに逆に喰ってかかって・・",
   "en": ""
  },
  {
   "id": "s143:01c0a",
   "op": "15",
   "jp": "「動物を殺すのは可哀想！！」\nだなんて、とんでもないことを\n言っちゃったらしいんだ・・・！",
   "en": ""
  },
  {
   "id": "s143:01cca",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s143:01cee",
   "op": "15",
   "jp": "何だぁそりゃあ！？",
   "en": ""
  },
  {
   "id": "s143:01d12",
   "op": "15",
   "jp": "かっ可哀想って言ったって、\n殺さなきゃ肉なんか喰えねぇ\nじゃねえか～！？",
   "en": ""
  },
  {
   "id": "s143:01d6e",
   "op": "15",
   "jp": "そ・・そいつ相当・・・\nどっかおかしいんじゃねぇのか～！？",
   "en": ""
  },
  {
   "id": "s143:01dde",
   "op": "15",
   "jp": "どうする！？ココの独房の鍵も・・・開けた方がいいのかなぁ！？",
   "en": ""
  },
  {
   "id": "s143:01e3a",
   "op": "1d",
   "jp": "イエス",
   "en": "",
   "max": 15
  },
  {
   "id": "s143:01e48",
   "op": "1d",
   "jp": "ノー",
   "en": "",
   "max": 15
  },
  {
   "id": "s143:0219e",
   "op": "15",
   "jp": "ぷんぷんバキーーーン！！",
   "en": ""
  },
  {
   "id": "s143:0225e",
   "op": "15",
   "jp": "★●◎◇□☆♂♀▲▼☆",
   "en": ""
  },
  {
   "id": "s143:022ba",
   "op": "15",
   "jp": "とっ・・・突然なにしやがるんだ\nてめぇ・・・□☆♂♀！！",
   "en": ""
  },
  {
   "id": "s143:02312",
   "op": "15",
   "jp": "プリカどっこも・・・",
   "en": ""
  },
  {
   "id": "s143:0233a",
   "op": "15",
   "jp": "おかしくないモン！",
   "en": ""
  },
  {
   "id": "s143:0236e",
   "op": "15",
   "jp": "鳥さんも豚さんも、ヘビさんも\nカエルさんも、みんなあんなに\n可愛いのに・・・",
   "en": ""
  },
  {
   "id": "s143:023ce",
   "op": "15",
   "jp": "どうかしてるのは、みんなの方だよ！",
   "en": ""
  },
  {
   "id": "s143:0242a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:02446",
   "op": "15",
   "jp": "だけどな、お嬢ちゃん・・・",
   "en": ""
  },
  {
   "id": "s143:02472",
   "op": "15",
   "jp": "人に限らず動物は、他の動物の\n命を奪わなければ生きては\nいけない・・・",
   "en": ""
  },
  {
   "id": "s143:024ca",
   "op": "15",
   "jp": "罪深き生き物なんだ・・・",
   "en": ""
  },
  {
   "id": "s143:024f6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:02512",
   "op": "15",
   "jp": "お肉なんか食べなくても・・・\nみんなでコーンやブルーベリー\nなんか食べてれば・・・",
   "en": ""
  },
  {
   "id": "s143:02576",
   "op": "15",
   "jp": "プリカは平気だもん！！",
   "en": ""
  },
  {
   "id": "s143:025a2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s143:025ce",
   "op": "15",
   "jp": "（そりゃ、本当はハンバーグ\n　なんかも好きなんだけどさ・・・）",
   "en": ""
  },
  {
   "id": "s143:026c2",
   "op": "15",
   "jp": "それより、コイツどおすんだよ～？",
   "en": ""
  },
  {
   "id": "s143:02702",
   "op": "1d",
   "jp": "連れていく",
   "en": "",
   "max": 15
  },
  {
   "id": "s143:02714",
   "op": "1d",
   "jp": "置いていく",
   "en": "",
   "max": 15
  },
  {
   "id": "s143:027ea",
   "op": "15",
   "jp": "まあ確かに、こんな所にガキ一人で\n置いて行くわけにもいかないか・・・・・・って！？",
   "en": ""
  },
  {
   "id": "s143:0285e",
   "op": "15",
   "jp": "ぷんぷんボッカーーーン！！",
   "en": ""
  },
  {
   "id": "s143:02922",
   "op": "15",
   "jp": "★●◎◇□☆♂♀▲▼☆",
   "en": ""
  },
  {
   "id": "s143:0295a",
   "op": "15",
   "jp": "プリカ、ガキなんかじゃないもん！！ねぇ～おにいちゃ～ん！",
   "en": ""
  },
  {
   "id": "s143:029a6",
   "op": "14",
   "jp": "・・・・・・・・",
   "en": ""
  },
  {
   "id": "s143:029d6",
   "op": "15",
   "jp": "ねえねえ、おにいちゃん！\nプリカなんだか、おにいちゃんの事が気に入っちゃったからぁ・・・",
   "en": ""
  },
  {
   "id": "s143:02a4e",
   "op": "15",
   "jp": "特別に、おにいちゃんを・・・\nプリカの奴隷にしてあげるね！",
   "en": ""
  },
  {
   "id": "s143:02ab2",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s143:02ad6",
   "op": "15",
   "jp": "これからもぉ～～！",
   "en": ""
  },
  {
   "id": "s143:02afa",
   "op": "15",
   "jp": "ずうぅ～っと、プリカが\nおにいちゃんの事を\n守ってあげるから安心してね！",
   "en": ""
  },
  {
   "id": "s143:02b86",
   "op": "15",
   "jp": "なに色気づいてやがる！\nこの肉ドロボウが！！",
   "en": ""
  },
  {
   "id": "s143:02bea",
   "op": "15",
   "jp": "いつまでも子供なんか、\nつれて歩けるわけ・・っぁ！！",
   "en": ""
  },
  {
   "id": "s143:02c3e",
   "op": "15",
   "jp": "ぐるめったズバーーーン！！",
   "en": ""
  },
  {
   "id": "s143:02d02",
   "op": "15",
   "jp": "★●◎◇□☆♂♀▲▼☆",
   "en": ""
  },
  {
   "id": "s143:02d3a",
   "op": "15",
   "jp": "プリカ子供じゃないもん！！",
   "en": ""
  },
  {
   "id": "s143:02d66",
   "op": "15",
   "jp": "ねぇ～おにいちゃ～ん！",
   "en": ""
  },
  {
   "id": "s143:02d92",
   "op": "14",
   "jp": "・・・・・・・・",
   "en": ""
  },
  {
   "id": "s143:02dc4",
   "op": "14",
   "jp": "プリカが仲間になった！",
   "en": ""
  },
  {
   "id": "s143:02e86",
   "op": "15",
   "jp": "そうだよなぁ！",
   "en": ""
  },
  {
   "id": "s143:02ea6",
   "op": "15",
   "jp": "今は、そんなお荷物にかまってる\n場合じゃねえよなぁ！！",
   "en": ""
  },
  {
   "id": "s143:02eee",
   "op": "15",
   "jp": "さっさと武器になりそうな物でも\n探して・・・とっとと、ここから\nおさらばしようぜ！！",
   "en": ""
  },
  {
   "id": "s143:02f56",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s143:03596",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:035c2",
   "op": "15",
   "jp": "お主・・・\n泣いておるのか？",
   "en": ""
  },
  {
   "id": "s143:035f2",
   "op": "15",
   "jp": "不慮の事故とは言え、\nお主までお尋ね者に\nさせてしまったようじゃのう。",
   "en": ""
  },
  {
   "id": "s143:0367e",
   "op": "15",
   "jp": "そういうんじゃないんだ。",
   "en": ""
  },
  {
   "id": "s143:036aa",
   "op": "15",
   "jp": "弱虫だったボクが、\nあんな風に立ち向かうことが\n出来たなんて！",
   "en": ""
  },
  {
   "id": "s143:036fa",
   "op": "15",
   "jp": "なんだか・・嬉しくて！\nまるで・・・",
   "en": ""
  },
  {
   "id": "s143:03732",
   "op": "14",
   "jp": "・・・",
   "en": ""
  },
  {
   "id": "s143:0374a",
   "op": "15",
   "jp": "おい・・弱虫って、\nいったい誰の事だ？",
   "en": ""
  },
  {
   "id": "s143:03792",
   "op": "15",
   "jp": "己の正義にかなう事を知りながら、\n実行しない者を弱虫、と言う。",
   "en": ""
  },
  {
   "id": "s143:037e2",
   "op": "15",
   "jp": "恐れを知って・・・",
   "en": ""
  },
  {
   "id": "s143:03816",
   "op": "15",
   "jp": "恐れを知って、\nしかもそれを恐れざる者こそ",
   "en": ""
  },
  {
   "id": "s143:03852",
   "op": "15",
   "jp": "真の勇者也！",
   "en": ""
  },
  {
   "id": "s143:03872",
   "op": "15",
   "jp": "古より伝わる邪教の教えじゃな！\nそれならこういうのもあるぞ！",
   "en": ""
  },
  {
   "id": "s143:038c2",
   "op": "15",
   "jp": "勇気こそ、君よ！\nこれこそ男をも、女をも、\n最も美しく見せるもの也！",
   "en": ""
  },
  {
   "id": "s143:0391a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s143:03946",
   "op": "15",
   "jp": "お主の見せた勇気こそが、\nその姿を変えさせた\n真の正体なのかもしれんな！",
   "en": ""
  },
  {
   "id": "s143:039ae",
   "op": "15",
   "jp": "おもしれぇ！\nどのみち俺達ゃあ、\nお尋ね者の脱走犯だ！！",
   "en": ""
  },
  {
   "id": "s143:039fa",
   "op": "15",
   "jp": "一人で逃げても、\n追っ手の連中と戦いづらいだけ。",
   "en": ""
  },
  {
   "id": "s143:03a3e",
   "op": "15",
   "jp": "しばらくの間はちょいと\n手を組むしか無さそうだな！",
   "en": ""
  },
  {
   "id": "s143:03aae",
   "op": "15",
   "jp": "このさい爺さんに\n一言だけいっておくが・・・",
   "en": ""
  },
  {
   "id": "s143:03aee",
   "op": "15",
   "jp": "他の事はともかく、",
   "en": ""
  },
  {
   "id": "s143:03b12",
   "op": "15",
   "jp": "人のセリフを勝手に奪うなぁ～！！",
   "en": ""
  }
 ]
}
