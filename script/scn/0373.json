{
 "source": "d1:SCENARIO/373",
 "copies": [
  "d1:SCENARIO/373",
  "d2:SCENARIO/373"
 ],
 "strings": [
  {
   "id": "s373:0052e",
   "op": "14",
   "jp": "ここはこの街の産業を支える、\n回転式製鉄炉のある工場です。",
   "en": ""
  },
  {
   "id": "s373:00570",
   "op": "14",
   "jp": "これができたおかげで、今までの\n何倍もの強度を誇る鉄を、\n大量に作ることに成功しました。",
   "en": ""
  },
  {
   "id": "s373:005d0",
   "op": "14",
   "jp": "そのおかげで、すごいでしょう。\n隣の最新式繊維工場を見て下さい！",
   "en": ""
  },
  {
   "id": "s373:00618",
   "op": "14",
   "jp": "大地から吹き出す蒸気の力を\n利用して滑車を動かす、\n自動機械式なんですよ！",
   "en": ""
  },
  {
   "id": "s373:006a6",
   "op": "14",
   "jp": "どうです、この建物の巨大なこと！",
   "en": ""
  },
  {
   "id": "s373:006ce",
   "op": "14",
   "jp": "これほどのモノを作る技術は、\nここ以外どの街にもありません。",
   "en": ""
  },
  {
   "id": "s373:00712",
   "op": "14",
   "jp": "ここには、宿屋を造るんです。\nみんな一生懸命働いてるでしょう？",
   "en": ""
  },
  {
   "id": "s373:00758",
   "op": "14",
   "jp": "これも生まれや\n羽の色などにこだわらず、",
   "en": ""
  },
  {
   "id": "s373:00788",
   "op": "14",
   "jp": "優秀な人材に重要な仕事を\nしてもらった\nおかげなんです！！",
   "en": ""
  },
  {
   "id": "s373:00806",
   "op": "14",
   "jp": "この街は立派だろう、\n俺達が一生懸命働いた証しさ！",
   "en": ""
  },
  {
   "id": "s373:00840",
   "op": "14",
   "jp": "俺達は、羽の色に関係なく\n一緒になって働いた方が、",
   "en": ""
  },
  {
   "id": "s373:0087a",
   "op": "14",
   "jp": "街がこんなに立派になる\nことに気づいたのさ！",
   "en": ""
  },
  {
   "id": "s373:008ea",
   "op": "14",
   "jp": "ここじゃあ\n羽の色なんて関係ない！",
   "en": ""
  },
  {
   "id": "s373:00914",
   "op": "14",
   "jp": "働きに応じた\n収入が約束されるんだ。",
   "en": ""
  },
  {
   "id": "s373:00940",
   "op": "14",
   "jp": "探そうと思えば、\nいくらでも仕事はあるのに、",
   "en": ""
  },
  {
   "id": "s373:00974",
   "op": "14",
   "jp": "この街で働かないような奴等は、\nはっきり言ってクズだよ！！",
   "en": ""
  },
  {
   "id": "s373:009b6",
   "op": "14",
   "jp": "領主のスタンは、\nこの街一番の働き者だったんだ",
   "en": ""
  },
  {
   "id": "s373:009ec",
   "op": "14",
   "jp": "だからこそ、\n彼は領主に選ばれたんだよ！！",
   "en": ""
  },
  {
   "id": "s373:00a5a",
   "op": "14",
   "jp": "白い羽の私でも、この街では\n好きな職業に就けて、\n自由に働けるんです！",
   "en": ""
  },
  {
   "id": "s373:00aa8",
   "op": "14",
   "jp": "私はこの街に来るまでは奴隷として\n扱われていました・・・",
   "en": ""
  },
  {
   "id": "s373:00ae8",
   "op": "14",
   "jp": "前の街では、どんなに働いても\n収入はみんなご主人様が\n持っていってしまっていたんです。",
   "en": ""
  },
  {
   "id": "s373:00b46",
   "op": "14",
   "jp": "でも、このソドムの街では、\n働けば働いただけの努力が\n収入として約束され・・・",
   "en": ""
  },
  {
   "id": "s373:00b9c",
   "op": "14",
   "jp": "白い羽だからと言うだけで\nいわれもなく自分の稼ぎを\n奪われることもありません。",
   "en": ""
  },
  {
   "id": "s373:00bf2",
   "op": "14",
   "jp": "まるで、夢のようですわ！！",
   "en": ""
  },
  {
   "id": "s373:00c4e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s373:00c9a",
   "op": "14",
   "jp": "キサマ等・・・",
   "en": ""
  },
  {
   "id": "s373:00cb0",
   "op": "14",
   "jp": "さては、手配中の\n逃亡奴隷だな！？",
   "en": ""
  },
  {
   "id": "s373:00d62",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s373:00d70",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s373:00d80",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  },
  {
   "id": "s373:00dba",
   "op": "15",
   "jp": "この街には住人の誇りでもある\n常設の投票所があるんです。",
   "en": ""
  },
  {
   "id": "s373:00e06",
   "op": "15",
   "jp": "私もその投票で、\nこの街のみなさんから、\n公平に選ばれたんですよ！",
   "en": ""
  },
  {
   "id": "s373:00e5a",
   "op": "15",
   "jp": "この街の領主は、何か不正な\nことをすればすぐに、新しい者に\nとって代わられるのです。",
   "en": ""
  },
  {
   "id": "s373:00ec2",
   "op": "15",
   "jp": "なんと公平で\n素晴らしいことなのでしょう！",
   "en": ""
  },
  {
   "id": "s373:00efe",
   "op": "15",
   "jp": "おおっと、そうそう！",
   "en": ""
  },
  {
   "id": "s373:00f26",
   "op": "15",
   "jp": "ここが領主の館です。\nまぁ、今の私の住まいですがね！",
   "en": ""
  },
  {
   "id": "s373:00f6e",
   "op": "15",
   "jp": "さぁどうぞ\n中へお入りください。",
   "en": ""
  }
 ]
}
