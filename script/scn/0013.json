{
 "source": "d1:SCENARIO/13",
 "copies": [
  "d1:SCENARIO/13",
  "d2:SCENARIO/13"
 ],
 "strings": [
  {
   "id": "s13:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": ""
  },
  {
   "id": "s13:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": ""
  },
  {
   "id": "s13:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": ""
  },
  {
   "id": "s13:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": ""
  },
  {
   "id": "s13:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": ""
  },
  {
   "id": "s13:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": ""
  },
  {
   "id": "s13:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": ""
  },
  {
   "id": "s13:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": ""
  },
  {
   "id": "s13:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": ""
  },
  {
   "id": "s13:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": ""
  },
  {
   "id": "s13:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": ""
  },
  {
   "id": "s13:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": ""
  },
  {
   "id": "s13:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": ""
  },
  {
   "id": "s13:0060e",
   "op": "15",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s13:00632",
   "op": "15",
   "jp": "よかったな・・・！",
   "en": ""
  },
  {
   "id": "s13:00656",
   "op": "15",
   "jp": "もう目を覚まさないんじゃ\nないかと思ったぜ！",
   "en": ""
  },
  {
   "id": "s13:00696",
   "op": "15",
   "jp": "なにせ・・・\nもう十ヶ月以上も高熱を出して\n寝込んだままだったんだぜ！",
   "en": ""
  },
  {
   "id": "s13:006f2",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s13:0071a",
   "op": "15",
   "jp": "えっ・・\nどうした！\nまだどこか痛むのか！？",
   "en": ""
  },
  {
   "id": "s13:0075a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s13:00786",
   "op": "15",
   "jp": "まさか・・・\nオレの事を・・・\n忘れちまったのか！？",
   "en": ""
  },
  {
   "id": "s13:007ce",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s13:007f2",
   "op": "15",
   "jp": "まさか、自分のことまで・・・？",
   "en": ""
  },
  {
   "id": "s13:00832",
   "op": "15",
   "jp": "クッ！\nオマエの名前は・・・",
   "en": ""
  },
  {
   "id": "s13:008de",
   "op": "15",
   "jp": "そ、そうだ！！",
   "en": ""
  },
  {
   "id": "s13:008fe",
   "op": "15",
   "jp": "じゃあ、オレの名前は・・・？",
   "en": ""
  },
  {
   "id": "s13:009aa",
   "op": "15",
   "jp": "その通り・・・！\nとりあえず良かったぜ！",
   "en": ""
  },
  {
   "id": "s13:009e6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s13:00a12",
   "op": "15",
   "jp": "ここは、オマエとオレの家、\n他には誰もいないさ！！",
   "en": ""
  },
  {
   "id": "s13:00a56",
   "op": "15",
   "jp": "雨の日に雷が落ちて・・・\nオマエは事故で大ケガをしたんだ！",
   "en": ""
  },
  {
   "id": "s13:00aa2",
   "op": "15",
   "jp": "傷の手当はしたんだが、\nずっと眠ったままなんで、\nちったぁ心配したんだぜ！",
   "en": ""
  },
  {
   "id": "s13:00b02",
   "op": "14",
   "jp": "・・・！？",
   "en": ""
  },
  {
   "id": "s13:00c16",
   "op": "15",
   "jp": "背中の羽？！",
   "en": ""
  },
  {
   "id": "s13:00c42",
   "op": "15",
   "jp": "おいおい、本当に全部\n忘れちまったのか・・・！？",
   "en": ""
  },
  {
   "id": "s13:00c86",
   "op": "15",
   "jp": "誰にでも生えてる物さ\nオマエにもオレにも・・・",
   "en": ""
  },
  {
   "id": "s13:00cca",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s13:00cf2",
   "op": "15",
   "jp": "まあ順番に思い出していこうぜ！\nこの世界のことを・・・\nそして・・・",
   "en": ""
  },
  {
   "id": "s13:00d56",
   "op": "15",
   "jp": "オレ達のことを・・・",
   "en": ""
  },
  {
   "id": "s13:00dd2",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "",
   "max": 15
  },
  {
   "id": "s13:00de8",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "",
   "max": 15
  }
 ]
}
