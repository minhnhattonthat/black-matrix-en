{
 "source": "d1:SCENARIO/45",
 "copies": [
  "d1:SCENARIO/45",
  "d2:SCENARIO/45"
 ],
 "strings": [
  {
   "id": "s45:0007a",
   "op": "15",
   "jp": "どうしたの？！\nひょっとして・・・・\n体の調子がどこか悪いの！？",
   "en": ""
  },
  {
   "id": "s45:000e2",
   "op": "15",
   "jp": "はいはい！甘えてないで・・・\n頑張ってリハビリしてきてね。",
   "en": ""
  },
  {
   "id": "s45:00182",
   "op": "15",
   "jp": "春はあけぼの・・・\nおはよう。気分はどう？",
   "en": ""
  },
  {
   "id": "s45:001ee",
   "op": "15",
   "jp": "吹き抜ける風が\n気持ちのいい朝ねぇ・・・",
   "en": ""
  },
  {
   "id": "s45:00236",
   "op": "15",
   "jp": "今日も頑張って\nリハビリしなくっちゃね！",
   "en": ""
  },
  {
   "id": "s45:0029e",
   "op": "15",
   "jp": "さあ！午後の日差しが\n強くならない内に、\n今日も朝から頑張らなきゃ！！",
   "en": ""
  },
  {
   "id": "s45:00326",
   "op": "15",
   "jp": "おはよう！今日もなんだか\n暑くなりそうね！！",
   "en": ""
  },
  {
   "id": "s45:00392",
   "op": "15",
   "jp": "熊手で秋を追い出しても・・・\n自然に秋は帰ってくるのよね・・・",
   "en": ""
  },
  {
   "id": "s45:00412",
   "op": "15",
   "jp": "おはよう。\nそろそろ寒くなるから・・・\n冬支度を始めなくちゃね！",
   "en": ""
  },
  {
   "id": "s45:00492",
   "op": "15",
   "jp": "おはよう。今日はなんだか、\n雪でも降りそうな雲行きね！",
   "en": ""
  },
  {
   "id": "s45:0050a",
   "op": "15",
   "jp": "冬来たりなば、春遠からじ・・・\nなんだか春の足音が・・・\n聞こえてきたような気がしない！？",
   "en": ""
  }
 ]
}
