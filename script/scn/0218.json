{
 "source": "d1:SCENARIO/218",
 "copies": [
  "d1:SCENARIO/218",
  "d2:SCENARIO/218"
 ],
 "strings": [
  {
   "id": "s218:0097e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:009aa",
   "op": "15",
   "jp": "結局は奴隷一人を助けた所で、\nここが無くならない限りはまた、\n新しい奴隷が連れてこられる・・・",
   "en": ""
  },
  {
   "id": "s218:00a1a",
   "op": "15",
   "jp": "俺自身、何度この場所を\n燃やしちまおうと\n思ったか解らねえ！！",
   "en": ""
  },
  {
   "id": "s218:00a6a",
   "op": "15",
   "jp": "だがここを燃やしたところで・・・",
   "en": ""
  },
  {
   "id": "s218:00a9e",
   "op": "15",
   "jp": "奴隷市の場所が変わるだけで\n実際には、何も変わりはしねえ！",
   "en": ""
  },
  {
   "id": "s218:00aea",
   "op": "15",
   "jp": "結局はこの世の中を\n変えちまうしか・・・",
   "en": ""
  },
  {
   "id": "s218:00b26",
   "op": "15",
   "jp": "オレ達が自由になる方法は、\nねえっていうのか・・・！！",
   "en": ""
  },
  {
   "id": "s218:00b72",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:00c02",
   "op": "15",
   "jp": "オマエは相変わらずだな・・・",
   "en": ""
  },
  {
   "id": "s218:0106e",
   "op": "15",
   "jp": "きっ・・・\nキサマは・・・",
   "en": ""
  },
  {
   "id": "s218:0109a",
   "op": "15",
   "jp": "史上最強の黒き皇帝と\n呼ばれた剣闘士・・・",
   "en": ""
  },
  {
   "id": "s218:010d6",
   "op": "15",
   "jp": "閃光のゼロ！！",
   "en": ""
  },
  {
   "id": "s218:010fa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:01116",
   "op": "15",
   "jp": "一つ尋ねるが、そこにいる\nお嬢さんも・・・",
   "en": ""
  },
  {
   "id": "s218:01152",
   "op": "15",
   "jp": "まさかオマエの戦闘チームの\nメンバーだと言うんじゃ\nないだろうな・・・？",
   "en": ""
  },
  {
   "id": "s218:011ba",
   "op": "15",
   "jp": "だったら何だって言うのよ！？",
   "en": ""
  },
  {
   "id": "s218:01202",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:0123a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:01266",
   "op": "15",
   "jp": "相変わらず・・か・・・",
   "en": ""
  },
  {
   "id": "s218:01292",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:012be",
   "op": "15",
   "jp": "オレの斬撃をかわして\n逃げおおせたのは・・・",
   "en": ""
  },
  {
   "id": "s218:012fe",
   "op": "15",
   "jp": "後にも先にもオマエだけだ・・・",
   "en": ""
  },
  {
   "id": "s218:0132e",
   "op": "15",
   "jp": "もしもオレとの決着をつける\n気があるんなら・・・",
   "en": ""
  },
  {
   "id": "s218:01372",
   "op": "15",
   "jp": "例の闘技場で待っている・・・",
   "en": ""
  },
  {
   "id": "s218:01412",
   "op": "15",
   "jp": "もっともオレの元にたどり着くまで、勝ち続けられればの話だが・・・",
   "en": ""
  },
  {
   "id": "s218:01466",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:0186a",
   "op": "15",
   "jp": "いったい奴は・・・・・",
   "en": ""
  },
  {
   "id": "s218:018a2",
   "op": "15",
   "jp": "奴は剣闘史上で唯一人、",
   "en": ""
  },
  {
   "id": "s218:018ca",
   "op": "15",
   "jp": "黒き羽を持った身分で\n戦い続ける男・・・",
   "en": ""
  },
  {
   "id": "s218:01906",
   "op": "15",
   "jp": "そして・・・",
   "en": ""
  },
  {
   "id": "s218:01926",
   "op": "15",
   "jp": "この俺の右目から光を奪い・・・",
   "en": ""
  },
  {
   "id": "s218:01956",
   "op": "15",
   "jp": "俺のかつての女房を\n殺した男だ・・・",
   "en": ""
  },
  {
   "id": "s218:01b72",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s218:01b8a",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s218:01bb2",
   "op": "15",
   "jp": "行こう・・・",
   "en": ""
  },
  {
   "id": "s218:01bd2",
   "op": "15",
   "jp": "奴とはどのみち・・・\n決着をつけなきゃならねえ・・・",
   "en": ""
  },
  {
   "id": "s218:01c1a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:01c62",
   "op": "15",
   "jp": "馬鹿かお前達は・・・",
   "en": ""
  },
  {
   "id": "s218:020c6",
   "op": "15",
   "jp": "何をグダグダほざいているのだ！！",
   "en": ""
  },
  {
   "id": "s218:02106",
   "op": "15",
   "jp": "きっ・・・\nキサマは・・・",
   "en": ""
  },
  {
   "id": "s218:02132",
   "op": "15",
   "jp": "退廃の剣闘士とうたわれた、\n奴隷ハンター・・・",
   "en": ""
  },
  {
   "id": "s218:02172",
   "op": "15",
   "jp": "不発弾のゼファル！！",
   "en": ""
  },
  {
   "id": "s218:0219a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:021ba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:021d6",
   "op": "15",
   "jp": "一つ尋ねるが、そこにいる\n筋肉質の奴隷は・・・",
   "en": ""
  },
  {
   "id": "s218:02216",
   "op": "15",
   "jp": "まさかオマエ達の\n仲間ではあるまいな・・・？",
   "en": ""
  },
  {
   "id": "s218:02262",
   "op": "15",
   "jp": "だったら何だって言うのよ！？",
   "en": ""
  },
  {
   "id": "s218:022aa",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:022d6",
   "op": "15",
   "jp": "いや、なあにね・・・\nその昔、俺がワナにはめて・・・",
   "en": ""
  },
  {
   "id": "s218:0231e",
   "op": "15",
   "jp": "監獄送りにしてやった筋肉バカの\nスットコドッコイに・・・",
   "en": ""
  },
  {
   "id": "s218:0236a",
   "op": "15",
   "jp": "そっくりだったモンでね・・・",
   "en": ""
  },
  {
   "id": "s218:0242e",
   "op": "15",
   "jp": "やぁ～いスットコドッコイ～！！",
   "en": ""
  },
  {
   "id": "s218:02462",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:0248e",
   "op": "15",
   "jp": "あぁ・・いや、こやつらは\nそこにいる邪道騎士と・・・",
   "en": ""
  },
  {
   "id": "s218:024d6",
   "op": "15",
   "jp": "神官であるわしが飼っておる\n奴隷達じゃ・・・",
   "en": ""
  },
  {
   "id": "s218:02516",
   "op": "15",
   "jp": "誰かの人違いであろう！！",
   "en": ""
  },
  {
   "id": "s218:02542",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s218:0255e",
   "op": "15",
   "jp": "まあ、今はそういう事に\nしときますか・・・",
   "en": ""
  },
  {
   "id": "s218:0259e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:025ca",
   "op": "15",
   "jp": "おい、レブロブス・・・",
   "en": ""
  },
  {
   "id": "s218:025f2",
   "op": "15",
   "jp": "もしもオレとの決着をつける\n気があんなら・・・",
   "en": ""
  },
  {
   "id": "s218:02632",
   "op": "15",
   "jp": "例の闘技場で待ってるぜ・・・",
   "en": ""
  },
  {
   "id": "s218:026d2",
   "op": "15",
   "jp": "もっともオレの元にたどり着くまで、勝ち続けられればの話だが・・・",
   "en": ""
  },
  {
   "id": "s218:02726",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s218:02c2e",
   "op": "15",
   "jp": "いったい奴は・・・・・",
   "en": ""
  },
  {
   "id": "s218:02c66",
   "op": "15",
   "jp": "やつはかつてオレの両親を\n殺した男さ・・・・",
   "en": ""
  },
  {
   "id": "s218:02ca6",
   "op": "15",
   "jp": "奴は自分自身も剣闘奴隷の身で\nありながら・・・",
   "en": ""
  },
  {
   "id": "s218:02ce6",
   "op": "15",
   "jp": "他の白き羽の逃亡奴隷達を\n捕まえては奴隷商人に売りつける\n腐りきった男・・・",
   "en": ""
  },
  {
   "id": "s218:02d46",
   "op": "15",
   "jp": "そして・・・",
   "en": ""
  },
  {
   "id": "s218:02d66",
   "op": "15",
   "jp": "この俺を汚いワナにはめて、\nあのゴルゴダの牢獄へと\nぶち込んだ男だ・・・・！！",
   "en": ""
  },
  {
   "id": "s218:02fae",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s218:02fc6",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s218:02fee",
   "op": "15",
   "jp": "行こう・・・",
   "en": ""
  },
  {
   "id": "s218:0300e",
   "op": "15",
   "jp": "奴とはどのみち・・・\n決着をつけなきゃならねえ・・・",
   "en": ""
  },
  {
   "id": "s218:03056",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  }
 ]
}
