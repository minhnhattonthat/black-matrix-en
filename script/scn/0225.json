{
 "source": "d1:SCENARIO/225",
 "copies": [
  "d1:SCENARIO/225",
  "d2:SCENARIO/225"
 ],
 "strings": [
  {
   "id": "s225:009b2",
   "op": "15",
   "jp": "秋のＧ１戦線を目前に控え・・・",
   "en": ""
  },
  {
   "id": "s225:009e2",
   "op": "15",
   "jp": "オレの最大のライバルと噂されて\nいたオマエが・・・",
   "en": ""
  },
  {
   "id": "s225:00a26",
   "op": "15",
   "jp": "この闘技場を逃げだしたと聞いて\nオレは自分の耳を疑った・・・",
   "en": ""
  },
  {
   "id": "s225:00a76",
   "op": "15",
   "jp": "黒き羽の身分を捨てたオレと・・・",
   "en": ""
  },
  {
   "id": "s225:00aaa",
   "op": "15",
   "jp": "剣闘士界最強を目指して育てられた\nファインブラッドのオマエ・・・",
   "en": ""
  },
  {
   "id": "s225:00afe",
   "op": "15",
   "jp": "ただ強さだけを・・・",
   "en": ""
  },
  {
   "id": "s225:00b26",
   "op": "15",
   "jp": "ただひたすら強さだけを\n追い求めていたはずの、\nオレとオマエの勝負が・・・",
   "en": ""
  },
  {
   "id": "s225:00b82",
   "op": "15",
   "jp": "一度も剣を交えずして勝敗が決する\nだなんて・・・",
   "en": ""
  },
  {
   "id": "s225:00bc6",
   "op": "15",
   "jp": "オレには正直、\n我慢出来なかった・・・",
   "en": ""
  },
  {
   "id": "s225:00c02",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:00c2a",
   "op": "15",
   "jp": "だからオマエ達二人の捜索隊が\n組織されたと聞いて・・・",
   "en": ""
  },
  {
   "id": "s225:00c72",
   "op": "15",
   "jp": "オレはその話に飛びついた\nってわけさ・・・！",
   "en": ""
  },
  {
   "id": "s225:00cb2",
   "op": "15",
   "jp": "だってそうだろう・・・！？",
   "en": ""
  },
  {
   "id": "s225:00cde",
   "op": "15",
   "jp": "これで誰が・・・",
   "en": ""
  },
  {
   "id": "s225:00d02",
   "op": "15",
   "jp": "誰が真の最強なのかが決まる！！",
   "en": ""
  },
  {
   "id": "s225:00d32",
   "op": "15",
   "jp": "そう思った・・・",
   "en": ""
  },
  {
   "id": "s225:00d56",
   "op": "15",
   "jp": "だが再び出会った時の\nオマエの眼には、\n焦りの色が濃く現れ・・・",
   "en": ""
  },
  {
   "id": "s225:00daa",
   "op": "15",
   "jp": "どこか集中力にかけていた・・・",
   "en": ""
  },
  {
   "id": "s225:00dda",
   "op": "15",
   "jp": "だからこそ、オレはオマエとの\n再戦を叶えるために・・・",
   "en": ""
  },
  {
   "id": "s225:00e22",
   "op": "15",
   "jp": "あえてあの時に\nオマエを逃がしたのだ・・・",
   "en": ""
  },
  {
   "id": "s225:00e5e",
   "op": "15",
   "jp": "だが、なぜだ・・・！？",
   "en": ""
  },
  {
   "id": "s225:00e86",
   "op": "15",
   "jp": "なぜお前は、自分の女なんかを\n連れたまま・・・",
   "en": ""
  },
  {
   "id": "s225:00ec6",
   "op": "15",
   "jp": "ココを逃げ出していったんだ！？",
   "en": ""
  },
  {
   "id": "s225:00f66",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:00f82",
   "op": "15",
   "jp": "アイツは、領主がオレ達に子供を\n産ませる目的であてがった女で・・・",
   "en": ""
  },
  {
   "id": "s225:00fd6",
   "op": "15",
   "jp": "正直その性格すら、\nよくは知らない相手だったが・・・",
   "en": ""
  },
  {
   "id": "s225:0101e",
   "op": "15",
   "jp": "あの時アイツは・・・",
   "en": ""
  },
  {
   "id": "s225:01046",
   "op": "15",
   "jp": "オレの子をはらんでいたのさ・・・",
   "en": ""
  },
  {
   "id": "s225:0121e",
   "op": "15",
   "jp": "オレはどうしても自分の子にだけは\n同じ思いをさせたくはなかった・・・",
   "en": ""
  },
  {
   "id": "s225:012be",
   "op": "15",
   "jp": "来る日も来る日も金持ち達の\n道楽の為だけに・・・",
   "en": ""
  },
  {
   "id": "s225:01302",
   "op": "15",
   "jp": "憎くもねえ相手を叩っ殺すだけの\n人生・・・",
   "en": ""
  },
  {
   "id": "s225:0133e",
   "op": "15",
   "jp": "そんな人生だけは・・・\n送らせたくなかったんだ・・・",
   "en": ""
  },
  {
   "id": "s225:013aa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:013d6",
   "op": "15",
   "jp": "お主達にも・・・\n色々と複雑な事情は有ると思うが、",
   "en": ""
  },
  {
   "id": "s225:0141a",
   "op": "15",
   "jp": "お互いに真の最強を望んで\nいるのであれば・・・・",
   "en": ""
  },
  {
   "id": "s225:0145e",
   "op": "15",
   "jp": "こんな所で意地の張り合いを\nしておっても・・・",
   "en": ""
  },
  {
   "id": "s225:0149e",
   "op": "15",
   "jp": "あまり意味がないと思うぞ・・",
   "en": ""
  },
  {
   "id": "s225:0150a",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s225:0152e",
   "op": "15",
   "jp": "なぜならこれからわし等が向かう\n総本山にこそ・・・",
   "en": ""
  },
  {
   "id": "s225:01572",
   "op": "15",
   "jp": "この世界最強の敵が\n存在するはずなのじゃから・・・",
   "en": ""
  },
  {
   "id": "s225:015f6",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s225:0160e",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s225:0164a",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s225:01666",
   "op": "15",
   "jp": "それに今のお主や我々は、\nそう悠長にもしてはいられまい・・・",
   "en": ""
  },
  {
   "id": "s225:016b6",
   "op": "15",
   "jp": "なにせ、本来殺されていなければ\nならぬはずのお主を、殺さずに試合を放棄しておいて・・・",
   "en": ""
  },
  {
   "id": "s225:0171e",
   "op": "15",
   "jp": "このままただですまされるとも\n思えんからのう・・・",
   "en": ""
  },
  {
   "id": "s225:01766",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s225:0178e",
   "op": "15",
   "jp": "どうじゃ！？ここはお互いに一時休戦協定を結ぶ事として・・・",
   "en": ""
  },
  {
   "id": "s225:017ea",
   "op": "15",
   "jp": "我らと共に、真の最強を望んで\nみる気は無いか！？",
   "en": ""
  },
  {
   "id": "s225:0182e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:0184a",
   "op": "15",
   "jp": "オマエは・・・\nそれでいいのか・・・！？",
   "en": ""
  },
  {
   "id": "s225:01886",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:018a2",
   "op": "15",
   "jp": "お前の好きにしろ・・・！！",
   "en": ""
  },
  {
   "id": "s225:01926",
   "op": "15",
   "jp": "決まりだね！！",
   "en": ""
  },
  {
   "id": "s225:01956",
   "op": "15",
   "jp": "ボクの本当の名はクレージュ！",
   "en": ""
  },
  {
   "id": "s225:01992",
   "op": "15",
   "jp": "言わなかったボクも悪いけど、\n気づかなかったキミ達も・・・\n結構失礼だと思うよ・・・！？",
   "en": ""
  },
  {
   "id": "s225:01a2e",
   "op": "15",
   "jp": "なんだとこの女ぁ・・・！！",
   "en": ""
  },
  {
   "id": "s225:01a50",
   "op": "08/15",
   "jp": "クレージュ",
   "en": ""
  },
  {
   "id": "s225:01aa6",
   "op": "15",
   "jp": "ピンポンパンポン・・・\nただいまの審議の結果について、\nご報告いたします・・・",
   "en": ""
  },
  {
   "id": "s225:01b06",
   "op": "15",
   "jp": "試合中に、両チームが戦闘を突然\n中断した件につきまして審判団は・・",
   "en": ""
  },
  {
   "id": "s225:01b6a",
   "op": "15",
   "jp": "やばいなっ・・・！！",
   "en": ""
  },
  {
   "id": "s225:01b92",
   "op": "15",
   "jp": "とりあえず早いとこ、ココから\n脱出するとしようぜ！",
   "en": ""
  },
  {
   "id": "s225:01be6",
   "op": "15",
   "jp": "なあに、お主達二人にかかれば、\nここの守衛共など・・・",
   "en": ""
  },
  {
   "id": "s225:01c2e",
   "op": "15",
   "jp": "カカシのようなもんじゃろうて！！",
   "en": ""
  },
  {
   "id": "s225:01c86",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:01cca",
   "op": "15",
   "jp": "それじゃあいくぜ・・・相棒！！",
   "en": ""
  },
  {
   "id": "s225:01cfe",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:01d2c",
   "op": "14",
   "jp": "ゼロが仲間になった！",
   "en": ""
  },
  {
   "id": "s225:02826",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s225:02866",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s225:02882",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s225:0289a",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s225:028b2",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s225:028d6",
   "op": "15",
   "jp": "ボクの本当の名はクレージュ！",
   "en": ""
  },
  {
   "id": "s225:02912",
   "op": "15",
   "jp": "言わなかったボクも悪いけど、\n気づかなかったキミ達も・・・\n結構失礼だと思うよ・・・！？",
   "en": ""
  },
  {
   "id": "s225:029ae",
   "op": "15",
   "jp": "なんだとこの女ぁ・・・！！",
   "en": ""
  },
  {
   "id": "s225:029d6",
   "op": "08/15",
   "jp": "クレージュ",
   "en": ""
  },
  {
   "id": "s225:034b2",
   "op": "15",
   "jp": "みんな・・・\n俺のために道草を食わせちまって",
   "en": ""
  },
  {
   "id": "s225:034f2",
   "op": "15",
   "jp": "すまなかったな・・・",
   "en": ""
  },
  {
   "id": "s225:0354a",
   "op": "15",
   "jp": "くだらん事を気にするな・・・",
   "en": ""
  },
  {
   "id": "s225:0357a",
   "op": "15",
   "jp": "それに今回は、オマエの間抜けさ\n加減がよくわかって・・・",
   "en": ""
  },
  {
   "id": "s225:035c6",
   "op": "15",
   "jp": "なにかと面白かったぜ・・・！！",
   "en": ""
  },
  {
   "id": "s225:03606",
   "op": "15",
   "jp": "なんだとキサマ～！",
   "en": ""
  },
  {
   "id": "s225:03652",
   "op": "15",
   "jp": "やぁ～い間抜け間抜け～～！！",
   "en": ""
  },
  {
   "id": "s225:0368e",
   "op": "15",
   "jp": "●☆□◆〇♂▽■",
   "en": ""
  },
  {
   "id": "s225:036be",
   "op": "15",
   "jp": "まあまあ、とにかくこの丘を越えればいよいよ大邪神の鎧があると\nユダが言っておった・・・",
   "en": ""
  },
  {
   "id": "s225:03726",
   "op": "15",
   "jp": "パンデモニウムの街じゃ・・",
   "en": ""
  },
  {
   "id": "s225:03752",
   "op": "15",
   "jp": "ここからは、いっそう気を引き締めてかからねばなるまいて・・・",
   "en": ""
  },
  {
   "id": "s225:037a2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s225:037c2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s225:03826",
   "op": "15",
   "jp": "なぁ・・・",
   "en": ""
  },
  {
   "id": "s225:03842",
   "op": "15",
   "jp": "なんだか俺にも少しだけ、\n愛とかって言葉の意味が・・・",
   "en": ""
  },
  {
   "id": "s225:038b6",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s225:038da",
   "op": "15",
   "jp": "いや！\nなんでもねえ・・・",
   "en": ""
  },
  {
   "id": "s225:03922",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s225:0395a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:03992",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s225:039b2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s225:039de",
   "op": "15",
   "jp": "このオレが・・・\n愛・・・だってよ！",
   "en": ""
  }
 ]
}
