 "strings": [
  {
   "id": "s418:00ee2",
   "op": "15",
   "jp": "なるほど！",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:00efe",
   "op": "15",
   "jp": "それでは、\nこれが最後の設問です。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:00f46",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s418:00f7e",
   "op": "15",
   "jp": "お、お父ちゃんの、\nお父ちゃんの仇ぃいぃ！！",
   "en": "",
   "box": "17x3",
   "face": 54
  },
  {
   "id": "s418:0114a",
   "op": "15",
   "jp": "お、おい！ちょっと待て！！\nお前ら一体！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s418:01196",
   "op": "15",
   "jp": "彼女達は、今までアナタ方が\n無造作に殺してきた、",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:011da",
   "op": "15",
   "jp": "名も無き兵士達の、\n遺族です！！",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:01222",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s418:01246",
   "op": "15",
   "jp": "兵士として殺された\n彼ら自身の善悪はともかく、",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:01286",
   "op": "15",
   "jp": "彼らにも当然家族があり、",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:012b2",
   "op": "15",
   "jp": "誰かを殺せば、\n必ず誰かの怨みを買う。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:012ea",
   "op": "15",
   "jp": "彼女達の復讐心は、これまでの\nアナタ方の行動が招いた、\n至極当然の結果です！！",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:0135a",
   "op": "15",
   "jp": "くっ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s418:01382",
   "op": "15",
   "jp": "残された彼女達の存在を\n戦闘中に、一度でも\n考えた事が有りますか？",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:013e6",
   "op": "15",
   "jp": "きっ、キサマ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s418:0140a",
   "op": "15",
   "jp": "最初から、このワナに\n俺達をはめるつもりで！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s418:01456",
   "op": "15",
   "jp": "参考までに言っておきますが、\n彼女らはどこまでもアナタ方を\n追い続けることでしょう・・・",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:014c2",
   "op": "15",
   "jp": "例え逃げたり誤魔化そうとしても、\n決着はつきませんよ。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s418:0151a",
   "op": "15",
   "jp": "おい、いったいどうするんだ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s418:0155a",
   "op": "1d",
   "jp": "このまま戦う！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s418:01574",
   "op": "1d",
   "jp": "逃げるように努力する",
   "en": "",
   "max": 15
  },
  {
   "id": "s418:01590",
   "op": "1d",
   "jp": "彼女らに殺される？",
   "en": "",
   "max": 15
  },
  {
   "id": "s418:015de",
   "op": "15",
   "jp": "それもやむを得ないか。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s418:01616",
   "op": "15",
   "jp": "確かに、それも\n一つの真理ですからね・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s418:01682",
   "op": "15",
   "jp": "それもやむを得ないか。",
   "en": "",
   "box": "17x3",
   "face": 1
