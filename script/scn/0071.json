{
 "source": "d1:SCENARIO/71",
 "copies": [
  "d1:SCENARIO/71",
  "d2:SCENARIO/71"
 ],
 "strings": [
  {
   "id": "s71:003a2",
   "op": "15",
   "jp": "おおっと！\n問題の奴隷が、\n帰ってきたようですね！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s71:0044e",
   "op": "15",
   "jp": "お・・・おにいちゃんに、\nヒドイことしないで！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:0049e",
   "op": "15",
   "jp": "我々とて同じ黒い羽のアナタに\n手荒な真似などしたくはない\nのですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:004f6",
   "op": "15",
   "jp": "お嬢さん！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00512",
   "op": "15",
   "jp": "ただ・・・\nアナタがどうしても奴隷を、\n奴隷らしく扱わず・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00562",
   "op": "15",
   "jp": "首輪もつけずに、\n放し飼いにし続けると\nいうのであれば・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:005b2",
   "op": "15",
   "jp": "彼には死んでもらう事に\nなりますねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:005ee",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00612",
   "op": "15",
   "jp": "だいいち周りに聞いた噂によると、\n奴隷をペットとして\n猫っ可愛がりするにしても、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00676",
   "op": "15",
   "jp": "服まで着せるなんて\nやりすぎじゃあないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:006ca",
   "op": "15",
   "jp": "おじさん達のバカバカバカぁっ！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:006fe",
   "op": "15",
   "jp": "おにいちゃんは・・・\nペットや・・奴隷なんかじゃないよ！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:0074a",
   "op": "15",
   "jp": "あたしの・・・おにいちゃんは、\nそんなんじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:0079e",
   "op": "15",
   "jp": "そりゃ自分の奴隷に\n執着心を持つのは勝手だが！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s71:007ee",
   "op": "15",
   "jp": "なるほど！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:0080e",
   "op": "15",
   "jp": "人から貰った時には\n気にいらなかったコップが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:0084e",
   "op": "15",
   "jp": "毎日使っているうちに、\nだんだん良い物に思えてくるという\nアレですか！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:008b6",
   "op": "15",
   "jp": "ちがうっ！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:008d2",
   "op": "15",
   "jp": "コ・・コップなんかと・・・\nいっしょにしないで！！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00926",
   "op": "15",
   "jp": "あ・・あたしは・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:0094e",
   "op": "15",
   "jp": "あたしは・・・おにいちゃんを・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00982",
   "op": "15",
   "jp": "愛してるんだもん！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:009b6",
   "op": "15",
   "jp": "あっ！！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s71:009d2",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s71:009f6",
   "op": "15",
   "jp": "愛だとぉ～！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s71:00a16",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00a32",
   "op": "15",
   "jp": "それは俗に、\nこの世界でも恋と呼ばれる\n人間の発情期の勘違いですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00a8a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00ab6",
   "op": "15",
   "jp": "発情期に入るとどんな動物でも\n動ξが激しくなって\n頭に血が上り・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00b0e",
   "op": "15",
   "jp": "ときおり訳の分からない事を\n叫んで見たりするものです。",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00b56",
   "op": "15",
   "jp": "だったらそれこそ、\nアナタが彼を\n好きにすればいいんです！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00ba6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s71:00bd2",
   "op": "15",
   "jp": "自分が奴隷に対して\n欲情した事を\n恥じてはいけませんよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00c1e",
   "op": "15",
   "jp": "誰かに欲情するという事は・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00c4e",
   "op": "15",
   "jp": "全ての動物にとって\n種族の保存に繋がる\n根元的な行為なのです！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00c9e",
   "op": "15",
   "jp": "だいいちそんな・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00cc6",
   "op": "15",
   "jp": "愛などという、\n実際にはこの世にはありもしない\n妄想を口にすることが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00d1e",
   "op": "15",
   "jp": "七つの大罪の一つである事を\nアナタはご存じないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s71:00d7a",
   "op": "15",
   "jp": "お・・・おじさん達の言うとおり、\nあたしの気持ちは・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00dc6",
   "op": "15",
   "jp": "ただのわがままだって思われて、\nおにいちゃんに嫌われちゃってる\nのかもしれない。",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00e2a",
   "op": "15",
   "jp": "でも・・・！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00e4a",
   "op": "15",
   "jp": "それがどんな悪いことでも・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00e7a",
   "op": "15",
   "jp": "あ、あたしは・・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s71:00ea2",
   "op": "15",
   "jp": "あたしは、おにいちゃんを、\n愛してるもん！！",
   "en": "",
   "box": "17x3",
   "face": 8
  }
 ]
}
