{
 "source": "d1:SCENARIO/27",
 "copies": [
  "d1:SCENARIO/27",
  "d2:SCENARIO/27"
 ],
 "strings": [
  {
   "id": "s27:00030",
   "op": "14",
   "jp": "○月×日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00046",
   "op": "14",
   "jp": "ついに・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0005a",
   "op": "14",
   "jp": "ついにあの人が\n眼を覚ましてくれた！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00088",
   "op": "14",
   "jp": "うれしくて・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:000a0",
   "op": "14",
   "jp": "うれしくてうれしくてうれしくて！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:000c8",
   "op": "14",
   "jp": "とってもじゃないけど、\n今日は眠れそうにない・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00104",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "19x3"
  },
  {
   "id": "s27:00118",
   "op": "14",
   "jp": "だけどあの人は、\nあたし達の記憶をなにもかも\n無くしてしまった・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00164",
   "op": "14",
   "jp": "ねえ、おねがい・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00182",
   "op": "14",
   "jp": "お願いだから早く思い出して！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:001c8",
   "op": "14",
   "jp": "△月○日　雨",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:001dc",
   "op": "14",
   "jp": "今日の私ったら・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:001f8",
   "op": "14",
   "jp": "自分でもビックリしちゃう位の\n大胆発言！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0022a",
   "op": "14",
   "jp": "だって二人っきりで\n暖炉で暖めあっていたら・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00262",
   "op": "14",
   "jp": "なんだかとってもいい雰囲気に\nなってきちゃったんだもん・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:002a6",
   "op": "14",
   "jp": "おまけにあの人の瞳の中には、\n私しか映っていなくて・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:002e8",
   "op": "14",
   "jp": "って、よく考えたら当たり前の事が、\nなんだかとってもうれしくって・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00338",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "19x3"
  },
  {
   "id": "s27:0034c",
   "op": "14",
   "jp": "本当に・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00360",
   "op": "14",
   "jp": "いつまでもこんな日が続けば\n良いのに・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:003b0",
   "op": "14",
   "jp": "◇月◎日　曇り",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:003c6",
   "op": "14",
   "jp": "私・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:003d6",
   "op": "14",
   "jp": "今年こそ勇気をだして\nあの人にチョコをあげようと\n決心しました・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00426",
   "op": "14",
   "jp": "だけど・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0043c",
   "op": "14",
   "jp": "あの人はすっかり\n記憶を無くしてしまっているから・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0047a",
   "op": "14",
   "jp": "このチョコをあげるって行為が、\n私達女性にとって\nどんな意味を持っているか何て・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:004d8",
   "op": "14",
   "jp": "きっと覚えていないんだと思う・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00502",
   "op": "14",
   "jp": "でもでも、そのほうがかえって、\n気が楽だよね・・・？！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00540",
   "op": "14",
   "jp": "だってあの人が覚えていて、\nもしも私に・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00574",
   "op": "14",
   "jp": "ってバカバカ！なにを望んでるのよ\n私ったら・・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:005d0",
   "op": "14",
   "jp": "○月■日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:005e6",
   "op": "14",
   "jp": "ここのところ、",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:005fc",
   "op": "14",
   "jp": "なんだかあの人の様子が、\n妙にそわそわしていて\n落ち着きがないような気がする・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00658",
   "op": "14",
   "jp": "もしかするとあの人も実は・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0067e",
   "op": "14",
   "jp": "そろそろ、この家の外に\n出たくなり始めたんじゃぁ・・・！？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:006c0",
   "op": "14",
   "jp": "バカバカ！なにを考えているの\nあたしったら・・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0071c",
   "op": "14",
   "jp": "□月×日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:00732",
   "op": "14",
   "jp": "最近のあの人は・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0074e",
   "op": "14",
   "jp": "すっかり元気に\nなってきたみたい・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0077c",
   "op": "14",
   "jp": "だけど、それにともなって、\n私の心の中では、どんどん\n不安が大きくなっていく・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:007da",
   "op": "14",
   "jp": "あの人がいつか・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:007f8",
   "op": "14",
   "jp": "この家の外へと出ていきたいって\n言い出すんじゃないかって・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0083e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "19x3"
  },
  {
   "id": "s27:00852",
   "op": "14",
   "jp": "ああもう、私って何て嫌な女\nなのかしら・・・・！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s27:0088c",
   "op": "14",
   "jp": "あの人が元気になることを、\n心から喜ぶことが出来ないなんて・・・",
   "en": "",
   "box": "19x3"
  }
 ]
}
