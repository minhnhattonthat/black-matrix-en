 "strings": [
  {
   "id": "s546:008e2",
   "op": "15",
   "jp": "我が名は、完全なる戦闘神と\nうたわれ・・・",
   "en": ""
  },
  {
   "id": "s546:0091e",
   "op": "15",
   "jp": "戦争を司る大天使、\nミカエル！！",
   "en": ""
  },
  {
   "id": "s546:00952",
   "op": "15",
   "jp": "今こそ我は、その完全なる記憶を\n取り戻した、唯一の神に\n忠実に仕えし者・・・",
   "en": ""
  },
  {
   "id": "s546:009b2",
   "op": "15",
   "jp": "新しき世界を創造すべき・・・",
   "en": ""
  },
  {
   "id": "s546:00a06",
   "op": "15",
   "jp": "次代のサタンとなるべき\n魂を持つ者よ・・・・！",
   "en": ""
  },
  {
   "id": "s546:00a4e",
   "op": "15",
   "jp": "次代のゴッドとなるべき\n魂を持つ者よ・・・・！",
   "en": ""
  },
  {
   "id": "s546:00a8e",
   "op": "15",
   "jp": "いにしえより伝わる縁により、",
   "en": ""
  },
  {
   "id": "s546:00abe",
   "op": "15",
   "jp": "我が今こそ、その力を試そう！！",
   "en": ""
  },
  {
   "id": "s546:00b8e",
   "op": "15",
   "jp": "まってお兄ちゃん！！",
   "en": ""
  },
  {
   "id": "s546:00bb6",
   "op": "15",
   "jp": "プリカも・・プリカもお兄ちゃんと\n一緒に闘う！！",
   "en": ""
  },
  {
   "id": "s546:00c1e",
   "op": "15",
   "jp": "ま・・まちなさい・・・・！",
   "en": ""
  },
  {
   "id": "s546:00c4a",
   "op": "15",
   "jp": "アタシに黙って一人で勝手に\n闘おうだなんて・・・",
   "en": ""
  },
  {
   "id": "s546:00c9a",
   "op": "15",
   "jp": "ふん！アンタ一人になんて・・・",
   "en": ""
  },
  {
   "id": "s546:00cda",
   "op": "15",
   "jp": "任せておけないわ！！",
   "en": ""
  },
  {
   "id": "s546:00d26",
   "op": "15",
   "jp": "やめてっ・・・！！",
   "en": ""
  },
  {
   "id": "s546:00d4a",
   "op": "15",
   "jp": "仲間同士で争うなんて・・・\nそんなのひどすぎるわ！！",
   "en": ""
  },
  {
   "id": "s546:00db6",
   "op": "15",
   "jp": "ボクにだって・・・",
   "en": ""
  },
  {
   "id": "s546:00dda",
   "op": "15",
   "jp": "ボクにだってちゃんと・・・\nちゃんと戦えるんだ～っつ！！",
   "en": ""
  },
  {
   "id": "s546:00e4a",
   "op": "15",
   "jp": "あーーんも～～っ！！",
   "en": ""
  },
  {
   "id": "s546:00e7e",
   "op": "15",
   "jp": "どうして、一緒に闘おうって・・・",
   "en": ""
  },
  {
   "id": "s546:00ebe",
   "op": "15",
   "jp": "キミは言い出せないのかなぁ～！？",
   "en": ""
  },
  {
   "id": "s546:00f16",
   "op": "15",
   "jp": "ここは、オレに任せろ！！",
   "en": ""
  },
  {
   "id": "s546:00f4e",
   "op": "15",
   "jp": "お前の事は・・・\n俺が命に代えても\n守り抜いてみせる！！",
   "en": ""
  },
  {
   "id": "s546:00f9a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
