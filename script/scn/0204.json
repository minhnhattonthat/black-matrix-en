{
 "source": "d1:SCENARIO/204",
 "copies": [
  "d1:SCENARIO/204",
  "d2:SCENARIO/204"
 ],
 "strings": [
  {
   "id": "s204:00a16",
   "op": "15",
   "jp": "おぅ、オメェか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00a3e",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s204:00a66",
   "op": "15",
   "jp": "ん？いや何、\nちょいと寝つけなくってよ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00aa2",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s204:00abe",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00ada",
   "op": "15",
   "jp": "なぁ・・・\nおめぇは、本当にその罪を\n犯しちまうほどよ、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00b26",
   "op": "15",
   "jp": "愛とかっていうのを\n理解できてんのかよ？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00b62",
   "op": "14",
   "jp": "・・・・？",
   "en": "...?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s204:00b8e",
   "op": "15",
   "jp": "俺は・・・俺は自由ってのが\n未だにさっぱりわかんねぇ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00bd6",
   "op": "15",
   "jp": "産まれたときから、\nただ虐げられるだけの\n白い羽の奴隷。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00c22",
   "op": "15",
   "jp": "俺はそいつが我慢出来ず、\nそこから抜け出すために力を、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00c6a",
   "op": "15",
   "jp": "そう、力を求めたんだ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00c96",
   "op": "15",
   "jp": "力さえあれば、\nもう誰にも縛られねぇ、\nどこへだって行ける！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00ce6",
   "op": "15",
   "jp": "だがこの世界ではそれを手に\n入れる事を自由といい、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00d2a",
   "op": "15",
   "jp": "７つの大罪に触れるって\nいうじゃねぇか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00d6a",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s204:00dfa",
   "op": "15",
   "jp": "ふざけんじゃねぇ！\nだったら黒い羽のやつらは\nどうなんだ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00e6e",
   "op": "15",
   "jp": "あの連中の白い羽に対する\n好き勝手な振る舞いの、\nどこが自由じゃねぇってんだ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00ed2",
   "op": "15",
   "jp": "そう思った俺は、自分の主人\nパンデモニウムの領主を\nこの手で殺しちまった。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00f56",
   "op": "15",
   "jp": "その後は聞いての通りさ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00fa6",
   "op": "15",
   "jp": "国中を渡り歩き、主を変え、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:00fd2",
   "op": "15",
   "jp": "仲間を変えては力の限り、\n思うまま好きなように振る舞って\nやった・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:0102a",
   "op": "15",
   "jp": "だが奴隷は奴隷、\nいっしょに戦った仲間の中に\n強ェ奴らはいっぱいいたが、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:01086",
   "op": "15",
   "jp": "結局、自由なんてものには\nとうてい巡り会えなかった。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:010ce",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s204:010f6",
   "op": "15",
   "jp": "でもよ、笑っちまうよな。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:01122",
   "op": "15",
   "jp": "黒い羽の連中にも\n主従関係ってのがあって、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:0115e",
   "op": "15",
   "jp": "連中でもすべてが思い通りって\nワケじゃねぇときやがる。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:011aa",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s204:011d2",
   "op": "15",
   "jp": "だったら、\n俺の知りてェ自由ってのは何だ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:0120e",
   "op": "15",
   "jp": "罪深い自由って何だよ？！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:0123a",
   "op": "15",
   "jp": "悪ィ、懐かしい街並みを目にして、\n少し感傷的になっちまった\nみてぇだ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:01292",
   "op": "15",
   "jp": "今夜は妙に右目の古傷が\n痛みやがる。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:0195e",
   "op": "15",
   "jp": "オイ！！\n昔話はそこまでだ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s204:019d6",
   "op": "15",
   "jp": "何か現れたぜ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s204:022aa",
   "op": "15",
   "jp": "ついに見つけたぞ、お前ら！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:022d6",
   "op": "15",
   "jp": "噂だとお前らは、\nたいそうなお宝を\n持っているそうじゃないか！！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:0232a",
   "op": "15",
   "jp": "さっさと、出しやがれ！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:02362",
   "op": "15",
   "jp": "そのお宝っていうのは、\nもしかして・・・ハッ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s204:023a2",
   "op": "15",
   "jp": "アタシのこの美貌の事！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s204:023da",
   "op": "15",
   "jp": "ぶっ殺す！！！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:02562",
   "op": "15",
   "jp": "くっくっくっ・・・\n我らが今まで生き残れてきた事を\nたんなる偶然と思うなよ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:025ca",
   "op": "15",
   "jp": "我らには我らの守護神とも言える、\n邪悪なる邪道騎士！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:02612",
   "op": "15",
   "jp": "オスカー様がついて\nいらっしゃるのだ！！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:0265a",
   "op": "15",
   "jp": "じゃ・・邪道騎士ですって！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s204:0268a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:026a6",
   "op": "15",
   "jp": "なにもキミ達の命を奪う事が\n我々の目的では無いんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:026f2",
   "op": "15",
   "jp": "出来れば、その宝物とやらを",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:0271e",
   "op": "15",
   "jp": "ココに置いて・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:02742",
   "op": "15",
   "jp": "だまってこの場を\n立ち去って欲しい・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:0277e",
   "op": "15",
   "jp": "そうすれば他には何も盗らないし\nキミ達の安全も保障しよう・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:027de",
   "op": "15",
   "jp": "ふざけるな！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s204:0280a",
   "op": "15",
   "jp": "残念ながら・・・\nそのアンタ等が言っている",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s204:02846",
   "op": "15",
   "jp": "お宝って奴は・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s204:0286a",
   "op": "15",
   "jp": "おいそれと置いたり脱いだり\n出来るような代物じゃないんでね！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s204:028ba",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:028e6",
   "op": "15",
   "jp": "オスカー様！！",
   "en": "",
   "box": "17x3",
   "face": 38
  },
  {
   "id": "s204:02916",
   "op": "15",
   "jp": "やるしか・・無いのか・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s204:02946",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  }
 ]
}
