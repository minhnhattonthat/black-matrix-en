 ],
 "strings": [
  {
   "id": "s348:00f36",
   "op": "15",
   "jp": "僕は子供の頃から、\n数多い奴隷達の中でも\n特に目立たない子供でした・・・",
   "en": ""
  },
  {
   "id": "s348:00fb6",
   "op": "15",
   "jp": "いえ！",
   "en": ""
  },
  {
   "id": "s348:00ff6",
   "op": "15",
   "jp": "むしろ変に目立って\n苛められるのが嫌で、自分から\n目立たないようにしていたのです。",
   "en": ""
  },
  {
   "id": "s348:0105e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s348:0108a",
   "op": "15",
   "jp": "ところが黒き羽の人々は、\n自分自身の個性を\n大事にするあまり・・・",
   "en": ""
  },
  {
   "id": "s348:010de",
   "op": "15",
   "jp": "ただ歯車のように生活する者を\n一番に嫌います。",
   "en": ""
  },
  {
   "id": "s348:0111e",
   "op": "15",
   "jp": "幼かった頃の僕は、\nその事に\n気が付いていませんでした。",
   "en": ""
  },
  {
   "id": "s348:0116a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s348:01196",
   "op": "15",
   "jp": "その結果、僕はいつしか\n同じ奴隷仲間達からも\n相手にされなくなり・・・",
   "en": ""
  },
  {
   "id": "s348:011ee",
   "op": "15",
   "jp": "誰とも口をきかない少年時代を\n何年も過ごしてきました。",
   "en": ""
  },
  {
   "id": "s348:01252",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s348:0128a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s348:012b6",
   "op": "15",
   "jp": "ところが、\nケルビムさんの息子だった\nセラフィムさんは・・・・",
   "en": ""
  },
  {
   "id": "s348:0132e",
   "op": "15",
   "jp": "こんな僕を孤独の淵から\n拾い上げてくれたのです！",
   "en": ""
  }
 ]
}
