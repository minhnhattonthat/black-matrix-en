 ],
 "strings": [
  {
   "id": "s10:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": ""
  },
  {
   "id": "s10:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": ""
  },
  {
   "id": "s10:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": ""
  },
  {
   "id": "s10:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": ""
  },
  {
   "id": "s10:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": ""
  },
  {
   "id": "s10:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": ""
  },
  {
   "id": "s10:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": ""
  },
  {
   "id": "s10:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": ""
  },
  {
   "id": "s10:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": ""
  },
  {
   "id": "s10:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": ""
  },
  {
   "id": "s10:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": ""
  },
  {
   "id": "s10:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": ""
  },
  {
   "id": "s10:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": ""
  },
  {
   "id": "s10:00602",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s10:00626",
   "op": "15",
   "jp": "・・・・・よかった～！",
   "en": ""
  },
  {
   "id": "s10:0065e",
   "op": "15",
   "jp": "もう・・・",
   "en": ""
  },
  {
   "id": "s10:0067a",
   "op": "15",
   "jp": "一生目を覚まさないんじゃないかと、思っちゃったよ！",
   "en": ""
  },
  {
   "id": "s10:006be",
   "op": "15",
   "jp": "だって・・・",
   "en": ""
  },
  {
   "id": "s10:006de",
   "op": "15",
   "jp": "だって、もう十ヶ月以上も・・・\n高熱を出したまま寝込んでたんだよ！",
   "en": ""
  },
  {
   "id": "s10:00736",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s10:00762",
   "op": "15",
   "jp": "えっ・・・",
   "en": ""
  },
  {
   "id": "s10:0078e",
   "op": "15",
   "jp": "どうしたの！\nまだどこか痛むの！？",
   "en": ""
  },
  {
   "id": "s10:007c6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s10:007f2",
   "op": "15",
   "jp": "まっ・・まさか！？",
   "en": ""
  },
  {
   "id": "s10:00826",
   "op": "15",
   "jp": "ボクの事を・・・\n忘れちゃったとか？",
   "en": ""
  },
  {
   "id": "s10:0086a",
   "op": "15",
   "jp": "えっ！？\nまさか・・・自分の事も？",
   "en": ""
  },
  {
   "id": "s10:008ae",
   "op": "15",
   "jp": "キミの名前は・・・？",
   "en": ""
  },
  {
   "id": "s10:00952",
   "op": "15",
   "jp": "じゃあ、ボクの名前は？",
   "en": ""
  },
  {
   "id": "s10:009f6",
   "op": "15",
   "jp": "その通り！！",
   "en": ""
  },
  {
   "id": "s10:00a16",
   "op": "15",
   "jp": "良かった、良かった・・・",
   "en": ""
  },
  {
   "id": "s10:00a42",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s10:00a6e",
   "op": "15",
   "jp": "ここは・・・\nキミとボクだけが住んでる家！",
   "en": ""
  },
  {
   "id": "s10:00aaa",
   "op": "15",
   "jp": "他には誰もいないよ！！",
   "en": ""
  },
  {
   "id": "s10:00ae2",
   "op": "15",
   "jp": "キミは事故で大ケガをしたんだ！",
   "en": ""
  },
  {
   "id": "s10:00b12",
   "op": "15",
   "jp": "雨の日に雷が落ちて・・・",
   "en": ""
  },
  {
   "id": "s10:00b4a",
   "op": "15",
   "jp": "傷の手当はしたんだけど・・・\nずっと眠ったままなんだもん！",
   "en": ""
  },
  {
   "id": "s10:00b96",
   "op": "15",
   "jp": "とっても心配しちゃったよ！",
   "en": ""
  },
  {
   "id": "s10:00bc6",
   "op": "14",
   "jp": "・・・！？",
   "en": ""
  },
  {
   "id": "s10:00cda",
   "op": "15",
   "jp": "背中の・・・羽？",
   "en": ""
  },
  {
   "id": "s10:00d0a",
   "op": "15",
   "jp": "本当に・・・\n全部忘れちゃったんだ・・・",
   "en": ""
  },
  {
   "id": "s10:00d46",
   "op": "15",
   "jp": "誰にでも、生えてる物じゃないか！\nキミにもボクにも・・・！",
   "en": ""
  },
  {
   "id": "s10:00d92",
   "op": "15",
   "jp": "・・・気にしないで、",
   "en": ""
  },
  {
   "id": "s10:00dba",
   "op": "15",
   "jp": "順番に思い出していこうね・・・！",
   "en": ""
  },
  {
   "id": "s10:00dee",
   "op": "15",
   "jp": "この世界のこと、\nそして・・・",
   "en": ""
  },
  {
   "id": "s10:00e1e",
   "op": "15",
   "jp": "ボク達のことも・・・",
   "en": ""
  },
  {
   "id": "s10:00e9a",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "",
   "max": 15
  },
  {
   "id": "s10:00eb0",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "",
   "max": 15
  }
 ]
}
