{
 "source": "d1:SCENARIO/10",
 "copies": [
  "d1:SCENARIO/10",
  "d2:SCENARIO/10"
 ],
 "strings": [
  {
   "id": "s10:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": "(Ow...!)",
   "box": "19x3"
  },
  {
   "id": "s10:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": "(My whole body hurts, somehow...)",
   "box": "19x3"
  },
  {
   "id": "s10:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": "(A dull pain, running all through me...)",
   "box": "19x3"
  },
  {
   "id": "s10:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": "(And under a faint nausea, a throbbing ache in the back of my head...)",
   "box": "19x3"
  },
  {
   "id": "s10:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": "(My arms and legs are completely numb... They won't do a thing I tell them...)",
   "box": "19x3"
  },
  {
   "id": "s10:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": "(This awful weakness...)",
   "box": "19x3"
  },
  {
   "id": "s10:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": "(And... and on top of that... why are my eyelids so heavy...!?)",
   "box": "19x3"
  },
  {
   "id": "s10:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": "(What on earth... ...is wrong... with my body...)",
   "box": "19x3"
  },
  {
   "id": "s10:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": "(Yesterday, I'm sure I... Wait... huh!?)",
   "box": "19x3"
  },
  {
   "id": "s10:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": "(What's today, anyway... ......??)",
   "box": "19x3"
  },
  {
   "id": "s10:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": "(No, hold on,)",
   "box": "19x3"
  },
  {
   "id": "s10:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": "(Who I am, to begin with...)",
   "box": "19x3"
  },
  {
   "id": "s10:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": "(Who am I!?)",
   "box": "19x3"
  },
  {
   "id": "s10:00602",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00626",
   "op": "15",
   "jp": "・・・・・よかった～！",
   "en": ".....Oh, phew!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:0065e",
   "op": "15",
   "jp": "もう・・・",
   "en": "Geez...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:0067a",
   "op": "15",
   "jp": "一生目を覚まさないんじゃないかと、思っちゃったよ！",
   "en": "I thought you'd never wake up as long as you lived!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:006be",
   "op": "15",
   "jp": "だって・・・",
   "en": "I mean...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:006de",
   "op": "15",
   "jp": "だって、もう十ヶ月以上も・・・\n高熱を出したまま寝込んでたんだよ！",
   "en": "I mean, you've been laid up with a high fever for over ten months...!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00736",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s10:00762",
   "op": "15",
   "jp": "えっ・・・",
   "en": "Huh...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:0078e",
   "op": "15",
   "jp": "どうしたの！\nまだどこか痛むの！？",
   "en": "What's up! Does something still hurt!?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:007c6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s10:007f2",
   "op": "15",
   "jp": "まっ・・まさか！？",
   "en": "N-no way!?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00826",
   "op": "15",
   "jp": "ボクの事を・・・\n忘れちゃったとか？",
   "en": "You didn't... forget about me?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:0086a",
   "op": "15",
   "jp": "えっ！？\nまさか・・・自分の事も？",
   "en": "What!? No way... yourself, too?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:008ae",
   "op": "15",
   "jp": "キミの名前は・・・？",
   "en": "Your name is...?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00952",
   "op": "15",
   "jp": "じゃあ、ボクの名前は？",
   "en": "Then what's my name?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:009f6",
   "op": "15",
   "jp": "その通り！！",
   "en": "You got it!!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00a16",
   "op": "15",
   "jp": "良かった、良かった・・・",
   "en": "Phew, thank goodness...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00a42",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s10:00a6e",
   "op": "15",
   "jp": "ここは・・・\nキミとボクだけが住んでる家！",
   "en": "This is... the house where only you and I live!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00aaa",
   "op": "15",
   "jp": "他には誰もいないよ！！",
   "en": "There's nobody else around!!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00ae2",
   "op": "15",
   "jp": "キミは事故で大ケガをしたんだ！",
   "en": "You got badly hurt in an accident!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00b12",
   "op": "15",
   "jp": "雨の日に雷が落ちて・・・",
   "en": "Lightning struck, on a rainy day...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00b4a",
   "op": "15",
   "jp": "傷の手当はしたんだけど・・・\nずっと眠ったままなんだもん！",
   "en": "I treated your wounds and all... but you just kept on sleeping!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00b96",
   "op": "15",
   "jp": "とっても心配しちゃったよ！",
   "en": "You really had me worried!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00bc6",
   "op": "14",
   "jp": "・・・！？",
   "en": "...!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s10:00cda",
   "op": "15",
   "jp": "背中の・・・羽？",
   "en": "The... wings?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00d0a",
   "op": "15",
   "jp": "本当に・・・\n全部忘れちゃったんだ・・・",
   "en": "So you really... forgot everything...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00d46",
   "op": "15",
   "jp": "誰にでも、生えてる物じゃないか！\nキミにもボクにも・・・！",
   "en": "Everybody's got those, don't they! You, me...!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00d92",
   "op": "15",
   "jp": "・・・気にしないで、",
   "en": "...Don't sweat it,",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00dba",
   "op": "15",
   "jp": "順番に思い出していこうね・・・！",
   "en": "We'll remember it all, one piece at a time...!",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00dee",
   "op": "15",
   "jp": "この世界のこと、\nそして・・・",
   "en": "About this world, and...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00e1e",
   "op": "15",
   "jp": "ボク達のことも・・・",
   "en": "...about us...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s10:00e9a",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "Continue with Chapter 1!",
   "max": 15
  },
  {
   "id": "s10:00eb0",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "Start from Chapter 2!",
   "max": 15
  }
 ]
}
