 "strings": [
  {
   "id": "s234:00642",
   "op": "14",
   "jp": "こやつら・・・、案外やりおるぞ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:0066a",
   "op": "14",
   "jp": "この調子なら、悲願であった・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00692",
   "op": "14",
   "jp": "戦場での死を\nむかえられるやもしれん・・・！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:0078e",
   "op": "14",
   "jp": "面白い・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:007a4",
   "op": "14",
   "jp": "こんなに暇をつぶせたのは、\nひさしぶりじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00b7e",
   "op": "14",
   "jp": "なっ！\nなんだこの爺さん達は！？、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s234:00c02",
   "op": "14",
   "jp": "つっ・・・強えぇ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s234:00c32",
   "op": "14",
   "jp": "タダのジジイと見くびるでないわ！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s234:00c5a",
   "op": "14",
   "jp": "ココにいるわし等は皆・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s234:00c7c",
   "op": "14",
   "jp": "その昔は戦場を駆けめぐった\n歴戦の勇士ばかりじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s234:00cb8",
   "op": "14",
   "jp": "ひよっ子共には・・・\nまだまだ殺られはせんて！！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s234:00d4a",
   "op": "14",
   "jp": "おい！俺達は・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s234:00d64",
   "op": "14",
   "jp": "この村の人間じゃ無っ・・・！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s234:00d96",
   "op": "14",
   "jp": "百も承知！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00daa",
   "op": "14",
   "jp": "そのような事を\n気にしていられるほど\nわし等の村は悠長な状態では無い！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00df8",
   "op": "14",
   "jp": "とにかく若者を・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00e14",
   "op": "14",
   "jp": "若者を集めねば村が崩壊し・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00e3a",
   "op": "14",
   "jp": "せっかく創ったわし等の楽園が・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00efa",
   "op": "14",
   "jp": "お主達も少しは落ち着け！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s234:00f2a",
   "op": "14",
   "jp": "なんじゃお前は！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00f42",
   "op": "14",
   "jp": "ジジイならジジイらしく・・・\nジジイの味方をせんか！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s234:00fda",
   "op": "14",
   "jp": "失礼しちゃうわ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s234:00ff4",
   "op": "14",
   "jp": "ヨハネ様は\nアナタ達ほど\nジジイじゃありませんことよ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s234:0103e",
