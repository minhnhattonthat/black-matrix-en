 ],
 "strings": [
  {
   "id": "s372:008ae",
   "op": "15",
   "jp": "あっ！",
   "en": ""
  },
  {
   "id": "s372:008c6",
   "op": "15",
   "jp": "あなたは！？",
   "en": ""
  },
  {
   "id": "s372:008e6",
   "op": "15",
   "jp": "救世主様だ！！",
   "en": ""
  },
  {
   "id": "s372:00906",
   "op": "15",
   "jp": "救世主様達が\nお着きになられたぞ！！",
   "en": ""
  },
  {
   "id": "s372:00eb2",
   "op": "15",
   "jp": "ようこそ、\n我がソドムの街へ！",
   "en": ""
  },
  {
   "id": "s372:00ee2",
   "op": "15",
   "jp": "私がこの街の代表の\nスタンと申します！！",
   "en": ""
  },
  {
   "id": "s372:00f72",
   "op": "15",
   "jp": "ケルビム殿から連絡を受け\n皆様が来るのを\n心待ちにしておりました！",
   "en": ""
  },
  {
   "id": "s372:00fd6",
   "op": "15",
   "jp": "凄い・・・本当だわ！\n白い羽の人が領主をしている？！",
   "en": ""
  },
  {
   "id": "s372:01036",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s372:0106e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s372:0109a",
   "op": "15",
   "jp": "ここには常設の投票所があって、\n私も投票によって\n公平に選ばれたんですよ！！",
   "en": ""
  },
  {
   "id": "s372:010fa",
   "op": "15",
   "jp": "それよりどうですか、\nこの建物！",
   "en": ""
  },
  {
   "id": "s372:0112e",
   "op": "15",
   "jp": "これほどの物を作る技術は、\nここソドムを除いては\nどこの街にもありません！",
   "en": ""
  },
  {
   "id": "s372:0118a",
   "op": "15",
   "jp": "羽の色などにこだわらず、\n優秀な人材に重要な仕事を\nしてもらったおかげなんです！",
   "en": ""
  },
  {
   "id": "s372:011ee",
   "op": "15",
   "jp": "さぁ、どうぞ\nこの街を見てやってください！",
   "en": ""
  }
 ]
}
