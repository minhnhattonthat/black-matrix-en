{
 "source": "d1:SCENARIO/9",
 "copies": [
  "d1:SCENARIO/9",
  "d2:SCENARIO/9"
 ],
 "strings": [
  {
   "id": "s9:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": ""
  },
  {
   "id": "s9:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": ""
  },
  {
   "id": "s9:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": ""
  },
  {
   "id": "s9:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": ""
  },
  {
   "id": "s9:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": ""
  },
  {
   "id": "s9:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": ""
  },
  {
   "id": "s9:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": ""
  },
  {
   "id": "s9:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": ""
  },
  {
   "id": "s9:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": ""
  },
  {
   "id": "s9:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": ""
  },
  {
   "id": "s9:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": ""
  },
  {
   "id": "s9:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": ""
  },
  {
   "id": "s9:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": ""
  },
  {
   "id": "s9:0060e",
   "op": "15",
   "jp": "あーーーっ！？",
   "en": ""
  },
  {
   "id": "s9:0063e",
   "op": "15",
   "jp": "・・・う・・う・うぅうわあぁぁん！",
   "en": ""
  },
  {
   "id": "s9:00672",
   "op": "15",
   "jp": "もう・・・もう・・・",
   "en": ""
  },
  {
   "id": "s9:0069a",
   "op": "15",
   "jp": "目を覚まさないかと、\n思ったぁ！！",
   "en": ""
  },
  {
   "id": "s9:006ce",
   "op": "15",
   "jp": "だって、\nだって、だってだって・・・",
   "en": ""
  },
  {
   "id": "s9:00706",
   "op": "15",
   "jp": "長い間ずうぅっとずっと\n眠ったまま起きないんだもん！！",
   "en": ""
  },
  {
   "id": "s9:0075e",
   "op": "15",
   "jp": "あたしが、何回起きてって呼んでも\nおにいちゃん\n何にも言ってくれないし・・・",
   "en": ""
  },
  {
   "id": "s9:007be",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s9:007e6",
   "op": "15",
   "jp": "えっ・・\nおにいちゃん？！",
   "en": ""
  },
  {
   "id": "s9:00822",
   "op": "15",
   "jp": "どうしたの？！！\nまだどっか痛い！？",
   "en": ""
  },
  {
   "id": "s9:0085a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s9:00886",
   "op": "15",
   "jp": "まさか、おにいちゃん、\nあたしの事・・・",
   "en": ""
  },
  {
   "id": "s9:008c2",
   "op": "15",
   "jp": "忘れちゃったのーーーっ？！！",
   "en": ""
  },
  {
   "id": "s9:008f2",
   "op": "15",
   "jp": "ねぇ、おにいちゃん！\nおにいちゃんの名前は・・・？",
   "en": ""
  },
  {
   "id": "s9:009b2",
   "op": "15",
   "jp": "うん、そう！！",
   "en": ""
  },
  {
   "id": "s9:009d2",
   "op": "15",
   "jp": "じゃあ・・・\nあ・・あたしの名前は？",
   "en": ""
  },
  {
   "id": "s9:00a86",
   "op": "15",
   "jp": "うわーーい！！\n良かったぁ・・・良かった・・・！",
   "en": ""
  },
  {
   "id": "s9:00ad6",
   "op": "15",
   "jp": "ふえぇぇぇん、良かったよぉ・・・\nおにいちゃんが、おにいちゃんが\nまた起きてくれたぁ。",
   "en": ""
  },
  {
   "id": "s9:00b42",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s9:00b6e",
   "op": "15",
   "jp": "このおうちには、\nおにいちゃんとあたしの\n二人っきりしか居ないんだから。",
   "en": ""
  },
  {
   "id": "s9:00bd6",
   "op": "15",
   "jp": "もう・・・もうぜったい、\n大ケガなんかして\nあたしを悲しませちゃヤダよ！",
   "en": ""
  },
  {
   "id": "s9:00c32",
   "op": "14",
   "jp": "・・・！？",
   "en": ""
  },
  {
   "id": "s9:00d46",
   "op": "15",
   "jp": "へっ・・・？！\n背中の羽？",
   "en": ""
  },
  {
   "id": "s9:00d82",
   "op": "15",
   "jp": "なに言ってンの？？\nおにいちゃんにも生えてるじゃない！",
   "en": ""
  },
  {
   "id": "s9:00dca",
   "op": "15",
   "jp": "おにいちゃんがいつもなでてくれた\nこの羽だけは・・・",
   "en": ""
  },
  {
   "id": "s9:00e12",
   "op": "15",
   "jp": "ちゃぁんと、\nキレイにしてたんだから・・・！！",
   "en": ""
  },
  {
   "id": "s9:00e52",
   "op": "15",
   "jp": "あっそうだ！！\nおにいちゃんの羽も\nキレイにしなきゃ！",
   "en": ""
  },
  {
   "id": "s9:00e9a",
   "op": "15",
   "jp": "もうずーっと\nお風呂に入ってないでしょ！！",
   "en": ""
  },
  {
   "id": "s9:00ed6",
   "op": "15",
   "jp": "あたしが・・・\nキレイにしてあげるね！！",
   "en": ""
  },
  {
   "id": "s9:00f12",
   "op": "15",
   "jp": "だから・だから・もう２度と・・・",
   "en": ""
  },
  {
   "id": "s9:00f46",
   "op": "15",
   "jp": "一人ぼっちにしちゃ\nイヤだからね！",
   "en": ""
  },
  {
   "id": "s9:00fd2",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "",
   "max": 15
  },
  {
   "id": "s9:00fe8",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "",
   "max": 15
  }
 ]
}
