{
 "source": "d1:SCENARIO/399",
 "copies": [
  "d1:SCENARIO/399",
  "d2:SCENARIO/399"
 ],
 "strings": [
  {
   "id": "s399:00ce6",
   "op": "15",
   "jp": "ベルフェのやり方が、\n完全に正しかったとは\n思いませんが・・",
   "en": ""
  },
  {
   "id": "s399:00d36",
   "op": "15",
   "jp": "きっとこの街も変わるでしょう、\n良くも、悪くも・・・",
   "en": ""
  },
  {
   "id": "s399:00de2",
   "op": "15",
   "jp": "ありがとうございます。\nアナタが私を助けるように\n言ってくださったんですね！",
   "en": ""
  },
  {
   "id": "s399:00ea2",
   "op": "15",
   "jp": "いや、もとはと言えば\nあんたは俺達のせいで\n捕まったようなもんだし・・・",
   "en": ""
  },
  {
   "id": "s399:00f4e",
   "op": "15",
   "jp": "でも、もう私には、\n住む家もありませんし・・・",
   "en": ""
  },
  {
   "id": "s399:00fe2",
   "op": "15",
   "jp": "私を、騎士様の奴隷として\n連れていって下さいませんか！？",
   "en": ""
  },
  {
   "id": "s399:010be",
   "op": "15",
   "jp": "えっ、だ、だめだ！！\n俺達と行動すると危険なんだ！",
   "en": ""
  },
  {
   "id": "s399:01186",
   "op": "15",
   "jp": "グスッ・・グスッ・・・",
   "en": ""
  },
  {
   "id": "s399:01212",
   "op": "15",
   "jp": "わーっ、泣くなよ・・・\n・・・ど、どうしよう・・",
   "en": ""
  },
  {
   "id": "s399:01262",
   "op": "15",
   "jp": "お前がその馬鹿力で\n守ってやればいいだろ！",
   "en": ""
  },
  {
   "id": "s399:012d2",
   "op": "15",
   "jp": "しょうがねぇ、\nま、奴隷じゃなく、\n仲間としてだったらいいぜ。",
   "en": ""
  },
  {
   "id": "s399:0133e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s399:01376",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s399:01416",
   "op": "15",
   "jp": "はい！！",
   "en": ""
  },
  {
   "id": "s399:01440",
   "op": "14",
   "jp": "リンが仲間になった！！",
   "en": ""
  }
 ]
}
