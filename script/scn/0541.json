{
 "source": "d1:SCENARIO/541",
 "copies": [
  "d1:SCENARIO/541",
  "d2:SCENARIO/541"
 ],
 "strings": [
  {
   "id": "s541:00762",
   "op": "15",
   "jp": "あまり突っ込むではないぞ！！\nやつらすでになり振りなんぞ、\nまったくかまっておらん！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:007d6",
   "op": "15",
   "jp": "おう、何が来ようと\n俺の自由を守るために、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s541:00812",
   "op": "15",
   "jp": "俺は闘うぜ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s541:00836",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:00856",
   "op": "15",
   "jp": "まだ、そんな戯言を、\n信じているのか！？",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:008b2",
   "op": "15",
   "jp": "なんだと！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s541:008ee",
   "op": "15",
   "jp": "それじゃあ、お前にとって\n自由とはなんだ！？",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:0092e",
   "op": "15",
   "jp": "人は自由の名の下に、\n今まで何度も戦争を\n繰り返してきたが、",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:0097e",
   "op": "15",
   "jp": "それで得た自由は往々にして、\n他人の不自由と沢山の屍を\n生み出す原動力となった。",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:009e2",
   "op": "14",
   "jp": "・・・・・・！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s541:00a12",
   "op": "15",
   "jp": "社会という枠にしがみついて\n生きる他に、方法のない\nお前達人間にとって、",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:00a6e",
   "op": "15",
   "jp": "真の自由など、\n本当に存在するのか！！",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:00aaa",
   "op": "14",
   "jp": "・・・・・・！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s541:00ada",
   "op": "15",
   "jp": "だいたいお前は、\nこの問いに自分自身の力で、\n答えられるのか！？",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s541:00b52",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s541:00b7e",
   "op": "15",
   "jp": "正義だってそうではないか！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00baa",
   "op": "15",
   "jp": "だいたい戦争とは、\n自分達の利益を優先させて、",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00bea",
   "op": "15",
   "jp": "自らが正義を名乗る、\n卑劣漢が先に始めるものだ！！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00c32",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s541:00c5e",
   "op": "15",
   "jp": "結果的に勝った方は、\nどんなに残虐な行為をしても、\n殆ど問題にはされず・・・",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00cbe",
   "op": "15",
   "jp": "正義だから勝った\nと言う言い方で、\n民衆をだますもんなのさ！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00d1a",
   "op": "15",
   "jp": "なにぃい！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s541:00d46",
   "op": "15",
   "jp": "だいたい自分が正しいと\n信じている事など、",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00d82",
   "op": "15",
   "jp": "その人々と同じ数だけ\n存在するというのに・・・",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00dc2",
   "op": "15",
   "jp": "自分が正しいと信じている事を、\n他人にまで強制するなんて、",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00e0e",
   "op": "15",
   "jp": "それこそがすでに、\n常軌を逸した考え方なのだよ！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00e82",
   "op": "15",
   "jp": "この世に、\n絶対的な正義は有る！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s541:00ec6",
   "op": "15",
   "jp": "それじゃあ、\n善悪を決める基準とは何だ？",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00f02",
   "op": "15",
   "jp": "そしてその根拠とは何なのだ？",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:00f32",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s541:00fb2",
   "op": "15",
   "jp": "今こうしている間にも・・・\nお前達が原因で大勢の人間が\n死んでいってるのだ！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:01012",
   "op": "15",
   "jp": "だいたい本当にこの世の中に、\n絶対悪や絶対善なんて、\nあると思っているのか？！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s541:0109a",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s541:010ca",
   "op": "15",
   "jp": "ふふん、\nそういえばヨハネも・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:010fe",
   "op": "15",
   "jp": "人権とか権利とか、\n言っていたわねぇ？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:0116a",
   "op": "15",
   "jp": "ああ、言ったとも！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:0119e",
   "op": "15",
   "jp": "それじゃあ、\n他の動物や植物にも、",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:011d2",
   "op": "15",
   "jp": "生きる権利とやらが、\n有るって言うのね！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:0121e",
   "op": "15",
   "jp": "広い意味で言えばそうじゃ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:0125a",
   "op": "15",
   "jp": "全ての動植物は、他の生き物を\n栄養源にしなければ、\n生きていけない罪深き存在。",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:012ba",
   "op": "15",
   "jp": "自分達は、\n他の動物の生命を奪わなければ\n生きてはいけないくせに・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:01312",
   "op": "15",
   "jp": "どうやって生きる権利とやらを\n他の動物に主張するのかしら！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:01392",
   "op": "15",
   "jp": "そっ、いやそれは、人間が・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:013d2",
   "op": "15",
   "jp": "つまり人間は、他の動物達とは\n違う特別な存在だから、",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:0141a",
   "op": "15",
   "jp": "権利を主張してもいいと、\n言うことかしら？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:0148a",
   "op": "15",
   "jp": "あ、すまん、\n言い直させて貰おう！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:014be",
   "op": "15",
   "jp": "人権とは、\n人間が人間として、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:014ee",
   "op": "15",
   "jp": "最低限、生まれたときから\n保証されるべき、\n生命や自由や平等の事で、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:01552",
   "op": "15",
   "jp": "人間だけは、\nその全てを特別に持っている\nって言いたいのね！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:015a2",
   "op": "15",
   "jp": "だから人間は、\n他の動物をペットにしたり、\n殺したり・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:015ee",
   "op": "15",
   "jp": "彼らの生活環境を\n自由に壊したりしてもいいと！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:0163e",
   "op": "15",
   "jp": "そっ、そうは言っていない！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:0167a",
   "op": "15",
   "jp": "そもそも権利を主張する以上、\n義務も存在するっていう事よねぇ？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:016da",
   "op": "15",
   "jp": "それじゃ、人間が人間として\n最低限、守らなければならない\n義務って・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:01736",
   "op": "15",
   "jp": "なんなのかしら！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:0176a",
   "op": "15",
   "jp": "そっ、それは・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:0179e",
   "op": "15",
   "jp": "アタシにはそれ以前に、\nこの世界に住む者として\n守らなければならない、",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:017f6",
   "op": "15",
   "jp": "最低限の義務が有るように、\n思えるんだけど。",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s541:01866",
   "op": "15",
   "jp": "おっ、お主・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:0188a",
   "op": "15",
   "jp": "い、いつからそんなに\n頭の回転が速くなったんじゃ！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s541:018ee",
   "op": "15",
   "jp": "ねぇ、臆病なぼうや・・・",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:0194a",
   "op": "15",
   "jp": "アナタは、弱者が虐められる事に、\n耐えられないほどの怒りを、\n感じているみたいだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:019b6",
   "op": "15",
   "jp": "それってもしかして、\n強い者への妬みって\n奴じゃないの！？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01a06",
   "op": "14",
   "jp": "・・・！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s541:01a3e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s541:01a6a",
   "op": "15",
   "jp": "弱肉強食は言ってみれば、\n自然界の基本原則みたいな\nものでしょ？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01abe",
   "op": "15",
   "jp": "人間も動物である以上、弱ければ\n虐められるのは、ある意味\n仕方がないことじゃないかしら？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01b36",
   "op": "15",
   "jp": "病気やケガをした動物達は、\n自然に群れから置いて行かれる\nでしょう？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01b8e",
   "op": "15",
   "jp": "それを怨んだり\nする様な動物なんて、\nこの世にいるのかしら？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01c02",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s541:01c2e",
   "op": "15",
   "jp": "本来、妬みや嫉妬心って\n感情は、あのユダの管轄\nなんだけど、",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01c7e",
   "op": "15",
   "jp": "確かにあの感情には\nパワーがあって、",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01cb6",
   "op": "15",
   "jp": "自分に弱い部分がある人は、\n誰かを妬む心を\n向上心に転化させて、",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01d0a",
   "op": "15",
   "jp": "時々信じられないくらい、\nその道を極めることだって\nあるじゃない！？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01d86",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s541:01daa",
   "op": "15",
   "jp": "だから弱者を作り出した、\n世の中や人を恨むよりは・・・",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01df2",
   "op": "15",
   "jp": "なにくそ！！って、\n自分が頑張って！",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01e36",
   "op": "15",
   "jp": "自分が強者になる努力を\nした方がいいんじゃないかって、",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01e7e",
   "op": "15",
   "jp": "アタシは思うのよ！？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01ea6",
   "op": "15",
   "jp": "ねぇ！あなたはどう思う！？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s541:01efa",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s541:01f22",
   "op": "15",
   "jp": "友情などと叫んでいても、\n所詮、偽物に過ぎぬ！",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:01f72",
   "op": "15",
   "jp": "お前はいまだにセラフィムの事を、\n自分の親友だなどと\n思い込んでいるようだが・・・",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:01fd6",
   "op": "15",
   "jp": "本当に、そう信じているのか？！",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:0200a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s541:02036",
   "op": "15",
   "jp": "奴は最初から、大神官である\n父親の私に頼まれて",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:02076",
   "op": "15",
   "jp": "白き羽の奴隷達の、\nスパイ活動をしていたのだ！！",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:020da",
   "op": "15",
   "jp": "ええっ！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s541:02106",
   "op": "15",
   "jp": "お前に、わざわざ近づいたのも、",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:02136",
   "op": "15",
   "jp": "最初から、最も彼らに嫌われていた、お前の心を開くことで・・・\n彼らの人望を得ようとする為の策謀",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:021a6",
   "op": "15",
   "jp": "まんまとそれに成功した息子は、\n少しづつ反動的な奴隷を集めては、",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:021fa",
   "op": "15",
   "jp": "一網打尽にする機をうかがって\nいたのだ！",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s541:02266",
   "op": "15",
