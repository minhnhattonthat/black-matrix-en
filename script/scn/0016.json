{
 "source": "d1:SCENARIO/16",
 "copies": [
  "d1:SCENARIO/16",
  "d2:SCENARIO/16"
 ],
 "strings": [
  {
   "id": "s16:0020e",
   "op": "15",
   "jp": "目が覚めたからって・・・\nまだ、動いちゃダメだよ！",
   "en": ""
  },
  {
   "id": "s16:00252",
   "op": "15",
   "jp": "ずっと眠ったままだったんだから、\n体がびっくりしちゃうじゃないか！",
   "en": ""
  },
  {
   "id": "s16:002a6",
   "op": "15",
   "jp": "退屈しないように、\nボクがお話でもしてあげるからさ！",
   "en": ""
  },
  {
   "id": "s16:002ee",
   "op": "15",
   "jp": "あの大きな落雷があった日、\nあ・・・",
   "en": ""
  },
  {
   "id": "s16:00326",
   "op": "15",
   "jp": "といっても覚えてないよね！？",
   "en": ""
  },
  {
   "id": "s16:00356",
   "op": "15",
   "jp": "キミは風邪をひいたボクのために、\n一人で山に薬草を取りに\nいってくれたんだ・・・！",
   "en": ""
  },
  {
   "id": "s16:003ba",
   "op": "15",
   "jp": "何故医者に連れて\n行かなかったのかって？\nそっそれは・・・",
   "en": ""
  },
  {
   "id": "s16:00406",
   "op": "15",
   "jp": "ちょっとね、\n行けない事情があったんだ・・・",
   "en": ""
  },
  {
   "id": "s16:00446",
   "op": "15",
   "jp": "とにかく、山奥へと入って行った\nキミは、何かの事故に巻き込まれて\nしまったらしいんだ・・・！",
   "en": ""
  },
  {
   "id": "s16:004b6",
   "op": "15",
   "jp": "それはとても大きな事故\nだったと思う。",
   "en": ""
  },
  {
   "id": "s16:00562",
   "op": "15",
   "jp": "（だって・・・\n　ボクは見たんだ・・・！）",
   "en": ""
  },
  {
   "id": "s16:0059e",
   "op": "15",
   "jp": "（雨が止んだあの日、\n　ボクがやっと動けるようになって\n　入って行った山の中に・・・）",
   "en": ""
  },
  {
   "id": "s16:00606",
   "op": "15",
   "jp": "（キミを囲むようにして倒れている\n　大勢の兵士達の死体を・・！！）",
   "en": ""
  },
  {
   "id": "s16:00650",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s16:0067a",
   "op": "15",
   "jp": "かすかな息しかしていない、\n血だらけのキミを見たとき・・・",
   "en": ""
  },
  {
   "id": "s16:006c6",
   "op": "15",
   "jp": "ボクは、絶望して・・・\n一瞬何も考えられなく\nなっちゃったんだ・・・",
   "en": ""
  },
  {
   "id": "s16:0072a",
   "op": "15",
   "jp": "（こんな世界に一人で残されたら、\n　ボクは・・・）",
   "en": ""
  },
  {
   "id": "s16:0076e",
   "op": "15",
   "jp": "グスッ・・",
   "en": ""
  },
  {
   "id": "s16:0079a",
   "op": "15",
   "jp": "だけど、気を取り直して\n今まで頑張ってきてよかった！",
   "en": ""
  },
  {
   "id": "s16:007e2",
   "op": "15",
   "jp": "だってキミがこうして・・・",
   "en": ""
  },
  {
   "id": "s16:0080e",
   "op": "15",
   "jp": "また眼を覚ましてくれたんだもん。",
   "en": ""
  },
  {
   "id": "s16:0089e",
   "op": "15",
   "jp": "さあ、もう休んで！\nこれ以上は・・・今日は、\n無理しない方がいいと思うよ！",
   "en": ""
  },
  {
   "id": "s16:008fa",
   "op": "15",
   "jp": "早く元気になってね！",
   "en": ""
  },
  {
   "id": "s16:00b62",
   "op": "15",
   "jp": "キミが目を覚まさなかった間・・・",
   "en": ""
  },
  {
   "id": "s16:00ba2",
   "op": "15",
   "jp": "ほんとはボクは\nとっても心細かったんだ・・・",
   "en": ""
  },
  {
   "id": "s16:00bee",
   "op": "15",
   "jp": "だっていつも意地ばっかり\n張ってるボクは・・・",
   "en": ""
  },
  {
   "id": "s16:00c2e",
   "op": "15",
   "jp": "キミと一緒に居られる時だけ\n誰かに甘える事が出来たんだ・・・",
   "en": ""
  },
  {
   "id": "s16:00c8a",
   "op": "15",
   "jp": "キミに見つめられていると・・・",
   "en": ""
  },
  {
   "id": "s16:00cca",
   "op": "15",
   "jp": "忘れていた気持ちが、\nなんだか、よみがえりそうで！",
   "en": ""
  },
  {
   "id": "s16:00d0e",
   "op": "15",
   "jp": "例えみんなに嫌われようと、\nこの気持ちだけは・・・",
   "en": ""
  },
  {
   "id": "s16:00d52",
   "op": "15",
   "jp": "ずっと変わらないよ！",
   "en": ""
  },
  {
   "id": "s16:00d7a",
   "op": "15",
   "jp": "これからもずっと・・・",
   "en": ""
  },
  {
   "id": "s16:00da2",
   "op": "15",
   "jp": "ずっと一緒にいたいな！",
   "en": ""
  },
  {
   "id": "s16:0115a",
   "op": "15",
   "jp": "だっ・・大丈夫かい！？",
   "en": ""
  },
  {
   "id": "s16:01182",
   "op": "15",
   "jp": "まだ目覚めてから、一週間しか\n経ってないのに起きたりして！？",
   "en": ""
  },
  {
   "id": "s16:011d2",
   "op": "15",
   "jp": "でも無理はしない方がいいよ、\nまだ本調子じゃないみたいだもの。",
   "en": ""
  },
  {
   "id": "s16:01226",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s16:01252",
   "op": "15",
   "jp": "それと、キミに・・・\n一つだけ大事なお願いが・・・",
   "en": ""
  },
  {
   "id": "s16:01296",
   "op": "15",
   "jp": "これは重要な事だから、\n絶対に忘れないでほしいんだ！！",
   "en": ""
  },
  {
   "id": "s16:012de",
   "op": "15",
   "jp": "キミはこの世界での記憶を無くして\nしまっていて・・・",
   "en": ""
  },
  {
   "id": "s16:01326",
   "op": "15",
   "jp": "この世界の常識には、\nまだ慣れてないでしょ・・・？！",
   "en": ""
  },
  {
   "id": "s16:0136e",
   "op": "15",
   "jp": "だからボクが安心してキミを、\n家の外に送り出せるようになるまで、",
   "en": ""
  },
  {
   "id": "s16:013c2",
   "op": "15",
   "jp": "勝手に家の柵の外には、\n出ないで欲しいんだ・・・",
   "en": ""
  },
  {
   "id": "s16:01406",
   "op": "15",
   "jp": "しばらくは、\nちゃんとリハビリをしなくっちゃ！",
   "en": ""
  },
  {
   "id": "s16:01446",
   "op": "15",
   "jp": "いい？絶対に勝手に外に出ちゃ、\nダメだからね！！",
   "en": ""
  },
  {
   "id": "s16:0148a",
   "op": "15",
   "jp": "ふたりだけの・・・約束だよ！！",
   "en": ""
  }
 ]
}
