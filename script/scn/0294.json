 "strings": [
  {
   "id": "s294:0124e",
   "op": "15",
   "jp": "どうぞ、こちらへ。\nご主人様がお待ちでございます。",
   "en": "",
   "box": "17x3",
   "face": 40
  },
  {
   "id": "s294:014aa",
   "op": "15",
   "jp": "いらっしゃいませ\nどうぞごゆっくり。",
   "en": "",
   "box": "17x3",
   "face": 41
  },
  {
   "id": "s294:01cba",
   "op": "15",
   "jp": "どことなく、\nみんなぎこちないようだが・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s294:01d2a",
   "op": "15",
   "jp": "きっと落ちつかないんですよ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s294:01d5a",
   "op": "15",
   "jp": "こんな、お屋敷のメイドだなんて\n奴隷達にとってはまさに\n破格の待遇ですからね！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s294:01dee",
   "op": "15",
   "jp": "本当にそうなのか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s294:01e22",
   "op": "15",
   "jp": "はい。",
   "en": "",
   "box": "17x3",
   "face": 41
  },
  {
   "id": "s294:01e3a",
   "op": "15",
   "jp": "ご主人様は、\n本当におやさしい方で、\n私たちは、楽しく働いています！",
   "en": "",
   "box": "17x3",
   "face": 41
  },
  {
   "id": "s294:01e92",
   "op": "15",
   "jp": "ここに居られるだけで、\n私達はとっても幸せです！！",
   "en": "",
   "box": "17x3",
   "face": 41
  },
  {
   "id": "s294:01efe",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
