   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s422:010ae",
   "op": "15",
   "jp": "お前さんの言いたい事は\n分かるぜ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s422:010e6",
   "op": "15",
