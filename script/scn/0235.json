 "strings": [
  {
   "id": "s235:00d56",
   "op": "15",
   "jp": "もうこれ以上・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:00d7a",
   "op": "15",
   "jp": "老人達と戦うのは止めて下さい！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:00dae",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:00dd6",
   "op": "15",
   "jp": "アンタは・・\n無料診療所の看護婦さんか・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00e22",
   "op": "15",
   "jp": "いいんじゃよ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00e46",
   "op": "15",
   "jp": "この戦いは・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00e6a",
   "op": "15",
   "jp": "わし等が自ら望んで仕掛けた\n戦いなんじゃから・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00eae",
   "op": "15",
   "jp": "どうせ、わしらは、\nこのまま生き続けても・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00eee",
   "op": "15",
   "jp": "無為に怠惰な時間を\n過ごすだけの余生なんじゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00f32",
   "op": "15",
   "jp": "ならばいっそ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00f56",
   "op": "15",
   "jp": "戦いの場で華々しく散りたいと\n思い続けていたんじゃよ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:00fa6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s235:00fd2",
   "op": "15",
   "jp": "いいえ！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:00ffe",
   "op": "15",
   "jp": "お年寄りには、お年寄りにしか\n出来ない事だって・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01046",
   "op": "15",
   "jp": "必ずあります！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01076",
   "op": "15",
   "jp": "こんなところで無駄死にする\n必要なんて・・・！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:010b6",
   "op": "15",
   "jp": "アナタ達にだって・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:010de",
   "op": "15",
   "jp": "誰かの愛情を受ける資格は・・・\nあるはずだわ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:0121a",
   "op": "15",
   "jp": "これで・・いいんじゃよ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:0124a",
   "op": "15",
   "jp": "くっくっくっっ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:01272",
   "op": "15",
   "jp": "「面白き・・・\n　こともなき世を面白く・・・」",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:012b2",
   "op": "15",
   "jp": "ゲフッ！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:0131e",
   "op": "15",
   "jp": "お主、先ほど看護婦などと\n呼ばれていたが・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s235:0135e",
   "op": "15",
   "jp": "もしやお主も、大神官の血を引きし\n魔道が使える娘なのか・・・！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s235:013b2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01422",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s235:0144e",
   "op": "15",
   "jp": "その割には頭に角も生えてない\nみたいですし・・・ゲフッ・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s235:014aa",
   "op": "15",
   "jp": "愛情だなんて、まるで・・・\n邪教徒みたいな言いぐさでしたわ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s235:01512",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s235:0154a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s235:0156a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01586",
   "op": "15",
   "jp": "私は、アイテムの力を使って、\n治療をおこなっているんです・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:015d6",
   "op": "15",
   "jp": "それよりもアナタ・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:015fe",
   "op": "15",
   "jp": "さっきから随分と顔色が\n悪いようですけど・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:0164e",
   "op": "15",
   "jp": "よっ・・余計なお世話よ！！\nゴフッ・・ゲフゲフッ・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s235:016ca",
   "op": "15",
   "jp": "（ハッ！）",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:0171a",
   "op": "15",
   "jp": "（これは・・・！？）",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01742",
   "op": "15",
   "jp": "・・・・私の名はドミナ",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:0176a",
   "op": "15",
   "jp": "これでも医術には多少の心得が\nあります・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:017aa",
   "op": "15",
   "jp": "私もアナタ達のお供の一人に、\n加えては\nいただけませんでしょうか？！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:0180e",
   "op": "1d",
   "jp": "仲間にする",
   "en": "",
   "max": 15
  },
  {
   "id": "s235:01820",
   "op": "1d",
   "jp": "仲間にしない",
   "en": "",
   "max": 15
  },
  {
   "id": "s235:01852",
   "op": "15",
   "jp": "わしも、もう年じゃし・・・\nルピルピもかなり衰弱しておる！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s235:018ae",
   "op": "15",
   "jp": "まさに渡りに船という奴だな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s235:018ea",
   "op": "15",
   "jp": "医者だって言うなら・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s235:01916",
   "op": "15",
   "jp": "歓迎させてもらうぜ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s235:0194e",
   "op": "15",
   "jp": "ありがとうございます・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:0197e",
   "op": "15",
   "jp": "（あんな重病人を・・・）",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:019aa",
   "op": "15",
   "jp": "（一人で戦場に向かわせるなんて\n　私には・・・）",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01a52",
   "op": "15",
   "jp": "（まさかこの女・・・）",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s235:01a7a",
   "op": "15",
   "jp": "（アタシのアイドルとしての\n　地位を脅かそうとたくらむ・・・）",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s235:01aca",
   "op": "15",
   "jp": "（ジジイフェチなんじゃ！？）",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s235:01b08",
   "op": "14",
   "jp": "ドミナが仲間になった！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s235:01bae",
   "op": "15",
   "jp": "そうですか・・・\nそれでは仕方が・ありませんね・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01bf6",
   "op": "15",
   "jp": "ルピルピさん・・・\nどうかお体を大切に・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s235:01e7e",
   "op": "15",
   "jp": "みんな！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:01e9a",
   "op": "15",
   "jp": "これ以上戦うのは止めてよ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:02042",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s235:02066",
   "op": "15",
   "jp": "いいんじゃよ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:0208a",
   "op": "15",
   "jp": "この戦いは・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:020ae",
   "op": "15",
   "jp": "わし等が自ら望んで仕掛けた\n戦いなんじゃから・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:020f2",
   "op": "15",
   "jp": "どうせ、わしらは、\nこのまま生き続けても・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02132",
   "op": "15",
   "jp": "無為に怠惰な時間を\n過ごすだけの余生なんじゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02176",
   "op": "15",
   "jp": "ならばいっそ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:0219a",
   "op": "15",
   "jp": "戦いの場で華々しく散りたいと\n思い続けていたんじゃよ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:021ea",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s235:02216",
   "op": "15",
   "jp": "だけど・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:02236",
   "op": "15",
   "jp": "お年寄りには、お年寄りにしか\n出来ない事だって・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:0228a",
   "op": "15",
   "jp": "必ずあるはずだよ・・・！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:022b6",
   "op": "15",
   "jp": "こんなところで・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:022de",
   "op": "15",
   "jp": "みすみす無駄死にする\nなんて・・・！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:02322",
   "op": "15",
   "jp": "みんなも、もっと・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:02372",
   "op": "15",
   "jp": "お年寄りは大切にしようよ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:024e2",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s235:02512",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s235:0252e",
   "op": "15",
   "jp": "ふん！くだらないわ・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s235:0255a",
   "op": "15",
   "jp": "年老いて力の無くなった者は\nただ消え去るのみ・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s235:0259e",
   "op": "15",
   "jp": "それこそが大自然のオキテじゃない！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s235:025d6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:0266e",
   "op": "15",
   "jp": "わし等のおかげで・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02696",
   "op": "15",
   "jp": "すっかり迷惑をかけてしまった\nようじゃな・・・！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:026da",
   "op": "15",
   "jp": "たしかにオマエの言うとおり\nわしにも、この世界のためにまだ\nやれるべき事があるのかもしれん",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02746",
   "op": "15",
   "jp": "どうだ！\nわしをオマエ達の仲間に\n加えてはくれんか！？",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:0279e",
   "op": "1d",
   "jp": "仲間にする",
   "en": "",
   "max": 15
  },
  {
   "id": "s235:027b0",
   "op": "1d",
   "jp": "仲間にしない",
   "en": "",
   "max": 15
  },
  {
   "id": "s235:027e2",
   "op": "15",
   "jp": "わしの名はマステマ！！\n老いたりとて・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:0281e",
   "op": "15",
   "jp": "まだまだ若い者には負けんぞ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02852",
   "op": "15",
   "jp": "なにせ若い頃には千人殺しの・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02886",
   "op": "15",
   "jp": "雷神のマステマと呼ばれて\nいたんじゃからな！！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:028de",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s235:0293a",
   "op": "15",
   "jp": "くっくっくっ・・・\n千人殺しだってよ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s235:029d2",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s235:029fc",
   "op": "14",
   "jp": "マステマが仲間になった！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s235:02a96",
   "op": "15",
   "jp": "そうか・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02ab6",
   "op": "15",
   "jp": "老兵は・・・ただ消え去るのみと\nいうわけじゃな・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02afe",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:02b2a",
   "op": "15",
   "jp": "それなら村に戻ってもう一度、\n一から出直してみるとするか・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s235:02d92",
   "op": "15",
   "jp": "くっくっくっっ・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
