   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s235:03112",
   "op": "15",
   "jp": "しっかし・・・\nなんて村だよココはいったい・・・！",
   "en": "",
   "box": "17x3",
   "face": 2
