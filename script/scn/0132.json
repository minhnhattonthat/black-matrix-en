{
 "source": "d1:SCENARIO/132",
 "copies": [
  "d1:SCENARIO/132",
  "d2:SCENARIO/132"
 ],
 "strings": [
  {
   "id": "s132:0050e",
   "op": "14",
   "jp": "おい、ピリポ！\n俺様に、その武器をよこせ！",
   "en": ""
  },
  {
   "id": "s132:0054e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s132:0056e",
   "op": "14",
   "jp": "これだから筋肉バカは困る。",
   "en": ""
  },
  {
   "id": "s132:0059e",
   "op": "14",
   "jp": "なにぃ！",
   "en": ""
  },
  {
   "id": "s132:005ba",
   "op": "14",
   "jp": "何事も力で片付けようと\nするから、困るんだよな。",
   "en": ""
  },
  {
   "id": "s132:005f2",
   "op": "14",
   "jp": "ようするにあたまさ！\nお前に付いているのはかざりか？",
   "en": ""
  },
  {
   "id": "s132:0063a",
   "op": "14",
   "jp": "ふっ、甘めぇな。\n最後に生き残ればいいのさ！",
   "en": ""
  },
  {
   "id": "s132:0066e",
   "op": "14",
   "jp": "オレ様の邪魔を\nするんじゃねぇぞ！",
   "en": ""
  },
  {
   "id": "s132:006a6",
   "op": "14",
   "jp": "何でもいいから、早く装備しろ！",
   "en": ""
  },
  {
   "id": "s132:006da",
   "op": "14",
   "jp": "武器を手に入れた！",
   "en": ""
  },
  {
   "id": "s132:007a2",
   "op": "14",
   "jp": "ちぃ、やりやがったな！！\nだいぶ血を流しちまった。\nここは一旦下がらせてもらうぜ。",
   "en": ""
  },
  {
   "id": "s132:00892",
   "op": "14",
   "jp": "くそおっ！！\n貴様のようなへなちょこ野郎に",
   "en": ""
  },
  {
   "id": "s132:008c4",
   "op": "14",
   "jp": "俺様が殺られるかよぉ！！",
   "en": ""
  },
  {
   "id": "s132:0097a",
   "op": "14",
   "jp": "ごめんね・・・",
   "en": ""
  },
  {
   "id": "s132:00990",
   "op": "14",
   "jp": "ボクはもう、戦えそうにないよ・・・",
   "en": ""
  },
  {
   "id": "s132:00bfe",
   "op": "14",
   "jp": "俺を誰だと思ってる！！",
   "en": ""
  },
  {
   "id": "s132:00c2a",
   "op": "14",
   "jp": "二百人殺しの\n疾風のガイ様だぜ！！",
   "en": ""
  },
  {
   "id": "s132:0108e",
   "op": "14",
   "jp": "良く見てろよ！\n相手に十分近づいてから殴る！\nこれが俺の殺り方だ！！",
   "en": ""
  },
  {
   "id": "s132:01122",
   "op": "14",
   "jp": "俺は強い奴に憧れた・・・\nなぜなら強さこそが\nこの世界唯一の真理だからだ！",
   "en": ""
  },
  {
   "id": "s132:01182",
   "op": "14",
   "jp": "俺の強さが・・・\n貴様にも分かったかぁ！！",
   "en": ""
  },
  {
   "id": "s132:0142e",
   "op": "14",
   "jp": "効かねえなぁ！\nこの最強の肉体にはよ！！",
   "en": ""
  },
  {
   "id": "s132:016d6",
   "op": "14",
   "jp": "無理無理！\nそんな攻撃、頭の上に、\nハエが止まってるぜ！",
   "en": ""
  },
  {
   "id": "s132:0198e",
   "op": "14",
   "jp": "ボクが、壁になるよ！",
   "en": ""
  },
  {
   "id": "s132:019aa",
   "op": "14",
   "jp": "これぐらいの攻撃、\nボクは殴られ慣れてるんだ！",
   "en": ""
  },
  {
   "id": "s132:01bf6",
   "op": "14",
   "jp": "あれっ？\n動きが鈍いと\n攻撃も当たりにくいのかな！？",
   "en": ""
  }
 ]
}
