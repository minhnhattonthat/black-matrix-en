{
 "source": "d1:SCENARIO/269",
 "copies": [
  "d1:SCENARIO/269",
  "d2:SCENARIO/269"
 ],
 "strings": [
  {
   "id": "s269:00ec2",
   "op": "15",
   "jp": "やはり選ばれた者にしか、\n鎧は使いこなせぬようじゃな！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s269:00f1a",
   "op": "15",
   "jp": "ちぃっ、役立たずどもめ！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:00f46",
   "op": "15",
   "jp": "かまわん！\n鎧の中身などいくらでもいる！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:00f9e",
   "op": "15",
   "jp": "お前も行けっ！\n行って鎧の力で、\n奴等共々死んでこい！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:0100a",
   "op": "15",
   "jp": "いっ、いやだ～～っ！",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01032",
   "op": "15",
   "jp": "死んでまでアンタの言う事なんか、\n聞きたくない～っ！",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:010aa",
   "op": "15",
   "jp": "いっ、今の声は、まさか\nパルタ？パルタなのか？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:0110a",
   "op": "15",
   "jp": "貴様ぁ～～！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:0112a",
   "op": "15",
   "jp": "金で雇われている分際でぇ！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:01156",
   "op": "15",
   "jp": "俺が我が手で殺してくれるわ～っ！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:012b2",
   "op": "15",
   "jp": "うぁぁあぁあぁあぁあぁぁあぁ！",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:0149a",
   "op": "15",
   "jp": "ひっ、ひでぇ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s269:014da",
   "op": "15",
   "jp": "いくら強力な力が込められた\n大邪神の鎧とはいえ、",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:0151e",
   "op": "15",
   "jp": "所詮中身は生身の人間、\n我が魔法力の前に塵芥と\n化すがいい！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s269:0158a",
   "op": "15",
   "jp": "あっ、あんまりだ・・・\n自分の仲間にそこまで\nひどい仕打ちをするなんて！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:0174a",
   "op": "15",
   "jp": "やっぱり自由に生きるためには・・\n強い力が必要なんだ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s269:017b2",
   "op": "15",
   "jp": "パルタ！？\nパルタなの本当に？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01802",
   "op": "15",
   "jp": "どうしちまったんだ、\n筋肉バカとピリポの野郎、\n敵が目の前に居るってのに・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s269:01872",
   "op": "15",
   "jp": "もうっ！白い羽の人達って\n何を考えてるのかしら？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s269:018ce",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s269:01906",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s269:0193e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s269:0197a",
   "op": "15",
   "jp": "やっぱりパルタなのか？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:019c2",
   "op": "15",
   "jp": "兄ちゃん・・・\nその声は兄ちゃんなのか？",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01a0a",
   "op": "15",
   "jp": "なんで・・・オマエが\nこんな物を着て！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01a52",
   "op": "15",
   "jp": "ゴメンよ。",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01a6e",
   "op": "15",
   "jp": "昔っからボクは・・・\n弱虫だった兄ちゃんが・・・\n大嫌いだった・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01ad2",
   "op": "15",
   "jp": "パルタ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01afe",
   "op": "15",
   "jp": "兄ちゃんがゴルゴダに行った後・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01b32",
   "op": "15",
   "jp": "ボクは強くなる為に修行して・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01b66",
   "op": "15",
   "jp": "マモン様の部下になり・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01b92",
   "op": "15",
   "jp": "この・・大邪神の鎧を着る事で・・\n自分は強いんだと・・・\n思い・・こもうとしてたんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01bfe",
   "op": "15",
   "jp": "でも・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01c1a",
   "op": "15",
   "jp": "でも、それは・・・\n自分自身の弱さを・・・\n認めたくなかったからなんだ・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01c86",
   "op": "15",
   "jp": "そんなことはないよ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01cb2",
   "op": "15",
   "jp": "お前は昔から、\n頭も良くて運動も出来て、\nそして強かった！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01d0e",
   "op": "15",
   "jp": "そんな・・肩書きに頼った\n強さなんか・・・本当の・・\n強さじゃ・・なかったんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01d76",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01da2",
   "op": "15",
   "jp": "兄ちゃんは・・・\nいくら・・イジメられても\nそんな現実から・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01df6",
   "op": "15",
   "jp": "逃げなかったし・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01e1e",
   "op": "15",
   "jp": "なにかに・・・頼ろうとも・・\nしなかった・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01e5e",
   "op": "15",
   "jp": "本当の・・強さを・・\n持っていたのは・・・兄ちゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 39
  },
  {
   "id": "s269:01ec6",
   "op": "15",
   "jp": "ウワーッ！\nパルターーーーーーーッ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:01f8e",
   "op": "15",
   "jp": "こいつだって、\n強そうな奴だったのに、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s269:01fc6",
   "op": "15",
   "jp": "いくら強くなったって\n奴隷は一生自由になる事は、\n出来ねえってのかっ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s269:020b2",
   "op": "15",
   "jp": "ボクは、強くなんかないよ！\nでも今はなんだかとっても\n強くなりたいんだ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:0219e",
   "op": "15",
   "jp": "白でも黒でもない、\nそんな力を！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s269:0225a",
   "op": "15",
   "jp": "強い力を。",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s269:02302",
   "op": "15",
   "jp": "新しい力を。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s269:02362",
   "op": "15",
   "jp": "何をするつもりじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s269:0238a",
   "op": "15",
   "jp": "まさかあの鎧を？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s269:023ba",
   "op": "15",
   "jp": "やめろ、お前達では無理・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s269:02872",
   "op": "15",
   "jp": "あれは、あの時と同じ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s269:028aa",
   "op": "15",
   "jp": "邪神の光臨！！",
   "en": "",
   "box": "17x3",
   "face": 5
  }
 ]
}
