{
 "source": "d1:SCENARIO/183",
 "copies": [
  "d1:SCENARIO/183",
  "d2:SCENARIO/183"
 ],
 "strings": [
  {
   "id": "s183:00bf6",
   "op": "15",
   "jp": "お主も先ほどのユダとの会話、\n聞いておったであろう！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:00c42",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s183:00c6e",
   "op": "15",
   "jp": "この大邪神の鎧の正体は、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:00c9a",
   "op": "15",
   "jp": "かの創世記戦争で滅んだ、白き羽の\n邪神達の魂が封じ込められし\nいわば、呪われた生きた鎧！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:00e06",
   "op": "15",
   "jp": "普通の人間が身に纏えば・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:00e96",
   "op": "15",
   "jp": "死してその屍を\n鎧に喰らいつくされるまで、\n脱ぐこともかなわず、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:00eea",
   "op": "15",
   "jp": "絶えず生き血を吸われ続ける\nこととなろう・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:00f2e",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s183:01046",
   "op": "15",
   "jp": "邪道騎士となったこのルピルピも・・そんな哀れな鎧の犠牲者なのじゃ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:01122",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s183:0114e",
   "op": "15",
   "jp": "どうやら、これらの鎧に\n喰い殺されずに着こなす為には、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:01196",
   "op": "15",
   "jp": "特別な資質が・・・\n必要とされるらしい",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:01216",
   "op": "15",
   "jp": "その事に気づいたわしは・・・\nわしの身体を気遣っておった\n彼女の気持ちも察して・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:012ba",
   "op": "15",
   "jp": "あのまま・・・獄中で\n死ぬつもりでおったのじゃ・・・！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:01356",
   "op": "15",
   "jp": "おっ・・お師匠様！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s183:013ba",
   "op": "15",
   "jp": "しかし、わしは幸運にも、\nお主と出会えたのだ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:01442",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s183:0146e",
   "op": "15",
   "jp": "お主が牢獄で放ったあの光は・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:014a2",
   "op": "15",
   "jp": "紛れもなく大悪神ゴッドの\n復活を表す邪悪なる印！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:014e6",
   "op": "15",
   "jp": "もしかするとお主ならば\nこのメタトロンの鎧を・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:0158e",
   "op": "15",
   "jp": "着れるやもしれんのじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:015d6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s183:0160e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s183:0166a",
   "op": "15",
   "jp": "お主に黙って、この鎧の\n実験材料にしようとした事は謝る。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:016fa",
   "op": "15",
   "jp": "じゃが無理にとは言わんが、\nもしオマエが本当に自分の飼い主を\n助けたいと願うのならば・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:01776",
   "op": "15",
   "jp": "この鎧に宿った、\n大邪神の力を手に入れる以外・・・\nもはや方法はなかろう！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:017d6",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s183:017fe",
   "op": "15",
   "jp": "でもね・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s183:0181e",
   "op": "15",
   "jp": "この鎧を身に纏うためには、\nその背中の羽を、自らの手で・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s183:018fe",
   "op": "15",
   "jp": "むしり取らなければならないわ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s183:0193e",
   "op": "15",
   "jp": "アナタにそれだけの・・・\n覚悟があるの？！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s183:019be",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s183:01a12",
   "op": "15",
   "jp": "大けがをした\nアナタを見た時・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01a46",
   "op": "15",
   "jp": "私・・・\n胸が潰れそうになったのよ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01a82",
   "op": "15",
   "jp": "アナタが死んだら、\nどうしたらいいかって・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01ac2",
   "op": "15",
   "jp": "アナタが側にいてくれれば、\n他には何もいらないのに。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01b0a",
   "op": "15",
   "jp": "私・・・アナタのためなら\nどんなことでも出来る！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01b4e",
   "op": "15",
   "jp": "例えそれが・・・\nどんなに罪なことでも・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01baa",
   "op": "15",
   "jp": "大けがをして倒れてる\nお兄ちゃんを見つけた時・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01bee",
   "op": "15",
   "jp": "私、びっくりして\n心臓が止まっちゃうかと\n思ったんだから",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01c3a",
   "op": "15",
   "jp": "ホントに・・・\nホントに朝まで泣いてたんだよ！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01c7a",
   "op": "15",
   "jp": "お兄ちゃんが死んだら\n私、ひとりぼっちでなんか\n生きていけないよう・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01cd6",
   "op": "15",
   "jp": "お兄ちゃんが側にいてくれれば\n他にはなにもいらないもん！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01d22",
   "op": "15",
   "jp": "私、お兄ちゃんのためなら\nどんなことでも、できるよ。\n例え・・・それが・・・\nどんなに悪いことでも・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01dba",
   "op": "15",
   "jp": "大けがをしたキミを見た時\nボクは胸が潰れそうになったよ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01e0a",
   "op": "15",
   "jp": "キミが・・・\nもしも死んだりしたら",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01e3e",
   "op": "15",
   "jp": "またボクは自分の本当の\n素顔を・・・隠したまま・・・\n生き続けなきゃならなくなる",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01ea2",
   "op": "15",
   "jp": "キミが側に居てくれさえすえば\nボクは・・・ボクは他には\nなんにもいらないのに・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01f06",
   "op": "15",
   "jp": "キミのためなら・・・\nどんなことでもできる。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01f46",
   "op": "15",
   "jp": "例え・・・それが・・・\nどんな大罪に問われようとも。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01faa",
   "op": "15",
   "jp": "私は・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:01fc6",
   "op": "15",
   "jp": "キミと一緒にいられる時だけ\n人に甘えることができたんだと思う",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:02016",
   "op": "15",
   "jp": "キミに見つめられていると・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:02046",
   "op": "15",
   "jp": "忘れていた気持ちが・・・\n何だかよみがえりそうで・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:0208e",
   "op": "15",
   "jp": "たとえみんなに毛嫌いされようと\nこの気持ちだけは・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:020d6",
   "op": "15",
   "jp": "ずっと、ずーーーっと\n変わらないよ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:0212a",
   "op": "15",
   "jp": "大けがをしたアンタを見たとき\n胸が潰れそうになったわ！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:02172",
   "op": "15",
   "jp": "アンタが死んだら・・・\nどうしたらいいのかって・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:021ba",
   "op": "15",
   "jp": "側に居てくれれば・・・\n他には何もいらない。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:021fa",
   "op": "15",
   "jp": "キライでしょ？・・・\nアタシのことなんて・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:0223a",
   "op": "15",
   "jp": "でも、アタシはアンタのこと・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:0228a",
   "op": "15",
   "jp": "大怪我をしたお前を見たとき・・・\n俺は、自分の胸が潰れそうになった",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:022de",
   "op": "15",
   "jp": "お前が死んだら・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:02306",
   "op": "15",
   "jp": "俺はいったい\nどうしたらいいかって・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:02342",
   "op": "15",
   "jp": "お前が側にいてくれれば・・・\n他には何もいらないのに。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:0238a",
   "op": "15",
   "jp": "俺はお前のためなら\nどんなことでもできる！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:023c6",
   "op": "15",
   "jp": "例えそれが・・・\nどんな罪に問われようとも",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s183:026a2",
   "op": "15",
   "jp": "おおっ、\nこれぞまさしく！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:026de",
   "op": "15",
   "jp": "あまたの悪魔達の力を\nはるかにしのぐ大邪神・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:02746",
   "op": "15",
   "jp": "偉大なる、メタトロンの光！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:02782",
   "op": "15",
   "jp": "すっ・・すごいわ！！\nにっ日記、日記に書かなくちゃ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s183:027d6",
   "op": "15",
   "jp": "この光だ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s183:02806",
   "op": "15",
   "jp": "この光が・・ボクを・・\n変えてくれたんだ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s183:02882",
   "op": "15",
   "jp": "な、何なの\nこのまばゆい輝きは・・・？！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s183:028e2",
   "op": "15",
   "jp": "ばかな！？\n本物の・・・\n邪神の復活だというのか？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s183:02996",
   "op": "15",
   "jp": "ハーッッハハハハハハ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:02a16",
   "op": "15",
   "jp": "どうじゃ見たかユダ！！\nわしはついに、\nかの大邪神の魂を・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:02a66",
   "op": "15",
   "jp": "再び解き放ったのだぁ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s183:02a92",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s183:02aaa",
   "op": "15",
   "jp": "ハッ！！\n邪神を信じる\n忌まわしき異端者どもめ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s183:02aee",
   "op": "15",
   "jp": "大善神サタン様の名の下、\nお前達を許すわけにはいかん！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s183:02b9a",
   "op": "15",
   "jp": "殺せぇつ！！皆殺しだー！",
   "en": "",
   "box": "17x3",
   "face": 13
  }
 ]
}
