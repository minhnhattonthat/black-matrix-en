 "strings": [
  {
   "id": "s50:0007a",
   "op": "15",
   "jp": "どうしたんだ・・・？",
   "en": ""
  },
  {
   "id": "s50:000a2",
   "op": "15",
   "jp": "ひょっとして、また・・・\n体の具合でも悪いのか？",
   "en": ""
  },
  {
   "id": "s50:000fa",
   "op": "15",
   "jp": "ほら、どうしたんだ・・・？",
   "en": ""
  },
  {
   "id": "s50:00126",
   "op": "15",
   "jp": "なに甘えてるんだよ！？\nしっかりリハビリしろよ！",
   "en": ""
  },
  {
   "id": "s50:001be",
   "op": "15",
   "jp": "おはよう！\nどうだい！？\n気分の方は・・・",
   "en": ""
  },
  {
   "id": "s50:0022a",
   "op": "15",
   "jp": "そよ風が気持ちいい朝だ・・・\n今日も頑張って\nリハビリしなくちゃな！",
   "en": ""
  },
  {
   "id": "s50:002ae",
   "op": "15",
   "jp": "おはようっ！\nさってと、\n今日も朝からがんばろーぜ！！",
   "en": ""
  },
  {
   "id": "s50:00326",
   "op": "15",
   "jp": "おはよう！\n今日も昼間は暑くなりそうだなぁ！",
   "en": ""
  },
  {
   "id": "s50:00392",
   "op": "15",
   "jp": "そろそろ過ごしやすい季節に\nなってきたな・・・",
   "en": ""
  },
  {
   "id": "s50:003d2",
   "op": "15",
   "jp": "もたもたしてると、\n冬がそこまでやって来ちまうよ！！",
   "en": ""
  },
  {
   "id": "s50:00446",
   "op": "15",
   "jp": "おはよう。\nそろそろ寒くなるから・・・\n冬支度を始めようなっ！",
   "en": ""
  },
  {
   "id": "s50:004c6",
   "op": "15",
   "jp": "おはようっ！今日はなんだか、\n雪でも降りそうだ・・・\nなんか楽しみだぜ！",
   "en": ""
  },
  {
   "id": "s50:0054e",
   "op": "15",
   "jp": "冬来たりなば、春遠からじ\n・・・って言ってさ、\n春も、もうすぐそこだよな！",
   "en": ""
  }
 ]
}
