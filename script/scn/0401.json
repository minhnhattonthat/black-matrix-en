{
 "source": "d1:SCENARIO/401",
 "copies": [
  "d1:SCENARIO/401",
  "d2:SCENARIO/401"
 ],
 "strings": [
  {
   "id": "s401:00d46",
   "op": "15",
   "jp": "これで・・・\n良かったんですかね・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s401:00e0a",
   "op": "15",
   "jp": "たぶん良かったんだと思うぜ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:00eb6",
   "op": "15",
   "jp": "無軌道な開発に\nはやった街づくりなんて、\nどっかで破綻するもんさ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:00f3e",
   "op": "15",
   "jp": "でも、よその街よりは・・・\nよっぽどましだったぜ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s401:0103a",
   "op": "15",
   "jp": "良かったに\n決まってるじゃないか！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s401:010ea",
   "op": "15",
   "jp": "誰かに命令されなきゃ\n何もできない生き方なんて、\n間違ってるぜ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s401:0116e",
   "op": "15",
   "jp": "でも、\nよその街よりは・・・\nよっぽどましだったな。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:0120a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:0124e",
   "op": "15",
   "jp": "しかしこれだけ\n過酷な結果を出した以上、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:0128a",
   "op": "15",
   "jp": "お主にはお主が理想とする\nやり方が、きっとあるんじゃろうな。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:0132e",
   "op": "15",
   "jp": "代案も出さずに、\n人のやり方を\n非難する事は簡単。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01372",
   "op": "15",
   "jp": "しかしそんな消極的な\n考え方ならば、命がけで\n旅をする意味などない！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01452",
   "op": "15",
   "jp": "うむ、どちらの街にも\n何かしらの問題はあるが、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01492",
   "op": "15",
   "jp": "それらは、街に住む者達が\n各々の手で解決して行かねば\nならない問題じゃからな。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:014f2",
   "op": "15",
   "jp": "確かにここは、\n黙ってこの場を立ち去るのが\n得策なのかも知れん・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:0156e",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s401:015ba",
   "op": "15",
   "jp": "どちらにしろ、\nいずれは各々が\n一番良いと思う未来を、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01602",
   "op": "15",
   "jp": "自分自身の手で\n見つけださねばならぬだろう。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:0167e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s401:016b6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s401:016fe",
   "op": "15",
   "jp": "全部の人が平等で、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s401:01722",
   "op": "15",
   "jp": "しかも一人一人が\n自由になる事は・・\nできないのかな！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s401:018ce",
   "op": "15",
   "jp": "この世界のあり方を変えん限りは\n難しい問題じゃな・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01916",
   "op": "15",
   "jp": "そのためには、\nこの世界の支配者、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01972",
   "op": "15",
   "jp": "アンゲルス教の教皇に、\nなんとしても会わねばならん！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s401:01b46",
   "op": "15",
   "jp": "いよいよですね！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s401:01b6a",
   "op": "15",
   "jp": "ケルビムさんの話では、\nこの街を抜ければ、",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s401:01ba6",
   "op": "15",
   "jp": "教皇がいる総本山まで、\nあと少しのようです。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s401:01c16",
   "op": "15",
   "jp": "日記を付ける手にも、\n自然に力が入りますわ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s401:01caa",
   "op": "15",
   "jp": "いつか見てみたいもんだな、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:01cd6",
   "op": "15",
   "jp": "その復讐日記の中に、\n誰の名が書いてあるのか・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:01d72",
   "op": "15",
   "jp": "・・・って、おい！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:01d96",
   "op": "15",
   "jp": "誰の顔見ながら\n日記をつけてやがんだ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s401:01e32",
   "op": "15",
   "jp": "なるほど、そういう\n結論を導き出しましたか。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s401:01e72",
   "op": "15",
   "jp": "その思考・行動・決断力。",
   "en": "",
   "box": "17x3",
   "face": 121
  },
  {
   "id": "s401:01e9e",
   "op": "15",
   "jp": "理論上とはいえ、彼らが私の\n求める人物である可能性は、\nおおいにありますね・・・",
   "en": "",
   "box": "17x3",
   "face": 121
  }
 ]
}
