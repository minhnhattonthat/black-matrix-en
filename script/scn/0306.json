{
 "source": "d1:SCENARIO/306",
 "copies": [
  "d1:SCENARIO/306",
  "d2:SCENARIO/306"
 ],
 "strings": [
  {
   "id": "s306:00696",
   "op": "14",
   "jp": "うぉーっ！腹が減ったぁっ！\nなにか喰わせろぉぉおおっ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00712",
   "op": "14",
   "jp": "この街はいいところだよぉ・・・\n何より、食い物がうまい！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:0078e",
   "op": "14",
   "jp": "この街の支配者は、バアル様だぁ\nとっても優しい紳士で、おらも\n食事に招待された事があるんだぁ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:007f4",
   "op": "14",
   "jp": "ヨロイ！？\n知らないなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:0081a",
   "op": "14",
   "jp": "トリュフなら知ってるけど、\n食い物じゃないよねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00856",
   "op": "14",
   "jp": "なに？黒い羽の女性、\nその辺探せば、\n沢山いるだろう？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:008ce",
   "op": "14",
   "jp": "バアル様の屋敷で\n何かあったらしいぜ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:008fc",
   "op": "14",
   "jp": "ついさっきも奴隷達が大勢\n屋敷に連れて行かれたところだ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00976",
   "op": "14",
   "jp": "なんだい客かい！？\n珍しいねぇ、\nわざわざ歩いて来るなんて",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:009b8",
   "op": "14",
   "jp": "でも悪いケド\n今材料を切らしててさぁ、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:009e6",
   "op": "14",
   "jp": "そういうわけで\nとっとと出てってくれ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00a14",
   "op": "14",
   "jp": "・・・なんて言ってみたいよなぁ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00a9a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00ac4",
   "op": "14",
   "jp": "犬に話しかけたからといって\n「わんわん」とでも言うと\n思ったのか？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00b0e",
   "op": "14",
   "jp": "お前はいつも犬に話しかけるのか？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00b36",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00b48",
   "op": "14",
   "jp": "わんわん",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00ba2",
   "op": "14",
   "jp": "すいません、お客さん！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s306:00bc0",
   "op": "14",
   "jp": "今、店の人間は\nバアル様のお屋敷に呼ばれて\n誰もいないんです・・・",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s306:00c0a",
   "op": "14",
   "jp": "私も後から来るように\n言われてるし、",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s306:00c36",
   "op": "14",
   "jp": "またいらしてくださいね！！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s306:00ca2",
   "op": "14",
   "jp": "いらっしゃい！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00cb8",
   "op": "14",
   "jp": "この店の食料は、\n他の街から仕入れてきた、\n保存に適した品揃えばかりだよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00d0a",
   "op": "14",
   "jp": "うちの品物は味よりも、\n長持ちする質に\nこだわってるんだ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00d4e",
   "op": "14",
   "jp": "しこたま金を稼いで\nバアル様印の\n美味しい物を食べるのさ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00d90",
   "op": "14",
   "jp": "さあ、何を買うんだい！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00dda",
   "op": "14",
   "jp": "まだ買うかい？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s306:00f16",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s306:00f24",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s306:00f34",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  }
 ]
}
