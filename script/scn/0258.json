{
 "source": "d1:SCENARIO/258",
 "copies": [
  "d1:SCENARIO/258",
  "d2:SCENARIO/258"
 ],
 "strings": [
  {
   "id": "s258:005b6",
   "op": "14",
   "jp": "私っていったい、\nこの街ではいくらなのかなぁ・・・？",
   "en": ""
  },
  {
   "id": "s258:006d2",
   "op": "14",
   "jp": "強えぇ、これじゃ約束が違う！！",
   "en": ""
  },
  {
   "id": "s258:0094a",
   "op": "14",
   "jp": "け・・結構やるじゃねえか！",
   "en": ""
  },
  {
   "id": "s258:0096c",
   "op": "14",
   "jp": "もらった金だけじゃあ\nちょいと割にあわねえな！",
   "en": ""
  },
  {
   "id": "s258:009a2",
   "op": "14",
   "jp": "おっと、\n命までは売った覚えはないぜ。",
   "en": ""
  },
  {
   "id": "s258:00a8a",
   "op": "14",
   "jp": "倒したぶんだけ、\nもらえる金が増えるんだ・・・",
   "en": ""
  },
  {
   "id": "s258:00ac0",
   "op": "14",
   "jp": "お前等逃げるんじゃねえぞ！",
   "en": ""
  },
  {
   "id": "s258:00b9a",
   "op": "14",
   "jp": "奴隷を殺して金になるたぁ、\nこの世はバラ色だぜ～っ！",
   "en": ""
  },
  {
   "id": "s258:00c9a",
   "op": "14",
   "jp": "なめるなよぉ～っ！",
   "en": ""
  },
  {
   "id": "s258:00cb4",
   "op": "14",
   "jp": "そこらのザコ共より、\n俺は高い銭をもらってんだ～っ！",
   "en": ""
  },
  {
   "id": "s258:00daa",
   "op": "14",
   "jp": "へへっ、\nこいつら殺せば、俺も大金持ちだあ。",
   "en": ""
  },
  {
   "id": "s258:00eca",
   "op": "14",
   "jp": "なんだこいつら、\n結構やるじゃないか。",
   "en": ""
  },
  {
   "id": "s258:0119e",
   "op": "14",
   "jp": "おっとっと、危ない危ない",
   "en": ""
  },
  {
   "id": "s258:011be",
   "op": "14",
   "jp": "結構やるねぇ、雇われ兵士さんよぉ！",
   "en": ""
  },
  {
   "id": "s258:0127e",
   "op": "14",
   "jp": "では、\n一発ド派手な呪文を・・・",
   "en": ""
  },
  {
   "id": "s258:012b6",
   "op": "14",
   "jp": "と言いたいところじゃが・・・\n死体がなくては・・・",
   "en": ""
  },
  {
   "id": "s258:012f0",
   "op": "14",
   "jp": "さすがに呪文は唱えられん・・・",
   "en": ""
  },
  {
   "id": "s258:0136a",
   "op": "14",
   "jp": "貴様等とて簡単に命までは・・・\n売れんと言う事じゃな！？",
   "en": ""
  },
  {
   "id": "s258:017ee",
   "op": "14",
   "jp": "私達の命は・・・\n売り物なんかじゃありませんわ！！",
   "en": ""
  },
  {
   "id": "s258:01828",
   "op": "14",
   "jp": "（大邪神の力って、\n　本当にお金より・・・）",
   "en": ""
  },
  {
   "id": "s258:0185c",
   "op": "14",
   "jp": "（強いのかしら？）",
   "en": ""
  },
  {
   "id": "s258:01956",
   "op": "14",
   "jp": "騎士様ファイトォ。",
   "en": ""
  },
  {
   "id": "s258:01e06",
   "op": "14",
   "jp": "汚い手で、\nこのアタシに触るとは・・・\nいい度胸してるじゃない！",
   "en": ""
  },
  {
   "id": "s258:01f36",
   "op": "14",
   "jp": "バキバババギャーーーン！！\nずばばばびびーーーん！！",
   "en": ""
  },
  {
   "id": "s258:01fa2",
   "op": "14",
   "jp": "めきゃまきゃばかーーーん！！",
   "en": ""
  },
  {
   "id": "s258:020a2",
   "op": "14",
   "jp": "ボクを本気にさせると・・・\nきっと後悔することになるよ！？",
   "en": ""
  },
  {
   "id": "s258:02586",
   "op": "14",
   "jp": "やぁーん、こっちこないでぇー！！",
   "en": ""
  }
 ]
}
