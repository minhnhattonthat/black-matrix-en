{
 "source": "d1:SCENARIO/19",
 "copies": [
  "d1:SCENARIO/19",
  "d2:SCENARIO/19"
 ],
 "strings": [
  {
   "id": "s19:0020e",
   "op": "15",
   "jp": "目が覚めたからって\nまだ動いちゃ駄目だ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0025a",
   "op": "15",
   "jp": "ずっと眠ったままだったんだ！\n体がびっくりしちまうぜ！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:002a2",
   "op": "15",
   "jp": "まったく・・・\nオマエは世話がかかる奴だ！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:002de",
   "op": "15",
   "jp": "あの大きな落雷があった日・・・\nといっても覚えてねぇか・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0032e",
   "op": "15",
   "jp": "オマエはオレのために山へ入って、\n薬草を取りに行った。",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00386",
   "op": "15",
   "jp": "何故医者に行かなかったかって？\nそれは・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:003d2",
   "op": "15",
   "jp": "ちょっとな！\n行けない事情があったんだよ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00412",
   "op": "15",
   "jp": "とにかく、山の奥へと入って行った\nオマエは、何かの事故に\n巻き込まれたみたいだ。",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00476",
   "op": "15",
   "jp": "それはたぶん、\n大きな事故だったと思う。",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00522",
   "op": "15",
   "jp": "だって、\nオレは見たんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00552",
   "op": "15",
   "jp": "雨が止んだあの日、\nやっと動けるようになって\n入って行った山の中に・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:005ae",
   "op": "15",
   "jp": "オマエを囲むようにして倒れる\n大勢の兵士達の死体を・・・！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:005fe",
   "op": "15",
   "jp": "かすかな息しかしていない\n血だらけのオマエを見たとき・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0065a",
   "op": "15",
   "jp": "（オレは・・・）",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00672",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0069e",
   "op": "15",
   "jp": "まあいいさ・・・\nとにかくこうして\n無事だったんだからな！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:006ee",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0076a",
   "op": "15",
   "jp": "フッ・・・\nもう休め！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00792",
   "op": "15",
   "jp": "無理はしない方がいいぜ・・・！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:007d2",
   "op": "15",
   "jp": "（早く元気になれよ・・・！）",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00a42",
   "op": "15",
   "jp": "オマエが目を覚まさなかったとき、",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00a76",
   "op": "15",
   "jp": "オレは本当は・・・\nえらく心細かったんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00ac6",
   "op": "15",
   "jp": "オレは・・・\nオマエの瞳が好きなんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00b02",
   "op": "15",
   "jp": "オマエを見ていると・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00b2e",
   "op": "15",
   "jp": "忘れていた気持ちが・・・\nなんだかよみがえりそうで・・・！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00b7a",
   "op": "15",
   "jp": "例え、オマエに\nどんなに嫌われようと・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00bc6",
   "op": "15",
   "jp": "この気持ちだけは変わらない！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00bf6",
   "op": "15",
   "jp": "ずっと・・・\nずっと一緒にいような・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00fc2",
   "op": "15",
   "jp": "だっ・・大丈夫か！？",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:00ff6",
   "op": "15",
   "jp": "目覚めてからまだ一週間しか経って\nないのに・・・！？",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0103e",
   "op": "15",
   "jp": "でも、無理はしない方がいいぜ、\nまだ本調子じゃないみたいだからな！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:01096",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s19:010c2",
   "op": "15",
   "jp": "それと・・・\n一つだけ言っておく事がある！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:010fe",
   "op": "15",
   "jp": "これは重要な事だから\n絶対に忘れるなよ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:0113a",
   "op": "15",
   "jp": "オマエはこの世界での記憶を\n無くしてしまっていて・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:01182",
   "op": "15",
   "jp": "この世界の常識には、\n慣れてないはずだ・・・！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:011c2",
   "op": "15",
   "jp": "だからオレが安心してオマエを、\n家の外に送り出せるようになるまで、",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:01216",
   "op": "15",
   "jp": "勝手に家の柵の外には、\n出ないで欲しいんだ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:01256",
   "op": "15",
   "jp": "いいか？\n絶対に外に出ちゃだめだぞ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:01292",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s19:012be",
   "op": "15",
   "jp": "しばらくは・・・\nちゃんとリハビリしなくっちゃな！！",
   "en": "",
   "box": "17x3",
   "face": 12
  }
 ]
}
