{
 "source": "d1:SCENARIO/446",
 "copies": [
  "d1:SCENARIO/446",
  "d2:SCENARIO/446"
 ],
 "strings": [
  {
   "id": "s446:00cea",
   "op": "15",
   "jp": "なっ、なんなんだここは！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s446:00d16",
   "op": "15",
   "jp": "て・・・天井に・・・\n大地がへばりついてやがるぜ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s446:00fde",
   "op": "15",
   "jp": "この地球の内側は、巨大な\n空洞になっておる・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01022",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s446:0104e",
   "op": "15",
   "jp": "ココこそが、創世記戦争で\nメフィスト達に敗れ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01092",
   "op": "15",
   "jp": "その結果、この大地の底に\n幽閉された、\n白き羽の天使達の牢獄！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:010f2",
   "op": "15",
   "jp": "もっとも今では、すっかり\n理性を失い、\n野性化してしまった・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01146",
   "op": "15",
   "jp": "堕天使達の地獄と化しておる！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01216",
   "op": "15",
   "jp": "おっ、おい！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s446:01236",
   "op": "15",
   "jp": "奴等仲間の肉を\n喰ってやがるぜ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s446:015f2",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s446:0161e",
   "op": "15",
   "jp": "ココには、\n他に食い物など無い！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01652",
   "op": "15",
   "jp": "しかも元々が天使\nであった彼らは\n容易に死ぬことも叶わず、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:0169e",
   "op": "15",
   "jp": "戦いに勝った者は、ワザと\n死なない程度に相手を喰っては、\n再び戦闘を繰り返す。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:016fe",
   "op": "15",
   "jp": "先ほどの喰われた奴も、\n気がついた頃には体が再生し、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01746",
   "op": "15",
   "jp": "他の者を食料として狙うという\n無限地獄を延々と\n繰り返しておるのじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:017be",
   "op": "15",
   "jp": "そんな・・酷い・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s446:0182a",
   "op": "15",
   "jp": "皆さん！もうやめて下さい！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s446:01a72",
   "op": "15",
   "jp": "キシャアアァアァアア！！\nフーーーーーーーッ！！",
   "en": "",
   "box": "17x3",
   "face": 94
  },
  {
   "id": "s446:01b32",
   "op": "15",
   "jp": "無駄じゃよマルコ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01b56",
   "op": "15",
   "jp": "すでに彼らは、\nまともな感情など\n持ち合わせてはおらん・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01ba6",
   "op": "15",
   "jp": "いや、今の彼らの反応こそ、\n全ての天使達の\n本来あるべき姿なのかもしれん！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01c06",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s446:01c32",
   "op": "15",
   "jp": "これ以上、話しかければ\n間違いなく、戦闘になるぞ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01c7a",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s446:01caa",
   "op": "15",
   "jp": "わし等の目的は、この先にある\n天国の門じゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01cea",
   "op": "15",
   "jp": "こんな所に長居は無用、\nすぐにあちらに向かうぞ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s446:01e32",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  }
 ]
}
