 "strings": [
  {
   "id": "s232:00982",
   "op": "15",
   "jp": "コイツはいったい・・・\n何のまねだ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s232:009ca",
   "op": "15",
   "jp": "オマエ達若い者を・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s232:009f2",
   "op": "15",
   "jp": "この村から出すわけには\nいかんのじゃよ！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s232:00ab2",
   "op": "15",
   "jp": "なんだって！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s232:00ae2",
   "op": "15",
   "jp": "この村の病院は若い連中から\n吸い上げた年貢によって\n運営されておる・・・！",
   "en": "",
   "box": "17x3",
   "face": 142
  },
  {
   "id": "s232:00b3e",
   "op": "15",
   "jp": "ところが最近の若い連中は・・・",
   "en": "",
   "box": "17x3",
   "face": 142
  },
  {
   "id": "s232:00b6e",
   "op": "15",
   "jp": "わし等が苦労して創り上げたこの村に住んでおきながら、老人に対する\n感謝の気持ちも忘れ・・・",
   "en": "",
   "box": "17x3",
   "face": 142
  },
  {
   "id": "s232:00bda",
   "op": "15",
   "jp": "自分等の生まれた村を捨てて、\n出ていこうなどと\nたくらんでおる・・・",
   "en": "",
   "box": "17x3",
   "face": 142
  },
  {
   "id": "s232:00c32",
   "op": "15",
   "jp": "自分達とて、いつかは年を取り、\nジジイになる日が来る事も\n忘れてのぅ・・・",
   "en": "",
   "box": "17x3",
   "face": 142
  },
  {
   "id": "s232:00c92",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s232:00cbe",
   "op": "15",
   "jp": "そんな無法な行いは・・・",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s232:00cea",
   "op": "15",
   "jp": "我ら爆老決死隊が、\n命に代えても阻止してくれるワ！！",
   "en": "",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s232:00d3e",
   "op": "15",
   "jp": "ちょ・・ちょっと待ってくれよ\n爺さん・・・俺達は・・！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s232:00d96",
   "op": "15",
   "jp": "問答無用！！",
   "en": "",
   "box": "17x3",
   "face": 112
  }
 ]
}
