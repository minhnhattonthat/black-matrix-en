 ],
 "strings": [
  {
   "id": "s129:000e6",
   "op": "15",
   "jp": "私ね・・・\nアナタが目を覚まさなかったとき、\nとっても心細かったのよ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0013e",
   "op": "15",
   "jp": "だって私・・・\nアナタの瞳が大好きなの。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0017a",
   "op": "15",
   "jp": "アナタに見つめられると・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:001aa",
   "op": "15",
   "jp": "忘れていた気持ちが、\nなんだかよみがえりそうで！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:001ee",
   "op": "15",
   "jp": "例えどんなに嫌われようと・・・\nこの気持ちは変わらないわ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:002b6",
   "op": "15",
   "jp": "お兄ちゃんが目を覚まさなかったとき\n私、本当はすっごく\n怖かったんだから",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00312",
   "op": "15",
   "jp": "私ね、お兄ちゃんの目が\n大好きなの",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00346",
   "op": "15",
   "jp": "お兄ちゃんに見つめられていると",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00376",
   "op": "15",
   "jp": "なんだか、なんだか\n良くわかんないんだけど\n胸のあたりがキュンてなるの。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:003d2",
   "op": "15",
   "jp": "お兄ちゃんが例え私のこと\n嫌いでも私はお兄ちゃんのことが\n大好き。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00426",
   "op": "15",
   "jp": "この気持ちは変わらないよ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:004ce",
   "op": "15",
   "jp": "キミが目を覚まさなかった間\n本当はボクはとても心細かったんだ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0051e",
   "op": "15",
   "jp": "だって、いつも意地ばっかり張ってるボクは、キミと一緒にいられる時だけ誰かに甘えることが出来たんだ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00592",
   "op": "15",
   "jp": "キミに見つめられていると",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:005be",
   "op": "15",
   "jp": "忘れていた気持ちが\nなんだかよみがえりそうで",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:005fe",
   "op": "15",
   "jp": "たとえみんなに嫌われようと\nこの気持ちだけは・・・\nずっと変わらないよ。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:006d6",
   "op": "15",
   "jp": "私、キミの瞳が好きなの",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:006fe",
   "op": "15",
   "jp": "その瞳に見つめられてると\nなんだか・・忘れていた記憶が\n蘇ってきそうで",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00756",
   "op": "15",
   "jp": "だから・・・\nだから、つい\n素直じゃなくなっちゃうのよ！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:007a2",
   "op": "15",
   "jp": "いつもの私は・・・\nホントの私じゃないの・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:007e2",
   "op": "15",
   "jp": "ねぇ・・・\nホントは気付いてるんでしょ？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0081e",
   "op": "15",
   "jp": "私が意地悪したから\n仕返してるだけなんでしょ！？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00862",
   "op": "15",
   "jp": "私の気持ちに気付いてるって・・・\n私を嫌ってないって言ってよ！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0092e",
   "op": "15",
   "jp": "アンタが目を覚まさなかった時\nアタシ・・・気付いちゃったのよ\n・・・本当の自分の気持ちに。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0099a",
   "op": "15",
   "jp": "アンタの瞳に・・・とっても\n惹かれるの",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:009d2",
   "op": "15",
   "jp": "アンタに見つめられると、\n忘れていた暖かい感情が・・・\nなんだか蘇るようで",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00a2e",
   "op": "15",
   "jp": "・・・嫌われているに決まってる\nでも・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00a6a",
   "op": "15",
   "jp": "アンタに対する\nアタシのこの気持ちだけは\n永遠に変わらない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00b32",
   "op": "15",
   "jp": "お前が目を覚まさなかった時\n俺は本当は、えらく心細かったんだ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00b82",
   "op": "15",
   "jp": "俺は・・・\nお前の瞳が好きなんだ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00bb6",
   "op": "15",
   "jp": "お前を見ていると・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00bde",
   "op": "15",
   "jp": "忘れていた気持ちが\nなんだか蘇りそうで",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00c16",
   "op": "15",
   "jp": "例えお前にどんなに嫌われようと\nこの気持ちだけは\n変わらない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00cc6",
   "op": "15",
   "jp": "正義・・・？自由？？\nあげくに愛ですって・・・？！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00d0a",
   "op": "15",
   "jp": "この世のどこを探せば・・・、\nそんな物が有るって言うのよ？！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00d5e",
   "op": "15",
   "jp": "愛や自由などとたわごとを\n語る愚か者よ！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00db2",
   "op": "15",
   "jp": "貴方達の言うように\n私の想いは\n一方的なものかもしれない。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00dfe",
   "op": "15",
   "jp": "でも・・・！\nそれがどんなに罪深くても\n私は・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00e42",
   "op": "15",
   "jp": "私は彼を、\n・・・愛しています！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00e8e",
   "op": "15",
   "jp": "おじさん達の言うとおり私の気持ちは\nただのわがままだって思われてお兄ちゃんに嫌われちゃってるのかもしれない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00f0a",
   "op": "15",
   "jp": "でもそれがどんな悪い事でも\n私は・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00f46",
   "op": "15",
   "jp": "私はお兄ちゃんを\n愛しているもん！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00f92",
   "op": "15",
   "jp": "あなた達の言うように\nボクの想いは一方的な\nものなのかもしれない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:00fe6",
   "op": "15",
   "jp": "でも・・・\nそれがどんなに罪深くても\nボクは・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0102a",
   "op": "15",
   "jp": "ボクは・・・彼を・・・\n愛しているんだ！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0107e",
   "op": "15",
   "jp": "あ、あなた達の言うように・・・\n私の想いは・・・\n一方的なものかもしれない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:010da",
   "op": "15",
   "jp": "それがどんなに罪深い事でも・・\n私は・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:0111a",
   "op": "15",
   "jp": "私は彼を、\n愛しているのよ！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:01162",
   "op": "15",
   "jp": "あなた達の言うように・・・\n私の想いは・・・\n一方的なものかもしれない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:011ba",
   "op": "15",
   "jp": "でも・・・\nそれがどんなに罪深くても・・・\n私は・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:01206",
   "op": "15",
   "jp": "アタシは彼を、\n愛しているのよ！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:01252",
   "op": "15",
   "jp": "きっ・・貴様達の言うように\n俺の想いは・・・\n一方的なものかもしれない",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:012aa",
   "op": "15",
   "jp": "だっ、だがそれがどんなに\n罪深い行為でも・・・\n俺は・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s129:012fa",
   "op": "15",
   "jp": "俺は・・・こいつの事を\n・・・クッ・・・・\n愛しているんだぁ！！",
   "en": "",
   "box": "19x3"
  }
 ]
}
