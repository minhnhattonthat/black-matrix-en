{
 "source": "d1:SCENARIO/319",
 "copies": [
  "d1:SCENARIO/319",
  "d2:SCENARIO/319"
 ],
 "strings": [
  {
   "id": "s319:00bda",
   "op": "15",
   "jp": "わ、私が負ける！？",
   "en": ""
  },
  {
   "id": "s319:00bfe",
   "op": "15",
   "jp": "ばっ、馬鹿な！？\n何が間違っていたというのだ？？",
   "en": ""
  },
  {
   "id": "s319:00c4e",
   "op": "15",
   "jp": "お主は、その大邪神の鎧を\n我がものにせんとして・・・",
   "en": ""
  },
  {
   "id": "s319:00c96",
   "op": "15",
   "jp": "口先だけの正義を\n実行しようとした！\nそれこそが、お主の敗因じゃな！",
   "en": ""
  },
  {
   "id": "s319:00cfa",
   "op": "15",
   "jp": "何を言う！",
   "en": ""
  },
  {
   "id": "s319:00d16",
   "op": "15",
   "jp": "それならお前達のしている事とて、\n大差無いではないか！！",
   "en": ""
  },
  {
   "id": "s319:00d6e",
   "op": "15",
   "jp": "それは違う！",
   "en": ""
  },
  {
   "id": "s319:00db2",
   "op": "15",
   "jp": "ガイよ、\nお主が奴隷達の中に\n飛び出したとき、",
   "en": ""
  },
  {
   "id": "s319:00df2",
   "op": "15",
   "jp": "彼女らがお前を受け入れて\nくれると思って、\n身を投げ出したのか！？",
   "en": ""
  },
  {
   "id": "s319:00ebe",
   "op": "15",
   "jp": "いや、あのとき俺は・・・\nたぶん何も考えては\nいなかった。",
   "en": ""
  },
  {
   "id": "s319:00f0a",
   "op": "15",
   "jp": "ただ・・単に、\n彼女らを助けたいと・・・",
   "en": ""
  },
  {
   "id": "s319:00f46",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s319:00f92",
   "op": "15",
   "jp": "見返りを求めず、\nおのれの信じたモノだけのために\n行動したガイの心に・・・",
   "en": ""
  },
  {
   "id": "s319:00fee",
   "op": "15",
   "jp": "おそらくは鎧も共鳴したのじゃ！",
   "en": ""
  },
  {
   "id": "s319:0102e",
   "op": "15",
   "jp": "くっははははははっ！\n解った、解った・・私の負けだよ！",
   "en": ""
  },
  {
   "id": "s319:01076",
   "op": "15",
   "jp": "気づかせて・もらったお礼に、\nいいことを教・えて・やろう！",
   "en": ""
  },
  {
   "id": "s319:010d2",
   "op": "15",
   "jp": "あら、\nいやに素直になっちゃいましたね！",
   "en": ""
  },
  {
   "id": "s319:0111a",
   "op": "15",
   "jp": "くっ・くっくっ・・・",
   "en": ""
  },
  {
   "id": "s319:01142",
   "op": "15",
   "jp": "お前達を・・喜ばす事で・はない、\n聞いて恐怖するがいい・・・",
   "en": ""
  },
  {
   "id": "s319:01192",
   "op": "15",
   "jp": "お前達が探し求める、\n我らが総本山は・・・",
   "en": ""
  },
  {
   "id": "s319:011ce",
   "op": "15",
   "jp": "この地上の・・何処・にも\n存在し・ない！！",
   "en": ""
  },
  {
   "id": "s319:01242",
   "op": "15",
   "jp": "なにっ！？",
   "en": ""
  },
  {
   "id": "s319:0126e",
   "op": "15",
   "jp": "お前達の・・探し・ている\nご主人様と・やらは・・・",
   "en": ""
  },
  {
   "id": "s319:012b2",
   "op": "15",
   "jp": "その・・総本山に居るのだからな！",
   "en": ""
  },
  {
   "id": "s319:012e6",
   "op": "15",
   "jp": "ハァッハァ・ッ・・ハ・ッ・・・",
   "en": ""
  }
 ]
}
