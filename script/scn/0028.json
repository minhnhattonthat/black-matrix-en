 "strings": [
  {
   "id": "s28:00030",
   "op": "14",
   "jp": "○月×日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00046",
   "op": "14",
   "jp": "{0021}にはおにいちゃんいがいに\nおはなしあいてがいないから・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:0008a",
   "op": "14",
   "jp": "きょうは、おにいちゃんに\nえほんをよんであげました・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:000cc",
   "op": "14",
   "jp": "でもおにいちゃんは\nこのおはなしはきらいだったみたいで\nなんにもいってくれません・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:0012c",
   "op": "14",
   "jp": "ちぇっあしたはちがうえほんで\nためしてみるからいいもん・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00190",
   "op": "14",
   "jp": "△月○日　雨",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:001a4",
   "op": "14",
   "jp": "おにいちゃんがいつもなでてくれた、\nおはねだって、ちゃんときれいに\nしてるのに・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00200",
   "op": "14",
   "jp": "おにいちゃんは、きょうも\nなにもはなしてくれません・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00242",
   "op": "14",
   "jp": "{0021}が\nもっといい子になったら・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:0026c",
   "op": "14",
   "jp": "おにいちゃんも\nなにかはなしてくれるのかなぁ？？？",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:002c4",
   "op": "14",
   "jp": "◇月◎日　曇り",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:002da",
   "op": "14",
   "jp": "きょうは、あさからクレヨンで、\nだいすきなおにいちゃんの\n絵をかきました・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00330",
   "op": "14",
   "jp": "だけど・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00344",
   "op": "14",
   "jp": "どうしてもおにいちゃんの\n目がうまくかけないから・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00382",
   "op": "14",
   "jp": "ぜんぶやぶいて\nすてちゃいました・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:003b0",
   "op": "14",
   "jp": "あ～あっ・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:003c8",
   "op": "14",
   "jp": "どうすればおにいちゃんの目が\nうまくかけるようになるのかなぁ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00430",
   "op": "14",
   "jp": "□月×日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00446",
   "op": "14",
   "jp": "きのうもおにいちゃんと\nいっしょにねました・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:0047e",
   "op": "14",
   "jp": "おにいちゃんのむねは、\nなんだかとってもあったかくって・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:004c2",
   "op": "14",
   "jp": "トクントクンて、おとがします。",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:004e8",
   "op": "14",
   "jp": "{0021}は、おにいちゃんの\nむねのおとをきいていると、\nなんだかとってもあんしんなので・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00546",
   "op": "14",
   "jp": "トクントクン・・て、\nきいてるうちに・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00578",
   "op": "14",
   "jp": "きがつくと、ねちゃってるみたいで、\nなんだかもったいないです・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:005c2",
   "op": "14",
   "jp": "でもでも・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:005d8",
   "op": "14",
   "jp": "あのままおにいちゃんといっしょに\nいつまでもねていたいような\nきもします・・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00650",
   "op": "14",
   "jp": "○月■日　晴れ",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00666",
   "op": "14",
   "jp": "おねぼうさんのおにいちゃんへ・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00690",
   "op": "14",
   "jp": "{0021}はおにいちゃんと\nいっしょにいられるだけで・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:006ca",
   "op": "14",
   "jp": "とってもしあわせです！！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:006ea",
   "op": "14",
   "jp": "だけど・・・",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:006fe",
   "op": "14",
   "jp": "だけど、だけどだけど・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00722",
   "op": "14",
   "jp": "{0021}は、はやく\nおにいちゃんのこえが\nききたいよぉ・・・！",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s28:00762",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "19x3"
  }
 ]
