{
 "source": "d1:SCENARIO/241",
 "copies": [
  "d1:SCENARIO/241",
  "d2:SCENARIO/241"
 ],
 "strings": [
  {
   "id": "s241:007de",
   "op": "15",
   "jp": "オイ、どうやら後ろから・・・",
   "en": ""
  },
  {
   "id": "s241:0080e",
   "op": "15",
   "jp": "つけてくる奴が居るぜ！！",
   "en": ""
  },
  {
   "id": "s241:0083a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s241:00866",
   "op": "15",
   "jp": "だれだ、キサマ！！\nとっとと姿を現しやがれ・・・！",
   "en": ""
  },
  {
   "id": "s241:00efa",
   "op": "15",
   "jp": "きっキサマ・・・\nたしかあの村で見かけた・・・？！",
   "en": ""
  },
  {
   "id": "s241:00f4e",
   "op": "15",
   "jp": "突然で驚かせちまったようだが、\nさっきの医者との一戦を見かけたんで気になってついてきちまったんだ！",
   "en": ""
  },
  {
   "id": "s241:00fc2",
   "op": "15",
   "jp": "どうやら、アンタ達の旅は・・・",
   "en": ""
  },
  {
   "id": "s241:00ff2",
   "op": "15",
   "jp": "かなりの訳有りであるらしいな！！",
   "en": ""
  },
  {
   "id": "s241:01026",
   "op": "15",
   "jp": "いいよ！皆まで言わなくていい！\n見たところの雰囲気はともかく、",
   "en": ""
  },
  {
   "id": "s241:01076",
   "op": "15",
   "jp": "その正体は、お尋ね者の・・・",
   "en": ""
  },
  {
   "id": "s241:010a6",
   "op": "15",
   "jp": "しかもかなり凶悪な強盗団一味って\n感じだ・・・！",
   "en": ""
  },
  {
   "id": "s241:010ea",
   "op": "15",
   "jp": "いいねぇ～！！",
   "en": ""
  },
  {
   "id": "s241:0110a",
   "op": "15",
   "jp": "隠したってわかるぜ！",
   "en": ""
  },
  {
   "id": "s241:01132",
   "op": "15",
   "jp": "そこの筋肉の旦那なんか、どうみても剣を振るってついたとしか思えねぇ\n立派な筋肉をしてやがる！！",
   "en": ""
  },
  {
   "id": "s241:011a2",
   "op": "15",
   "jp": "まさに山賊以外の何モンでもない\nって面構えだ・・・！",
   "en": ""
  },
  {
   "id": "s241:0120e",
   "op": "15",
   "jp": "ヤァーイ！\n山賊さんぞく～っつ！！",
   "en": ""
  },
  {
   "id": "s241:01246",
   "op": "14",
   "jp": "●☆□◆〇♂▽■",
   "en": ""
  },
  {
   "id": "s241:01276",
   "op": "15",
   "jp": "くっくっくっ・・・",
   "en": ""
  },
  {
   "id": "s241:012aa",
   "op": "15",
   "jp": "男の人生は太く短く！！",
   "en": ""
  },
  {
   "id": "s241:012d2",
   "op": "15",
   "jp": "黒き羽の男なら、誰でも一度は\nお尋ね者に憧れて・・・",
   "en": ""
  },
  {
   "id": "s241:0131a",
   "op": "15",
   "jp": "それこそ好きに暴れ回りたいモンさ！",
   "en": ""
  },
  {
   "id": "s241:0134e",
   "op": "15",
   "jp": "どうだい！\nいっそ俺をアンタ達の仲間に\n加えてくれないか・・・！？",
   "en": ""
  },
  {
   "id": "s241:013b2",
   "op": "1d",
   "jp": "仲間にする",
   "en": "",
   "max": 15
  },
  {
   "id": "s241:013c4",
   "op": "1d",
   "jp": "仲間にしない",
   "en": "",
   "max": 15
  },
  {
   "id": "s241:013f6",
   "op": "15",
   "jp": "そうこなくっちゃあ・・・\n俺の名は烈火のパウア！",
   "en": ""
  },
  {
   "id": "s241:0143a",
   "op": "15",
   "jp": "おっと、一旦アンタ達の組織に\n入った以上は、白き羽だろうと\n先輩は先輩だ・・・・",
   "en": ""
  },
  {
   "id": "s241:0149e",
   "op": "15",
   "jp": "これからは筋肉の兄貴って・・・\n呼ばせて貰いますぜ！！",
   "en": ""
  },
  {
   "id": "s241:0150e",
   "op": "15",
   "jp": "くっくっくっ・・・！",
   "en": ""
  },
  {
   "id": "s241:01536",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s241:01560",
   "op": "14",
   "jp": "パウアが仲間になった！",
   "en": ""
  },
  {
   "id": "s241:015c6",
   "op": "15",
   "jp": "ちっ！\nまあどの道、あの村からは\n出ていく予定だったんだ・・・",
   "en": ""
  },
  {
   "id": "s241:01616",
   "op": "15",
   "jp": "また別の道を探す事にするさ・・・！",
   "en": ""
  },
  {
   "id": "s241:02192",
   "op": "15",
   "jp": "みんな・・・\n僕のために道草を食わせてしまって",
   "en": ""
  },
  {
   "id": "s241:021d2",
   "op": "15",
   "jp": "ほんとうにごめんね・・・！",
   "en": ""
  },
  {
   "id": "s241:0220e",
   "op": "15",
   "jp": "いいって事よ！\nそれにお前の親父もお前に似て",
   "en": ""
  },
  {
   "id": "s241:0224e",
   "op": "15",
   "jp": "案外邪悪な人物だったみてぇ\nじゃねえか！！",
   "en": ""
  },
  {
   "id": "s241:0228a",
   "op": "15",
   "jp": "それに、なんだか昨日までより・・・",
   "en": ""
  },
  {
   "id": "s241:022be",
   "op": "15",
   "jp": "さらにお前の男前が上がったような\n気がするぜ・・・！！",
   "en": ""
  },
  {
   "id": "s241:02316",
   "op": "15",
   "jp": "まあお前と比べれば・・・\nヘビでも百倍は男前なんだが・・・",
   "en": ""
  },
  {
   "id": "s241:02396",
   "op": "15",
   "jp": "なんだとキサマ～！",
   "en": ""
  },
  {
   "id": "s241:023e2",
   "op": "15",
   "jp": "ヘビっていうより、\nウマでしょウマ！！",
   "en": ""
  },
  {
   "id": "s241:0241e",
   "op": "14",
   "jp": "●☆□◆〇♂▽■",
   "en": ""
  },
  {
   "id": "s241:0244e",
   "op": "15",
   "jp": "まあまあ、とにかくこの丘を越えればいよいよ大邪神の鎧があると\nユダがいっておった・・・",
   "en": ""
  },
  {
   "id": "s241:024b6",
   "op": "15",
   "jp": "パンデモニウムの街じゃ！",
   "en": ""
  },
  {
   "id": "s241:024e2",
   "op": "15",
   "jp": "ここからは、いっそう気を引き締めてかからねばなるまいて・・・",
   "en": ""
  },
  {
   "id": "s241:02532",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s241:02552",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s241:0257e",
   "op": "15",
   "jp": "ねぇ・・・",
   "en": ""
  },
  {
   "id": "s241:0259a",
   "op": "15",
   "jp": "なんだかボクにもキミが言っていた、愛とかって言葉の意味が・・・",
   "en": ""
  },
  {
   "id": "s241:025ea",
   "op": "15",
   "jp": "少しだけ・・・\nわかったような気がするんだ・・・",
   "en": ""
  },
  {
   "id": "s241:02646",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s241:0267e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s241:026b6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s241:026d6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s241:02702",
   "op": "15",
   "jp": "父さん・・・",
   "en": ""
  }
 ]
}
