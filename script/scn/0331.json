{
 "source": "d1:SCENARIO/331",
 "copies": [
  "d1:SCENARIO/331",
  "d2:SCENARIO/331"
 ],
 "strings": [
  {
   "id": "s331:00032",
   "op": "15",
   "jp": "・・・・どうやら\nレブロブスにも気づかれて\nしまったようじゃな・・・・",
   "en": ""
  },
  {
   "id": "s331:0008a",
   "op": "15",
   "jp": "ルピルピよ。",
   "en": ""
  },
  {
   "id": "s331:000aa",
   "op": "15",
   "jp": "やはりその鎧を着た状態で、\nこれ以上長旅を続けるのは\n無理ではないのか！？",
   "en": ""
  },
  {
   "id": "s331:0010a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s331:00136",
   "op": "15",
   "jp": "わしの身を案じてくれるのは\nあり難いんじゃが、",
   "en": ""
  },
  {
   "id": "s331:00176",
   "op": "15",
   "jp": "いずれはわし自身も・・・\n大邪神の鎧を\n手に入れたいと思うておる。",
   "en": ""
  },
  {
   "id": "s331:001ce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s331:001fa",
   "op": "15",
   "jp": "わしは・・・\n最初にあの愛を語る坊やを\n見かけた時に、",
   "en": ""
  },
  {
   "id": "s331:00242",
   "op": "15",
   "jp": "あの弱虫のピリポに\n対してまで、平等などと\n呼ばれる態度で接するなんて、",
   "en": ""
  },
  {
   "id": "s331:0029e",
   "op": "15",
   "jp": "なんと邪悪極まりない輩なんじゃ、\nと思っておった・・・！",
   "en": ""
  },
  {
   "id": "s331:002ea",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s331:00316",
   "op": "15",
   "jp": "だが・・そんなアヤツだからこそ、\nあの大邪神の鎧を\n着ることが出来たんじゃろうと、",
   "en": ""
  },
  {
   "id": "s331:0037a",
   "op": "15",
   "jp": "今は思うておる。",
   "en": ""
  },
  {
   "id": "s331:0039e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s331:003ca",
   "op": "15",
   "jp": "しかし、奴だけにとどまらず、\n弱者であったピリポや、",
   "en": ""
  },
  {
   "id": "s331:00412",
   "op": "15",
   "jp": "自由という妄想を\n求め続けていたレブロブス、",
   "en": ""
  },
  {
   "id": "s331:00452",
   "op": "15",
   "jp": "そして正義などという、\n甘っちょろい偽善を信じる\nガイまでもが、",
   "en": ""
  },
  {
   "id": "s331:004a6",
   "op": "15",
   "jp": "大邪神の鎧を\n着る事が出来たという事は、",
   "en": ""
  },
  {
   "id": "s331:004e2",
   "op": "15",
   "jp": "もしかしたら、\n我々の聖書で言うところの、\nこの世で最も邪悪なる偽善・・・",
   "en": ""
  },
  {
   "id": "s331:0053e",
   "op": "15",
   "jp": "すなわち、自由や正義、\n人権や弱者や友情、愛、\nそして平等といった、",
   "en": ""
  },
  {
   "id": "s331:00596",
   "op": "15",
   "jp": "七つの大罪にこそ、\n大邪神の鎧を解放する鍵が\nあるのやもしれん。",
   "en": ""
  },
  {
   "id": "s331:005ea",
   "op": "14",
   "jp": "・・・！？",
   "en": ""
  },
  {
   "id": "s331:0060a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s331:0062a",
   "op": "15",
   "jp": "わしは、\n彼らとの旅を続ける前から、\n時折考えておったのじゃ。",
   "en": ""
  },
  {
   "id": "s331:0067a",
   "op": "15",
   "jp": "創世記戦争によって創られた\nこの世界は・・・\n実は間違っておるのではないかと！",
   "en": ""
  },
  {
   "id": "s331:006de",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s331:0070a",
   "op": "15",
   "jp": "そんな疑問を解き明かす為にも、\nわしは鎧に封じ込められている\n大邪神の魂を・・・",
   "en": ""
  },
  {
   "id": "s331:0076e",
   "op": "15",
   "jp": "是非、解き放ってみたいのじゃ！",
   "en": ""
  },
  {
   "id": "s331:007a2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s331:007ce",
   "op": "15",
   "jp": "それに万が一、\n既に悪魔の鎧を着てしまった、\nお主に先に死なれたら・・・",
   "en": ""
  },
  {
   "id": "s331:0082a",
   "op": "15",
   "jp": "わしはこの膨大な量の知識を、\n誰と共有すれば良いのじゃ！？",
   "en": ""
  },
  {
   "id": "s331:008fa",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s331:00916",
   "op": "15",
   "jp": "我々の聖書では優しさも\n立派な罪なんですよ。",
   "en": ""
  },
  {
   "id": "s331:00956",
   "op": "15",
   "jp": "彼らのことをおっしゃる割には\nお師匠様も・・・",
   "en": ""
  },
  {
   "id": "s331:00996",
   "op": "15",
   "jp": "随分と邪悪な人物に\nなられましたこと！",
   "en": ""
  },
  {
   "id": "s331:00b1e",
   "op": "15",
   "jp": "ルピルピーーーーーーッ！！",
   "en": ""
  },
  {
   "id": "s331:04b4e",
   "op": "15",
   "jp": "爺さん、\nどうしたっ！！",
   "en": ""
  },
  {
   "id": "s331:04b86",
   "op": "15",
   "jp": "うわああっ・・・\nひどい血だっ！",
   "en": ""
  },
  {
   "id": "s331:04bea",
   "op": "15",
   "jp": "いかん！\n急いでこの場を離れよ！",
   "en": ""
  },
  {
   "id": "s331:04c1e",
   "op": "15",
   "jp": "矢の方向から考えて\n攻撃を仕掛けた輩は多分\nこの上におる！！",
   "en": ""
  },
  {
   "id": "s331:04c7a",
   "op": "15",
   "jp": "無理よ！！無理無理！",
   "en": ""
  },
  {
   "id": "s331:04ca2",
   "op": "15",
   "jp": "何てったって、アンタ達は\nここで死んじゃうんですものね！",
   "en": ""
  },
  {
   "id": "s331:04e1e",
   "op": "15",
   "jp": "なっ、\n今の声は？",
   "en": ""
  },
  {
   "id": "s331:04e7e",
   "op": "15",
   "jp": "そうよ。",
   "en": ""
  },
  {
   "id": "s331:04e9a",
   "op": "15",
   "jp": "完全無欠の美しさを誇る、\n偉大なる大神官・・・\nユダ様よ！",
   "en": ""
  },
  {
   "id": "s331:04eea",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s331:04f0e",
   "op": "15",
   "jp": "しっ、しつこいな！\nこの、オカマ神官！",
   "en": ""
  },
  {
   "id": "s331:04f56",
   "op": "15",
   "jp": "私の一番の美徳でもある、\n嫉妬深さを褒めないで\n欲しいわねえ！",
   "en": ""
  },
  {
   "id": "s331:04fa6",
   "op": "15",
   "jp": "あの位の事でこの私が改心して、\n貴方達に対する復讐を\n諦めるとでも思ったの！？",
   "en": ""
  },
  {
   "id": "s331:0500a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s331:05036",
   "op": "15",
   "jp": "大体、戦闘のトドメとして、\n相手の生首を切り落とす\n程度の用心は出来んのかね？",
   "en": ""
  },
  {
   "id": "s331:050a6",
   "op": "15",
   "jp": "おっ・・・お前はまさか、\n強欲のマモン！？",
   "en": ""
  },
  {
   "id": "s331:050f2",
   "op": "15",
   "jp": "だいいち、誇り高き\nヴァンパイアであるこの私を、",
   "en": ""
  },
  {
   "id": "s331:05136",
   "op": "15",
   "jp": "通常の武器で\n殺せると思っていたなんて、\n完全に馬鹿にしている！！",
   "en": ""
  },
  {
   "id": "s331:0519a",
   "op": "15",
   "jp": "バアル？！\nき、貴様までも",
   "en": ""
  },
  {
   "id": "s331:051d6",
   "op": "15",
   "jp": "なんや難儀やわぁ～\n満足に動けもせぇへん\n雑魚共ばっかり",
   "en": ""
  },
  {
   "id": "s331:0522e",
   "op": "15",
   "jp": "異端審問官たち、\nあんじょう始末しておくれやす。",
   "en": ""
  },
  {
   "id": "s331:0527e",
   "op": "15",
   "jp": "ははっ、\nルカ様の御命とあらば！",
   "en": ""
  },
  {
   "id": "s331:052be",
   "op": "15",
   "jp": "なにせ、\nうちが興味があるのは\n愛しいダーリンだけやわ！",
   "en": ""
  },
  {
   "id": "s331:0532e",
   "op": "15",
   "jp": "アタシのカイン君に・・・\nなに色目、使ってんのよ！！",
   "en": ""
  },
  {
   "id": "s331:0539a",
   "op": "15",
   "jp": "おにいちゃんは・・・・・\nプリカの奴隷だもん！！",
   "en": ""
  },
  {
   "id": "s331:053f6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  }
 ]
}
