  "d2:SCENARIO/350"
 ],
 "strings": [
  {
   "id": "s350:00ef6",
   "op": "15",
   "jp": "そんなセラフィムさんが、\nまさか、あんな目に会うなんて！",
   "en": ""
  },
  {
   "id": "s350:012c2",
   "op": "15",
   "jp": "たいへんだぁーっ！！\n下水道の入り口を破壊されたぞ！",
   "en": ""
  },
  {
   "id": "s350:01316",
   "op": "15",
   "jp": "何だぁっ！？",
   "en": ""
  },
  {
   "id": "s350:01336",
   "op": "15",
   "jp": "ここなら安全じゃあ\nなかったのか！！",
   "en": ""
  },
  {
   "id": "s350:0137a",
   "op": "15",
   "jp": "みんなは無事か！？",
   "en": ""
  },
  {
   "id": "s350:013ae",
   "op": "15",
   "jp": "ぎぃやぁああぁあああああっ！！\n何だっ、\nこの水は？",
   "en": ""
  },
  {
   "id": "s350:013f6",
   "op": "15",
   "jp": "助けてく、\nガバゲベゴボッ！！",
   "en": ""
  },
  {
   "id": "s350:01436",
   "op": "15",
   "jp": "どこに敵がいるんだ！\n慌ててないで教えろっ！",
   "en": ""
  },
  {
   "id": "s350:01482",
   "op": "15",
   "jp": "何がなんだか解らないよ！\nどうすればいいのか誰か教えて。",
   "en": ""
  },
  {
   "id": "s350:015b6",
   "op": "15",
   "jp": "くそっ！\n明かりまで消えやがった。",
   "en": ""
  },
  {
   "id": "s350:015fa",
   "op": "15",
   "jp": "いかん、\nみんな混乱して収拾がつかんぞ！",
   "en": ""
  }
 ]
}
