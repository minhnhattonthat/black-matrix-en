 "strings": [
  {
   "id": "s48:0007a",
   "op": "15",
   "jp": "キミィ、どうしたの・・・？",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:000b6",
   "op": "15",
   "jp": "ひょ・・ひょっとして、\n体の具合でも・・・悪いの？",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00112",
   "op": "15",
   "jp": "なにを、キミは甘えているのかなぁ、",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00156",
   "op": "15",
   "jp": "頑張ってリハビリしてきなね！\nもぅぅぅ・・・フンッ！！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:001f2",
   "op": "15",
   "jp": "お・はよう・・・春はなんだか\nねむくなるよねぇ・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00266",
   "op": "15",
   "jp": "んーっ！春風が気持ちいい～！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:002a2",
   "op": "15",
   "jp": "今日も頑張って\nリハビリしなくっちゃね！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:0030a",
   "op": "15",
   "jp": "おっはよ～！\nさあ、今日も頑張って・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00346",
   "op": "15",
   "jp": "お昼寝するぞ～！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00396",
   "op": "15",
   "jp": "おはよ～！\n今日も暑くなりそぅ・・・！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:003ce",
   "op": "15",
   "jp": "木陰で居眠りでもしてようかなぁ！？",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00432",
   "op": "15",
   "jp": "お・は・よ・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00456",
   "op": "15",
   "jp": "秋は、ついつい食べ過ぎちゃって、\nそのあとやっぱり\n眠くなっちゃうんだよねぇ・・・！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:004ea",
   "op": "15",
   "jp": "おはよ・・・！\nそろそろ寒くなるから、\n冬支度を始めてよね！！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:0056a",
   "op": "15",
   "jp": "おはよー！今日はなんかさ、\n雪でも降っちゃいそうな\n感じしなぁい？",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:005be",
   "op": "15",
   "jp": "寒くってベッドから出たくないよ～！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:00622",
   "op": "15",
   "jp": "毎日毎日、なんか寒ーい！！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s48:0064e",
   "op": "15",
   "jp": "次の季節は春だけどぉ・・・\nいつくるのぉー！？\n待てなぁぁい！",
   "en": "",
   "box": "17x3",
   "face": 10
  }
 ]
}
