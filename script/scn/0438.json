{
 "source": "d1:SCENARIO/438",
 "copies": [
  "d1:SCENARIO/438",
  "d2:SCENARIO/438"
 ],
 "strings": [
  {
   "id": "s438:00c5e",
   "op": "15",
   "jp": "なっ、なんだ、\nこの巨大な遺跡都市は！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s438:00d42",
   "op": "15",
   "jp": "ここはかつて・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:00eb6",
   "op": "15",
   "jp": "全ての者が神と崇めた\nゴッドによって創られし、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:00ef6",
   "op": "15",
   "jp": "エデンの園と呼ばれる\n大陸のなれの果て！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:00f32",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s438:00f8e",
   "op": "15",
   "jp": "我々が先ほどまでいた\n場所以外には陸地が\n存在しないこの世界にも、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:00fe2",
   "op": "15",
   "jp": "かつては数多くの\n大陸や動物達が存在し・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01022",
   "op": "15",
   "jp": "アダムとイブと呼ばれる\nサルの子孫達が暮らしていたと、\n伝えられています！！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01082",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:010ae",
   "op": "15",
   "jp": "当時白き天と黒き地に\n別れ住んでいた\n多くの大天使様達が・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:010fe",
   "op": "15",
   "jp": "このサル達の成長を\n暖かい目で見守って\nおられました・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0114a",
   "op": "15",
   "jp": "中でも我々が救世主と仰ぐ\n慈悲深き大天使\nメフィスト様は・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0119a",
   "op": "15",
   "jp": "このサル達を大変に\nお気にいりになられ・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:011e6",
   "op": "15",
   "jp": "かつてゴッドが、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0120a",
   "op": "15",
   "jp": "アダムの最初の妻として\n創り出して棄てた、\n可哀想なメスザルを・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01262",
   "op": "15",
   "jp": "自分の妻の一人に、\n迎えられたほどだと\n聞いております・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:012ca",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s438:01302",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s438:0132e",
   "op": "15",
   "jp": "そしてメフィスト様は、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01356",
   "op": "15",
   "jp": "いつも裸で歩き、\n羽すら生えていない\nサル達を哀れんで・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:013b2",
   "op": "15",
   "jp": "天界にある知恵の実を\n与えてしまわれたのです！！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0140e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s438:01446",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s438:01472",
   "op": "15",
   "jp": "「神は自らの姿に似せられて、\n　このサル達を創ったと\n　聞いている・・・」",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s438:014ce",
   "op": "15",
   "jp": "「にも関わらず、なぜ神は\n　彼らに知恵を与えては\n　いけないというのか！？」",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s438:0152e",
   "op": "15",
   "jp": "「・・・・我思う、」",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s438:01556",
   "op": "15",
   "jp": "「故に我有り・・・」",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s438:0157e",
   "op": "15",
   "jp": "「されば自らを認識する為に\n　必要な知恵こそが、」",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s438:015c2",
   "op": "15",
   "jp": "「我らを我らたらしめんと\n　している本質では\n　あるまいか・・・！？」",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s438:0162a",
   "op": "15",
   "jp": "この事を大神ゴッドは\n烈火のごとく怒りました！！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0167a",
   "op": "15",
   "jp": "そして事もあろうに、\nこのエデンの園を壮絶なる\n大雨と大洪水で襲い・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:016d6",
   "op": "15",
   "jp": "全てをこの海の底へと\n覆い隠してしまったと\n伝えられています・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0172e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s438:0175a",
   "op": "15",
   "jp": "にわかには、\n信じがたい話ですが",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0178e",
   "op": "15",
   "jp": "隷属の地ノアにあった\nあの巨大な箱船も、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:017ca",
   "op": "15",
   "jp": "この異変に、いち早く気づいた、\n大天使ラファエル様が、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01812",
   "op": "15",
   "jp": "地上にいた動物達を\n避難させる為に、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0184a",
   "op": "15",
   "jp": "ノアと言う名のサルに命じて\n作らせた船だと言われています！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0189a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:019b2",
   "op": "15",
   "jp": "そっ、そんな馬鹿な！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s438:019da",
   "op": "15",
   "jp": "だいいちどうして\nサルなんかに船が\n作れるんだよ・・・！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s438:01b3a",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s438:01b62",
   "op": "15",
   "jp": "だから言ったはずです！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01b8a",
   "op": "15",
   "jp": "そのサル達は、\n知恵を与えられた\nサル達なのだと・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01bd6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s438:01c02",
   "op": "15",
   "jp": "そもそも天界を二分する\n創世記戦争が始まったのも、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01c46",
   "op": "15",
   "jp": "このゴッドのあまりの\n仕打ちにお怒りになられた\nメフィスト様が・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01c9e",
   "op": "15",
   "jp": "志を同じくする大天使様達と\n始められたのだと、\n伝えられています・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01cfa",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:01d26",
   "op": "15",
   "jp": "それが証拠に、この石板や\n隠し通路も、かの遺跡より\n発掘されたものなのです。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01e0e",
   "op": "15",
   "jp": "ゲフッ・・ゴボッ！！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01e42",
   "op": "15",
   "jp": "モーゼ殿！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:01e6e",
   "op": "15",
   "jp": "どうやら、\n私がお供できるのも・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01ea6",
   "op": "15",
   "jp": "これまでのようですね。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01f0e",
   "op": "15",
   "jp": "アンタ、その体は！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s438:01f56",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s438:01f7a",
   "op": "15",
   "jp": "我らが、大善神と崇める\nいまのハ・サタン様は、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:01fba",
   "op": "15",
   "jp": "ことのほか血の生Γを\n好まれるようでね。\nゲボッ・・！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02096",
   "op": "15",
   "jp": "この先の冥界の門を通る為には、\n教皇と同じ、黒と白の羽、\n二つの心を持つ者、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:020f6",
   "op": "15",
   "jp": "すなわち\n神と邪神の力を\nその体内に併せ持った者だけが、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02142",
   "op": "15",
   "jp": "約束の地へ誘う封印の扉を\n開く事が出来ると言われています。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02212",
   "op": "15",
   "jp": "そんな力、\n誰が持ってるってんだ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s438:02266",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s438:0235e",
   "op": "15",
   "jp": "お主じゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:0237e",
   "op": "15",
   "jp": "お主の着る大邪神の鎧は\n破壊と創造の、\n二つの力を併せ持つもの、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:023d2",
   "op": "15",
   "jp": "さすれば、お主こそ\nその力があってしかるべきじゃ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:02426",
   "op": "15",
   "jp": "私もそう思います。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:0245a",
   "op": "15",
   "jp": "さあ、門の前で\nこの石板を掲げて下さい。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02562",
   "op": "15",
   "jp": "どのみち、後戻りはできねぇんだ。\n他に選択肢なんかねぇんだろう！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s438:0265e",
   "op": "15",
   "jp": "物は試しだ、\nやってみて損はねぇ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s438:0275e",
   "op": "15",
   "jp": "なんかドキドキするな！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s438:02796",
   "op": "15",
   "jp": "あの石板を扱えるのは、\nもはやお主だけじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:027e6",
   "op": "15",
   "jp": "がんばってください！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s438:0281e",
   "op": "15",
   "jp": "今日の事は、一字一句忘れずに\n日記に書いておきますからね。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s438:0296a",
   "op": "15",
   "jp": "私はこの石板を託せる日を\n待ち望んでいました。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02c5a",
   "op": "15",
   "jp": "我が名はモーゼ、\n石板を守護する者なり。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02cea",
   "op": "15",
   "jp": "この世界を新たなる戒律へと\n導く者に、この力を託さん！！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02d36",
   "op": "15",
   "jp": "我は、真に等しき世界を\n望む者なり！！！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02dfe",
   "op": "15",
   "jp": "ハ・サタン様の真の御意志を\n継ぎし者が現れ・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02e42",
   "op": "15",
   "jp": "世界が・・・\n変革するときが来た。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02e76",
   "op": "15",
   "jp": "私もやっと・・・\n役目を果たし終えたか。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s438:02f0a",
   "op": "15",
   "jp": "モーゼ殿！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:02f96",
   "op": "15",
   "jp": "どうやら、\nすでに引き返す道のない旅に\n追い込まれちまったみてぇだな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s438:0300a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s438:03042",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s438:0307a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s438:030b2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s438:030ea",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s438:03122",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s438:0314e",
   "op": "15",
   "jp": "ぐずぐずはしておれん！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:0317a",
   "op": "15",
   "jp": "これだけ派手な事をしたんじゃ、\n門の向こうで、\nわんさか敵が待っておるぞ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s438:0321e",
   "op": "15",
   "jp": "ありがちだが、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s438:0323e",
   "op": "15",
   "jp": "「虎穴に入らずんば虎児を得ず」\nって事か？",
   "en": "",
   "box": "17x3",
   "face": 1
  }
 ]
}
