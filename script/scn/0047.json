 "strings": [
  {
   "id": "s47:0007a",
   "op": "15",
   "jp": "どうしたの？ひょっとして・・・",
   "en": ""
  },
  {
   "id": "s47:000aa",
   "op": "15",
   "jp": "具合でも悪いの？！",
   "en": ""
  },
  {
   "id": "s47:000e6",
   "op": "15",
   "jp": "今日も頑張って・・・\nリハビリしてよね！",
   "en": ""
  },
  {
   "id": "s47:00176",
   "op": "15",
   "jp": "だんだんと春めいて・・・\nスポーツの季節って感じだよね！",
   "en": ""
  },
  {
   "id": "s47:001ee",
   "op": "15",
   "jp": "朝のジョギングが、\n気持ちいい季節になってきたね！",
   "en": ""
  },
  {
   "id": "s47:00242",
   "op": "15",
   "jp": "今日も頑張って\nリハビリしなくっちゃ！",
   "en": ""
  },
  {
   "id": "s47:002aa",
   "op": "15",
   "jp": "さあ！\n今日も一日いっぱい汗を流すぞぉ～！",
   "en": ""
  },
  {
   "id": "s47:002e6",
   "op": "15",
   "jp": "朝から頑張らなきゃね！！",
   "en": ""
  },
  {
   "id": "s47:0033e",
   "op": "15",
   "jp": "おはよう！今日もなんだか・・・\n暑くなりそうだ～！！",
   "en": ""
  },
  {
   "id": "s47:003b2",
   "op": "15",
   "jp": "秋といったら運動の秋・・・\n朝から体を動かすのって\nとっても気持ちいいよね～！",
   "en": ""
  },
  {
   "id": "s47:00442",
   "op": "15",
   "jp": "おはよう。\nそろそろ寒くなるから・・・\n冬支度を始めなきゃだめかなぁ？！",
   "en": ""
  },
  {
   "id": "s47:004ca",
   "op": "15",
   "jp": "おはよ～っっ！！",
   "en": ""
  },
  {
   "id": "s47:004ee",
   "op": "15",
   "jp": "ボクは冬は比較的苦手なんだけど、\n今日も元気にいかなくっちゃね！",
   "en": ""
  },
  {
   "id": "s47:0056e",
   "op": "15",
   "jp": "おはよう。今日はなんだか、\n雪でも降りそうな雲行きだね！",
   "en": ""
  },
  {
   "id": "s47:005ba",
   "op": "15",
   "jp": "ウインタースポーツも棄てがたい\nよなぁ・・・",
   "en": ""
  }
 ]
}
