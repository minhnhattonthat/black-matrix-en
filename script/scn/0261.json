 ],
 "strings": [
  {
   "id": "s261:006fe",
   "op": "14",
   "jp": "噂ほどではないな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:0071c",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:0078a",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:00802",
   "op": "14",
   "jp": "噂ほどではないな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:00820",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:008ba",
   "op": "14",
   "jp": "（ち、ちくしょう！！）",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s261:008e6",
   "op": "14",
   "jp": "おい、貴様。俺が貴様の力を\n買ってやろう。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00918",
   "op": "14",
   "jp": "いくら欲しい？ん？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:0093e",
   "op": "14",
   "jp": "・・・",
   "en": "...",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:0095a",
   "op": "14",
   "jp": "こいつらを倒したら、\n特別な金を用意してやる。\nどうだ？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:009a6",
   "op": "14",
   "jp": "金がいるなら、\n貴様を殺して奪えばいい。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:009d6",
   "op": "14",
   "jp": "それが、\nこの世界のオキテであろう？",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:00a0e",
   "op": "14",
   "jp": "・・・",
   "en": "...",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00a2a",
   "op": "14",
   "jp": "貴様も生き延びたいのであれば、\n無駄口はたたかんことだ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:00a6a",
   "op": "14",
   "jp": "それとも、白き羽共による\n死より、俺からの死を\n望んでいるのか？",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:00abe",
   "op": "14",
   "jp": "ぐ・・・",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00b0e",
   "op": "14",
   "jp": "（行ってくれたか・・・）",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s261:00b6e",
   "op": "14",
   "jp": "くそぅ！待ちやがれ！てめぇ！\nまだ決着はついてねぇぞ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s261:00bee",
   "op": "14",
   "jp": "・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s261:00c6e",
   "op": "14",
   "jp": "大金をかけた、\n私の兵士達にかなうわけがない。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00cf6",
   "op": "14",
   "jp": "いい調子だ、\n給金を１０パーセントアップして\nやるぞ。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00d86",
   "op": "14",
   "jp": "その鎧はあまり傷つけるなよ、\n俺のコレクションに\nするんだからな！！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00e32",
   "op": "14",
   "jp": "なかなかやるな、\n降伏すれば俺が雇ってやるぞ。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00eba",
   "op": "14",
   "jp": "コラ！逃げるんじゃねぇ！\n逃げても借金は\n必ず追いかけてくるんだぜ",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:00f04",
   "op": "14",
   "jp": "一人倒す度に\nさらに１万のボーナスを出すぞ。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:01022",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s261:01034",
   "op": "14",
   "jp": "くだらん！俺の前に立つな！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s261:0116a",
   "op": "14",
   "jp": "ごめんなさい・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s261:01184",
   "op": "14",
   "jp": "お願いだから早く逃げて下さい！！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s261:012be",
   "op": "14",
   "jp": "なによ！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s261:012ce",
   "op": "14",
   "jp": "アタシは\nホントは闘いたくないんだから\n近寄らないで！！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s261:01416",
   "op": "14",
   "jp": "ぐっ！！\nか、堅てぇ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s261:01442",
   "op": "14",
   "jp": "なんだぁ！てめぇは！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s261:0146e",
   "op": "14",
   "jp": "お前らが、\n噂に聞く白い羽か・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:01498",
   "op": "14",
   "jp": "ふん。この程度の力で、\n貴様らに何が出来るというのだ？",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:014e2",
   "op": "14",
   "jp": "なんだと？この野郎！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s261:015d2",
   "op": "14",
   "jp": "（くっ！何だこの強さは！）",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s261:01602",
   "op": "14",
   "jp": "貴様！！何者だ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s261:0162a",
   "op": "14",
   "jp": "どけっ！俺がやる！！\nてめぇは手を出すんじゃねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s261:01672",
   "op": "14",
   "jp": "この筋肉バカが！！\nもっと状況を把握しろ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s261:016b2",
   "op": "14",
   "jp": "白い羽が、よく喋る・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:016d2",
   "op": "14",
   "jp": "（また、時代が動いているのか・・）",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:017da",
   "op": "14",
   "jp": "こ、この力は、\n神官以上の・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s261:0180e",
   "op": "14",
   "jp": "俺の力に及ばぬ者が、\n教団に・・・奴に\n立ち向かうというのか・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:01858",
   "op": "14",
   "jp": "愚かな奴らよ・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:01942",
   "op": "14",
   "jp": "（！？）",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s261:01952",
   "op": "14",
   "jp": "な、なぜこうも無効化できる！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s261:01986",
   "op": "14",
   "jp": "・・・ほう、なかなか\n面白い力を使うな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:019ba",
   "op": "14",
   "jp": "見極めてみるとするか・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:01cc6",
   "op": "14",
   "jp": "噂ほどではないな・・・",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:01ce4",
   "op": "14",
   "jp": "まあ、\nせいぜい生き延びることだな、\n力なき白い羽共よ。",
   "en": "",
   "box": "17x3",
   "face": 128
  },
  {
   "id": "s261:01d42",
   "op": "14",
   "jp": "なっ、なにぃ！？\n俺が、大金をはたいて集めた傭兵達が\nこうも簡単に。",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s261:01d9a",
   "op": "14",
   "jp": "奴ら逃げたぜ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s261:01db0",
   "op": "14",
   "jp": "どうする、俺達も一旦態勢を立て直すか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s261:01dfe",
   "op": "1d",
   "jp": "いったん街に戻る",
   "en": "",
   "max": 15
  },
  {
   "id": "s261:01e18",
   "op": "1d",
   "jp": "このままマモンを追う",
   "en": "",
   "max": 15
  }
 ]
}
