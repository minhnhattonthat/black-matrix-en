{
 "source": "d1:SCENARIO/273",
 "copies": [
  "d1:SCENARIO/273",
  "d2:SCENARIO/273"
 ],
 "strings": [
  {
   "id": "s273:00afa",
   "op": "15",
   "jp": "なっ、なぜだ！？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:00b1e",
   "op": "15",
   "jp": "それだけの力があれば、\nいくらでも金を手に入れる事が\nできようはずなのに！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:00b8a",
   "op": "15",
   "jp": "全ての者が金の為に生きていると\n言うわけではない！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s273:00bce",
   "op": "15",
   "jp": "この世界では忌み嫌われる、\n七つの大罪と言われることに、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s273:00c1a",
   "op": "15",
   "jp": "命をかける馬鹿者達も\nおるという事じゃ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s273:00ca6",
   "op": "15",
   "jp": "か、金が全てではないだと！？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:00cd6",
   "op": "15",
   "jp": "金さえあれば、自由に\n生きられるし、強い味方を\n雇うこともできるのだぞ！？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:00d86",
   "op": "15",
   "jp": "だが、それは必ずしも\n自分自身の力ではないし、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s273:00ea2",
   "op": "15",
   "jp": "本当の自由でもない！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s273:00ed6",
   "op": "15",
   "jp": "人はパンの為にのみ\n生きるにあらず！ってこったよ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s273:00f2a",
   "op": "15",
   "jp": "パルタもそう言ってた！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s273:00f62",
   "op": "15",
   "jp": "所詮貴様も、\n世を統べる教団の前では、\n一介の領主に過ぎぬであろう。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s273:00fba",
   "op": "15",
   "jp": "身を取り巻く金の繋がり以外には\n何も持たぬ、弱い生き物だったと\nいうことじゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s273:01022",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:0103e",
   "op": "15",
   "jp": "貴様らは本当の、\n金の恐さを知らんのだ！",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:0107a",
   "op": "15",
   "jp": "貴様らには高額の賞金がかけられ、\nどこに行こうと\n狙われ続けるんだぞ！？",
   "en": "",
   "box": "17x3",
   "face": 14
  },
  {
   "id": "s273:0113e",
   "op": "15",
   "jp": "たとえ何があろうと、\n少なくとも私たちには・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s273:01182",
   "op": "15",
   "jp": "自分の信じた道があるわ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s273:011ce",
   "op": "15",
   "jp": "ところが、あんたはん達の場合、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s273:011fe",
   "op": "15",
   "jp": "その信じとるモンが\n大問題なんよ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s273:014ee",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s273:020d2",
   "op": "15",
   "jp": "邪神崇拝のみならず・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s273:020fe",
   "op": "15",
   "jp": "その力を使こぉて、\n世界を混乱と崩壊に導こうとする\nアンタはん達には・・・",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s273:0215a",
   "op": "15",
   "jp": "総本山の教皇庁から、\n直接の抹殺命令が下されました！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s273:022ca",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s273:022ee",
   "op": "15",
   "jp": "教皇様の名において、\n我ら異端審問十字軍が、",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s273:0232e",
   "op": "15",
   "jp": "アンタはん達を処刑します！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s273:0236a",
   "op": "15",
   "jp": "冗談じゃねぇ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s273:0238a",
   "op": "15",
   "jp": "お前らの勝手な言いぐさで\n殺されてたまるかよ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s273:023f2",
   "op": "15",
   "jp": "そうだそうだ～！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s273:02426",
   "op": "15",
   "jp": "だいいちワシ等は、\nこの世界の崩壊なぞ\n望んではおらんぞ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s273:0248e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s273:024c6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s273:024fe",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s273:0252a",
   "op": "15",
   "jp": "問答無用やネ！",
   "en": "",
   "box": "17x3",
   "face": 18
  },
  {
   "id": "s273:0254a",
   "op": "15",
   "jp": "やれっ！",
   "en": "",
   "box": "17x3",
   "face": 18
  }
 ]
}
