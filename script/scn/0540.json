 "strings": [
  {
   "id": "s540:00026",
   "op": "14",
   "jp": "我は、天使達の君主にして、\n天界の大王と呼ばれし者・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:00066",
   "op": "14",
   "jp": "その名はベール！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:00080",
   "op": "14",
   "jp": "私を呼び出せたことを・・・\n神に感謝するがいい！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:000c6",
   "op": "14",
   "jp": "おいっ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s540:000da",
   "op": "14",
   "jp": "キサマ等外見にだまされてるぞ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s540:00102",
   "op": "14",
   "jp": "奴等の中身は・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s540:0012a",
   "op": "14",
   "jp": "我々天魔にとっては・・・\n中身など関係ない！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:0016e",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s540:00186",
   "op": "14",
   "jp": "要はメフィスト様の遺骸を\n受け継いだ教皇という・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:001c2",
   "op": "14",
   "jp": "看板こそが重要なのだ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:001e2",
   "op": "14",
   "jp": "それに我々を呼び出せる\nというだけで・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s540:00214",
   "op": "14",
   "jp": "すでに中身も大した物だとは、\n思わんのか！？",
   "en": "",
   "box": "17x3",
   "face": 104
