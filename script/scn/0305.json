 ],
 "strings": [
  {
   "id": "s305:00dc2",
   "op": "15",
   "jp": "コウモリ！？\n奴の正体はコウモリだったのか？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s305:00e32",
   "op": "15",
   "jp": "いや、おそらく\nこれは奴の作った影！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:00f06",
   "op": "15",
   "jp": "じゃあ、\nバアルは別の場所に？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:00f46",
   "op": "15",
   "jp": "うむ、隠れておるにちがいない！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:00f86",
   "op": "15",
   "jp": "くっ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:00fae",
   "op": "15",
   "jp": "それにしても\nいったい何が有ったというのじゃ\nガイよ！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:0101e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:0103a",
   "op": "15",
   "jp": "やっぱり奴は単なる・・・\n偽善者だったって事さ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:0107e",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:0109a",
   "op": "15",
   "jp": "その言葉が真実ならば・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:010c6",
   "op": "15",
   "jp": "この屋敷にもすでに仕掛けが\nしてあるやもしれん・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:0110e",
   "op": "15",
   "jp": "奴の正体はどうやら、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:01136",
   "op": "15",
   "jp": "人間を吸血鬼へと変える\nヴァンパイヤ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:01172",
   "op": "14",
   "jp": "・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s305:0119a",
   "op": "15",
   "jp": "いったん奴に生き血を\n吸い尽くされれば、\nもはや人間には戻れん！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:011fe",
   "op": "15",
   "jp": "待ってくれ！！\nじゃあこの屋敷のメイド達も？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:0126e",
   "op": "15",
   "jp": "おそらくはすでに・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:012be",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:0130e",
   "op": "15",
   "jp": "じゃが、たとえ彼女らが\n可哀想な白き羽の者達とはいえ、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:01356",
   "op": "15",
   "jp": "私情を捨てて戦わんと\nお主達まで、吸血鬼と化すぞ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:013b6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:01406",
   "op": "15",
   "jp": "さっきの食事を食べ損ねたから\nお腹がすいたよ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s305:0147e",
   "op": "15",
   "jp": "緊張感のねぇやつだ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s305:014fa",
   "op": "15",
   "jp": "いや、こやつの言う事も\nもっともじゃ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:0154a",
   "op": "15",
   "jp": "激情に身を任せたままでは\nそれこそ奴らの思うツボ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:015da",
   "op": "15",
   "jp": "いったん屋敷を出て、\n態勢を整えた方が良い。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:0167a",
   "op": "15",
   "jp": "良いな？ガイ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s305:0169e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s305:016ca",
   "op": "1d",
   "jp": "いったん街に戻る！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s305:016e8",
   "op": "1d",
   "jp": "バアルを追う！",
   "en": "",
   "max": 15
  }
 ]
}
