{
 "source": "d1:SCENARIO/228",
 "copies": [
  "d1:SCENARIO/228",
  "d2:SCENARIO/228"
 ],
 "strings": [
  {
   "id": "s228:0064a",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s228:00672",
   "op": "15",
   "jp": "さっきは・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:00692",
   "op": "15",
   "jp": "突然無理な事を言い出しちゃって\nごめんね・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:006d6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s228:00702",
   "op": "15",
   "jp": "ボクは、ほら・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:00726",
   "op": "15",
   "jp": "色々あって、突然白き羽に生まれ\n変わっちゃったじゃない！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:00772",
   "op": "15",
   "jp": "だから、二度と家には\n帰れないかもしれないって\n思ったら・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:007c2",
   "op": "15",
   "jp": "なんだか・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:007e6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s228:00812",
   "op": "15",
   "jp": "ううん！\n別段後悔してるわけじゃないんだ！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0084e",
   "op": "15",
   "jp": "むしろこんな健康な体に\n生まれ変われて感謝してるし・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:008a6",
   "op": "15",
   "jp": "だからもしかしたら・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:008d2",
   "op": "15",
   "jp": "父さん達も・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:008f6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s228:00922",
   "op": "15",
   "jp": "ごめんね！\nほんとうになんでもないんだ！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0096a",
   "op": "15",
   "jp": "昼間の方が人通りも少ないから・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0099e",
   "op": "15",
   "jp": "今日は無理してでも夜のうちに\n寝ておかなくっちゃね・・・！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:01012",
   "op": "15",
   "jp": "なんなんだココは！？\nまっ・・・まるで村全体が・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s228:0105a",
   "op": "15",
   "jp": "でっかい墓地みたいじゃねえか！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s228:0109a",
   "op": "15",
   "jp": "それに住民も・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s228:010be",
   "op": "15",
   "jp": "なぜだか、ジジイとババアばっかり\nときてやがるぜ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s228:011a6",
   "op": "15",
   "jp": "このケデロンの村には・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:011d2",
   "op": "15",
   "jp": "度重なる戦争で死んだ、\n兵士達の遺体が・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:01212",
   "op": "15",
   "jp": "埋められているんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0123e",
   "op": "15",
   "jp": "この村の住人はみんな・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0126a",
   "op": "15",
   "jp": "この巨大な墓地に守られて\n生活しているんだよ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:012be",
   "op": "15",
   "jp": "墓地に守られてるだぁ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s228:012f6",
   "op": "15",
   "jp": "なるほどね・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s228:0131a",
   "op": "15",
   "jp": "私達アンゲルス教を信じる\n黒き羽の一族にとって、\n自分の亡骸は・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s228:01372",
   "op": "15",
   "jp": "いつの日にか再び転生するために\n必要な聖なる器だと信じられて\nいますもんね・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s228:013e2",
   "op": "15",
   "jp": "流石の権力者達も・・・、\nいつ自分達が入るか解らない\n墓の周りでは・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0143e",
   "op": "15",
   "jp": "戦争をやろうとは\nしないでしょ・・・？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:01486",
   "op": "15",
   "jp": "ようするに、臆病者の住人が\n住む村だ、って事だ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s228:014ce",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:015d6",
   "op": "15",
   "jp": "ちなみにわしら黒き羽の一族の\n生き方は大きく三つに分けて\n考えられるじゃろう・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:0163a",
   "op": "15",
   "jp": "まずは、力を求めて腕を磨くために\n放浪生活を送る者達・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01686",
   "op": "15",
   "jp": "彼らは時として軍の傭兵となったり\n金持ちの用心棒になったりはするが、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:016de",
   "op": "15",
   "jp": "基本的には己の腕だけで生きようと\nするために、決まった住居を持たず\n家族も持たないのが一般的じゃ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01756",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s228:01782",
   "op": "15",
   "jp": "次にその力のおかげで、\nすでに名声を得てしまっておって、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:017ce",
   "op": "15",
   "jp": "年老いてからは、ある一定の場所に\n住居を構えた者達・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:0181a",
   "op": "15",
   "jp": "彼らは家族を持ち種族繁栄に\nいそしみながら、戦いだけではなく\n奴隷を使っての農耕や・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01886",
   "op": "15",
   "jp": "商売を行わせたりするんじゃが\nその中でも特に力のある者が・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:018d6",
   "op": "15",
   "jp": "教皇や領主達に貢ぎ物を贈り・・・\n街や村の管理を任されるように\nなるのじゃ・・・！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:0194a",
   "op": "15",
   "jp": "ボクの両親が、そのパターンだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:0198e",
   "op": "15",
   "jp": "そして一番多いのが力を求める事を\nすでにあきらめ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:019d6",
   "op": "15",
   "jp": "生きるためだけに\n日々の生活をしている者達・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01a1a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s228:01a46",
   "op": "15",
   "jp": "俺がこの世で一番嫌いなタイプの\n連中じゃねえか・・・！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s228:01a9e",
   "op": "15",
   "jp": "とはいえ、実際の世の中という\nものは大多数の彼らのような人間が",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01aee",
   "op": "15",
   "jp": "動かしておるのだ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01b16",
   "op": "15",
   "jp": "村にあるしがない店を経営したり、\nただ毎日の日銭を稼いで生活する\n力無き者達が寄り集まって・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01b8a",
   "op": "15",
   "jp": "結果的に出来上がったのが\n一つの街だという事じゃよ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01bfa",
   "op": "15",
   "jp": "彼らとて、自分自身の生活水準を\n少しでも上げようと、普段から\nもがき苦しんでおる・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01c62",
   "op": "15",
   "jp": "言い換えれば彼らのような底辺の\n人間こそが、社会を動かす潤滑剤に\nなっておるという事じゃろう・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01cfe",
   "op": "15",
   "jp": "そもそも人間という生き物は・・・\n群をなして生活する習性を\n持った動物じゃからなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01d8e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s228:01dc6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s228:01e16",
   "op": "15",
   "jp": "それよりピリポ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01e3a",
   "op": "15",
   "jp": "お主の実家は、まだココから\nだいぶ距離があるのかな！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s228:01efe",
   "op": "15",
   "jp": "ココからなら\n大した距離じゃないんだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:01f3e",
   "op": "15",
   "jp": "出来れば先に、実家の隣に住んでいる弟に話を聞きたいんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s228:01fa6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s228:01fd2",
   "op": "15",
   "jp": "そういえばアナタも元々は・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s228:02002",
   "op": "15",
   "jp": "アタシ達と同じ黒き羽の出身\nだったんですものね・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s228:0204a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  }
 ]
}
