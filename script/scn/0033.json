{
 "source": "d1:SCENARIO/33",
 "copies": [
  "d1:SCENARIO/33",
  "d2:SCENARIO/33"
 ],
 "strings": [
  {
   "id": "s33:00696",
   "op": "14",
   "jp": "何だ・・・！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:006ac",
   "op": "14",
   "jp": "奴隷のくせに・・・\n立ったまま話しかけるんじゃねぇ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:006e8",
   "op": "14",
   "jp": "なに一人でうろついてんだ？\nまさか野良奴隷じゃあるまいな！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00766",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00776",
   "op": "14",
   "jp": "なにを話しかけているの！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00798",
   "op": "14",
   "jp": "私は、アナタが簡単に\n話しかけてもいいような・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:007d2",
   "op": "14",
   "jp": "身分じゃないのよ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:0082a",
   "op": "14",
   "jp": "ごめんなさい、\n急いでるの・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00852",
   "op": "14",
   "jp": "遅くなるとご主人様に\nひどくぶたれるのよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:008be",
   "op": "14",
   "jp": "何だよ、話しかけるなよ！\nさぼってると思われるだろう！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:008fe",
   "op": "14",
   "jp": "（あいついいなぁ・・・！）",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00920",
   "op": "14",
   "jp": "（立って歩いても\n　怒られないのかぁ・・・！）",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00992",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:009de",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00a2a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00a3e",
   "op": "14",
   "jp": "・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00a4c",
   "op": "14",
   "jp": "こちとら腐っても\nてめえら相手には商売しねえぞ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00abe",
   "op": "14",
   "jp": "へい、らっしゃ！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00ad8",
   "op": "14",
   "jp": "なんでえ白い羽か、\n何だお使いか？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00b02",
   "op": "14",
   "jp": "なにが欲しいんだ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00b1c",
   "op": "14",
   "jp": "おっとその前に、\nお前が飼い主から預かってきた",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00b52",
   "op": "14",
   "jp": "商品購入・委任証明書を\n見せてもらおうか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00b86",
   "op": "14",
   "jp": "バカ野郎！！\nさっさと貰ってこい！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00bea",
   "op": "14",
   "jp": "ふむ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00bfc",
   "op": "14",
   "jp": "やはり奴隷にしては\nちょっと変わっておるのぅ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00c32",
   "op": "14",
   "jp": "かなり邪悪な面構えをしておる！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00c92",
   "op": "14",
   "jp": "何だ、貴様は！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00cda",
   "op": "14",
   "jp": "飼い主はどうした？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00cf4",
   "op": "14",
   "jp": "いいから貴様の・・・\n奴隷認識票を出せ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00d32",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s33:00d52",
   "op": "14",
   "jp": "さては貴様\n逃亡奴隷じゃ！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00d76",
   "op": "14",
   "jp": "・・・なんだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00d8c",
   "op": "14",
   "jp": "ちゃんと持ってるじゃねえか！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00db2",
   "op": "14",
   "jp": "なになに予防注射は・・・\n済ませてるっと！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00de4",
   "op": "14",
   "jp": "なるほど・・・！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00dfe",
   "op": "14",
   "jp": "貴様は、あの丘の上に住む\nオカルトマニアの変人が、\n飼っている奴隷なのか！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00e5e",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s33:00e76",
   "op": "14",
   "jp": "どうりで服なんか着て\nおかしな奴隷だと思ったぜ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00efa",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s33:00f08",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s33:00f18",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  },
  {
   "id": "s33:00f46",
   "op": "14",
   "jp": "お前奴隷のくせに\nなんで服を着てるんだ！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00f78",
   "op": "14",
   "jp": "だいたいお前のご主人様は・・・\nどっか、おかしいって噂だぞ！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00fbe",
   "op": "14",
   "jp": "噂だと、一緒のテーブルで\n奴隷と食事をしたり・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:00ff8",
   "op": "14",
   "jp": "一緒に働いたり\nするらしいじゃないか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:01036",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s33:0105a",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:0106a",
   "op": "14",
   "jp": "だけどオレは正直、\nお前のご主人様がうらやましいよ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:010a6",
   "op": "14",
   "jp": "だって俺達のご主人様のように\nいきなり殴り倒したり",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:010e0",
   "op": "14",
   "jp": "死ぬまで働かせて・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:010fe",
   "op": "14",
   "jp": "そこいら辺に、\nてきとうに埋めちまったり\nするような事は・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:01144",
   "op": "14",
   "jp": "お前には無いんだろ！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:01162",
   "op": "14",
   "jp": "気をつけろよ・・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:0117e",
   "op": "14",
   "jp": "俺達奴隷が、\nご主人様を連れずに・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:011ac",
   "op": "14",
   "jp": "しかも、首輪も着けずに\n街を歩いているのが見つかったら",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:011ea",
   "op": "14",
   "jp": "すぐに異端審問官達に\nとっつかまって、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:01218",
   "op": "14",
   "jp": "お前だけじゃなく\nお前のご主人様まで、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s33:01246",
   "op": "14",
   "jp": "ひどい罰を受ける事になるぞ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  }
 ]
}
