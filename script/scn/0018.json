{
 "source": "d1:SCENARIO/18",
 "copies": [
  "d1:SCENARIO/18",
  "d2:SCENARIO/18"
 ],
 "strings": [
  {
   "id": "s18:0020e",
   "op": "15",
   "jp": "目が覚めたからって、\nまだ動くんじゃないよ！",
   "en": ""
  },
  {
   "id": "s18:0024e",
   "op": "15",
   "jp": "いい！？アンタはアタシの奴隷なの、アタシの言うことは絶対なのよ！",
   "en": ""
  },
  {
   "id": "s18:002ae",
   "op": "15",
   "jp": "そうね、あのときのことでも\n話してあげるわ！",
   "en": ""
  },
  {
   "id": "s18:002ee",
   "op": "15",
   "jp": "あの大きな落雷があった日、\nといっても覚えていないのね、\n全く・・・",
   "en": ""
  },
  {
   "id": "s18:00346",
   "op": "15",
   "jp": "アンタはアタシの言いつけ通りに\n山に入って、薬草を取りにいった。",
   "en": ""
  },
  {
   "id": "s18:0039a",
   "op": "15",
   "jp": "何故医者に行かなかったのかって？",
   "en": ""
  },
  {
   "id": "s18:003da",
   "op": "15",
   "jp": "ふん！\n奴隷のくせにアタシに質問？",
   "en": ""
  },
  {
   "id": "s18:0041e",
   "op": "15",
   "jp": "（あ、アタシ以外のものに\n　アンタの体を・・・）",
   "en": ""
  },
  {
   "id": "s18:0046e",
   "op": "15",
   "jp": "と、とにかく山の奥へ\n入って行ったアンタは、\n何かの事故に巻き込まれたようね！",
   "en": ""
  },
  {
   "id": "s18:004ce",
   "op": "15",
   "jp": "それはたぶん、\nとても大きな事故だったと思う・・・",
   "en": ""
  },
  {
   "id": "s18:00586",
   "op": "15",
   "jp": "（だって、アタシは見たのよ！）",
   "en": ""
  },
  {
   "id": "s18:005b6",
   "op": "15",
   "jp": "（雨が止んだあの日・・・）",
   "en": ""
  },
  {
   "id": "s18:005e2",
   "op": "15",
   "jp": "（やっと動けるようになって\n　入って行った山の中に・・・）",
   "en": ""
  },
  {
   "id": "s18:0062e",
   "op": "15",
   "jp": "（アンタを囲むようにして倒れている　大勢の人の死体を・・・！！）",
   "en": ""
  },
  {
   "id": "s18:00682",
   "op": "15",
   "jp": "（かすかな息しかしていない、\n　血だらけのアンタを見たとき、）",
   "en": ""
  },
  {
   "id": "s18:006d2",
   "op": "15",
   "jp": "（アタシには一体何がおきたのか\n　分からなかった・・・）",
   "en": ""
  },
  {
   "id": "s18:0071e",
   "op": "15",
   "jp": "（この世界から・・・\n　アンタがいなくなったら\n　アタシは・・・）",
   "en": ""
  },
  {
   "id": "s18:00782",
   "op": "15",
   "jp": "べ、別にアンタのことなんか、\n心配してないわよ！！",
   "en": ""
  },
  {
   "id": "s18:007d6",
   "op": "15",
   "jp": "グスッ・・・",
   "en": ""
  },
  {
   "id": "s18:00852",
   "op": "15",
   "jp": "ふん！\nちょっと喋りすぎたようね！",
   "en": ""
  },
  {
   "id": "s18:00886",
   "op": "15",
   "jp": "早く元気になることね！",
   "en": ""
  },
  {
   "id": "s18:008be",
   "op": "15",
   "jp": "アタシはアンタのことを・・・",
   "en": ""
  },
  {
   "id": "s18:00b2e",
   "op": "15",
   "jp": "アンタが目を覚まさなかったとき、",
   "en": ""
  },
  {
   "id": "s18:00b62",
   "op": "15",
   "jp": "アタシ、気付いちゃったのよ・・・",
   "en": ""
  },
  {
   "id": "s18:00b96",
   "op": "15",
   "jp": "本当の自分の気持ちに・・・",
   "en": ""
  },
  {
   "id": "s18:00bc2",
   "op": "15",
   "jp": "アンタの瞳に・・・\nとっても惹かれるの・・・",
   "en": ""
  },
  {
   "id": "s18:00c02",
   "op": "15",
   "jp": "アンタに見つめられると、\n忘れていた暖かい感情が・・・\nなんだかよみがえるようで！",
   "en": ""
  },
  {
   "id": "s18:00c66",
   "op": "15",
   "jp": "嫌われてるに決まってる・・・\n・・・でも！",
   "en": ""
  },
  {
   "id": "s18:00ca2",
   "op": "15",
   "jp": "アンタに対するアタシの\nこの気持ちだけは・・・",
   "en": ""
  },
  {
   "id": "s18:00ce2",
   "op": "15",
   "jp": "永遠に変わらない・・・",
   "en": ""
  },
  {
   "id": "s18:0109a",
   "op": "15",
   "jp": "ふん！やっと動ける\nようになったようね。\nこの一週間大変だったわ！",
   "en": ""
  },
  {
   "id": "s18:010fe",
   "op": "15",
   "jp": "だ、だけどまさか無理してるんじゃ\nないでしょうねぇ～？",
   "en": ""
  },
  {
   "id": "s18:01156",
   "op": "15",
   "jp": "また、倒れられたりしたら、\nかえって面倒だわ！",
   "en": ""
  },
  {
   "id": "s18:011a6",
   "op": "15",
   "jp": "どうやら・・・大丈夫なようね。",
   "en": ""
  },
  {
   "id": "s18:011da",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s18:01206",
   "op": "15",
   "jp": "そういえば一つだけ、\n大事なことがあるわ！",
   "en": ""
  },
  {
   "id": "s18:01242",
   "op": "15",
   "jp": "これは重要な事だから、\n絶対に忘れないで！",
   "en": ""
  },
  {
   "id": "s18:0127e",
   "op": "15",
   "jp": "アンタはこの世界での記憶を\n無くしてしまって、",
   "en": ""
  },
  {
   "id": "s18:012be",
   "op": "15",
   "jp": "この世界の常識に\n慣れてないはずだわ。",
   "en": ""
  },
  {
   "id": "s18:012f6",
   "op": "15",
   "jp": "だから私が安心してアンタを、\n家の外に送り出せるようになるまで、",
   "en": ""
  },
  {
   "id": "s18:0134a",
   "op": "15",
   "jp": "私の断り無しに、\n家の柵の外には出ない事！！",
   "en": ""
  },
  {
   "id": "s18:01396",
   "op": "15",
   "jp": "いい！？\n勝手に外に出たら、\nただじゃ済まさないわよ！",
   "en": ""
  },
  {
   "id": "s18:013ee",
   "op": "15",
   "jp": "しばらくは・・・\nこの家でリハビリでもしてなさい！！",
   "en": ""
  }
 ]
}
