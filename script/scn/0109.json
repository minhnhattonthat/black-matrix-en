 "strings": [
  {
   "id": "s109:00032",
   "op": "15",
   "jp": "私ね・・・\n人に裏切られるのが恐くて・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:0006e",
   "op": "15",
   "jp": "どうしても人と話をする事が・・・\n出来ないのね・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:000c2",
   "op": "15",
   "jp": "だけど・・・\n私には両親も、友達も・・・\n誰もいないから・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:00112",
   "op": "15",
   "jp": "本当は、人寂しくて・・・\nだけど・・・\n誰にも嫌われたくなくて・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:0016a",
   "op": "15",
   "jp": "しょうがないのょぉ・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:001a2",
   "op": "15",
   "jp": "だ・・だから・・・\nだから私決めたの・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:001de",
   "op": "15",
   "jp": "誰にも・・・\n本当の自分は見せないで・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:0021a",
   "op": "15",
   "jp": "自分一人で・・・\n生きていこうって・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:00262",
   "op": "15",
   "jp": "だけど・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:00282",
   "op": "15",
   "jp": "キミが目を覚まさなかった\nこの１０ヶ月間で・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:002c6",
   "op": "15",
   "jp": "私の中で・・・\n何かがはじけちゃったのよぉ！！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:0030a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:00326",
   "op": "15",
   "jp": "私は・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:00352",
   "op": "15",
   "jp": "キミと一緒に居られる時だけ・・・\n人に甘える事が出来たんだと思う。",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:003a6",
   "op": "15",
   "jp": "キミに見つめられていると・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:003d6",
   "op": "15",
   "jp": "忘れていた気持ちが、\nなんだか、よみがえりそうで！",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:0042a",
   "op": "15",
   "jp": "例えみんなに毛嫌いされようと、\nこの気持ちだけは・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s109:00472",
   "op": "15",
   "jp": "ずっと、ずぅ～っと変わらないよ！",
   "en": "",
   "box": "17x3",
   "face": 10
  }
 ]
}
