{
 "source": "d1:SCENARIO/212",
 "copies": [
  "d1:SCENARIO/212",
  "d2:SCENARIO/212"
 ],
 "strings": [
  {
   "id": "s212:00a6e",
   "op": "15",
   "jp": "くっくっくっ・・・・・",
   "en": ""
  },
  {
   "id": "s212:00a96",
   "op": "15",
   "jp": "確かに勝てば大金が手に入るが、",
   "en": ""
  },
  {
   "id": "s212:00ac6",
   "op": "15",
   "jp": "この闘技場に集まる者達はいずれも\n自らが最強を名乗る、\n歴戦の戦士達ばかりだ・・・",
   "en": ""
  },
  {
   "id": "s212:00b2a",
   "op": "15",
   "jp": "しかもケガによる試合放棄や反則などという甘っちょろい物など・・・",
   "en": ""
  },
  {
   "id": "s212:00b7e",
   "op": "15",
   "jp": "ここには有りはしない！！",
   "en": ""
  },
  {
   "id": "s212:00baa",
   "op": "15",
   "jp": "二度と生きては戻れん方に、\n俺もたんまり賭けさせて貰うぜ！",
   "en": ""
  },
  {
   "id": "s212:00ea2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:00ece",
   "op": "15",
   "jp": "・・・・すまんな！",
   "en": ""
  },
  {
   "id": "s212:00ef2",
   "op": "15",
   "jp": "成り行きとはいえ、\nこんなくだらねぇ事にお前達まで\nつきあわせちまって・・・",
   "en": ""
  },
  {
   "id": "s212:00f52",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s212:00f7e",
   "op": "15",
   "jp": "お察しのとおり俺はその昔、\n剣闘士となるべく育てられ・・・",
   "en": ""
  },
  {
   "id": "s212:00ff2",
   "op": "15",
   "jp": "いや・・・\nむしろ創られたといったほうが",
   "en": ""
  },
  {
   "id": "s212:0102e",
   "op": "15",
   "jp": "適切なのかもしれねえなぁ・・・",
   "en": ""
  },
  {
   "id": "s212:01086",
   "op": "15",
   "jp": "なにせ俺は両親の顔すら見たことが\nねぇんだからなぁ・・・・",
   "en": ""
  },
  {
   "id": "s212:010d6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01102",
   "op": "15",
   "jp": "剣闘士ってぇのは大抵、金持ち共が\n自分の権力を他の金持ち共に\n見せつける目的で集めてきた、",
   "en": ""
  },
  {
   "id": "s212:0116e",
   "op": "15",
   "jp": "力自慢の奴隷連中なんだが・・・",
   "en": ""
  },
  {
   "id": "s212:0119e",
   "op": "15",
   "jp": "負ければその場で必ず殺される！！",
   "en": ""
  },
  {
   "id": "s212:011d2",
   "op": "15",
   "jp": "だから勝ち続けるような奴隷を\n捜してくるのは並大抵の事じゃあ\nねぇんで・・・",
   "en": ""
  },
  {
   "id": "s212:01256",
   "op": "15",
   "jp": "そのうちに誰の子供かが重要視されるようになり始めたのさ・・・",
   "en": ""
  },
  {
   "id": "s212:012ca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:012f6",
   "op": "15",
   "jp": "うちの両親もその昔は、剣闘界の帝王とか桜の女王とうたわれた強者だったと聞いちゃあいるが・・・",
   "en": ""
  },
  {
   "id": "s212:01366",
   "op": "15",
   "jp": "二人とも、ジジイババアになって\nまで剣闘奴隷を続けさせられ・・・",
   "en": ""
  },
  {
   "id": "s212:013de",
   "op": "15",
   "jp": "結局あの世へいっちまった・・・",
   "en": ""
  },
  {
   "id": "s212:01436",
   "op": "15",
   "jp": "産まれてすぐにセリにかけられるから子供の顔なんかいちいち覚えちゃ\nいなかったんだろうが・・・",
   "en": ""
  },
  {
   "id": "s212:014ee",
   "op": "15",
   "jp": "それでも・・・",
   "en": ""
  },
  {
   "id": "s212:0150e",
   "op": "15",
   "jp": "ただ生き残るためだけに戦い続け・・",
   "en": ""
  },
  {
   "id": "s212:01542",
   "op": "15",
   "jp": "力を手に入れようともがくだけの\n人生しか送れなかった両親には・・・",
   "en": ""
  },
  {
   "id": "s212:01596",
   "op": "15",
   "jp": "正直、心から同情しているよ・・・",
   "en": ""
  },
  {
   "id": "s212:015ca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:0161a",
   "op": "15",
   "jp": "僕たち、黒き羽の家に産まれた\n子供は、誰もが教会で\nこんな風に教わるんだ・・・",
   "en": ""
  },
  {
   "id": "s212:0167a",
   "op": "15",
   "jp": "元来、人間はこの地球上に\n生息している他の多くの動物と\nなんら変わりのない存在だから",
   "en": ""
  },
  {
   "id": "s212:016e2",
   "op": "15",
   "jp": "自然界における大原則、弱肉強食\nこそが万物不変の真理であり、",
   "en": ""
  },
  {
   "id": "s212:01732",
   "op": "15",
   "jp": "最終的に勝ち残った強者こそが\n正しき者なんだって・・・",
   "en": ""
  },
  {
   "id": "s212:0177e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:017aa",
   "op": "15",
   "jp": "じゃが、わし等が言う強さとは、\n単純に体力的な物だけを指し示す\nわけでは無い・・・",
   "en": ""
  },
  {
   "id": "s212:0180e",
   "op": "15",
   "jp": "経済力や精神力・・・\n人々を引きつける魅力の\nような物までをも、含んでおる！",
   "en": ""
  },
  {
   "id": "s212:0186e",
   "op": "15",
   "jp": "その証拠に、たとえ体力的には\n多少劣っておったとしても、傭兵や\n殺し屋を雇う事が出来るような",
   "en": ""
  },
  {
   "id": "s212:018de",
   "op": "15",
   "jp": "財力をもった商売人が・・・",
   "en": ""
  },
  {
   "id": "s212:0190a",
   "op": "15",
   "jp": "簡単に殺されるような事は、\n滅多にありえんのじゃ・・・",
   "en": ""
  },
  {
   "id": "s212:01956",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01982",
   "op": "15",
   "jp": "人は、産まれた段階ですでに、",
   "en": ""
  },
  {
   "id": "s212:019b2",
   "op": "15",
   "jp": "その運動能力や容姿や性別・・・\n親や地域による貧富の差など",
   "en": ""
  },
  {
   "id": "s212:019fe",
   "op": "15",
   "jp": "人それぞれに別々の、非常に偏った\n条件や環境を持って育つもので・・・",
   "en": ""
  },
  {
   "id": "s212:01a56",
   "op": "15",
   "jp": "それらがスタートラインから\n等しく同じ条件になる事など\n決して有りえんのじゃ・・・",
   "en": ""
  },
  {
   "id": "s212:01aba",
   "op": "15",
   "jp": "お主達になら、理解出来るじゃろう？",
   "en": ""
  },
  {
   "id": "s212:01af2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01b12",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01b4a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01b9a",
   "op": "15",
   "jp": "じゃが人は、自分自身の努力如何に\nよっては・・・",
   "en": ""
  },
  {
   "id": "s212:01bde",
   "op": "15",
   "jp": "学問や見識を広める事によって\n知識という力を、後天的に\n手に入れる事が出来る・・・",
   "en": ""
  },
  {
   "id": "s212:01c42",
   "op": "15",
   "jp": "そしてそれらを生かすだけの\n知恵と経験を身につける\n事さえできれば・・・",
   "en": ""
  },
  {
   "id": "s212:01cc2",
   "op": "15",
   "jp": "そのスタートラインでの不利な条件をはるかに上回る強力な力を手に入れることが出来るという事じゃ・・・！",
   "en": ""
  },
  {
   "id": "s212:01d3a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01d66",
   "op": "15",
   "jp": "じゃからこそ我々は、我々にとってのもう一つの重要な理念でもある、",
   "en": ""
  },
  {
   "id": "s212:01dba",
   "op": "15",
   "jp": "自分の欲望に正直に生きると\nいう事を大切にして生きなければ\nならん・・・",
   "en": ""
  },
  {
   "id": "s212:01e3a",
   "op": "15",
   "jp": "なにせ総ての物事の上達は・・・",
   "en": ""
  },
  {
   "id": "s212:01e6a",
   "op": "15",
   "jp": "「好きこそ物の上手なれ」と\n昔から言うではないか・・・！",
   "en": ""
  },
  {
   "id": "s212:01eda",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01efa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:01f3e",
   "op": "15",
   "jp": "だから私達は・・・・",
   "en": ""
  },
  {
   "id": "s212:01f66",
   "op": "15",
   "jp": "この世のあらゆる偽善と戦い、\nつねに本音で話しをするよう\n教えられているんですわ！",
   "en": ""
  },
  {
   "id": "s212:01fe6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:0201e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:0203e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s212:02216",
   "op": "15",
   "jp": "おい・・・、そろそろ\n貴様達の出番だぞ！！",
   "en": ""
  }
 ]
}
