 "strings": [
  {
   "id": "s203:00542",
   "op": "15",
   "jp": "この丘を越えれば、\nパンデモニウムの街か・・・",
   "en": ""
  },
  {
   "id": "s203:00582",
   "op": "15",
   "jp": "なんだかやけに懐かしいぜ！",
   "en": ""
  },
  {
   "id": "s203:005ae",
   "op": "15",
   "jp": "俺は昔、あそこの領主に\n仕えていた事があったんだ！",
   "en": ""
  },
  {
   "id": "s203:00626",
   "op": "15",
   "jp": "アナタが仕えていたのなら\nその領主はとても\n強かったんでしょうね・・・",
   "en": ""
  },
  {
   "id": "s203:00752",
   "op": "15",
   "jp": "それがとんでもない\n見かけ倒しでなぁ～！",
   "en": ""
  },
  {
   "id": "s203:0078e",
   "op": "15",
   "jp": "愛想を尽かして、\n自分から飛び出したのさ！",
   "en": ""
  },
  {
   "id": "s203:0095a",
   "op": "15",
   "jp": "ボクの実家も・・・\nこの近くにあるんだ！",
   "en": ""
  },
  {
   "id": "s203:00996",
   "op": "15",
   "jp": "なんだか久しぶりだな・・・",
   "en": ""
  },
  {
   "id": "s203:009ea",
   "op": "15",
   "jp": "ねえ・・・\nちょっと遠回りになるかも\nしれないけど・・・",
   "en": ""
  },
  {
   "id": "s203:00a36",
   "op": "15",
   "jp": "もしよかったら明日、\nボクの実家のある村に寄って\nみてくれないかなぁ・・・！？",
   "en": ""
  },
  {
   "id": "s203:00aa6",
   "op": "1d",
   "jp": "そうだね！そうしよう！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s203:00ac8",
   "op": "1d",
   "jp": "ごめん先を急ぐから・・・",
   "en": "",
   "max": 15
  },
  {
   "id": "s203:00baa",
   "op": "15",
   "jp": "村まであと少しだが今夜は\nココで野宿するとしようぜ！",
   "en": ""
  },
  {
   "id": "s203:00c72",
   "op": "15",
   "jp": "街まであと少しだが今夜は\nココで野宿するとしようぜ！",
   "en": ""
  }
 ]
}
