{
 "source": "d1:SCENARIO/226",
 "copies": [
  "d1:SCENARIO/226",
  "d2:SCENARIO/226"
 ],
 "strings": [
  {
   "id": "s226:0086e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:0089a",
   "op": "15",
   "jp": "おいレブロブス・・・\n後であの女の背中にはってある・・・",
   "en": "",
   "box": "17x3",
   "face": 107
  },
  {
   "id": "s226:008e6",
   "op": "15",
   "jp": "呪符をはがして・おいて・・\nやってくれ・・・",
   "en": "",
   "box": "17x3",
   "face": 107
  },
  {
   "id": "s226:00926",
   "op": "15",
   "jp": "それから・・俺からもう少し・・\n離れておいたほうが・・いいぞ！",
   "en": "",
   "box": "17x3",
   "face": 107
  },
  {
   "id": "s226:0098e",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:009b2",
   "op": "15",
   "jp": "誰かに操られてるってのは・・・\nつれえ事だょなぁ・・・\nフッ！",
   "en": "",
   "box": "17x3",
   "face": 107
  },
  {
   "id": "s226:01566",
   "op": "15",
   "jp": "俺がまだ１５才の頃・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01592",
   "op": "15",
   "jp": "俺の母親が、ゼファルとかいう男との戦闘中に腹をかっ切って自殺をし・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:015ea",
   "op": "15",
   "jp": "親父もまた、その後を追うように\n自殺まがいの特攻で討ち死にしたと、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:0163e",
   "op": "15",
   "jp": "調教師から聞かされた・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01692",
   "op": "15",
   "jp": "だがその話を聞いても俺は、\n別段何の疑いも抱かなかったんだ・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:016e2",
   "op": "15",
   "jp": "俺の両親もその頃の俺が、\nそうだったように・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:0174a",
   "op": "15",
   "jp": "ただ戦うだけの毎日に、\n疲れちまったんだろうと・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01792",
   "op": "15",
   "jp": "勝手に思いこんじまったのさ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:017e6",
   "op": "15",
   "jp": "だが、それから数年の月日がたち・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01842",
   "op": "15",
   "jp": "俺が自分の飼い主だった領主を殺して同じ様な境遇の連中と旅を続けていた時期に・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:018a6",
   "op": "15",
   "jp": "奴隷ハンターと化した\nゼファルが、奇襲をかけてきたんだ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:018f2",
   "op": "15",
   "jp": "奴は、俺達の中に女が居ることを\nしきりにバカにしていやがった・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01946",
   "op": "15",
   "jp": "そして、奴が呪文を唱えた次の瞬間！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:0197a",
   "op": "15",
   "jp": "俺が妹分として可愛がっていた娘が、突然苦しみだし・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:019c2",
   "op": "15",
   "jp": "俺の目の前で爆死しやがった！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01b1a",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s226:01b32",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s226:01b5e",
   "op": "15",
   "jp": "気が動転して奴に不覚をとった俺は、結果としてあのゴルゴダの牢獄に\n入れられちまった・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01bca",
   "op": "15",
   "jp": "だが後で、冷静になって考えてみて\n初めて俺の両親が・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01c16",
   "op": "15",
   "jp": "同じ手で殺られたんだって気づいたって訳さ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01c66",
   "op": "15",
   "jp": "だとすると・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01c8a",
   "op": "15",
   "jp": "お前の両親も、随分と邪悪な\n人物だったってことになるな・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01d0a",
   "op": "15",
   "jp": "なんだとぉ～っつ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01d3e",
   "op": "15",
   "jp": "だってそうだろ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01dae",
   "op": "15",
   "jp": "今の話を要約すると、お前のお袋は\n呪符に意識を乗っ取られていた\nっていうのに・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01e12",
   "op": "15",
   "jp": "無理矢理自分から自殺したって事に\nなるじゃねえか・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01e5a",
   "op": "15",
   "jp": "それも自分の旦那を・・・\n巻き添えにしないために・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01ea6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s226:01ed2",
   "op": "15",
   "jp": "その親父にしたって、\n妻に死なれて逆上したって事は・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01f1e",
   "op": "15",
   "jp": "お前と同じような、\n人物だったってことさ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:01f82",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:01fea",
   "op": "15",
   "jp": "奴には絶対裏があるとは思って\nいたが・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:02026",
   "op": "15",
   "jp": "まさか奴のあだ名に、あんな意味が\n隠されてたなんて・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:02072",
   "op": "15",
   "jp": "お前には、奴に操られていた間の\n記憶はちゃんと有るのか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:020da",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:02106",
   "op": "15",
   "jp": "本当に・・・・\nすみませんでした！！",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:0213e",
   "op": "15",
   "jp": "こんなに・・・",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:0215e",
   "op": "15",
   "jp": "こんなに何度も助けて\n頂いたのに・・・・",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:0219a",
   "op": "15",
   "jp": "アタシも・・・",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:021ba",
   "op": "15",
   "jp": "アタシも自分で自殺\nするべきだったのに・・・",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:02212",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s226:0222e",
   "op": "15",
   "jp": "体の自由や会話に関しては・・・\n正直全く言うことを聞きません\nでしたが・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s226:0228e",
   "op": "15",
   "jp": "意識だけはハッキリ\nしていたんです・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s226:022fa",
   "op": "15",
   "jp": "ごめんなさい！！",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s226:0234e",
   "op": "15",
   "jp": "ボクの本当の名はクレージュ！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:0237e",
   "op": "15",
   "jp": "あの盗賊団に入る以前の記憶が、\nまだ混乱していてハッキリとは、\n思い出せないんだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:023fa",
   "op": "15",
   "jp": "でも、ボクがこの鎧を着た理由が、\n強い男性に対する憧れから\nだって事だけは・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:0245e",
   "op": "15",
   "jp": "信じて欲しいんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:0247c",
   "op": "08/15",
   "jp": "クレージュ",
   "en": ""
  },
  {
   "id": "s226:024d2",
   "op": "15",
   "jp": "それで、こやつをどうする・・・\nやはり仲間から外すのか！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s226:02552",
   "op": "15",
   "jp": "いや、その判断は\n彼女自身にまかせようや・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:025ba",
   "op": "15",
   "jp": "ゼファルも言っていたが・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:0260e",
   "op": "15",
   "jp": "誰かに自分の生き方を勝手に\n決められたり・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:0264e",
   "op": "15",
   "jp": "操られたりするのは、\n気持ちがいいもんじゃねえ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:02692",
   "op": "15",
   "jp": "たとえ俺達の中だけでしか\n通用しない自由でも・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:026d6",
   "op": "15",
   "jp": "みんな自由でいたいじゃねえか！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:02722",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 20
  },
  {
   "id": "s226:0275a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:03242",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 127
  },
  {
   "id": "s226:03282",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:0329e",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s226:032b6",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:032ce",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:032f2",
   "op": "15",
   "jp": "ボクの本当の名はクレージュ！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:0332e",
   "op": "15",
   "jp": "言わなかったボクも悪いけど、\n気づかなかったキミ達も・・・\n結構失礼だと思うよ・・・！？",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s226:033ca",
   "op": "15",
   "jp": "なんだとこの女ぁ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:033ec",
   "op": "08/15",
   "jp": "クレージュ",
   "en": ""
  },
  {
   "id": "s226:042e2",
   "op": "15",
   "jp": "おい、何だか人数が\n増えてねえか！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:0437a",
   "op": "15",
   "jp": "えーっと。ひい、ふう、みい・・・\nあら、本当だ！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s226:04446",
   "op": "15",
   "jp": "アナタ誰？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s226:046a2",
   "op": "15",
   "jp": "私ミニオン。\nおもしろそうだから\nついて来ちゃった！",
   "en": "",
   "box": "17x3",
   "face": 25
  },
  {
   "id": "s226:046ea",
   "op": "15",
   "jp": "エヘッ！！",
   "en": "",
   "box": "17x3",
   "face": 25
  },
  {
   "id": "s226:04716",
   "op": "15",
   "jp": "えへ、じゃねぇだろう。\nさっさと帰んな！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s226:04762",
   "op": "15",
   "jp": "えーっ、\nついて行っちゃダメですかーぁ？",
   "en": "",
   "box": "17x3",
   "face": 25
  },
  {
   "id": "s226:047aa",
   "op": "1d",
   "jp": "おいでおいで",
   "en": "",
   "max": 15
  },
  {
   "id": "s226:047c0",
   "op": "1d",
   "jp": "あっち行け！",
   "en": "",
   "max": 15
  },
  {
   "id": "s226:047f2",
   "op": "15",
   "jp": "わーい、やったぁ！",
   "en": "",
   "box": "17x3",
   "face": 25
  },
  {
   "id": "s226:04828",
   "op": "14",
   "jp": "ミニオンが仲間になった！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s226:048c6",
   "op": "15",
   "jp": "いいもん、べーぇだ！",
   "en": "",
   "box": "17x3",
   "face": 25
  },
  {
   "id": "s226:048fa",
   "op": "15",
   "jp": "やれやれ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s226:0498a",
   "op": "15",
   "jp": "私は奴隷のライラと申します。",
   "en": "",
   "box": "17x3",
   "face": 111
  },
  {
   "id": "s226:049ba",
   "op": "15",
   "jp": "もしよろしければ・・・\n私を奴隷として\n使って頂けませんか・・・？",
   "en": "",
   "box": "17x3",
   "face": 111
  },
  {
   "id": "s226:04a0e",
   "op": "15",
   "jp": "争い事は苦手ですけれど、\nせめて夜伽を、\nお申し付け下さいませ・・・",
   "en": "",
   "box": "17x3",
   "face": 111
  },
  {
   "id": "s226:04a72",
   "op": "1d",
   "jp": "奴隷じゃなくて仲間としてなら",
   "en": "",
   "max": 15
  },
  {
   "id": "s226:04a98",
   "op": "1d",
   "jp": "ゴメンナサイ！",
   "en": "",
   "max": 15
  },
  {
   "id": "s226:04ad0",
   "op": "14",
   "jp": "ライラが仲間になった！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s226:04b5e",
   "op": "14",
   "jp": "ライラは去っていった！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s226:04bf6",
   "op": "15",
   "jp": "あら、アンゲルス教の人では\nないようですね",
   "en": "",
   "box": "17x3",
   "face": 28
  },
  {
   "id": "s226:04c32",
   "op": "15",
   "jp": "私を助けていただけるの？",
   "en": "",
   "box": "17x3",
   "face": 28
  },
  {
   "id": "s226:04c6a",
   "op": "15",
   "jp": "ありがとうございました。\n私はフィムと申します！",
   "en": "",
   "box": "17x3",
   "face": 28
  },
  {
   "id": "s226:04cba",
   "op": "1d",
   "jp": "連れていく！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s226:04cd0",
   "op": "1d",
   "jp": "連れていかない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s226:04d06",
   "op": "15",
   "jp": "はい！！\n助けていただいたご恩返しを\nしなくてはなりませんものね！",
   "en": "",
   "box": "17x3",
   "face": 28
