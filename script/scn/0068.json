 ],
 "strings": [
  {
   "id": "s68:00282",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s68:0039e",
   "op": "15",
   "jp": "どうやら体の方は・・・\nもう大丈夫のようね！",
   "en": ""
  },
  {
   "id": "s68:003de",
   "op": "15",
   "jp": "頭の方はどうだか分からないけど、\nふふふっ・・・",
   "en": ""
  },
  {
   "id": "s68:00422",
   "op": "14",
   "jp": "・・・・・・・・",
   "en": ""
  },
  {
   "id": "s68:00446",
   "op": "15",
   "jp": "いつかは\n言い出すんじゃないかって\n思ってたんだけど・・・",
   "en": ""
  },
  {
   "id": "s68:00492",
   "op": "15",
   "jp": "どう、アンタはこの家から出て、\n外や街へ行ってみたい・・・？",
   "en": ""
  },
  {
   "id": "s68:004e2",
   "op": "15",
   "jp": "そう・・・",
   "en": ""
  },
  {
   "id": "s68:004fe",
   "op": "15",
   "jp": "でも、少しは\n私の気持ちも・・・・！",
   "en": ""
  },
  {
   "id": "s68:00542",
   "op": "15",
   "jp": "な、なんでもない！",
   "en": ""
  },
  {
   "id": "s68:00566",
   "op": "15",
   "jp": "どうする・・・\nやっぱり出てみる・・・？",
   "en": ""
  },
  {
   "id": "s68:005ae",
   "op": "1d",
   "jp": "外へ出たい！",
   "en": "",
   "max": 15
  },
  {
   "id": "s68:005c4",
   "op": "1d",
   "jp": "外へ出たくない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s68:005fa",
   "op": "15",
   "jp": "そう・・・・\n分かったわ！",
   "en": ""
  },
  {
   "id": "s68:00626",
   "op": "15",
   "jp": "アンタが記憶を早く取り戻す為には、そのほうがいいのかもしれない。",
   "en": ""
  },
  {
   "id": "s68:0067a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s68:006a6",
   "op": "15",
   "jp": "でも外に出るんなら、\nこれだけは覚えておきなさい！！",
   "en": ""
  },
  {
   "id": "s68:006ee",
   "op": "15",
   "jp": "街には色んな人が居るけど、\n羽の色が黒い奴等には気をつける事！",
   "en": ""
  },
  {
   "id": "s68:0073e",
   "op": "15",
   "jp": "わかった・・・？",
   "en": ""
  },
  {
   "id": "s68:00762",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s68:0078e",
   "op": "15",
   "jp": "それから、\nこのネックレスを渡しておくわ、\nかならず身に着けてるのよ！",
   "en": ""
  },
  {
   "id": "s68:00812",
   "op": "15",
   "jp": "そ、そう・・・\nそれならいいわ・・・！",
   "en": ""
  },
  {
   "id": "s68:0084a",
   "op": "15",
   "jp": "いい！\nアンタは私だけに尽くす為の\n奴隷なのよ！",
   "en": ""
  },
  {
   "id": "s68:0088e",
   "op": "15",
   "jp": "私のいう事だけを聞いていれば・・・何も問題はないわ！",
   "en": ""
  },
  {
   "id": "s68:008d6",
   "op": "15",
   "jp": "でも、もしも・・・\n外に出たくなったら・・・",
   "en": ""
  }
 ]
}
