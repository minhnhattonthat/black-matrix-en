 "strings": [
  {
   "id": "s182:00672",
   "op": "14",
   "jp": "こそこそ逃げ回ってねぇで、\nとっとと戦いやがれ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s182:006ba",
   "op": "14",
   "jp": "失礼ね！！\nこういうのを世間では\n頭がいい戦い方って言うのよ！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s182:00922",
   "op": "14",
   "jp": "こいつらはまかせな！っと、\n言いたい所だが、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s182:00962",
   "op": "14",
   "jp": "こいつらなんだか気持ち悪りぃ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s182:009e2",
   "op": "14",
   "jp": "何やってんだ。\nこの筋肉バカは！\n見ちゃいらんねぇな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s182:00b8e",
   "op": "14",
   "jp": "今まで\nよくもダマしてくれたわね！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s182:00bb8",
   "op": "14",
   "jp": "あとで私の復讐日記に、\n書いておかなくっちゃ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s182:00c4a",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s182:00c62",
   "op": "14",
   "jp": "お前の日記って\n復讐日記だったんかい！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s182:00ff6",
   "op": "14",
   "jp": "うるさい人たちね～っ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s182:010aa",
   "op": "14",
   "jp": "きゃっ！こんな所で死ぬモンですか！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s182:01152",
   "op": "14",
   "jp": "このユダ様を裏切るとは、\nみんな死んでしまえっ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s182:01226",
   "op": "14",
   "jp": "ええいっ、\nこのグズ、\nのろま！",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s182:012e6",
   "op": "14",
   "jp": "何やってんのよ！\nお前達それでもアタシの愛人！？",
   "en": "",
   "box": "17x3",
   "face": 13
  },
  {
   "id": "s182:015d6",
   "op": "14",
   "jp": "ひとまず撤退よ！！",
   "en": "",
   "box": "17x3",
   "face": 13
  }
 ]
