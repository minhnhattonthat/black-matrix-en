{
 "source": "d1:SCENARIO/180",
 "copies": [
  "d1:SCENARIO/180",
  "d2:SCENARIO/180"
 ],
 "strings": [
  {
   "id": "s180:00b72",
   "op": "15",
   "jp": "おーっほっほっほっほっ！！",
   "en": ""
  },
  {
   "id": "s180:00bc2",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s180:00be6",
   "op": "15",
   "jp": "よくいらっしゃいました！\n大神官ヨハネ様、",
   "en": ""
  },
  {
   "id": "s180:00c22",
   "op": "15",
   "jp": "おっと今はお尋ね者の、\nただのクソジジイでしたね！",
   "en": ""
  },
  {
   "id": "s180:00c76",
   "op": "15",
   "jp": "愚かな権力の亡者ユダよ、\nせっかくの美女達の食事中、\nお騒がせして申し訳ない！",
   "en": ""
  },
  {
   "id": "s180:00ce6",
   "op": "15",
   "jp": "美女！？",
   "en": ""
  },
  {
   "id": "s180:00d02",
   "op": "15",
   "jp": "びっ、美女ですって？？",
   "en": ""
  },
  {
   "id": "s180:00d2a",
   "op": "15",
   "jp": "相変わらず、\n失礼な男ですねアナタは！",
   "en": ""
  },
  {
   "id": "s180:00d62",
   "op": "15",
   "jp": "この嫉妬深い事で誉れを受ける\nユダ様が、女なんかを\n相手にするはずないでショ！",
   "en": ""
  },
  {
   "id": "s180:00dc2",
   "op": "15",
   "jp": "彼らは・・・\nれっきとした、\n可愛い男性達よ！！",
   "en": ""
  },
  {
   "id": "s180:00e42",
   "op": "15",
   "jp": "うげぇっ！！",
   "en": ""
  },
  {
   "id": "s180:00e92",
   "op": "15",
   "jp": "そんな事より、わざわざ\nアタシが用意してさしあげた、",
   "en": ""
  },
  {
   "id": "s180:00eda",
   "op": "15",
   "jp": "鎧の刺客は\n気に入って貰えましたか！？",
   "en": ""
  },
  {
   "id": "s180:00f36",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s180:00f66",
   "op": "15",
   "jp": "彼女は可哀想な人でねぇ。",
   "en": ""
  },
  {
   "id": "s180:00f92",
   "op": "15",
   "jp": "自分のお師匠さまが捕まった後も\nずっと一人で\n研究を続けてましてね。",
   "en": ""
  },
  {
   "id": "s180:00fea",
   "op": "15",
   "jp": "とうとうその研究の犠牲となって、\n自ら邪道騎士の鎧を着てしまった\nらしいんですよ！",
   "en": ""
  },
  {
   "id": "s180:01052",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s180:0107e",
   "op": "15",
   "jp": "しかもそのせいで彼女は、\n鎧に生命力を奪われて・・・",
   "en": ""
  },
  {
   "id": "s180:010c6",
   "op": "15",
   "jp": "今では余命幾ばくも無いんですって！",
   "en": ""
  },
  {
   "id": "s180:010fe",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s180:01126",
   "op": "15",
   "jp": "ひょっとしてアナタ、\n最初から知ってらしたんじゃ\nありません？",
   "en": ""
  },
  {
   "id": "s180:01176",
   "op": "15",
   "jp": "彼女の着た邪道騎士の鎧や、\nここにある大邪神の鎧が・・・",
   "en": ""
  },
  {
   "id": "s180:011c2",
   "op": "15",
   "jp": "着た者の生き血を奪う、\n呪われた鎧だって事を？！",
   "en": ""
  },
  {
   "id": "s180:01236",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s180:0125e",
   "op": "15",
   "jp": "せっかく彼女が、\nアナタの身を案じて、何度も研究を\n止めようとしたのに、",
   "en": ""
  },
  {
   "id": "s180:012ba",
   "op": "15",
   "jp": "そんな可哀想な彼女の話を、\nアナタは聞こうともしなかった。",
   "en": ""
  },
  {
   "id": "s180:01306",
   "op": "15",
   "jp": "フフッ・・・\nそうじゃありませんか！？",
   "en": ""
  },
  {
   "id": "s180:01342",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s180:0136a",
   "op": "15",
   "jp": "当時はアタシも\nずいぶん彼女の相談に、\n乗ってあげたものです。",
   "en": ""
  },
  {
   "id": "s180:013ca",
   "op": "15",
   "jp": "おやおや、\nお見受けしたところ、\n彼女の姿が見えないようですが、",
   "en": ""
  },
  {
   "id": "s180:0141e",
   "op": "15",
   "jp": "ああっ！！まさかアナタ達・・・\nそんな彼女を、\n殺しちゃったんですかぁ！？",
   "en": ""
  },
  {
   "id": "s180:014ba",
   "op": "15",
   "jp": "よっ・・・\n世迷い言もいい加減にせい！！",
   "en": ""
  },
  {
   "id": "s180:014f6",
   "op": "15",
   "jp": "貴様もかつては、わしの弟子として\n大邪神の鎧を研究していた、\n研究者だったはず・・・",
   "en": ""
  },
  {
   "id": "s180:0155e",
   "op": "15",
   "jp": "ならば・・・その鎧に秘められた\n力の真の意味が・・・",
   "en": ""
  },
  {
   "id": "s180:015a6",
   "op": "15",
   "jp": "お主にならわかるはずじゃ！",
   "en": ""
  },
  {
   "id": "s180:015d6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s180:01602",
   "op": "15",
   "jp": "そしてわしはついに、\nこの鎧の封印を\n解きあかす糸口を得たのだ・・・",
   "en": ""
  },
  {
   "id": "s180:0165a",
   "op": "15",
   "jp": "悪いが・・・大邪神の鎧は",
   "en": ""
  },
  {
   "id": "s180:01686",
   "op": "15",
   "jp": "是が非でも渡してもらうぞ！",
   "en": ""
  },
  {
   "id": "s180:01716",
   "op": "15",
   "jp": "だ・・誰がアナタなんかに！！",
   "en": ""
  },
  {
   "id": "s180:01746",
   "op": "15",
   "jp": "アタシはアナタの側近だった頃から、アナタの事が妬ましくて、\n仕方が無かったんです！",
   "en": ""
  },
  {
   "id": "s180:017aa",
   "op": "15",
   "jp": "人から妬まれる事は、\nそいつの能力が、\n優れているなによりの証し！",
   "en": ""
  },
  {
   "id": "s180:017fe",
   "op": "15",
   "jp": "アナタは・・いつでも、\n人々から妬まれるこの街の支配者で、",
   "en": ""
  },
  {
   "id": "s180:0184a",
   "op": "15",
   "jp": "誰からも羨望の熱いまなざしで\n見つめられていた・・・",
   "en": ""
  },
  {
   "id": "s180:01892",
   "op": "15",
   "jp": "あまつさえ、アナタには・・・\nアナタの為に自分の命さえ\n犠牲にする女までいるなんて・・・",
   "en": ""
  },
  {
   "id": "s180:018fe",
   "op": "15",
   "jp": "私は・・・\nこの街の支配者としての、\n地位が欲しかっただけよ！！",
   "en": ""
  },
  {
   "id": "s180:01952",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s180:0197e",
   "op": "15",
   "jp": "その為にわざわざ\nアナタに近づいて、",
   "en": ""
  },
  {
   "id": "s180:019b6",
   "op": "15",
   "jp": "鎧の研究をネタに、\nアナタを監獄送りにして\nあげましたのに！",
   "en": ""
  },
  {
   "id": "s180:01a06",
   "op": "15",
   "jp": "アナタは今まで、\n気が付かなかったんですか！",
   "en": ""
  },
  {
   "id": "s180:01a46",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s180:01a6e",
   "op": "15",
   "jp": "知っていたとも。",
   "en": ""
  },
  {
   "id": "s180:01a92",
   "op": "15",
   "jp": "ユダよ！・・お前は昔から、\n自分よりも強くて\n人望のある者を・・・",
   "en": ""
  },
  {
   "id": "s180:01ae6",
   "op": "15",
   "jp": "妬まずにはいられない、\n底の浅い男じゃからなぁ！",
   "en": ""
  },
  {
   "id": "s180:01b36",
   "op": "15",
   "jp": "わしには分かっておったのだ・・・",
   "en": ""
  },
  {
   "id": "s180:01b6a",
   "op": "15",
   "jp": "お主のことも・・・ルピルピの\nつらい気持ちも・・・",
   "en": ""
  },
  {
   "id": "s180:01bbe",
   "op": "15",
   "jp": "だからこそ自らの意志で、\nあえていままで、あの牢獄に\n入っておったのじゃ！",
   "en": ""
  },
  {
   "id": "s180:01c1e",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s180:01c36",
   "op": "15",
   "jp": "どちらにしても・・・\nお終いですね！！",
   "en": ""
  },
  {
   "id": "s180:01c6e",
   "op": "15",
   "jp": "いくらアナタ方でも、\nこの人数には・・・",
   "en": ""
  },
  {
   "id": "s180:01cb6",
   "op": "15",
   "jp": "待ちなさいっ！",
   "en": ""
  },
  {
   "id": "s180:01e56",
   "op": "15",
   "jp": "アナタは・・・\nルピルピ！？",
   "en": ""
  },
  {
   "id": "s180:01e86",
   "op": "15",
   "jp": "生きていた上に・・・\nアタシを裏切ったんですか！？",
   "en": ""
  },
  {
   "id": "s180:01eda",
   "op": "15",
   "jp": "黙って聞いてれば、\n勝手なことばっか言ってぇーー！",
   "en": ""
  },
  {
   "id": "s180:01f1e",
   "op": "15",
   "jp": "私がいつ、アンタの仲間に\nなったって言うのよ、\nこのっ、オカマ野郎！！",
   "en": ""
  },
  {
   "id": "s180:01fb6",
   "op": "15",
   "jp": "き～～～っ！！くやしいぃっ！！\nだから本物の女は、\n大嫌いだっていうんです！！",
   "en": ""
  },
  {
   "id": "s180:020ae",
   "op": "15",
   "jp": "それでは、\n可愛い愛人の皆さん、\n殺ってしまってちょうだい！",
   "en": ""
  }
 ]
}
