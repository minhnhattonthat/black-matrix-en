{
 "source": "d1:SCENARIO/207",
 "copies": [
  "d1:SCENARIO/207",
  "d2:SCENARIO/207"
 ],
 "strings": [
  {
   "id": "s207:00886",
   "op": "15",
   "jp": "なぜだ・・・",
   "en": ""
  },
  {
   "id": "s207:008a6",
   "op": "15",
   "jp": "なぜキミ達は、他の白き羽の\n奴隷達だけではなく・・・",
   "en": ""
  },
  {
   "id": "s207:008ee",
   "op": "15",
   "jp": "敵であるボクや盗賊たちにまで、",
   "en": ""
  },
  {
   "id": "s207:0091e",
   "op": "15",
   "jp": "情けをかけたりしたんだ！？",
   "en": ""
  },
  {
   "id": "s207:0094e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:0096a",
   "op": "15",
   "jp": "戦場では、黒き羽も白き羽も\n一切関係ないが・・・",
   "en": ""
  },
  {
   "id": "s207:009ae",
   "op": "15",
   "jp": "さっきの言動から察すると、\nオマエもその羽をもぎ取る\nまでは・・・",
   "en": ""
  },
  {
   "id": "s207:00a02",
   "op": "15",
   "jp": "白き羽の奴隷だったんだろ！？",
   "en": ""
  },
  {
   "id": "s207:00a36",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s207:00a5e",
   "op": "15",
   "jp": "隠したってわかるぜ！",
   "en": ""
  },
  {
   "id": "s207:00a86",
   "op": "15",
   "jp": "邪道騎士の鎧を着てるってのに、\nそんな、へりくだった喋り方を\nしながら・・・",
   "en": ""
  },
  {
   "id": "s207:00ae6",
   "op": "15",
   "jp": "さっきみたいな事をいってりゃあ\nそりゃ、どんなバカでも勘付くさ！！",
   "en": ""
  },
  {
   "id": "s207:00b62",
   "op": "15",
   "jp": "やぁ～いバ～カ、バ～カ！！",
   "en": ""
  },
  {
   "id": "s207:00bc2",
   "op": "15",
   "jp": "って、そういう意味じゃねぇ～！",
   "en": ""
  },
  {
   "id": "s207:00c12",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s207:00c32",
   "op": "15",
   "jp": "平たく言えば、コイツ等は\n邪悪なる極悪人なのよ・・・",
   "en": ""
  },
  {
   "id": "s207:00c86",
   "op": "15",
   "jp": "彼らはみんな、正義や自由や・・・\n愛や平等なんていう、邪教の教えを\n本気で信じているの・・・！",
   "en": ""
  },
  {
   "id": "s207:00cf6",
   "op": "15",
   "jp": "奴隷達は別段自分の意志で私達を\n襲ってきたわけじゃないし・・・",
   "en": ""
  },
  {
   "id": "s207:00d46",
   "op": "15",
   "jp": "あのリーダーはともかく、\n他の盗賊達も、自分の生活に\n追われていただけに感じられた・・・",
   "en": ""
  },
  {
   "id": "s207:00db2",
   "op": "15",
   "jp": "それにさっきのアナタの反応は、",
   "en": ""
  },
  {
   "id": "s207:00de2",
   "op": "15",
   "jp": "私達を殺さずにすまそうなんて\nとんでもない代物だったわ・・・",
   "en": ""
  },
  {
   "id": "s207:00e32",
   "op": "15",
   "jp": "そこら辺の邪悪さが・・・\nアナタ達を助けた原因だったんじゃ\nないかしら・・・",
   "en": ""
  },
  {
   "id": "s207:00eb6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:00ed2",
   "op": "15",
   "jp": "邪道騎士であるキミも・・・",
   "en": ""
  },
  {
   "id": "s207:00f26",
   "op": "15",
   "jp": "その平等とかいう\n感情から、他のメンバーと同じ\nように扱われているのか・・・",
   "en": ""
  },
  {
   "id": "s207:00f86",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s207:00fb2",
   "op": "15",
   "jp": "ならばいっそ・・・\nボクも、キミ達のメンバーに加えて\nもらえないだろうか・・・！？",
   "en": ""
  },
  {
   "id": "s207:01126",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s207:0114a",
   "op": "15",
   "jp": "おい・・・\nどうする・・・！？",
   "en": ""
  },
  {
   "id": "s207:0118a",
   "op": "1d",
   "jp": "仲間にする",
   "en": "",
   "max": 15
  },
  {
   "id": "s207:0119c",
   "op": "1d",
   "jp": "仲間にしない",
   "en": "",
   "max": 15
  },
  {
   "id": "s207:011d2",
   "op": "15",
   "jp": "礼をいうよ・・・！！",
   "en": ""
  },
  {
   "id": "s207:011fa",
   "op": "15",
   "jp": "ボクは生まれてこの方・・・",
   "en": ""
  },
  {
   "id": "s207:01226",
   "op": "15",
   "jp": "自分自身の力が、世間で\nどれだけ通用するのか・・・",
   "en": ""
  },
  {
   "id": "s207:0126a",
   "op": "15",
   "jp": "ただそれだけが知りたくて\n傭兵として今まで\n生きてきたんだ・・・",
   "en": ""
  },
  {
   "id": "s207:012be",
   "op": "15",
   "jp": "少なくとも・・・",
   "en": ""
  },
  {
   "id": "s207:012e2",
   "op": "15",
   "jp": "戦闘の邪魔だけは、\nしないよう努力するよ！",
   "en": ""
  },
  {
   "id": "s207:01322",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:01350",
   "op": "14",
   "jp": "オスカーが仲間になった！",
   "en": ""
  },
  {
   "id": "s207:013ba",
   "op": "15",
   "jp": "そうか・・・",
   "en": ""
  },
  {
   "id": "s207:013da",
   "op": "15",
   "jp": "仕方がないね・・・",
   "en": ""
  },
  {
   "id": "s207:013fe",
   "op": "15",
   "jp": "やはり自分の選ぶべき道は・・・\n自分自身で探しだすしか方法が\n無いということか・・・！",
   "en": ""
  },
  {
   "id": "s207:0146a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:01b6e",
   "op": "15",
   "jp": "おっ、お前・・・\nダロムじゃないか！？",
   "en": ""
  },
  {
   "id": "s207:01ba6",
   "op": "15",
   "jp": "なんで盗賊なんか\nやってんだ・・・！？",
   "en": ""
  },
  {
   "id": "s207:01bee",
   "op": "15",
   "jp": "お、お前は・・レブか・・・！？",
   "en": ""
  },
  {
   "id": "s207:01c1e",
   "op": "15",
   "jp": "あの街は、もうダメだよ！\n新しい領主になって、\nメチャクチャに物価が上がり、",
   "en": ""
  },
  {
   "id": "s207:01c7e",
   "op": "15",
   "jp": "大金が無ければ、\n暮らせなくなってしまったんだ！",
   "en": ""
  },
  {
   "id": "s207:01cce",
   "op": "15",
   "jp": "みんなは、街のみんなは\nどうしているんだろう？",
   "en": ""
  },
  {
   "id": "s207:01d1e",
   "op": "15",
   "jp": "ひでぇ有様さ・・・",
   "en": ""
  },
  {
   "id": "s207:01d42",
   "op": "15",
   "jp": "金のためなら何でもやる奴と\n奪われる奴、\n今の街にはその２種類しかいねぇ",
   "en": ""
  },
  {
   "id": "s207:01d9e",
   "op": "15",
   "jp": "俺の主も生活できなくなって、\n街から追い出されちまった・・・",
   "en": ""
  },
  {
   "id": "s207:01dfa",
   "op": "15",
   "jp": "そんな領主、この俺様が\nまたぶっ殺してやるぜ！！",
   "en": ""
  },
  {
   "id": "s207:01e4e",
   "op": "15",
   "jp": "そ・・・それよりレブ・・・",
   "en": ""
  },
  {
   "id": "s207:01e7a",
   "op": "15",
   "jp": "例の闘技場にヤツが・・・",
   "en": ""
  },
  {
   "id": "s207:01ea6",
   "op": "15",
   "jp": "再びヤツが現れたぞ・・・！！",
   "en": ""
  },
  {
   "id": "s207:01eea",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s207:01f02",
   "op": "15",
   "jp": "生きて・・・",
   "en": ""
  },
  {
   "id": "s207:01f22",
   "op": "15",
   "jp": "いやがったのか・・・",
   "en": ""
  },
  {
   "id": "s207:01f3e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:01f5a",
   "op": "15",
   "jp": "ダロム！！\nお前も一緒に来いよ！",
   "en": ""
  },
  {
   "id": "s207:01f9a",
   "op": "15",
   "jp": "い・・いや、いい。",
   "en": ""
  },
  {
   "id": "s207:01fbe",
   "op": "15",
   "jp": "俺は弱いし、\nお前みたいに自由には\n生きられそうにない。",
   "en": ""
  },
  {
   "id": "s207:0202e",
   "op": "15",
   "jp": "それに・・・いけねぇや・・・",
   "en": ""
  },
  {
   "id": "s207:0205e",
   "op": "15",
   "jp": "もう目が霞んで・・・\nきやがった・・ぜ・・・",
   "en": ""
  },
  {
   "id": "s207:020ce",
   "op": "15",
   "jp": "ダロム！",
   "en": ""
  },
  {
   "id": "s207:020ea",
   "op": "15",
   "jp": "おいダロム・・・",
   "en": ""
  },
  {
   "id": "s207:0210e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:0212e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:02172",
   "op": "15",
   "jp": "俺が？",
   "en": ""
  },
  {
   "id": "s207:021b2",
   "op": "15",
   "jp": "じっ・・自由だって！？",
   "en": ""
  },
  {
   "id": "s207:021f6",
   "op": "15",
   "jp": "どこか別の街で、\nまた新しいご主人様を",
   "en": ""
  },
  {
   "id": "s207:0222e",
   "op": "15",
   "jp": "見つけることにするよ。",
   "en": ""
  },
  {
   "id": "s207:02266",
   "op": "15",
   "jp": "俺が？",
   "en": ""
  },
  {
   "id": "s207:0227e",
   "op": "15",
   "jp": "じっ・・自由だって！？",
   "en": ""
  },
  {
   "id": "s207:02b7a",
   "op": "15",
   "jp": "ありがとうございました。\n騎士様はお強いんですね！",
   "en": ""
  },
  {
   "id": "s207:02bf2",
   "op": "15",
   "jp": "当たり前さ、\nこの俺を誰だと思ってるんだ！",
   "en": ""
  },
  {
   "id": "s207:02c2e",
   "op": "15",
   "jp": "２００人殺しの\n大義賊って言ったら・・・\nちったぁ有名なんだぜ。",
   "en": ""
  },
  {
   "id": "s207:02cb2",
   "op": "15",
   "jp": "それで、お願いがあるんです。",
   "en": ""
  },
  {
   "id": "s207:02d06",
   "op": "15",
   "jp": "アタシ達白い羽の奴隷は、\nご主人様も無く一人で歩いていると、",
   "en": ""
  },
  {
   "id": "s207:02d56",
   "op": "15",
   "jp": "逃亡奴隷として捕まって、\n牢獄に入れられるか競売に\nかけられてしまうんです・・・",
   "en": ""
  },
  {
   "id": "s207:02dba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:02de6",
   "op": "15",
   "jp": "他のみんなは、別の街に行くって\n言うんですけどぉ。",
   "en": ""
  },
  {
   "id": "s207:02e2a",
   "op": "15",
   "jp": "私をあなた様の奴隷にして\n貰えませんか！？",
   "en": ""
  },
  {
   "id": "s207:02e6a",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s207:02f12",
   "op": "15",
   "jp": "お主の身分は、\nすでに\n白き羽でも黒き羽でも無い！",
   "en": ""
  },
  {
   "id": "s207:02f56",
   "op": "15",
   "jp": "世間的には邪道騎士と\n呼ばれる冒険者のようなものだ。",
   "en": ""
  },
  {
   "id": "s207:02f9e",
   "op": "15",
   "jp": "奴隷が欲しいのなら、\n別段、問題は無いと思うぞ！",
   "en": ""
  },
  {
   "id": "s207:02fee",
   "op": "15",
   "jp": "これ以上、女を増やすのは・・・\n俺は反対だぜ！",
   "en": ""
  },
  {
   "id": "s207:0307a",
   "op": "15",
   "jp": "どうせ仲間に入れるなら、\nもっと戦力になる奴がいい！",
   "en": ""
  },
  {
   "id": "s207:0310e",
   "op": "15",
   "jp": "そうだそうだ～！！",
   "en": ""
  },
  {
   "id": "s207:03142",
   "op": "15",
   "jp": "って・・オマエがいうんじゃねぇ～！",
   "en": ""
  },
  {
   "id": "s207:031e6",
   "op": "15",
   "jp": "いったい、どうするんだ？",
   "en": ""
  },
  {
   "id": "s207:0321e",
   "op": "1d",
   "jp": "仲間にする",
   "en": "",
   "max": 15
  },
  {
   "id": "s207:03230",
   "op": "1d",
   "jp": "仲間にしない",
   "en": "",
   "max": 15
  },
  {
   "id": "s207:032da",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:032f6",
   "op": "15",
   "jp": "まったく・・・",
   "en": ""
  },
  {
   "id": "s207:03316",
   "op": "15",
   "jp": "アンタ達がなにを考えているか\nアタシにはさっぱり理解できないわ！",
   "en": ""
  },
  {
   "id": "s207:03376",
   "op": "15",
   "jp": "さすがは邪教徒ね！\n神をも恐れず罪深い優しさを、\n平気で行えるんだから！！",
   "en": ""
  },
  {
   "id": "s207:033d2",
   "op": "15",
   "jp": "とりあえず、日記に\n書いておかなくっちゃ！",
   "en": ""
  },
  {
   "id": "s207:0341e",
   "op": "15",
   "jp": "ありがとうございます。",
   "en": ""
  },
  {
   "id": "s207:03446",
   "op": "15",
   "jp": "私の名はジェル！",
   "en": ""
  },
  {
   "id": "s207:0346a",
   "op": "15",
   "jp": "私は長いこと盗賊をやっていたんで、戦闘には自信があるんですよ！",
   "en": ""
  },
  {
   "id": "s207:034be",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:034ec",
   "op": "14",
   "jp": "ジェルが仲間になった！！",
   "en": ""
  },
  {
   "id": "s207:035be",
   "op": "15",
   "jp": "気にしないで下さい！！",
   "en": ""
  },
  {
   "id": "s207:035e6",
   "op": "15",
   "jp": "突然、無理なお願いをしちゃって\nごめんなさいね。",
   "en": ""
  },
  {
   "id": "s207:0362a",
   "op": "15",
   "jp": "あんまり騎士様が\nカッコ良かったものだから！",
   "en": ""
  },
  {
   "id": "s207:0366a",
   "op": "15",
   "jp": "とりあえずアタシも、\n他のみんなと一緒に街に向かいます。",
   "en": ""
  },
  {
   "id": "s207:039ba",
   "op": "15",
   "jp": "あぁ～あ、\nほとんど殺されてしまいよった。",
   "en": ""
  },
  {
   "id": "s207:039f6",
   "op": "15",
   "jp": "うちに、\n踊らされていたとも知らずに、\nあの盗賊達もあわれなこと。",
   "en": ""
  },
  {
   "id": "s207:03a4a",
   "op": "15",
   "jp": "それにしても、あの鎧・・・",
   "en": ""
  },
  {
   "id": "s207:03a76",
   "op": "15",
   "jp": "まさかとは思ぅてたけど、",
   "en": ""
  },
  {
   "id": "s207:03aa2",
   "op": "15",
   "jp": "たしかに、\n我が教団の脅威になるやも\nしれへんね！！",
   "en": ""
  },
  {
   "id": "s207:04072",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s207:0409a",
   "op": "15",
   "jp": "俺は弱いし・・・、\nお前みたいに自由には、\n生きられそうにない・・・",
   "en": ""
  },
  {
   "id": "s207:04116",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:04132",
   "op": "15",
   "jp": "すまんがみんな・・・",
   "en": ""
  },
  {
   "id": "s207:0415a",
   "op": "15",
   "jp": "ちょっと寄りたい場所が\n出来ちまったんだが・・・",
   "en": ""
  },
  {
   "id": "s207:041aa",
   "op": "15",
   "jp": "ふむ・・・",
   "en": ""
  },
  {
   "id": "s207:041c6",
   "op": "15",
   "jp": "お主、先ほど話しておった、\n闘技場とやらに一人で向かう\nつもりであろう・・・！？",
   "en": ""
  },
  {
   "id": "s207:0422a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s207:04256",
   "op": "15",
   "jp": "風の噂によると・・・",
   "en": ""
  },
  {
   "id": "s207:0427e",
   "op": "15",
   "jp": "あの街に住む住民達は、\n毎週末にその闘技場とやらで\n開かれる・・・",
   "en": ""
  },
  {
   "id": "s207:042d2",
   "op": "15",
