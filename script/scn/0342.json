{
 "source": "d1:SCENARIO/342",
 "copies": [
  "d1:SCENARIO/342",
  "d2:SCENARIO/342"
 ],
 "strings": [
  {
   "id": "s342:005e6",
   "op": "14",
   "jp": "ああ～らっ！いい男ねぇ～ん！！",
   "en": ""
  },
  {
   "id": "s342:0060c",
   "op": "14",
   "jp": "ここは欲情の街・ベギルドよ！\nゆっくりしていってね！",
   "en": ""
  },
  {
   "id": "s342:00682",
   "op": "14",
   "jp": "いらっしゃぁ～～い！\nうちの商品は\nいい物取りそろえてるわよぉ～",
   "en": ""
  },
  {
   "id": "s342:0076e",
   "op": "14",
   "jp": "あ～ら、アナタなんだか、\nとぉ～っても強そうね！！",
   "en": ""
  },
  {
   "id": "s342:007e2",
   "op": "14",
   "jp": "いやぁ～～ん！！",
   "en": ""
  },
  {
   "id": "s342:007fa",
   "op": "14",
   "jp": "この街にアタシを知らない男が\nいるなんてぇ～！",
   "en": ""
  },
  {
   "id": "s342:0086a",
   "op": "14",
   "jp": "ようこそ、ベギルドの街へ。\nこの街はお気に召しまして？",
   "en": ""
  },
  {
   "id": "s342:008a8",
   "op": "14",
   "jp": "ワタシが\nこの街の領主アスタルテです。",
   "en": ""
  },
  {
   "id": "s342:008e2",
   "op": "14",
   "jp": "お主らはお尋ね者のわしらを見て、\nなんとも思わんのか・・・！？",
   "en": ""
  },
  {
   "id": "s342:00936",
   "op": "14",
   "jp": "なにぶん度重なる戦争で\n男の数が減ってしまって・・・、",
   "en": ""
  },
  {
   "id": "s342:00974",
   "op": "14",
   "jp": "この街が気に入られたのなら、\nお住まいになられても\nよろしいですのよ。",
   "en": ""
  },
  {
   "id": "s342:009c2",
   "op": "14",
   "jp": "強い方なら・・・くすっ！\n羽の色など気にしませんもの！",
   "en": ""
  },
  {
   "id": "s342:00a00",
   "op": "14",
   "jp": "なんと言ってもこの街は・・・",
   "en": ""
  },
  {
   "id": "s342:00a24",
   "op": "14",
   "jp": "素晴らしき欲情の街\nなんですから！！",
   "en": ""
  },
  {
   "id": "s342:00a5e",
   "op": "14",
   "jp": "よ・・欲情って、\n強い人となら誰でも良いの！？",
   "en": ""
  },
  {
   "id": "s342:00aba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00af2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00b12",
   "op": "14",
   "jp": "もちろんですとも！\n強い殿方との禁断の欲情\nああーっ、たまりませんわ！！",
   "en": ""
  },
  {
   "id": "s342:00b86",
   "op": "14",
   "jp": "？？？？？？",
   "en": ""
  },
  {
   "id": "s342:00bbe",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00bde",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00bfe",
   "op": "14",
   "jp": "あらこちら・・・\nずいぶんと無口な、お・か・た！",
   "en": ""
  },
  {
   "id": "s342:00c36",
   "op": "14",
   "jp": "口数の多い男に\n強い者はいないとも\n言いますものね・・・",
   "en": ""
  },
  {
   "id": "s342:00c82",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00cba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00cf2",
   "op": "14",
   "jp": "この女、なんかムカツク・・・",
   "en": ""
  },
  {
   "id": "s342:00d22",
   "op": "14",
   "jp": "なんだかやけに\nノリの軽い領主だな・・・！？",
   "en": ""
  },
  {
   "id": "s342:00d62",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:00d74",
   "op": "14",
   "jp": "お主は大邪神の鎧について、\n何か知ってはおらぬか？",
   "en": ""
  },
  {
   "id": "s342:00dba",
   "op": "14",
   "jp": "そうですわねぇ・・・",
   "en": ""
  },
  {
   "id": "s342:00dd6",
   "op": "14",
   "jp": "かつてこの街にも、\nそのような鎧が\nあったと聞いていますが・・・",
   "en": ""
  },
  {
   "id": "s342:00e1e",
   "op": "14",
   "jp": "２～３年ほど前に、\nこの街の神殿内部にある教会から\n盗み出されてしまったそうです・・・",
   "en": ""
  },
  {
   "id": "s342:00e7c",
   "op": "14",
   "jp": "それから先のことは\nワタシは存じませんし・・・",
   "en": ""
  },
  {
   "id": "s342:00eb2",
   "op": "14",
   "jp": "興味すらありませんわ！！",
   "en": ""
  },
  {
   "id": "s342:00f0e",
   "op": "14",
   "jp": "何だよ、俺は何も悪い事なんか",
   "en": ""
  },
  {
   "id": "s342:00f32",
   "op": "14",
   "jp": "してないぞ・・・たぶん。",
   "en": ""
  },
  {
   "id": "s342:00f52",
   "op": "14",
   "jp": "なにせこの街で働いてるのは、\n女性だけなのさ、",
   "en": ""
  },
  {
   "id": "s342:00f88",
   "op": "14",
   "jp": "・・・・ってそうでもないか！？",
   "en": ""
  },
  {
   "id": "s342:00fea",
   "op": "14",
   "jp": "アンタ、\nグザファンって奴を知ってるかい？",
   "en": ""
  },
  {
   "id": "s342:0101c",
   "op": "14",
   "jp": "なんでも奴は金の力で軍隊を作って、マルコとかという子供を\n探し回ってるらしいんだ・・・",
   "en": ""
  },
  {
   "id": "s342:010ce",
   "op": "14",
   "jp": "あら、この街に来て\nウチによらないなんてウソよ！",
   "en": ""
  },
  {
   "id": "s342:01106",
   "op": "14",
   "jp": "ちょっと寄ってく？",
   "en": ""
  },
  {
   "id": "s342:0113a",
   "op": "1d",
   "jp": "寄っていく",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:0114c",
   "op": "1d",
   "jp": "寄っていかない",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:01168",
   "op": "14",
   "jp": "だれが行きますか？",
   "en": ""
  },
  {
   "id": "s342:0119a",
   "op": "1d",
   "jp": "レブロブス",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:011ac",
   "op": "1d",
   "jp": "ガイウス",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:011bc",
   "op": "1d",
   "jp": "ピリポ",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:011cc",
   "op": "1d",
   "jp": "ヨハネ",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:01232",
   "op": "14",
   "jp": "「あっ！」",
   "en": ""
  },
  {
   "id": "s342:01244",
   "op": "14",
   "jp": "「いや！！」",
   "en": ""
  },
  {
   "id": "s342:01258",
   "op": "14",
   "jp": "「そのちょっと・・！」",
   "en": ""
  },
  {
   "id": "s342:01276",
   "op": "14",
   "jp": "「うわあぁあぁ・・・・！！」",
   "en": ""
  },
  {
   "id": "s342:0129a",
   "op": "14",
   "jp": "「なっ・・・」",
   "en": ""
  },
  {
   "id": "s342:012b0",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s342:012ea",
   "op": "14",
   "jp": "いっ、おっ、\nそれが、\n武器屋だった、ような。",
   "en": ""
  },
  {
   "id": "s342:0134e",
   "op": "14",
   "jp": "あ、えっと、いや・・・あの\nぱっ、パン屋だった・ぜ！！\nあの店は。",
   "en": ""
  },
  {
   "id": "s342:013c6",
   "op": "14",
   "jp": "ボクは、\n・・・少し大人になったんだ。",
   "en": ""
  },
  {
   "id": "s342:01422",
   "op": "14",
   "jp": "わしはもう、・・・ほら、\n歳じゃからな！",
   "en": ""
  },
  {
   "id": "s342:0145e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:01496",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:014c2",
   "op": "14",
   "jp": "また・・・ネ",
   "en": ""
  },
  {
   "id": "s342:0150a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:01542",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s342:0157a",
   "op": "14",
   "jp": "ムカツク～～っ！！",
   "en": ""
  },
  {
   "id": "s342:015ba",
   "op": "14",
   "jp": "くだらん・・・",
   "en": ""
  },
  {
   "id": "s342:015f6",
   "op": "14",
   "jp": "？？？？？",
   "en": ""
  },
  {
   "id": "s342:01616",
   "op": "14",
   "jp": "それじゃあ、\nアナタが寄ってってよ！！",
   "en": ""
  },
  {
   "id": "s342:0167e",
   "op": "14",
   "jp": "また来てネ！",
   "en": ""
  },
  {
   "id": "s342:0173a",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:01748",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s342:01758",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  }
 ]
}
