{
 "source": "d1:SCENARIO/320",
 "copies": [
  "d1:SCENARIO/320",
  "d2:SCENARIO/320"
 ],
 "strings": [
  {
   "id": "s320:00b2e",
   "op": "15",
   "jp": "いったい・・・\nさっきのバアルの言葉は\nどういう、意味だったんだろう！？",
   "en": ""
  },
  {
   "id": "s320:00b8a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s320:00bb6",
   "op": "15",
   "jp": "今はとりあえず、\n次の街に行くしかあるまい。",
   "en": ""
  },
  {
   "id": "s320:00bf6",
   "op": "15",
   "jp": "それぞれの街の支配者ならば\n何らかの情報を知っておる\nはずじゃからな！！",
   "en": ""
  },
  {
   "id": "s320:00c5e",
   "op": "15",
   "jp": "ああっ！",
   "en": ""
  },
  {
   "id": "s320:00c7a",
   "op": "15",
   "jp": "それにしてもあの御馳走、\nもったいないったら、\nないぜ！！",
   "en": ""
  },
  {
   "id": "s320:00cca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s320:00d02",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s320:00d3a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s320:00d7e",
   "op": "15",
   "jp": "街の食堂でさえあの旨さだって\n言うのに！",
   "en": ""
  },
  {
   "id": "s320:00dba",
   "op": "15",
   "jp": "いったい材料に\n何を使ってるんだろうな！！",
   "en": ""
  },
  {
   "id": "s320:00dfa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s320:00e16",
   "op": "15",
   "jp": "おい！",
   "en": ""
  },
  {
   "id": "s320:00e2e",
   "op": "15",
   "jp": "お前、\nさっきあの食堂で\n料理を喰ったんだっけ！？",
   "en": ""
  },
  {
   "id": "s320:00e76",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s320:00ebe",
   "op": "15",
   "jp": "いや・・・別に・・・\nそれならいいんだ！",
   "en": ""
  },
  {
   "id": "s320:00f0e",
   "op": "15",
   "jp": "食わなくって正解さ！",
   "en": ""
  },
  {
   "id": "s320:00f36",
   "op": "15",
   "jp": "あの料理の材料は、\n奴が食べ尽くした後の・・・",
   "en": ""
  },
  {
   "id": "s320:00f76",
   "op": "15",
   "jp": "いわば・・・\n食い残しだったんだからな！！",
   "en": ""
  },
  {
   "id": "s320:0101a",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s320:0215e",
   "op": "15",
   "jp": "街の他の連中は、\nどうしちまったんだい！？",
   "en": ""
  },
  {
   "id": "s320:022e2",
   "op": "15",
   "jp": "あなた達がバアル様を倒したんで、\n脅えて逃げ出したか、\n家に閉じこもっちゃったのよ！！",
   "en": ""
  },
  {
   "id": "s320:0234a",
   "op": "15",
   "jp": "もっとも普段と、あんまり\nかわらないんだけどネ！",
   "en": ""
  },
  {
   "id": "s320:0238e",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s320:023ce",
   "op": "15",
   "jp": "バアルに頼り切っていたのね、\nここの人たちは・・・",
   "en": ""
  },
  {
   "id": "s320:02446",
   "op": "15",
   "jp": "私の御主人様も逃げちゃったんだ！",
   "en": ""
  },
  {
   "id": "s320:0247a",
   "op": "15",
   "jp": "で、モノは相談なんだけどぉ、",
   "en": ""
  },
  {
   "id": "s320:024aa",
   "op": "15",
   "jp": "私もあなた達に\n付いて行っちゃダメかなぁ！？",
   "en": ""
  },
  {
   "id": "s320:024f6",
   "op": "1d",
   "jp": "連れていく！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s320:0250c",
   "op": "1d",
   "jp": "連れていかない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s320:02542",
   "op": "15",
   "jp": "わぁーい！ありがとう！\n私パリティ、よろしくね！",
   "en": ""
  },
  {
   "id": "s320:02592",
   "op": "15",
   "jp": "特技はお料理と人の癖を\n見抜くことかなぁ～！？",
   "en": ""
  },
  {
   "id": "s320:025e2",
   "op": "15",
   "jp": "ぜぇったい、\n役に立つからね！！",
   "en": ""
  },
  {
   "id": "s320:02624",
   "op": "14",
   "jp": "パリティが仲間になった！",
   "en": ""
  },
  {
   "id": "s320:0268a",
   "op": "15",
   "jp": "そうだよね！",
   "en": ""
  },
  {
   "id": "s320:026aa",
   "op": "15",
   "jp": "私なんかが付いて行っても、\n足手まといになるだけだモノね！",
   "en": ""
  },
  {
   "id": "s320:026f6",
   "op": "15",
   "jp": "いいの・・・\nここで食堂を続けるわ！",
   "en": ""
  },
  {
   "id": "s320:0272e",
   "op": "15",
   "jp": "近くに来る事があったら、\nまた食べに来てね！！",
   "en": ""
  },
  {
   "id": "s320:02772",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s320:027aa",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s320:027e2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  }
 ]
}
