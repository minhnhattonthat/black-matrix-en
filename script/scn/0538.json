{
 "source": "d1:SCENARIO/538",
 "copies": [
  "d1:SCENARIO/538",
  "d2:SCENARIO/538"
 ],
 "strings": [
  {
   "id": "s538:00032",
   "op": "15",
   "jp": "きっ・・貴様いったい何者じゃっ？！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:00066",
   "op": "15",
   "jp": "お主、教皇の口を使って\n喋っているものの・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:000a6",
   "op": "15",
   "jp": "おそらく彼女自身ではあるまい！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:000ee",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s538:00112",
   "op": "15",
   "jp": "なぜなら、わしが箱船の作り方を\n教えた事は事実じゃが・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:0015e",
   "op": "15",
   "jp": "その事はノアに\n堅く口止めしてある！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:00196",
   "op": "15",
   "jp": "また、家族にも隠れて一人で\n巨大な箱船を作りあげたほど\n信仰心の厚かったノアが・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:001fe",
   "op": "15",
   "jp": "大天使であった\nわしとの誓願を破ってまで、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:0023a",
   "op": "15",
   "jp": "その事を他人に喋ったとも\n思えん以上・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:00276",
   "op": "15",
   "jp": "当時、まだ赤ん坊だった\n彼女自身は・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:002b2",
   "op": "15",
   "jp": "わしが箱船の作り方を\nノアに教えた事など、\nどう考えても・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:00302",
   "op": "15",
   "jp": "知らんはずなのじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:0033a",
   "op": "15",
   "jp": "おおラファエル！？\n突然何を言いだすのです！！？",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s538:0037e",
   "op": "15",
   "jp": "私はアナタもよく知っている・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s538:003b2",
   "op": "15",
   "jp": "ノアの娘ヤペテでは\nあ～りませんか！！",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s538:0042a",
   "op": "15",
   "jp": "き・・貴様の正体は・・・\nいったい・・・・？！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:004aa",
   "op": "15",
   "jp": "くっくっくっくっ、\nおしい・・・\n惜しかったなあ！",
   "en": "",
   "box": "17x3",
   "face": 59
  },
  {
   "id": "s538:00512",
   "op": "15",
   "jp": "きっ・・キサマ、その声は！？\n強欲のマモン！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s538:00562",
   "op": "15",
   "jp": "おまえら、もう少しで、\n自分から死のうとか\n思わなかったか！？",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s538:005d6",
   "op": "15",
   "jp": "そ・・その声は・・・！？\n暴食のバアル！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s538:00622",
   "op": "15",
   "jp": "あの程度の戦いで・・・\n我が怨念が消えたとでも\n思ったか？！",
   "en": "",
   "box": "17x3",
   "face": 62
  },
  {
   "id": "s538:0067e",
   "op": "15",
   "jp": "ケルビム・・・さん！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s538:006b6",
   "op": "15",
   "jp": "当然美しいアタシや・・・\nたいした事の無い\nアスタルテもいるわよ！",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:0071a",
   "op": "15",
   "jp": "・・・って誰が\nなんですって・・・！？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:00762",
   "op": "15",
   "jp": "今までアタシ達をだましていた、\nこのサル女の正体は・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:007ae",
   "op": "15",
   "jp": "どうやらメフィスト様が\n受胎の魔法と\n不死の呪いを使って作りだした・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00806",
   "op": "15",
   "jp": "依り代となる子供を\n産ませる為の・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:0083e",
   "op": "15",
   "jp": "道具だったみたいねぇ？！",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00882",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s538:008a2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:008ce",
   "op": "15",
   "jp": "大天使の鎧でアタシ達の、\n魂の複製は取ってあったものの・・\nあの鎧で転生する為には、",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00936",
   "op": "15",
   "jp": "またどっかで強力な\n意志の力を持った\n依り代を・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:0098a",
   "op": "15",
   "jp": "捜さなきゃいけなかった\nじゃな～い！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:009c2",
   "op": "15",
   "jp": "普段だったら、他の大天使達が\n捜してくれるとこなんだけど、\nみ～んな同時に死んじゃったから、",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00a32",
   "op": "15",
   "jp": "どうしようかと内心、\n冷や冷やしてたのよぉ～",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00a72",
   "op": "15",
   "jp": "ところが、\nこのサル女の胎内に５人も\n依り代が居たなんて・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00ac2",
   "op": "15",
   "jp": "アタシ達もホ～ント\n助かっちゃったわよ～！！",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00b1a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s538:00b3a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s538:00b66",
   "op": "15",
   "jp": "これでアタシも\nもう一度・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00b96",
   "op": "15",
   "jp": "赤ん坊のような肌に\n生まれ変われるのかしら！？",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00be6",
   "op": "15",
   "jp": "やっぱり気にして\nたんじゃない！",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:00c26",
   "op": "15",
   "jp": "うるさいわね！！",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00c4a",
   "op": "15",
   "jp": "このサル女の\n狙いはどうやら・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00c7e",
   "op": "15",
   "jp": "メフィスト様を転生させつつ\nこの世界の崩壊を防ぐ事に\nあったみたいだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00cde",
   "op": "15",
   "jp": "アタシ達の狙いは、\nもはや違うわ！！",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00d22",
   "op": "15",
   "jp": "メフィスト様はすでに亡くなられ\nその鎧の今の持ち主はバカだから\n転生を拒んでいる・・・",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:00d8a",
   "op": "15",
   "jp": "その上、このメフィスト様の\nご遺体から・・・",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:00dca",
   "op": "15",
   "jp": "強大なる魔力が流れ込んでくる\n素晴らしい教皇の体を\n手に入れた今・・・",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:00e22",
   "op": "15",
   "jp": "アタシ達以上の実力を\n持った者がこの世界に\nいると思う・・・！？",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:00e8e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s538:00eba",
   "op": "15",
   "jp": "きっ、貴様ら教皇、いや\nノアの娘ヤペテをどうした！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:00f0e",
   "op": "15",
   "jp": "サル女の魂なら、\nもういないわよ。",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:00f66",
   "op": "15",
   "jp": "何！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s538:00f8e",
   "op": "15",
   "jp": "強大なる魔力を誇る\n教皇といった所で・・・",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s538:00fca",
   "op": "15",
   "jp": "所詮中身はサルにすぎんのだ！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s538:00ffa",
   "op": "15",
   "jp": "意志の力で\n我々大天使達に・・・",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s538:0102e",
   "op": "15",
   "jp": "かなうはずなど無いではないか！！",
   "en": "",
   "box": "17x3",
   "face": 58
  },
  {
   "id": "s538:0106e",
   "op": "15",
   "jp": "きっと今頃どこかで\n隠れんぼでもしてるんじゃない？！",
   "en": "",
   "box": "17x3",
   "face": 60
  },
  {
   "id": "s538:010c2",
   "op": "15",
   "jp": "きっキサマ等ぁ～っ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s538:0112a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s538:0116e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s538:011b2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s538:011f6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s538:0123a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s538:0127e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s538:012ba",
   "op": "15",
   "jp": "とりあえずのアタシ達の\n狙いは、アナタ達への・・・",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:012fe",
   "op": "15",
   "jp": "復讐あるのみ！！",
   "en": "",
   "box": "17x3",
   "face": 57
  },
  {
   "id": "s538:0133e",
   "op": "15",
   "jp": "体が一つしかないから、\n一人づつ・・・\n交替で相手をしてやる！",
   "en": "",
   "box": "17x3",
   "face": 58
  }
 ]
}
