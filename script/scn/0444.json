{
 "source": "d1:SCENARIO/444",
 "copies": [
  "d1:SCENARIO/444",
  "d2:SCENARIO/444"
 ],
 "strings": [
  {
   "id": "s444:00b0e",
   "op": "15",
   "jp": "この穴はいったい？",
   "en": ""
  },
  {
   "id": "s444:00b42",
   "op": "15",
   "jp": "地の底へと通ずる穴じゃ・・・",
   "en": ""
  },
  {
   "id": "s444:00b7e",
   "op": "15",
   "jp": "あーっ、底の方は\n真っ暗で何も見えないよ。",
   "en": ""
  },
  {
   "id": "s444:00bca",
   "op": "15",
   "jp": "いったい、どこまで\n続いているというの？",
   "en": ""
  },
  {
   "id": "s444:00c12",
   "op": "15",
   "jp": "こんな事が出来るなんて、\n教皇って恐ろしい人なんですね！",
   "en": ""
  },
  {
   "id": "s444:00c6a",
   "op": "15",
   "jp": "これは教皇の力ではなく、",
   "en": ""
  },
  {
   "id": "s444:00ce6",
   "op": "15",
   "jp": "あくまでも\n自然が作り出したものじゃ。",
   "en": ""
  },
  {
   "id": "s444:00d1e",
   "op": "15",
   "jp": "わし等は世界の裏側へと\n出ようとしておるのだ。",
   "en": ""
  },
  {
   "id": "s444:00e1e",
   "op": "15",
   "jp": "世界の裏側だと！？",
   "en": ""
  },
  {
   "id": "s444:00e52",
   "op": "15",
   "jp": "そうじゃ。",
   "en": ""
  },
  {
   "id": "s444:00e6e",
   "op": "15",
   "jp": "この夜の闇より暗き地の底に\n我らの進むべき道がある。",
   "en": ""
  },
  {
   "id": "s444:00f1e",
   "op": "15",
   "jp": "（まさか生きて再び、この地へ\n　足を踏み込む事になろうとは）",
   "en": ""
  },
  {
   "id": "s444:00f8a",
   "op": "15",
   "jp": "はっきり言うがここから先は、",
   "en": ""
  },
  {
   "id": "s444:00fba",
   "op": "15",
   "jp": "進むほど険しく、\n苦しくなっていく・・・",
   "en": ""
  },
  {
   "id": "s444:01056",
   "op": "15",
   "jp": "どのみち引き返すことは\n出来ねぇんだ\n行くしかねぇだろ。",
   "en": ""
  },
  {
   "id": "s444:010a2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  }
 ]
}
