 "strings": [
  {
   "id": "s549:00066",
   "op": "15",
   "jp": "へへっ・・・\nやっぱりな！",
   "en": ""
  },
  {
   "id": "s549:00092",
   "op": "15",
   "jp": "あんだけ強さや力にこだわってた、\nこの俺が・・・",
   "en": ""
  },
  {
   "id": "s549:000d6",
   "op": "15",
   "jp": "なんでかな・・・\n負けたってのに、\nちっとも悔しくないぜ！！",
   "en": ""
  },
  {
   "id": "s549:00126",
   "op": "14",
   "jp": "・・・・・・・！！",
   "en": ""
  },
  {
   "id": "s549:00176",
   "op": "15",
   "jp": "キミに出会えたおかげで、",
   "en": ""
  },
  {
   "id": "s549:001a2",
   "op": "15",
   "jp": "本当に・・幸せ、\nだったんだ・・・",
   "en": ""
  },
  {
   "id": "s549:001da",
   "op": "14",
   "jp": "・・・・・！！",
   "en": ""
  },
  {
   "id": "s549:00226",
   "op": "15",
   "jp": "ご一緒出来たのは、\nほんの短い間でしたが",
   "en": ""
  },
  {
   "id": "s549:00262",
   "op": "15",
   "jp": "僕はあなたを・・・\n二人目の親友だと・・",
   "en": ""
  },
  {
   "id": "s549:0029e",
   "op": "15",
   "jp": "思っています！！",
   "en": ""
  },
  {
   "id": "s549:002c2",
   "op": "14",
   "jp": "・・・・・！！",
   "en": ""
  },
  {
   "id": "s549:0030e",
   "op": "15",
   "jp": "ルピルピよ・・・",
   "en": ""
  },
  {
   "id": "s549:00332",
   "op": "15",
   "jp": "わしもやっと使命を果たせたので・・すぐに、そっちにいくぞ！",
   "en": ""
  },
  {
   "id": "s549:00382",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s549:003ca",
   "op": "15",
   "jp": "なぁ、\n俺が結構ルピルピの事・・・",
   "en": ""
  },
  {
   "id": "s549:003fe",
   "op": "15",
   "jp": "気に入って・・たって・・・\n気づい・・てたか・・・！？",
   "en": ""
  },
  {
   "id": "s549:00446",
   "op": "15",
   "jp": "あいつの日記にさ・・",
   "en": ""
  },
  {
   "id": "s549:0046e",
   "op": "15",
   "jp": "こんどは先にめぐり逢えたら・・・\nいいのにね・・・\nとか書いてありやがった。",
   "en": ""
  },
  {
   "id": "s549:004da",
   "op": "15",
   "jp": "ふふっ\n笑っちまうだろ",
   "en": ""
  },
  {
   "id": "s549:00502",
   "op": "15",
   "jp": "おい、\n聞いてるか・・・？",
   "en": ""
  }
 ]
