{
 "source": "d1:SCENARIO/253",
 "copies": [
  "d1:SCENARIO/253",
  "d2:SCENARIO/253"
 ],
 "strings": [
  {
   "id": "s253:0067e",
   "op": "14",
   "jp": "なんだお前らは・・・？\nなにか聞きたいんなら\n金をよこしな。",
   "en": ""
  },
  {
   "id": "s253:006fe",
   "op": "14",
   "jp": "この街では、何をするにも\n山ほどお金が必要で・・・",
   "en": ""
  },
  {
   "id": "s253:00738",
   "op": "14",
   "jp": "もう私達は暮らしていけません。",
   "en": ""
  },
  {
   "id": "s253:0079a",
   "op": "14",
   "jp": "ここはパンデモニウムの街だ！\n教えてやったんだから金をおくれよ。",
   "en": ""
  },
  {
   "id": "s253:0081e",
   "op": "14",
   "jp": "忙しいんだから話しかけるなよ。\nそれとも・・・頼み事か！？",
   "en": ""
  },
  {
   "id": "s253:00860",
   "op": "14",
   "jp": "なら安くしとくぜ！！",
   "en": ""
  },
  {
   "id": "s253:008b6",
   "op": "14",
   "jp": "うちの品物はなんでも高いよぉ！！\nさあ、買った買った！",
   "en": ""
  },
  {
   "id": "s253:008f4",
   "op": "14",
   "jp": "安く買って、高く売るのが\n上手い商売ってモンだ！",
   "en": ""
  },
  {
   "id": "s253:0092c",
   "op": "14",
   "jp": "商売って奴は、太鼓といっしょさ！",
   "en": ""
  },
  {
   "id": "s253:00954",
   "op": "14",
   "jp": "でっかく叩けば、でっかく鳴るし、\n小さく叩けば、しょぼい音しか出や\nしねえ・・・！！",
   "en": ""
  },
  {
   "id": "s253:009b0",
   "op": "14",
   "jp": "多少ヤバイ山だったとしても、\nそこでたじろいでちゃあ、いつまで\nたっても、儲かりはしねえのさ・・・",
   "en": ""
  },
  {
   "id": "s253:00a1a",
   "op": "14",
   "jp": "金さえ払えば、たとえ白い羽にでも\n俺は売ってやるぜ・・・！！",
   "en": ""
  },
  {
   "id": "s253:00a5e",
   "op": "14",
   "jp": "二割、三割り増しは当たり前、\n全品十割、二十割増しの\nお客様感謝セール中だぁ～！！",
   "en": ""
  },
  {
   "id": "s253:00ab8",
   "op": "14",
   "jp": "どうだいアンタ達も・・・\n買っていかねえか！？",
   "en": ""
  },
  {
   "id": "s253:00b36",
   "op": "14",
   "jp": "・・・・・？",
   "en": ""
  },
  {
   "id": "s253:00b4a",
   "op": "14",
   "jp": "うちの品物は安いよ！！",
   "en": ""
  },
  {
   "id": "s253:00b68",
   "op": "14",
   "jp": "売り切れたけどね・・・",
   "en": ""
  },
  {
   "id": "s253:00bc2",
   "op": "14",
   "jp": "なんだなんだお前達は・・・！？\nあっ！",
   "en": ""
  },
  {
   "id": "s253:00bf0",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s253:00c04",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s253:00c18",
   "op": "14",
   "jp": "うちに泊まっていく気なのか？\n宿泊費は・・・",
   "en": ""
  },
  {
   "id": "s253:00c4c",
   "op": "14",
   "jp": "有り金全部だ・・・・！！",
   "en": ""
  },
  {
   "id": "s253:00ca6",
   "op": "14",
   "jp": "この街じゃ金が全てなのさ・・・",
   "en": ""
  },
  {
   "id": "s253:00ccc",
   "op": "14",
   "jp": "どんなに腕っ節が強い奴でも\nお金がなけりゃあこの街では\nやっていけないよ・・・！",
   "en": ""
  },
  {
   "id": "s253:00d24",
   "op": "14",
   "jp": "昔は俺達も、少しは暮らし\nやすかったんだけど・・・",
   "en": ""
  },
  {
   "id": "s253:00d5e",
   "op": "14",
   "jp": "新しい領主になってからは、\nそりゃあひどいもんさ・・・！",
   "en": ""
  },
  {
   "id": "s253:00d9e",
   "op": "14",
   "jp": "この街に住む住民達は、毎週末に\n闘技場で開かれている賭博に",
   "en": ""
  },
  {
   "id": "s253:00de0",
   "op": "14",
   "jp": "必ず参加しなければならず・・・",
   "en": ""
  },
  {
   "id": "s253:00e06",
   "op": "14",
   "jp": "そこで大半の人達は、その週に\n稼いだ金のほとんどをマモン様に\n巻き上げられているのさ・・・",
   "en": ""
  },
  {
   "id": "s253:00e76",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s253:00ec2",
   "op": "14",
   "jp": "あぁ～忙しい・・・",
   "en": ""
  },
  {
   "id": "s253:00f16",
   "op": "14",
   "jp": "街の真ん中に、宮殿みたいな\n豪邸があるだろう・・・！？",
   "en": ""
  },
  {
   "id": "s253:00f54",
   "op": "14",
   "jp": "あれが新領主マモン様の\nお屋敷さ！！",
   "en": ""
  },
  {
   "id": "s253:00f80",
   "op": "14",
   "jp": "マモン様はその金の力で、\n大勢の戦士を雇っているようだ！",
   "en": ""
  },
  {
   "id": "s253:00fc0",
   "op": "14",
   "jp": "お前さん達ならもしかすると\n高給で雇って貰える\nかもしれないぜ！！",
   "en": ""
  },
  {
   "id": "s253:010b2",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s253:010c0",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s253:010d0",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  }
 ]
}
