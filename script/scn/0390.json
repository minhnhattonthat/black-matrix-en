{
 "source": "d1:SCENARIO/390",
 "copies": [
  "d1:SCENARIO/390",
  "d2:SCENARIO/390"
 ],
 "strings": [
  {
   "id": "s390:00bee",
   "op": "15",
   "jp": "ど、どうしましょうか？",
   "en": ""
  },
  {
   "id": "s390:00c7a",
   "op": "15",
   "jp": "決まってんだろう！！",
   "en": ""
  },
  {
   "id": "s390:00ca2",
   "op": "15",
   "jp": "ゴモラの街のやり方を\n変えるんだよなぁ！？",
   "en": ""
  },
  {
   "id": "s390:00d22",
   "op": "15",
   "jp": "そう感情的に物を考えてはいかん！",
   "en": ""
  },
  {
   "id": "s390:00d9e",
   "op": "15",
   "jp": "少なくとも、\nベルフェ殿の考え方も\nあながち間違ってはおらんぞ。",
   "en": ""
  },
  {
   "id": "s390:00e22",
   "op": "15",
   "jp": "それより、俺はソドムのやつらが\nスラム街にいる人間のことを\n隠していたのが気になるが・・・",
   "en": ""
  },
  {
   "id": "s390:00f0a",
   "op": "15",
   "jp": "働けなくなった人達を\n差別しているんだろうか！？",
   "en": ""
  },
  {
   "id": "s390:00f4e",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s390:00f6a",
   "op": "15",
   "jp": "どのようなやり方をしても、",
   "en": ""
  },
  {
   "id": "s390:00f96",
   "op": "15",
   "jp": "全く歪みのない社会を\n作るのは、不可能に近い！！",
   "en": ""
  },
  {
   "id": "s390:01052",
   "op": "15",
   "jp": "じゃあ、いったい\nどうするつもりなんですか？",
   "en": ""
  },
  {
   "id": "s390:010c2",
   "op": "15",
   "jp": "わしはこの問いを、\nお主に託したいと思うておる。",
   "en": ""
  },
  {
   "id": "s390:01106",
   "op": "14",
   "jp": "・・・・・？",
   "en": ""
  },
  {
   "id": "s390:01156",
   "op": "15",
   "jp": "人々に活気があって\n産業も発展しやすく、",
   "en": ""
  },
  {
   "id": "s390:01192",
   "op": "15",
   "jp": "住民の一人一人に\n自由があるかわりに\n貧富の差が生じ、",
   "en": ""
  },
  {
   "id": "s390:011da",
   "op": "15",
   "jp": "ともすると、\n金儲けが全てに優先して\n自然環境を",
   "en": ""
  },
  {
   "id": "s390:0121e",
   "op": "15",
   "jp": "絶滅させかねない\nソドムの街のやり方と！",
   "en": ""
  },
  {
   "id": "s390:0125a",
   "op": "15",
   "jp": "かたや人々の\n自由や言論が抑圧され\nその活力を奪う代わりに・・・",
   "en": ""
  },
  {
   "id": "s390:012ae",
   "op": "15",
   "jp": "ある意味では全員が平等、\n病気や失業・老人になっても\n生活の心配はないが、",
   "en": ""
  },
  {
   "id": "s390:0130a",
   "op": "15",
   "jp": "その長期計画自体の失策が、\n街全体を壊滅に追いやりかねない\nゴモラの街のやり方！！",
   "en": ""
  },
  {
   "id": "s390:0136e",
   "op": "15",
   "jp": "どちらがより\n望ましい未来の姿なのか・・・",
   "en": ""
  },
  {
   "id": "s390:01486",
   "op": "15",
   "jp": "お主はどう思うのじゃ？",
   "en": ""
  },
  {
   "id": "s390:014e2",
   "op": "15",
   "jp": "そうだな、\n俺もお前に聞いてみたいぜ！",
   "en": ""
  },
  {
   "id": "s390:0152a",
   "op": "15",
   "jp": "責任を押しつけるようだけど、\n君に決めてほしいんだ！！",
   "en": ""
  },
  {
   "id": "s390:01582",
   "op": "1d",
   "jp": "ソドムの方がいい",
   "en": "",
   "max": 15
  },
  {
   "id": "s390:0159c",
   "op": "1d",
   "jp": "ゴモラの方がいい",
   "en": "",
   "max": 15
  },
  {
   "id": "s390:015b4",
   "op": "1d",
   "jp": "どちらとも言えない",
   "en": "",
   "max": 15
  },
  {
   "id": "s390:01662",
   "op": "15",
   "jp": "そうだよなぁ！\nどうもベルフェの\nやり方は気にくわねぇ！",
   "en": ""
  },
  {
   "id": "s390:0171a",
   "op": "15",
   "jp": "支配することでしか実現できない\n平等なんて、間違いだぜ！",
   "en": ""
  },
  {
   "id": "s390:017ba",
   "op": "15",
   "jp": "一概にはそうとも言えんのじゃが、\nともかくゴモラの軍隊を\n説得するとしよう。",
   "en": ""
  },
  {
   "id": "s390:01832",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s390:0186a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s390:01916",
   "op": "15",
   "jp": "ボクも働けなくなった人のことまで\n考えてあげている、\nゴモラの街の方が好きだよ！",
   "en": ""
  },
  {
   "id": "s390:01a16",
   "op": "15",
   "jp": "好き嫌いで判断できるほど、\n簡単な問題では無いが、",
   "en": ""
  },
  {
   "id": "s390:01a5a",
   "op": "15",
   "jp": "ともかくソドムの軍を・・\n説得することにしよう。",
   "en": ""
  },
  {
   "id": "s390:01b06",
   "op": "15",
   "jp": "う～む！しかしどちらとも\n言えないと言うのは、",
   "en": ""
  },
  {
   "id": "s390:01b46",
   "op": "15",
   "jp": "どちらにも反対なのか？\nどちらにも賛成なのか？",
   "en": ""
  },
  {
   "id": "s390:01b96",
   "op": "1d",
   "jp": "どちらにも反対！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s390:01bb0",
   "op": "1d",
   "jp": "どちらにも賛成！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s390:01c5e",
   "op": "15",
   "jp": "うむ、\nどちらの街のやり方にも\n問題があるので、",
   "en": ""
  },
  {
   "id": "s390:01ca2",
   "op": "15",
   "jp": "どちらの街も許すことは\n出来んと言う事か！！",
   "en": ""
  },
  {
   "id": "s390:01d72",
   "op": "15",
   "jp": "それも良かろう。",
   "en": ""
  }
 ]
}
