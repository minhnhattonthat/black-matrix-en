{
 "source": "d1:SCENARIO/152",
 "copies": [
  "d1:SCENARIO/152",
  "d2:SCENARIO/152"
 ],
 "strings": [
  {
   "id": "s152:006ce",
   "op": "15",
   "jp": "おい爺さん！\nお前さんの故郷は、",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s152:00702",
   "op": "15",
   "jp": "ずいぶんとまた、\n抹香臭い街じゃねえか！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s152:00782",
   "op": "15",
   "jp": "ここは天空につらなる\n神の鎖と・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:007ba",
   "op": "15",
   "jp": "その根を支える宗教都市、\n聖地リベイラじゃからな！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:0083e",
   "op": "15",
   "jp": "それにしても・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s152:00862",
   "op": "15",
   "jp": "いつ見てもでっけえ鎖だなあ\nこいつは・・・！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s152:008a2",
   "op": "15",
   "jp": "真下から見上げると・・・\nさらにでっかく感じるぜ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s152:0092a",
   "op": "15",
   "jp": "この街は他の国々から集まった、\n信者や神官達が、\n普段から出入りしておるので、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:009b2",
   "op": "15",
   "jp": "わし等の身元を誤魔化すにも\n非常に都合がいいんじゃ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00a06",
   "op": "15",
   "jp": "だが牢獄を脱走した俺達には、\nすでに追っ手が出されているはずだ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s152:00a5a",
   "op": "15",
   "jp": "しかも爺さん、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s152:00a7a",
   "op": "15",
   "jp": "ここがあんたの出身地だってんなら、ここに待ち伏せがいるのは、\n当然だと考えるが・・・！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s152:00b0a",
   "op": "15",
   "jp": "それが正論ね・・・！",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s152:00b32",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00b4e",
   "op": "15",
   "jp": "逃げまわっとる限り、\n状況は一向に変わりはせんよ",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00b92",
   "op": "15",
   "jp": "この世は力が正義！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00bba",
   "op": "15",
   "jp": "ならば奴らには、わしらに対し\nこの追っ手は無駄だ、\nということを知らしめればよい。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00c22",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s152:00c5e",
   "op": "15",
   "jp": "そんなのおにいちゃんにかかれば\n一発ばきーーんだよ！\nいけいけゴーゴー！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s152:00cbe",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s152:00cea",
   "op": "15",
   "jp": "でもそれって、\n具体的にはどうするんだろう？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s152:00d36",
   "op": "15",
   "jp": "ここには古い知人もおる、\nうまくすれば、なにがしかの助力を\n得られるやもしれん。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00d9a",
   "op": "15",
   "jp": "が、まずはそのズタボロの\n身なりを整え、各々必要な情報を\n仕入れることが先決じゃろう！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s152:00e12",
   "op": "15",
   "jp": "おっとその前に・・・わしは、\nすでに面が割れておるので、\n今の内に仮面を付けさせて貰うぞ。",
   "en": "",
   "box": "17x3",
   "face": 5
  }
 ]
}
