 "strings": [
  {
   "id": "s276:0062e",
   "op": "14",
   "jp": "（なぁるほどなぁ・・・\n　神官相手の戦闘データは\n　だいたいこんな感じかいな・・・）",
   "en": ""
  },
  {
   "id": "s276:0068a",
   "op": "14",
   "jp": "（あの大邪神の鎧の力は・・・\n　たしかに、うちとこの神さんとは\n　完全に異質の力・・・）",
   "en": ""
  },
  {
   "id": "s276:006ea",
   "op": "14",
   "jp": "（あの教皇様が恐れられるのも\n　うなずけるワ・・・）",
   "en": ""
  },
  {
   "id": "s276:00726",
   "op": "14",
   "jp": "（・・・・）",
   "en": ""
  },
  {
   "id": "s276:0073a",
   "op": "14",
   "jp": "（直ちに総本山へ報告し・・・",
   "en": ""
  },
  {
   "id": "s276:0075e",
   "op": "14",
   "jp": "　新たなる抹殺部隊の編成を\n　急がなあかんやろなぁ・・・！）",
   "en": ""
  },
  {
   "id": "s276:007a2",
   "op": "14",
   "jp": "（しかしあの鎧の男はん、",
   "en": ""
  },
  {
   "id": "s276:007c2",
   "op": "14",
   "jp": "　なんやあの顔見とったら\n　むしょうにゾクゾクと・・・）",
   "en": ""
  },
  {
   "id": "s276:00802",
   "op": "14",
   "jp": "（ウチだけの手ぇで独占して・・・、　イジメとぅなってくるやんか！）",
   "en": ""
  },
  {
   "id": "s276:0084c",
   "op": "14",
   "jp": "（その上、たしかどっかで\n　出会ったような・・・？）",
   "en": ""
  },
  {
   "id": "s276:008ae",
   "op": "14",
   "jp": "（ハッ！！）",
   "en": ""
  },
  {
   "id": "s276:008c2",
   "op": "14",
   "jp": "あの紫おんな・・・\nあんな所で\n呪いの復讐日記をつけてる・・・！",
   "en": ""
  },
  {
   "id": "s276:0092e",
   "op": "14",
   "jp": "そんなもん、つけるかぁあ！！",
   "en": ""
  },
