  {
   "id": "s111:00156",
   "op": "15",
   "jp": "オレは・・・\nオマエのためなら\nどんな事でも出来る！",
   "en": ""
  },
  {
   "id": "s111:001aa",
   "op": "15",
   "jp": "例え、それが・・・\nどんな罪に問われようとも・・・",
   "en": ""
  }
 ]
