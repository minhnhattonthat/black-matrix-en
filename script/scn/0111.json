  {
   "id": "s111:000ba",
   "op": "15",
   "jp": "オレはいったい・・・\nどうしたらいいかって・・・",
   "en": ""
  },
  {
   "id": "s111:000fe",
   "op": "15",
   "jp": "オマエが側にいてくれれば、\n他には何もいらないのに・・・",
   "en": ""
