{
 "source": "d1:SCENARIO/534",
 "copies": [
  "d1:SCENARIO/534",
  "d2:SCENARIO/534"
 ],
 "strings": [
  {
   "id": "s534:001d2",
   "op": "15",
   "jp": "どうしても貴方達が・・・",
   "en": ""
  },
  {
   "id": "s534:001fe",
   "op": "15",
   "jp": "我々に抗うというのであれば\n致し方ありませんね！",
   "en": ""
  },
  {
   "id": "s534:00256",
   "op": "15",
   "jp": "ですが、この世界全体を\n滅ぼすと言うことは・・・",
   "en": ""
  },
  {
   "id": "s534:0029a",
   "op": "15",
   "jp": "大邪神の鎧を着ていない\n貴方の味方達までをも・・・",
   "en": ""
  },
  {
   "id": "s534:002de",
   "op": "15",
   "jp": "滅ぼすことになるのですよ！？",
   "en": ""
  },
  {
   "id": "s534:0030e",
   "op": "15",
   "jp": "貴方達は・・・",
   "en": ""
  },
  {
   "id": "s534:0032e",
   "op": "15",
   "jp": "それでいいんですか！？",
   "en": ""
  },
  {
   "id": "s534:0035e",
   "op": "15",
   "jp": "ですが、この私を殺して・・・",
   "en": ""
  },
  {
   "id": "s534:0038e",
   "op": "15",
   "jp": "それがいったい\nなんになると言うのです！？",
   "en": ""
  },
  {
   "id": "s534:003ca",
   "op": "15",
   "jp": "この戦いで、たとえ貴方達が\n勝利したところで・・・",
   "en": ""
  },
  {
   "id": "s534:0040e",
   "op": "15",
   "jp": "その後に、どうやって、\n白と黒の羽の者達が平等な社会を\n創ろうと言うのですか！？",
   "en": ""
  },
  {
   "id": "s534:00472",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:004b6",
   "op": "15",
   "jp": "だいいち確かに貴方達は、\nそれでいいのかも知れませんが・・・",
   "en": ""
  },
  {
   "id": "s534:00506",
   "op": "15",
   "jp": "この場で闘えば・・・",
   "en": ""
  },
  {
   "id": "s534:0052e",
   "op": "15",
   "jp": "大邪神の鎧を着ていない\n貴方の他の味方達までをも、",
   "en": ""
  },
  {
   "id": "s534:00572",
   "op": "15",
   "jp": "巻き込む事になるのですよ！？",
   "en": ""
  },
  {
   "id": "s534:005a2",
   "op": "15",
   "jp": "貴方達は、それでいいんですか！？",
   "en": ""
  },
  {
   "id": "s534:005ee",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:00626",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:0065e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:00696",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:006ce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:00706",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:0073e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:00776",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:007ae",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:007e6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:0081e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:00856",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:0088e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:008c6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:00922",
   "op": "15",
   "jp": "こんなこともあろうかと\n思って・・・",
   "en": ""
  },
  {
   "id": "s534:0095a",
   "op": "15",
   "jp": "実は密かに、貴方達の中に\nスパイを紛れ込ませて\nおいたのです・・・",
   "en": ""
  },
  {
   "id": "s534:009ae",
   "op": "15",
   "jp": "私の子供達よ・・・",
   "en": ""
  },
  {
   "id": "s534:009ea",
   "op": "15",
   "jp": "この世界の黒き聖母と\n呼ばれる私にとって・・・",
   "en": ""
  },
  {
   "id": "s534:00a2a",
   "op": "15",
   "jp": "広い意味で言えば、",
   "en": ""
  },
  {
   "id": "s534:00a4e",
   "op": "15",
   "jp": "貴方達は皆、\n私の子供達なのです・・・",
   "en": ""
  },
  {
   "id": "s534:00aea",
   "op": "15",
   "jp": "お兄ちゃん、いくら何でも・・・\n皆殺しはひどすぎるよ！！",
   "en": ""
  },
  {
   "id": "s534:00b36",
   "op": "15",
   "jp": "そうまでして、お兄ちゃんは・・・\nあの人だけを助けたいの！？",
   "en": ""
  },
  {
   "id": "s534:00b96",
   "op": "14",
   "jp": "プリカがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:00c1a",
   "op": "15",
   "jp": "アタシの妹が、\n教皇の娘だって\n話を聞いて・・・",
   "en": ""
  },
  {
   "id": "s534:00c62",
   "op": "15",
   "jp": "アタシの弟が、\n教皇の息子だって\n話を聞いて・・・",
   "en": ""
  },
  {
   "id": "s534:00ca6",
   "op": "15",
   "jp": "アンタだって薄々は・・・\n感づいてたんだろ・・！？",
   "en": ""
  },
  {
   "id": "s534:00cea",
   "op": "15",
   "jp": "たしかにアタシは途中から\nアンタ達に好意を\n抱き始めていた・・・",
   "en": ""
  },
  {
   "id": "s534:00d3e",
   "op": "15",
   "jp": "だからといって・・・・",
   "en": ""
  },
  {
   "id": "s534:00d66",
   "op": "15",
   "jp": "この世界が崩壊するのを\nだまって見過ごす訳には・・・\nいかないのよぉ～っつ！！",
   "en": ""
  },
  {
   "id": "s534:00dd6",
   "op": "14",
   "jp": "プラハがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:00e46",
   "op": "15",
   "jp": "ごめんなさい・・・",
   "en": ""
  },
  {
   "id": "s534:00e6a",
   "op": "15",
   "jp": "私にはこの世界が崩壊するのを\n黙って見逃す事なんて・・・",
   "en": ""
  },
  {
   "id": "s534:00eb6",
   "op": "15",
   "jp": "やっぱりできない・・・・",
   "en": ""
  },
  {
   "id": "s534:00ee2",
   "op": "15",
   "jp": "それに、地上にいる多くの\n人々の人生を・・・",
   "en": ""
  },
  {
   "id": "s534:00f22",
   "op": "15",
   "jp": "全て犠牲にするなんて、\nやっぱりひどすぎるわ！！",
   "en": ""
  },
  {
   "id": "s534:00f76",
   "op": "14",
   "jp": "ドミナがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:00ffa",
   "op": "15",
   "jp": "やっと思い出したよ・・・",
   "en": ""
  },
  {
   "id": "s534:01026",
   "op": "15",
   "jp": "ボクは最初から母様に言われて\nキミ達に近づいていたんだ・・・",
   "en": ""
  },
  {
   "id": "s534:01076",
   "op": "15",
   "jp": "ごめんね、だけどやっぱり・・・",
   "en": ""
  },
  {
   "id": "s534:010a6",
   "op": "15",
   "jp": "この世界の崩壊を見逃す\n事なんて・・・",
   "en": ""
  },
  {
   "id": "s534:010de",
   "op": "15",
   "jp": "ボクには出来ないんだ～っ！！",
   "en": ""
  },
  {
   "id": "s534:0111e",
   "op": "14",
   "jp": "クレージュがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01192",
   "op": "15",
   "jp": "やっぱりだ・・・",
   "en": ""
  },
  {
   "id": "s534:011b6",
   "op": "15",
   "jp": "やっぱりアンタが\n私の幼なじみで・・・",
   "en": ""
  },
  {
   "id": "s534:011ee",
   "op": "15",
   "jp": "しかもずっと憧れの人だった\nおにいちゃんを・・・",
   "en": ""
  },
  {
   "id": "s534:01232",
   "op": "15",
   "jp": "あのカイン君を殺したっていう\n弟だったのねぇ～～っつ！！",
   "en": ""
  },
  {
   "id": "s534:0128e",
   "op": "14",
   "jp": "ミシェットがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01302",
   "op": "15",
   "jp": "流石のオレも・・・\nこの世界全体の崩壊に\n手を貸すわけにはいかんな・・・",
   "en": ""
  },
  {
   "id": "s534:0135e",
   "op": "15",
   "jp": "それに新たなるゴッドとの\n対決にも、正直興味がある・・・・",
   "en": ""
  },
  {
   "id": "s534:013aa",
   "op": "15",
   "jp": "悪いが！死んで貰うぜ！！",
   "en": ""
  },
  {
   "id": "s534:013e6",
   "op": "14",
   "jp": "ゼロがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01452",
   "op": "15",
   "jp": "この世界全体を\n崩壊させるってことは・・・",
   "en": ""
  },
  {
   "id": "s534:0148e",
   "op": "15",
   "jp": "私達にも死ねって、\n言ってるんですよね・・！？",
   "en": ""
  },
  {
   "id": "s534:014d2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:014fe",
   "op": "14",
   "jp": "ジェルがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0156e",
   "op": "15",
   "jp": "ごめんなさい・・ご主人様！",
   "en": ""
  },
  {
   "id": "s534:0159a",
   "op": "15",
   "jp": "やっぱり私には・・・",
   "en": ""
  },
  {
   "id": "s534:015c2",
   "op": "15",
   "jp": "教皇様を裏切ることなど\nできません・・・！！",
   "en": ""
  },
  {
   "id": "s534:01602",
   "op": "15",
   "jp": "申し訳ありませんが・・・",
   "en": ""
  },
  {
   "id": "s534:0162e",
   "op": "15",
   "jp": "やはり私は教皇様とこの世界を\n守らせていただきます！！",
   "en": ""
  },
  {
   "id": "s534:0167a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:016a6",
   "op": "14",
   "jp": "アークエンがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0171a",
   "op": "15",
   "jp": "これまで良くして頂いた、\nご主人様達には・・・・\n申し訳ありませんが・・・",
   "en": ""
  },
  {
   "id": "s534:01776",
   "op": "15",
   "jp": "やはりこの世界に\n生まれついた者として・・・",
   "en": ""
  },
  {
   "id": "s534:017b6",
   "op": "15",
   "jp": "教皇様に弓を弾くことなど、\n出来ないのです！！",
   "en": ""
  },
  {
   "id": "s534:01806",
   "op": "14",
   "jp": "シャムシェルがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0187a",
   "op": "15",
   "jp": "ごめんよ、ご主人様・・・",
   "en": ""
  },
  {
   "id": "s534:018a6",
   "op": "15",
   "jp": "おらは・・・",
   "en": ""
  },
  {
   "id": "s534:018c6",
   "op": "15",
   "jp": "ずっと母ちゃんがわりになって\nおらを育ててくれた教皇様を・・・",
   "en": ""
  },
  {
   "id": "s534:01916",
   "op": "15",
   "jp": "裏切れないんだな！！",
   "en": ""
  },
  {
   "id": "s534:0194e",
   "op": "14",
   "jp": "エルリムがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:019be",
   "op": "15",
   "jp": "わし等に・・・",
   "en": ""
  },
  {
   "id": "s534:019de",
   "op": "15",
   "jp": "死ねと言うとるんじゃな・・・",
   "en": ""
  },
  {
   "id": "s534:01a0e",
   "op": "15",
   "jp": "わしはいい・・・",
   "en": ""
  },
  {
   "id": "s534:01a32",
   "op": "15",
   "jp": "じゃが、わし等のまだ見ぬ\n子孫達のためにも・・・\nわしは教皇様と共に闘わせてもらう！",
   "en": ""
  },
  {
   "id": "s534:01a9a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:01ac6",
   "op": "14",
   "jp": "マステマがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01b36",
   "op": "15",
   "jp": "私は・・・\n私のご主人様を・・・",
   "en": ""
  },
  {
   "id": "s534:01b6a",
   "op": "15",
   "jp": "裏切ることなど出来ません！！",
   "en": ""
  },
  {
   "id": "s534:01b9a",
   "op": "15",
   "jp": "ですので当然！",
   "en": ""
  },
  {
   "id": "s534:01bba",
   "op": "15",
   "jp": "教皇様に御味方させて\nいただきます！！",
   "en": ""
  },
  {
   "id": "s534:01c02",
   "op": "14",
   "jp": "ライラがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01c72",
   "op": "15",
   "jp": "へっへっへっ・・・\nスパイってのは俺のことかな！？",
   "en": ""
  },
  {
   "id": "s534:01cb6",
   "op": "15",
   "jp": "やっぱり・・・\n思った通り金になりそうな\n話になってきやがった・・・",
   "en": ""
  },
  {
   "id": "s534:01d0e",
   "op": "15",
   "jp": "教皇様！後から礼は・・・\nたっぷりいただきますぜ！",
   "en": ""
  },
  {
   "id": "s534:01d62",
   "op": "14",
   "jp": "パウアがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01dd2",
   "op": "15",
   "jp": "あったしい～パリティ！",
   "en": ""
  },
  {
   "id": "s534:01dfa",
   "op": "15",
   "jp": "その正体は教皇様のお庭番にして、\n諜報省・首席補佐官",
   "en": ""
  },
  {
   "id": "s534:01e42",
   "op": "15",
   "jp": "幻影のパリティと申します！！",
   "en": ""
  },
  {
   "id": "s534:01e72",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:01e9e",
   "op": "14",
   "jp": "パリティがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:01f0e",
   "op": "15",
   "jp": "アタシがいくら・・・",
   "en": ""
  },
  {
   "id": "s534:01f36",
   "op": "15",
   "jp": "白き羽解放戦線のメンバー\nの一人だっていっても・・・",
   "en": ""
  },
  {
   "id": "s534:01f7e",
   "op": "15",
   "jp": "断固、この世界の崩壊には\n反対しますぅ・・・！",
   "en": ""
  },
  {
   "id": "s534:01fc2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:01fee",
   "op": "14",
   "jp": "デュナがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0205e",
   "op": "15",
   "jp": "私の上司は・・・！",
   "en": ""
  },
  {
   "id": "s534:02082",
   "op": "15",
   "jp": "あくまでも\nアスタルテ様ただお一人・・・",
   "en": ""
  },
  {
   "id": "s534:020be",
   "op": "15",
   "jp": "したがって私も当然、\n教皇様に御味方させていただきます！",
   "en": ""
  },
  {
   "id": "s534:0211a",
   "op": "14",
   "jp": "タルシスがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0218a",
   "op": "15",
   "jp": "私ミニオン・・・",
   "en": ""
  },
  {
   "id": "s534:021ae",
   "op": "15",
   "jp": "その正体は、教皇様のお庭番にして\n諜報省のナンバー２",
   "en": ""
  },
  {
   "id": "s534:021f6",
   "op": "15",
   "jp": "人呼んで深淵のミニオン！！",
   "en": ""
  },
  {
   "id": "s534:02232",
   "op": "14",
   "jp": "ミニオンがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:022a2",
   "op": "15",
   "jp": "レブロブス様までが、\n本気で私達に・・・",
   "en": ""
  },
  {
   "id": "s534:022de",
   "op": "15",
   "jp": "死ねって\n言うんですか・・・？",
   "en": ""
  },
  {
   "id": "s534:02312",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:0233e",
   "op": "14",
   "jp": "リンがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:023aa",
   "op": "15",
   "jp": "ねぇねぇ騎士様達・・・",
   "en": ""
  },
  {
   "id": "s534:023d2",
   "op": "15",
   "jp": "私の正体は、教皇様のお庭番にして\n諜報省のナンバー３",
   "en": ""
  },
  {
   "id": "s534:0241a",
   "op": "15",
   "jp": "人呼んで謀略のルビィと申します！",
   "en": ""
  },
  {
   "id": "s534:0244e",
   "op": "15",
   "jp": "したがって当然教皇様に、\n御味方させていただきますわ！",
   "en": ""
  },
  {
   "id": "s534:024a6",
   "op": "14",
   "jp": "ルビィがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0251e",
   "op": "15",
   "jp": "プリカには・・・",
   "en": ""
  },
  {
   "id": "s534:02542",
   "op": "15",
   "jp": "いまさらおにいちゃん達と、\n闘う事なんて・・・",
   "en": ""
  },
  {
   "id": "s534:02582",
   "op": "15",
   "jp": "できないよぉ・・・！",
   "en": ""
  },
  {
   "id": "s534:0259e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:025ba",
   "op": "15",
   "jp": "だからプリカは、\nおにいちゃん達と一緒に・・・",
   "en": ""
  },
  {
   "id": "s534:025fa",
   "op": "15",
   "jp": "一緒に闘うよ！！",
   "en": ""
  },
  {
   "id": "s534:02652",
   "op": "15",
   "jp": "アンタが言っていた、\n白と黒の羽が平等な社会って\n言うのは・・・",
   "en": ""
  },
  {
   "id": "s534:026a6",
   "op": "15",
   "jp": "いったいどんな社会を\n意味しているの！？",
   "en": ""
  },
  {
   "id": "s534:026e2",
   "op": "15",
   "jp": "ソドム・・・？",
   "en": ""
  },
  {
   "id": "s534:02702",
   "op": "15",
   "jp": "それともゴモラ？？",
   "en": ""
  },
  {
   "id": "s534:02726",
   "op": "15",
   "jp": "どちらにしても・・・",
   "en": ""
  },
  {
   "id": "s534:0274e",
   "op": "15",
   "jp": "欠陥だらけの社会だったじゃない！？",
   "en": ""
  },
  {
   "id": "s534:02782",
   "op": "15",
   "jp": "アンタ達の理想が\n高いのは分かるけど・・・",
   "en": ""
  },
  {
   "id": "s534:027be",
   "op": "15",
   "jp": "理想ばかりが高くて、\nハッキリしたビジョンを持たない\n指導者に導かれた民衆は・・・",
   "en": ""
  },
  {
   "id": "s534:02822",
   "op": "15",
   "jp": "破滅の道を歩むだけ！",
   "en": ""
  },
  {
   "id": "s534:0284a",
   "op": "15",
   "jp": "悪いけど\nアンタ達には協力できないわ！",
   "en": ""
  },
  {
   "id": "s534:02892",
   "op": "14",
   "jp": "プラハがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:02902",
   "op": "15",
   "jp": "私はアナタが言っていた、\n平等や共存という\n考えには賛成なんです・・・",
   "en": ""
  },
  {
   "id": "s534:0295a",
   "op": "15",
   "jp": "ですが、ごめんなさい・・・",
   "en": ""
  },
  {
   "id": "s534:02986",
   "op": "15",
   "jp": "私にはやっぱり・・・",
   "en": ""
  },
  {
   "id": "s534:029ae",
   "op": "15",
   "jp": "お母様を殺すことに\n手を貸すなんて出来ません！！",
   "en": ""
  },
  {
   "id": "s534:02a02",
   "op": "14",
   "jp": "ドミナがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:02a86",
   "op": "15",
   "jp": "さっきね・・・\n実はあの知恵の実のおかげで・・・",
   "en": ""
  },
  {
   "id": "s534:02aca",
   "op": "15",
   "jp": "ボクの失われていた記憶が\n蘇ったんだ・・・",
   "en": ""
  },
  {
   "id": "s534:02b06",
   "op": "15",
   "jp": "どうやらボクは教皇の娘で・・・",
   "en": ""
  },
  {
   "id": "s534:02b36",
   "op": "15",
   "jp": "キミ達を監視する役割を\n受け持っていたらしい・・・",
   "en": ""
  },
  {
   "id": "s534:02b7e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s534:02baa",
   "op": "15",
   "jp": "だけど・・・",
   "en": ""
  },
  {
   "id": "s534:02bca",
   "op": "15",
   "jp": "キミの言う平等な世界って\n言う話が本当なら・・・",
   "en": ""
  },
  {
   "id": "s534:02c0e",
   "op": "15",
   "jp": "ボクはキミ達と一緒に、\n闘わせてもらうよ！！",
   "en": ""
  },
  {
   "id": "s534:02c82",
   "op": "15",
   "jp": "ねぇキミ・・・",
   "en": ""
  },
  {
   "id": "s534:02ca2",
   "op": "15",
   "jp": "キミが本物のカインくん\nだっていうんなら・・・",
   "en": ""
  },
  {
   "id": "s534:02ce2",
   "op": "15",
   "jp": "お願いだから、\nちゃんとそう言ってよ・・・！？",
   "en": ""
  },
  {
   "id": "s534:02d22",
   "op": "15",
   "jp": "ねぇ！？何か、\n思いだしたんでしょう？",
   "en": ""
  },
  {
   "id": "s534:02d5a",
   "op": "15",
   "jp": "そうじゃないとアタシ・・・",
   "en": ""
  },
  {
   "id": "s534:02d86",
   "op": "15",
   "jp": "アタシ、アンタと\n闘わなきゃいけないのよぉ・・・！？",
   "en": ""
  },
  {
   "id": "s534:02dde",
   "op": "14",
   "jp": "ミシェットがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:02e52",
   "op": "15",
   "jp": "俺は、最初ッから腹を決めてたって\n言っただろ・・・！？",
   "en": ""
  },
  {
   "id": "s534:02e9a",
   "op": "15",
   "jp": "たとえ相手が\n自分の親だったとしても・・・",
   "en": ""
  },
  {
   "id": "s534:02ed6",
   "op": "15",
   "jp": "最強を目指すのが・・・",
   "en": ""
  },
  {
   "id": "s534:02efe",
   "op": "15",
   "jp": "俺のやりかたさ！！",
   "en": ""
  },
  {
   "id": "s534:02f56",
   "op": "15",
   "jp": "私は騎士様達に・・・",
   "en": ""
  },
  {
   "id": "s534:02f7e",
   "op": "15",
   "jp": "今まで何度も\n助けていただきました・・・",
   "en": ""
  },
  {
   "id": "s534:02fba",
   "op": "15",
   "jp": "だからこそ・・・・",
   "en": ""
  },
  {
   "id": "s534:02fde",
   "op": "15",
   "jp": "だからこそ、\nたとえここで死んでも・・・",
   "en": ""
  },
  {
   "id": "s534:0301a",
   "op": "15",
   "jp": "悔いはありません！！",
   "en": ""
  },
  {
   "id": "s534:03076",
   "op": "15",
   "jp": "ごめんなさい教皇様！",
   "en": ""
  },
  {
   "id": "s534:0309e",
   "op": "15",
   "jp": "やっぱり私には・・・",
   "en": ""
  },
  {
   "id": "s534:030c6",
   "op": "15",
   "jp": "ご主人様達を裏切ることなど\nできません・・・！！",
   "en": ""
  },
  {
   "id": "s534:0310a",
   "op": "15",
   "jp": "申し訳ありませんが・・・",
   "en": ""
  },
  {
   "id": "s534:03136",
   "op": "15",
   "jp": "やはり私は、ご主人様達と共に\n闘わせていただきます！！",
   "en": ""
  },
  {
   "id": "s534:031b2",
   "op": "15",
   "jp": "これまで良くして頂いた、\nご主人様達には・・・・\n申し訳ありませんが・・・",
   "en": ""
  },
  {
   "id": "s534:0320e",
   "op": "15",
   "jp": "やはりこの世界に\n生まれついた者として・・・",
   "en": ""
  },
  {
   "id": "s534:0324e",
   "op": "15",
   "jp": "教皇様に弓を弾くことなど、\n出来ないのです！！",
   "en": ""
  },
  {
   "id": "s534:0329e",
   "op": "14",
   "jp": "シャムシェルがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:03316",
   "op": "15",
   "jp": "ごめんよ、ご主人様・・・",
   "en": ""
  },
  {
   "id": "s534:03342",
   "op": "15",
   "jp": "おらは・・・",
   "en": ""
  },
  {
   "id": "s534:03362",
   "op": "15",
   "jp": "ずっと母ちゃんがわりになって\nおらを育ててくれた教皇様を・・・",
   "en": ""
  },
  {
   "id": "s534:033b2",
   "op": "15",
   "jp": "裏切れないんだな！！",
   "en": ""
  },
  {
   "id": "s534:033ea",
   "op": "14",
   "jp": "エルリムがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:0345a",
   "op": "15",
   "jp": "この世界のためにも・・・",
   "en": ""
  },
  {
   "id": "s534:03486",
   "op": "15",
   "jp": "そしてまだ見ぬ子孫達の為にも・・・",
   "en": ""
  },
  {
   "id": "s534:034ba",
   "op": "15",
   "jp": "わしはやはりお主達に\n御味方させていただくとするかな！！",
   "en": ""
  },
  {
   "id": "s534:0353a",
   "op": "15",
   "jp": "私は・・・\n私のご主人様を・・・",
   "en": ""
  },
  {
   "id": "s534:0356e",
   "op": "15",
   "jp": "裏切ることなど出来ません！！",
   "en": ""
  },
  {
   "id": "s534:0359e",
   "op": "15",
   "jp": "ですので当然！",
   "en": ""
  },
  {
   "id": "s534:035be",
   "op": "15",
   "jp": "教皇様に御味方させて\nいただきます！！",
   "en": ""
  },
  {
   "id": "s534:03606",
   "op": "14",
   "jp": "ライラがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:03676",
   "op": "15",
   "jp": "へっへっへっ・・・\nスパイってのは俺のことかな！？",
   "en": ""
  },
  {
   "id": "s534:036ba",
   "op": "15",
   "jp": "やっぱり・・・\n思った通り金になりそうな\n話になってきやがった・・・",
   "en": ""
  },
  {
   "id": "s534:03712",
   "op": "15",
   "jp": "教皇様！後から礼は・・・\nたっぷりいただきますぜ！",
   "en": ""
  },
  {
   "id": "s534:03766",
   "op": "14",
   "jp": "パウアがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:037d6",
   "op": "15",
   "jp": "あったしい～パリティ！",
   "en": ""
  },
  {
   "id": "s534:037fe",
   "op": "15",
   "jp": "その正体は教皇様のお庭番にして、\n諜報省・首席補佐官",
   "en": ""
  },
  {
   "id": "s534:03846",
   "op": "15",
   "jp": "幻影のパリティと申します！！",
   "en": ""
  },
  {
   "id": "s534:03886",
   "op": "14",
   "jp": "パリティがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:038f6",
   "op": "15",
   "jp": "アタシだって～～！",
   "en": ""
  },
  {
   "id": "s534:0391a",
   "op": "15",
   "jp": "白き羽解放戦線のメンバー\nの一人として・・・",
   "en": ""
  },
  {
   "id": "s534:0395a",
   "op": "15",
   "jp": "断固救世主様達に\n御味方しますぅ・・・！",
   "en": ""
  },
  {
   "id": "s534:039ca",
   "op": "15",
   "jp": "私の上司は・・・！",
   "en": ""
  },
  {
   "id": "s534:039ee",
   "op": "15",
   "jp": "あくまでも\nアスタルテ様ただお一人・・・",
   "en": ""
  },
  {
   "id": "s534:03a2a",
   "op": "15",
   "jp": "したがって私も当然、\n教皇様に御味方させていただきます！",
   "en": ""
  },
  {
   "id": "s534:03a86",
   "op": "14",
   "jp": "タルシスがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:03af6",
   "op": "15",
   "jp": "私ミニオン・・・",
   "en": ""
  },
  {
   "id": "s534:03b1a",
   "op": "15",
   "jp": "その正体は、教皇様のお庭番にして\n諜報省のナンバー２",
   "en": ""
  },
  {
   "id": "s534:03b62",
   "op": "15",
   "jp": "人呼んで深淵のミニオン！！",
   "en": ""
  },
  {
   "id": "s534:03b9e",
   "op": "14",
   "jp": "ミニオンがパーティーから抜けた",
   "en": ""
  },
  {
   "id": "s534:03c0e",
   "op": "15",
   "jp": "私は・・・",
   "en": ""
  },
  {
   "id": "s534:03c2a",
   "op": "15",
   "jp": "私のお母さんのお墓を守って貰い",
   "en": ""
  },
  {
   "id": "s534:03c5a",
   "op": "15",
   "jp": "皆さんに危ないところを\n助けていただきました・・・",
   "en": ""
  },
  {
   "id": "s534:03c9e",
   "op": "15",
   "jp": "それに私には・・・",
   "en": ""
  },
  {
   "id": "s534:03cc2",
   "op": "15",
   "jp": "レブロブスさん達の気持ちを\n裏切る事なんて出来ません！！",
   "en": ""
  },
  {
   "id": "s534:03d42",
   "op": "15",
   "jp": "ねぇねぇ騎士様達・・・",
   "en": ""
  },
  {
   "id": "s534:03d6a",
   "op": "15",
   "jp": "私の正体は、教皇様のお庭番にして・・・",
   "en": ""
  },
  {
   "id": "s534:03da2",
   "op": "15",
   "jp": "諜報省のナンバー３\n人呼んで謀略のルビィ！！",
   "en": ""
  },
  {
   "id": "s534:03de2",
   "op": "15",
   "jp": "だったんだけど・・・",
   "en": ""
  },
  {
   "id": "s534:03e0a",
   "op": "15",
   "jp": "やっぱり、アナタ達の理想って奴に\n協力させてもらうわ！！",
   "en": ""
  }
 ]
}
