 ],
 "strings": [
  {
   "id": "s161:00692",
   "op": "14",
   "jp": "たいして強くも無いくせに\n俺様の前に立つんじゃねぇ！",
   "en": ""
  },
  {
   "id": "s161:009f6",
   "op": "14",
   "jp": "げぇっ、\nこいつ案外強いぜ",
   "en": ""
  },
  {
   "id": "s161:00a96",
   "op": "14",
   "jp": "我が血液よ・・・\n猛毒と変わりて・・・、\n我が敵を滅ぼせ！！",
   "en": ""
  },
  {
   "id": "s161:00b32",
   "op": "14",
   "jp": "ポイゾニストの毒魔法か！？",
   "en": ""
  },
  {
   "id": "s161:00bae",
   "op": "14",
   "jp": "何だぁっつ・・・！？\n魔法を使うなんて聞いてないぞ！",
   "en": ""
  },
  {
   "id": "s161:00c42",
   "op": "14",
   "jp": "ふっ、\nちょいとやばい展開だな。",
   "en": ""
  },
  {
   "id": "s161:00cc2",
   "op": "14",
   "jp": "存外やりおるわ、\nならばわしも・・・",
   "en": ""
  },
  {
   "id": "s161:00cee",
   "op": "14",
   "jp": "いにしえのゾンビ魔法を、\n見せてくれるわ！",
   "en": ""
  },
  {
   "id": "s161:0104a",
   "op": "14",
   "jp": "愚かな邪神の手先の悪魔どもめ！！",
   "en": ""
  },
  {
   "id": "s161:01072",
   "op": "14",
   "jp": "この一撃こそが神の御意志だ！",
   "en": ""
  },
  {
   "id": "s161:010e6",
   "op": "14",
   "jp": "なんか力が抜けていくけど、\nこれが毒って物なのかな？",
   "en": ""
  },
  {
   "id": "s161:01162",
   "op": "14",
   "jp": "まだまだ、たぶん大丈夫だよ、\n毒の廻りまで・・・\nボクはノロイのかな！？",
   "en": ""
  }
 ]
}
