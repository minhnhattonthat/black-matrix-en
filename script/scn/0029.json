{
 "source": "d1:SCENARIO/29",
 "copies": [
  "d1:SCENARIO/29",
  "d2:SCENARIO/29"
 ],
 "strings": [
  {
   "id": "s29:00030",
   "op": "14",
   "jp": "○月×日　晴れ",
   "en": ""
  },
  {
   "id": "s29:00046",
   "op": "14",
   "jp": "今日ついに・・・",
   "en": ""
  },
  {
   "id": "s29:0005e",
   "op": "14",
   "jp": "ついにあの人が\n眼を覚ましてくれた！！",
   "en": ""
  },
  {
   "id": "s29:0008c",
   "op": "14",
   "jp": "何度も・・・・",
   "en": ""
  },
  {
   "id": "s29:000a2",
   "op": "14",
   "jp": "何度も、何度も何度も\nくじけそうになったけど・・・！",
   "en": ""
  },
  {
   "id": "s29:000de",
   "op": "14",
   "jp": "きっと自分に神様が、\nご褒美をくれたに違いない・・・！",
   "en": ""
  },
  {
   "id": "s29:0011c",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s29:00130",
   "op": "14",
   "jp": "でもあの人は、ボク達の\n記憶をなにもかも無くしてしまった・・・",
   "en": ""
  },
  {
   "id": "s29:00176",
   "op": "14",
   "jp": "くじけなければ大丈夫・・・・",
   "en": ""
  },
  {
   "id": "s29:0019a",
   "op": "14",
   "jp": "きっとそのうち・・・\nいいことあるよね・・・！？",
   "en": ""
  },
  {
   "id": "s29:001f0",
   "op": "14",
   "jp": "△月○日　雨",
   "en": ""
  },
  {
   "id": "s29:00204",
   "op": "14",
   "jp": "雨が降った日は・・・",
   "en": ""
  },
  {
   "id": "s29:00220",
   "op": "14",
   "jp": "どうしても、あの人が記憶を無くした\n日のことを思い出すから嫌いだ・・・",
   "en": ""
  },
  {
   "id": "s29:0026e",
   "op": "14",
   "jp": "だけど最近は台風の日に二人っきりで\n暖炉で暖めあった日のことも\n思い出すから・・・",
   "en": ""
  },
  {
   "id": "s29:002c8",
   "op": "14",
   "jp": "どっちでもいいような、複雑な気分・・・",
   "en": ""
  },
  {
   "id": "s29:002f6",
   "op": "14",
   "jp": "どうせなら、\nまた台風が上陸すればいいのに・・・・",
   "en": ""
  },
  {
   "id": "s29:00330",
   "op": "14",
   "jp": "って、よく考えたら天気に関係なく、\nもっと、ボクが積極的に\nいけばいいんだよね・・・！",
   "en": ""
  },
  {
   "id": "s29:0038e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s29:003a2",
   "op": "14",
   "jp": "でもボクは・・・",
   "en": ""
  },
  {
   "id": "s29:003ba",
   "op": "14",
   "jp": "ちっとも女の子らしくないしなぁ・・・",
   "en": ""
  },
  {
   "id": "s29:00404",
   "op": "14",
   "jp": "◇月◎日　曇り",
   "en": ""
  },
  {
   "id": "s29:0041a",
   "op": "14",
   "jp": "ボクだってやっぱり女の子・・・",
   "en": ""
  },
  {
   "id": "s29:00440",
   "op": "14",
   "jp": "今年こそ、勇気をだして\nあの人にチョコをあげようと\n決心した・・・！！",
   "en": ""
  },
  {
   "id": "s29:0048e",
   "op": "14",
   "jp": "だけど・・・・",
   "en": ""
  },
  {
   "id": "s29:004a4",
   "op": "14",
   "jp": "魚料理以外はからっきしのボクに\nはたしてチョコなんか\n作れるんだろうか・・・？？",
   "en": ""
  },
  {
   "id": "s29:004fc",
   "op": "14",
   "jp": "世の中の女性陣は、\nこのチョコで、相手を気絶させたり\nしてるらしいけど・・・・",
   "en": ""
  },
  {
   "id": "s29:00552",
   "op": "14",
   "jp": "そんな強引な手を果たして使っても\n良い物なのかなぁ・・・",
   "en": ""
  },
  {
   "id": "s29:00592",
   "op": "14",
   "jp": "でもでも、あの人を気絶させた後、\nボクはどうしたらいいんだろう・・・？！",
   "en": ""
  },
  {
   "id": "s29:005e2",
   "op": "14",
   "jp": "ってバカバカ！なに考えてるんだ\nボクは・・・・！！",
   "en": ""
  },
  {
   "id": "s29:0063c",
   "op": "14",
   "jp": "□月×日　晴れ",
   "en": ""
  },
  {
   "id": "s29:00652",
   "op": "14",
   "jp": "今日はあの人と、\n水浴びなんかしちゃったりして・・・",
   "en": ""
  },
  {
   "id": "s29:0068e",
   "op": "14",
   "jp": "少しはボクにも胸があるんだって、\nアピールしてみたんだけど・・・",
   "en": ""
  },
  {
   "id": "s29:006d6",
   "op": "14",
   "jp": "はたして、あの人はその事に\n気づいてくれたんだろうか・・・？！",
   "en": ""
  },
  {
   "id": "s29:0071c",
   "op": "14",
   "jp": "もしかして・・・・",
   "en": ""
  },
  {
   "id": "s29:00736",
   "op": "14",
   "jp": "実は逆効果だったりなんかして・・・",
   "en": ""
  },
  {
   "id": "s29:00760",
   "op": "14",
   "jp": "（ぞっ）・・・・・",
   "en": ""
  },
  {
   "id": "s29:0077a",
   "op": "14",
   "jp": "ああもう、ボクには向いてないよな、\nこういった悩みは・・・・！！",
   "en": ""
  },
  {
   "id": "s29:007c2",
   "op": "14",
   "jp": "いっそのこと、\n今夜は彼のベッドに・・・",
   "en": ""
  },
  {
   "id": "s29:007f2",
   "op": "14",
   "jp": "ってわーっわーっ！なに考えてんの！",
   "en": ""
  },
  {
   "id": "s29:0083c",
   "op": "14",
   "jp": "○月■日　晴れ",
   "en": ""
  },
  {
   "id": "s29:00852",
   "op": "14",
   "jp": "最近のあの人は、\nすっかり元気になってくれた・・・！",
   "en": ""
  },
  {
   "id": "s29:0088e",
   "op": "14",
   "jp": "だけどもしかすると・・・",
   "en": ""
  },
  {
   "id": "s29:008ae",
   "op": "14",
   "jp": "そろそろこの家の外に\n出たいって言い出すかも知れない・・・！",
   "en": ""
  },
  {
   "id": "s29:008f2",
   "op": "14",
   "jp": "たしかに、外に出てショックを受ければ、記憶が回復する可能性だって\n有るんだけど・・・・",
   "en": ""
  },
  {
   "id": "s29:00950",
   "op": "14",
   "jp": "・・・・ボクはその日が来るのが・・・\n正直怖いんだと思う・・・",
   "en": ""
  }
 ]
}
