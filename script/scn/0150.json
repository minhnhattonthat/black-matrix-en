 "strings": [
  {
   "id": "s150:006f2",
   "op": "15",
   "jp": "ゴルゴダの牢獄からの脱獄に成功し\nお尋ね者となった一行は・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s150:00742",
   "op": "15",
   "jp": "ヨハネに導かれるようにして、リベイラの街にある、太陽の神殿へと向かった。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s150:0080a",
   "op": "15",
   "jp": "ご主人様の行方が解るかもしれない\nという、ヨハネの言葉を信じて。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s150:0085e",
   "op": "15",
   "jp": "しかし、ヨハネには初めから\nある思惑があったのだ。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s150:00912",
   "op": "15",
   "jp": "そう、彼自身の野望とも言える、\n極めて個人的・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s150:00956",
   "op": "15",
   "jp": "遠大な思惑が・・・",
   "en": "",
   "box": "19x2"
