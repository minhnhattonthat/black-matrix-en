 "strings": [
  {
   "id": "s267:006a2",
   "op": "14",
   "jp": "こちらにも大邪神の鎧が\nあるんで驚いたようだな！",
   "en": ""
  },
  {
   "id": "s267:006da",
   "op": "14",
   "jp": "へへっ・・・\n現金の持つ本当の力を・・・",
   "en": ""
  },
  {
   "id": "s267:0070a",
   "op": "14",
   "jp": "お前達にも思い知らせてやるぜ！",
   "en": ""
  },
  {
   "id": "s267:00866",
   "op": "14",
   "jp": "貴様その鎧の影に隠れて、\n惰眠をむさぼるつもりか！？",
   "en": ""
  },
  {
   "id": "s267:008ae",
   "op": "14",
   "jp": "悔しかったら、そいつらを、\n全部倒してから来ることだ・・・",
   "en": ""
  },
  {
   "id": "s267:008f0",
   "op": "14",
   "jp": "「金持ち喧嘩せず」\nってなあ、こう言うときにも\n使う言葉なんだよ！",
   "en": ""
  },
  {
   "id": "s267:00c0a",
   "op": "14",
   "jp": "ようし、そろそろ・・・\nお前達の真の力を見せてやれ！！",
   "en": ""
  },
  {
   "id": "s267:00c48",
   "op": "14",
   "jp": "大邪神の鎧の力が\nたとえ、どれほどの物で\nあったにせよ・・・",
   "en": ""
  },
  {
   "id": "s267:00c8c",
   "op": "14",
   "jp": "大金を払って\n二つも鎧を揃えられる\nこっちの方が・・・",
   "en": ""
  },
  {
   "id": "s267:00cca",
   "op": "14",
   "jp": "さらに強いって事なんだよ！",
   "en": ""
  }
 ]
}
