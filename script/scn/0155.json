{
 "source": "d1:SCENARIO/155",
 "copies": [
  "d1:SCENARIO/155",
  "d2:SCENARIO/155"
 ],
 "strings": [
  {
   "id": "s155:0062a",
   "op": "14",
   "jp": "ここはリベイラの街だ！\nもっとも、他の街の者からは、\n背徳の街と呼ばれとるがな！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:006be",
   "op": "14",
   "jp": "お前達、下せんなる白い羽の分際で\nなんで勝手に街をうろついてんだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00708",
   "op": "14",
   "jp": "あっ、こりゃどうも！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00726",
   "op": "14",
   "jp": "そちらの神官様の奴隷でしたか！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00786",
   "op": "14",
   "jp": "この街には、\n数多くの教会がある。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:007b0",
   "op": "14",
   "jp": "その中でも特に凄いのは、\n太陽の神殿なんだが・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:007ea",
   "op": "14",
   "jp": "そこにいた前の大神官のヨハネ様は、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00814",
   "op": "14",
   "jp": "なにかヘマをやらかして\n監獄に送られたらしいぜ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00886",
   "op": "14",
   "jp": "太陽の神殿の大神官ユダ様は、\nこの街の支配者であらせられる！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:008ca",
   "op": "14",
   "jp": "ユダ様は、えらく嫉妬深いんで、\nすぐ人を殺しちまうんだ・・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00910",
   "op": "14",
   "jp": "たしかに嫉妬深いのは\nいい事なんだろうけど・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00948",
   "op": "14",
   "jp": "誰だって死ぬのはイヤなんで、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:0096c",
   "op": "14",
   "jp": "前の支配者だった、ヨハネ様の方が、今だに人気が高いがね！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:009e6",
   "op": "14",
   "jp": "この街の神殿には、かの有名な\n神々達の戦いで産み出された",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00a26",
   "op": "14",
   "jp": "遺跡が眠っているって\nもっぱらの噂よ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00a54",
   "op": "14",
   "jp": "本当の所は、\n正直、誰にもわからないけど・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00ac6",
   "op": "14",
   "jp": "実はこの街には悪魔達が残した\nとんでもない鎧が、\nあるって評判なんだが・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00b1a",
   "op": "14",
   "jp": "たとえ悪魔の物だろうと、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00b3a",
   "op": "14",
   "jp": "強い力を持つ物は使わないと\n絶対損だと思わないか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00b82",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s155:00ba2",
   "op": "14",
   "jp": "もっともこの考え方は、\n偉大なる前の支配者、\nヨハネ様の受け売りだがね！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00c2e",
   "op": "14",
   "jp": "あんた達、邪道騎士って\n知ってるかい・・・！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00c64",
   "op": "14",
   "jp": "なんでも、白き羽の悪魔達の\n残した鎧を身につける事によって、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00ca8",
   "op": "14",
   "jp": "強大な力を手に入れたって\n話らしいぜ・・・。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:00cea",
   "op": "14",
   "jp": "ボク達の先祖にあたる\n黒き羽の大天使達は・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00d20",
   "op": "14",
   "jp": "この大地の地下に住んでいたと\n言われているんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00d5c",
   "op": "14",
   "jp": "吹き上がるマグマ、血も凍るような\n極寒の地、乾燥しきった砂漠地帯。\nそれらが混在する地下の世界は・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00dca",
   "op": "14",
   "jp": "必然的に弱い生命は駆逐される、\n単純明快な弱肉強食の世界！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00e0e",
   "op": "14",
   "jp": "そこでは人々が、いつでも\n最大限の努力をしなければ、生き\n残れなかったと言われているんだ。",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00e70",
   "op": "14",
   "jp": "強い力や不屈の闘志とかって\n物に憧れている人達は、恵まれた\n楽園だなんて言ってるけど・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00ed2",
   "op": "14",
   "jp": "ボクにとってはそんな場所・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00ef8",
   "op": "14",
   "jp": "地獄以外の何物でも無いんだけどね！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00f2e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s155:00f4e",
   "op": "14",
   "jp": "とにかくそんな楽園で暮らしていた\nボク等のご先祖様達は・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00f92",
   "op": "14",
   "jp": "かの救世主メフィスト・フェレス様のお導きで・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:00fca",
   "op": "14",
   "jp": "大邪神や悪魔達がばっこしていた\nこの地上へと侵攻して、\n大邪神軍団を滅ぼし・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:01022",
   "op": "14",
   "jp": "この大陸の地下深くに・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:01044",
   "op": "14",
   "jp": "あの神の鎖で封じ込めてたんだって\n教えられているんだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s155:010ae",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s155:010e2",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s155:01144",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:0117c",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:01194",
   "op": "14",
   "jp": "なんでぃ！\n白い羽の分際で何のようだ？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:011c2",
   "op": "14",
   "jp": "お使いか！\nなにが欲しいんだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:01208",
   "op": "14",
   "jp": "うちの商品は、どれも値段に見合った極上モンばっかりだぜ！。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:01250",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:012ae",
   "op": "14",
   "jp": "おわらんぞ～",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:012c2",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:012d8",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s155:0139e",
   "op": "15",
   "jp": "準備が良ければ、\n太陽の神殿に向かうとするか？",
   "en": "",
   "box": "17x3",
   "face": 30
  },
  {
   "id": "s155:013ee",
   "op": "1d",
   "jp": "太陽の神殿に行く！",
   "en": "",
   "max": 15
  },
  {
   "id": "s155:01408",
   "op": "1d",
   "jp": "まだ準備ができていない！",
   "en": "",
   "max": 15
  }
 ]
}
