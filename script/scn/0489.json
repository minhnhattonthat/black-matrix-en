{
 "source": "d1:SCENARIO/489",
 "copies": [
  "d1:SCENARIO/489",
  "d2:SCENARIO/489"
 ],
 "strings": [
  {
   "id": "s489:003ba",
   "op": "15",
   "jp": "とうとう、\nここまで来てしもうたんやね。",
   "en": ""
  },
  {
   "id": "s489:003f6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s489:00422",
   "op": "15",
   "jp": "どないしてん！？",
   "en": ""
  },
  {
   "id": "s489:00446",
   "op": "15",
   "jp": "うちが相手では、\n本気になられへんいうの！？",
   "en": ""
  },
  {
   "id": "s489:00486",
   "op": "15",
   "jp": "（違う！？本気で戦ってへんのは\n　ウチの方やわ！！）",
   "en": ""
  },
  {
   "id": "s489:004ce",
   "op": "15",
   "jp": "何とか言いなはれ、\nお前は一体何者なん？",
   "en": ""
  },
  {
   "id": "s489:0050a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s489:00536",
   "op": "15",
   "jp": "メタトロンの鎧を着ても\n鎧に喰い殺されない！",
   "en": ""
  },
  {
   "id": "s489:00576",
   "op": "15",
   "jp": "やっぱり・・あなたは・・",
   "en": ""
  },
  {
   "id": "s489:005ae",
   "op": "15",
   "jp": "ルカよ、さがりなさい。",
   "en": ""
  },
  {
   "id": "s489:0067e",
   "op": "15",
   "jp": "せっ、せやけど！！",
   "en": ""
  },
  {
   "id": "s489:006b2",
   "op": "15",
   "jp": "貴方の役目はもう終わりました、\nもう良いのです。",
   "en": ""
  },
  {
   "id": "s489:00702",
   "op": "15",
   "jp": "うっ！",
   "en": ""
  },
  {
   "id": "s489:0072a",
   "op": "15",
   "jp": "ここまで来れるとはさすがは、\n大したものですね・・・\nそれ故にまた哀れでもある。",
   "en": ""
  },
  {
   "id": "s489:0078e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s489:007ba",
   "op": "15",
   "jp": "あなたは、私達の子供に\n会いたいのでしょう！？",
   "en": ""
  },
  {
   "id": "s489:007fe",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s489:00822",
   "op": "15",
   "jp": "それならば、\nこの祭壇の上にいます。",
   "en": ""
  },
  {
   "id": "s489:0085a",
   "op": "15",
   "jp": "さあ、今こそ、\n勇気を持って、\n真実の扉を開けるのです！！",
   "en": ""
  },
  {
   "id": "s489:01796",
   "op": "14",
   "jp": "！！",
   "en": ""
  }
 ]
}
