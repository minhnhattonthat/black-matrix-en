 "strings": [
  {
   "id": "s501:00042",
   "op": "15",
   "jp": "さすがは救世主と\n呼ばれるだけの事はありますね・・・",
   "en": ""
  },
  {
   "id": "s501:0008a",
   "op": "15",
   "jp": "アナタからは、確かにその名を\n名乗るに相応しい・・・",
   "en": ""
  },
  {
   "id": "s501:000d2",
   "op": "15",
   "jp": "意志の力が、感じられます！",
   "en": ""
  },
  {
   "id": "s501:0010e",
   "op": "15",
   "jp": "そして、たしかにこの子こそ、\n愛を称える大邪神・・・",
   "en": ""
  },
  {
   "id": "s501:00156",
   "op": "15",
   "jp": "ガブリエルの鎧を着るに、\nふさわしい人物なのかもしれません！",
   "en": ""
  },
  {
   "id": "s501:001ba",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s501:001de",
   "op": "15",
   "jp": "私達の子供であるこの子が・・・",
   "en": ""
  },
  {
   "id": "s501:0020e",
   "op": "15",
   "jp": "事もあろうに奴隷である\nアナタを愛したという話は、\n聞いています・・・",
   "en": ""
  },
  {
   "id": "s501:0026a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s501:00296",
   "op": "15",
   "jp": "たとえそれが、どんな大罪に\n問われる事になったとしても・・・",
   "en": ""
  },
  {
   "id": "s501:002e6",
   "op": "15",
   "jp": "いつの間にか虐げられている者達に、限りない愛情を注いでしまう・・・",
   "en": ""
  },
  {
   "id": "s501:0033a",
   "op": "15",
   "jp": "長く離れて暮らしていたとはいえ、",
   "en": ""
  },
  {
   "id": "s501:0036e",
   "op": "15",
   "jp": "やはりあの人の血は\n争えないのかもしれませんね・・・",
   "en": ""
  },
  {
   "id": "s501:003ce",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s501:00406",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s501:0043e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s501:00476",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s501:004ae",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s501:004e6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s501:0052a",
   "op": "15",
   "jp": "ですが、もし彼女を生き返らせる為にこの大邪神の鎧を着させれば・・・",
   "en": ""
  },
  {
   "id": "s501:00596",
   "op": "15",
   "jp": "ですが、もし彼を生き返らせる為に\nこの大邪神の鎧を着させれば・・・",
   "en": ""
  },
  {
   "id": "s501:005ea",
   "op": "15",
   "jp": "この世界は間違いなく\n崩壊への道をたどるのですよ！？",
   "en": ""
  }
 ]
