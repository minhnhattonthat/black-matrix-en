 "strings": [
  {
   "id": "s8:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": "",
   "box": "19x3"
  },
  {
   "id": "s8:0060e",
   "op": "15",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00632",
   "op": "15",
   "jp": "良かった～！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:0065e",
   "op": "15",
   "jp": "もう・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:0067a",
   "op": "15",
   "jp": "目を覚まさないんじゃないかと、\n思ってた！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:006b6",
   "op": "15",
   "jp": "だって、だって・・・\nもう十ヶ月以上も高熱を出して\n寝込んでいたのよ？！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00712",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s8:0073a",
   "op": "15",
   "jp": "えっ・・・どうしたの！\nまだどこか痛むの！？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:0077a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s8:007a6",
   "op": "15",
   "jp": "まさか・・・\n私の事を忘れちゃったの？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:007de",
   "op": "15",
   "jp": "えっ！？\nまさか、自分のことも？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:0081e",
   "op": "15",
   "jp": "ねぇ、アナタの名前は・・・？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:008ca",
   "op": "15",
   "jp": "そう！\nそうよ！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:008fa",
   "op": "15",
   "jp": "じゃあ、私の名前は？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:0099e",
   "op": "15",
   "jp": "その通り！！\n良かった、良かった・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:009da",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s8:00a06",
   "op": "15",
   "jp": "ココは、アナタと私の家、\n他には誰もいないわ。",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00a46",
   "op": "15",
   "jp": "アナタは事故で大ケガをしたのよ！\n雨の日に雷が落ちて・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00a92",
   "op": "15",
   "jp": "傷の手当はしたんだけど、\nずっと眠ったままなんだもん、\n心配したのよ！",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00aee",
   "op": "14",
   "jp": "・・・！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s8:00c02",
   "op": "15",
   "jp": "背中の羽？",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00c2e",
   "op": "15",
   "jp": "本当に全部忘れちゃったのね・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00c6e",
   "op": "15",
   "jp": "誰にでも生えてる物なのよ・・・\nアナタにも・・・私にも・・・",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00cbe",
   "op": "15",
   "jp": "順番に思い出していこうね、\nこの世界のこと・・・\nそして、私達の・・こと。",
   "en": "",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s8:00d72",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "",
   "max": 15
  },
  {
   "id": "s8:00d88",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "",
   "max": 15
  }
 ]
