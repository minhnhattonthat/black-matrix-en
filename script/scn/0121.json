   "box": "19x2"
  },
  {
   "id": "s121:008da",
   "op": "15",
   "jp": "ゴルゴダと呼ばれる\n薄暗き牢獄へと連行される",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:0091a",
   "op": "15",
