  {
   "id": "s121:006ee",
   "op": "15",
   "jp": "この世界における犯罪の中でも、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:0071e",
   "op": "15",
   "jp": "最も罪が重いとされる\n七つの大罪の一つ、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:0076e",
   "op": "15",
   "jp": "愛を口にしてしまった少女は、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:007a2",
   "op": "15",
   "jp": "愛を口にしてしまったご主人様は、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:007d6",
   "op": "15",
   "jp": "異端審問官達の手によって、\n何処かへと連れさられてしまった。",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:00826",
   "op": "15",
   "jp": "記憶を失い、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:00846",
   "op": "15",
   "jp": "この世界の全てとも言える\n主をも失い、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:0087e",
   "op": "15",
   "jp": "絶望の淵にたたされたあなたは、",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s121:008ae",
   "op": "15",
   "jp": "反抗奴隷のらく印を押され、",
