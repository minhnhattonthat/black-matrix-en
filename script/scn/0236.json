{
 "source": "d1:SCENARIO/236",
 "copies": [
  "d1:SCENARIO/236",
  "d2:SCENARIO/236"
 ],
 "strings": [
  {
   "id": "s236:009d6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:009f6",
   "op": "15",
   "jp": "もしかして弟は・・・",
   "en": "Could it be that my little brother...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:00a1e",
   "op": "15",
   "jp": "もうココには住んでいないん\nだろうか・・・？！",
   "en": "...doesn't live here anymore...!?",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:00a6e",
   "op": "15",
   "jp": "そいつがオマエと同い年位だって\nいうんなら十分にあり得る話だな！",
   "en": "If he's about your age, that's entirely possible.",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s236:00ac2",
   "op": "15",
   "jp": "俺がこの村の住人なら、\nとっくに引っ越してる所だ・・・",
   "en": "If I lived in this village, I'd have moved out long ago...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s236:00b0a",
   "op": "15",
   "jp": "それに・・・",
   "en": "And besides...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s236:00b2a",
   "op": "15",
   "jp": "すでにさっきのジイさん達に、\nやられちまってるって可能性だって\n十分にあり得る・・・",
   "en": "...it's just as possible those old men back there already got to him...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s236:00baa",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 112
  },
  {
   "id": "s236:00bca",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:00c12",
   "op": "1d",
   "jp": "はい",
   "en": "Yes",
   "max": 15
  },
  {
   "id": "s236:00c20",
   "op": "1d",
   "jp": "いいえ",
   "en": "No",
   "max": 15
  },
  {
   "id": "s236:00c30",
   "op": "20",
   "jp": "ドアをノックしますか？",
   "en": "Knock on the door?"
  },
  {
   "id": "s236:00dba",
   "op": "15",
   "jp": "なによ眠いのに\nこんな真っ昼間っから・・・",
   "en": "Ugh, what is it? I'm sleepy, and it's the middle of the day...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:00df6",
   "op": "15",
   "jp": "アンタ達だれ？！",
   "en": "And who are you people!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:00e26",
   "op": "15",
   "jp": "あのぉ・・・・",
   "en": "Um....",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:00e46",
   "op": "15",
   "jp": "ココに住んでいたパルタって\n男の子は・・・！？",
   "en": "The boy named Parta who lived here...!?",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:00e96",
   "op": "15",
   "jp": "そんな奴しらないわよ！\n・・・って",
   "en": "Never heard of him! ...Wait.",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:00efe",
   "op": "15",
   "jp": "ああぁぁあぁああぁあああぁあぁ！",
   "en": "Aaaaaaaaaaaaaaaaaaaaaaaah!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:00f3e",
   "op": "15",
   "jp": "カイン君！？\nアナタ、カイン君じゃない！！",
   "en": "Cain-kun!? It's you, isn't it, Cain-kun!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:00f7e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s236:00faa",
   "op": "15",
   "jp": "ああぁぁあぁああぁああぁ！\nカイン君ったらもう～！！",
   "en": "Aaaaaaaaaaaaaaah! Oh, Cain-kun, honestly!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:00ff2",
   "op": "15",
   "jp": "突然行方不明になったかと思ったら\nひょっこり、またアタシの元に・・・",
   "en": "You go missing out of nowhere, and then you just pop back to me...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:0104a",
   "op": "15",
   "jp": "帰ってくるなんてぇ・・・！！",
   "en": "...just like that...!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01116",
   "op": "15",
   "jp": "オイオイ！！\nちょっと待てよ姉ちゃん！",
   "en": "Whoa, whoa!! Hold it right there, sister!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:0114e",
   "op": "15",
   "jp": "コイツの名前は、\nそんなんじゃないって・・・",
   "en": "This guy's name ain't nothin' like that...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:011b2",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:011d2",
   "op": "15",
   "jp": "アンタ誰よ！？",
   "en": "And who are you!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:011f2",
   "op": "15",
   "jp": "アンタ達、白い羽の奴隷の分際で\nアタシに口答えなんかして",
   "en": "You people, mere white-winged slaves, talking back to me...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:0123e",
   "op": "15",
   "jp": "いいと思ってるの！？",
   "en": "You think that's okay!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01266",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:01292",
   "op": "15",
   "jp": "アタシがカイン君だっていったら\nカイン君に決まってるじゃない！！",
   "en": "If I say he's Cain-kun, then he's Cain-kun, obviously!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:012f2",
   "op": "15",
   "jp": "なんだと、このアマぁ・・・！！",
   "en": "What'd you say, you damn wench...!!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:0139e",
   "op": "15",
   "jp": "まあ待てレブロブス！！",
   "en": "Now hold on, Leburobus!!",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:013c6",
   "op": "15",
   "jp": "考えてみれば、こやつは長い間、\n記憶喪失になって、眠っておった\n身なのじゃ・・・！",
   "en": "Think about it, my boy. This one lay asleep for a long time, with no memory...!",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:0142a",
   "op": "15",
   "jp": "そうじゃな？！",
   "en": "Is that not so!?",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:0144e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s236:0147a",
   "op": "15",
   "jp": "つまりは、こやつ自身も自分の\n過去の記憶に関しては、",
   "en": "Which means that about the memories of his own past, this lad himself...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:014c2",
   "op": "15",
   "jp": "全く自信がないという事になる・・・",
   "en": "...can't be sure of anything at all...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:014f6",
   "op": "15",
   "jp": "言い換えれば、こやつのご主人が\n話して聞かせたという昔話自体が、",
   "en": "Put another way, the old stories his master told him...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:0154a",
   "op": "15",
   "jp": "真実ではないという可能性も・・・\n十分に考えられる！！",
   "en": "...may themselves be untrue... That is quite possible, eh!!",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:015a2",
   "op": "15",
   "jp": "オイ爺さん、ちょっと待てよ！！",
   "en": "Hey, old man, hold it!!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:015d2",
   "op": "15",
   "jp": "それじゃあ、アンタ\nコイツが本当にその・・・",
   "en": "So what, you sayin' this guy's really that...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:01612",
   "op": "15",
   "jp": "カ・イ・ンとかいう奴だって\nいうのかよ・・・？！",
   "en": "...that \"C-a-i-n\" or whatever!?",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:0166e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s236:016a6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s236:016de",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s236:0170a",
   "op": "15",
   "jp": "その可能性もあるという事じゃ・・・",
   "en": "I say the possibility exists, my boy...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:01742",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s236:0176e",
   "op": "15",
   "jp": "ねぇキミ・・・",
   "en": "Hey, you...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01806",
   "op": "15",
   "jp": "キミは本当にアタシの\nカイン君じゃないの・・・！？",
   "en": "You're really not my Cain-kun...!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:0185a",
   "op": "1d",
   "jp": "ボクはキミのカインじゃない！",
   "en": "I'm not your Cain!",
   "max": 15
  },
  {
   "id": "s236:01880",
   "op": "1d",
   "jp": "ボクはカインだ！",
   "en": "I'm Cain!",
   "max": 15
  },
  {
   "id": "s236:01898",
   "op": "1d",
   "jp": "どちらとも言えない・・・",
   "en": "I can't say either way...",
   "max": 15
  },
  {
   "id": "s236:018d6",
   "op": "15",
   "jp": "そう・・・・\nだったらアタシになんて・・・",
   "en": "I see.... Then I guess someone like me...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01912",
   "op": "15",
   "jp": "興味ないでしょ！？",
   "en": "...doesn't interest you, right!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01936",
   "op": "15",
   "jp": "いいわよ・・・",
   "en": "Fine...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:0198a",
   "op": "15",
   "jp": "目障りだから！\n早くココから出てって！！",
   "en": "You're an eyesore! Get out of here, now!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:019c6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s236:01a3a",
   "op": "15",
   "jp": "うわああぁぁあぁああぁああぁん！",
   "en": "Waaaaaaaaaaaaaaaaaah!",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:01a6e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s236:01aaa",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s236:01ad6",
   "op": "15",
   "jp": "そうだよなあ！\nそんなこと突然いわれたら・・・",
   "en": "Yeah, no kiddin'! Somebody springs that on you outta nowhere...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:01b16",
   "op": "15",
   "jp": "俺だって困るよなぁ・・・！",
   "en": "...even I'd be stumped, dammit...!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:01b46",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01b72",
   "op": "15",
   "jp": "それじゃあ、いいわよ！！",
   "en": "Fine then, whatever!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01b9e",
   "op": "15",
   "jp": "キミが正真正銘のカイン君だって\nハッキリさせるために・・・",
   "en": "To make it clear you're the one and only Cain-kun...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01bfa",
   "op": "15",
   "jp": "アタシが必ず証拠を見つけて\nみせるんだから！！",
   "en": "...I'll find the proof, you'll see!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01c4c",
   "op": "14",
   "jp": "ミシェットが仲間になった！",
   "en": "Michette joined the party!",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:01d32",
   "op": "15",
   "jp": "やっぱりそうでしょ！！",
   "en": "See, I knew it!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01d5a",
   "op": "15",
   "jp": "ああん！もう絶対間違いないって\n思ってたのよ～！！",
   "en": "Ooh! I just knew there was no way I was wrong!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01d9e",
   "op": "15",
   "jp": "だったら早く、入って入って！！",
   "en": "So hurry, come in, come in!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01dde",
   "op": "15",
   "jp": "オイ！ちょっと待てよ！！",
   "en": "Hey! Hold it!!",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:01e16",
   "op": "15",
   "jp": "・・・なによ！",
   "en": "...What!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01e46",
   "op": "15",
   "jp": "アンタ達なんかに、用はないわよ！\nね～っ！カインく～ん！！",
   "en": "I've got no business with you lot! Riiight, Cain-kuuun!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s236:01f36",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s236:01f6e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s236:01fa6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s236:01fc6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s236:01fe6",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s236:02006",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s236:02032",
   "op": "15",
   "jp": "じゃぁいつものやつ、いくよ！",
   "en": "Okay, here comes the usual!",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:02062",
   "op": "15",
   "jp": "イェ～～ィ！！\nココは私と、\nヌイグルミさん達だけの家！",
   "en": "Yeaaaah!! This house is just for me and my plushies!",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:020ae",
   "op": "15",
   "jp": "他には誰ぁ～れもいない・・・",
   "en": "Nooobody else around...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:020de",
   "op": "15",
   "jp": "この世のパラダ～イス！！",
   "en": "A paradiiise on earth!!",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:0210a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s236:02136",
   "op": "15",
   "jp": "まあこれはこれで・・・",
   "en": "Well, this way...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s236:0215e",
   "op": "15",
   "jp": "よかったのかもしれんな・・・",
   "en": "...may have been for the best, I daresay...",
   "box": "17x3",
   "face": 5
  }
 ]
}
