   "face": 3
  },
  {
   "id": "s236:02032",
   "op": "15",
   "jp": "じゃぁいつものやつ、いくよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s236:02062",
