{
 "source": "d1:SCENARIO/136",
 "copies": [
  "d1:SCENARIO/136",
  "d2:SCENARIO/136"
 ],
 "strings": [
  {
   "id": "s136:004ca",
   "op": "14",
   "jp": "筋肉バカと爺さんとガキか・・・",
   "en": ""
  },
  {
   "id": "s136:004f0",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s136:0053e",
   "op": "14",
   "jp": "お前、腹すいてねえか？",
   "en": ""
  },
  {
   "id": "s136:0055c",
   "op": "14",
   "jp": "そういやぁリンゴ持ってやがったな\nあいつ・・・",
   "en": ""
  },
  {
   "id": "s136:005ce",
   "op": "14",
   "jp": "こんな所におっても仕方あるまい。\n先を急ごうではないか？",
   "en": ""
  },
  {
   "id": "s136:0064a",
   "op": "14",
   "jp": "確かキミは・・・",
   "en": ""
  },
  {
   "id": "s136:00662",
   "op": "14",
   "jp": "大事な記憶を色々と\n無くしちゃってるんだったよね・・・",
   "en": ""
  },
  {
   "id": "s136:006a0",
   "op": "14",
   "jp": "ボクなんかでも・・・\nなにかキミの役にたてる事が\nあるのかなぁ？",
   "en": ""
  },
  {
   "id": "s136:00702",
   "op": "1d",
   "jp": "七つの大罪について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:0071c",
   "op": "1d",
   "jp": "七つの美徳について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:00738",
   "op": "1d",
   "jp": "この牢獄の事について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:00754",
   "op": "1d",
   "jp": "黒き羽の生活について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:00770",
   "op": "1d",
   "jp": "大神官について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:00788",
   "op": "1d",
   "jp": "この牢獄の獄長について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:007a8",
   "op": "1d",
   "jp": "自分のご主人様の居場所について",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:007e6",
   "op": "14",
   "jp": "自由・正義・人権・平等・友情・愛\nなんていう考え方は・・・",
   "en": ""
  },
  {
   "id": "s136:00828",
   "op": "14",
   "jp": "どれも実際には、この世に有りも\nしない偽善的で退廃的な\n考え方だとして・・・",
   "en": ""
  },
  {
   "id": "s136:0087c",
   "op": "14",
   "jp": "黒き羽のボク等の間では、口にする\n事さえ、はばかられているんだ。",
   "en": ""
  },
  {
   "id": "s136:008c4",
   "op": "14",
   "jp": "それにボクのような弱者は・・・",
   "en": ""
  },
  {
   "id": "s136:008ea",
   "op": "14",
   "jp": "弱肉強食のこの世の中では、\n存在自体が罪に値するんだって・・・",
   "en": ""
  },
  {
   "id": "s136:00942",
   "op": "14",
   "jp": "憤怒・おごり・嫉妬・怠惰・暴食・\n強欲、それに欲情といった感情は・・",
   "en": ""
  },
  {
   "id": "s136:0098e",
   "op": "14",
   "jp": "どれも、最も動物らしい自然な\n行いだとして、どれもとっても\n尊重されているんだ・・・",
   "en": ""
  },
  {
   "id": "s136:009ea",
   "op": "14",
   "jp": "弱肉強食のこの世の中では、\nどれも当たり前の行いだって\nみんなは言ってるけど・・・",
   "en": ""
  },
  {
   "id": "s136:00a56",
   "op": "14",
   "jp": "このゴルゴダの牢獄は地下３階建ての建物になっていて・・・",
   "en": ""
  },
  {
   "id": "s136:00a96",
   "op": "14",
   "jp": "地下１階には、たんに殺される予定の軽い刑罰を受ける犯罪者達が\n入っているんだ・・・",
   "en": ""
  },
  {
   "id": "s136:00af0",
   "op": "14",
   "jp": "地下２階には、罪人に痛みを\n与え続ける為の拷問部屋が・・・",
   "en": ""
  },
  {
   "id": "s136:00b32",
   "op": "14",
   "jp": "そしていまボク達がいる地下３階が\n大邪神を封じ込める為の\n生けにえとして選ばれ・・・、",
   "en": ""
  },
  {
   "id": "s136:00b90",
   "op": "14",
   "jp": "生きたまま永遠の苦しみを\n与え続けられる大罪人用の監獄だって聞いてるんだけど・・・",
   "en": ""
  },
  {
   "id": "s136:00bea",
   "op": "14",
   "jp": "実際に罪人が、ここからどこに\n連れて行かれるのかは、\nボクもよく知らないんだ・・・",
   "en": ""
  },
  {
   "id": "s136:00c44",
   "op": "14",
   "jp": "だけど少なくとも、\nキミが言っていたご主人様は・・・",
   "en": ""
  },
  {
   "id": "s136:00c80",
   "op": "14",
   "jp": "ココにはいないと思うよ・・・",
   "en": ""
  },
  {
   "id": "s136:00cb6",
   "op": "14",
   "jp": "黒き羽のボク達の基本的な生活は、\n狩猟に頼った所が多いから\n放浪生活を送る人も多いんだけど、",
   "en": ""
  },
  {
   "id": "s136:00d1a",
   "op": "14",
   "jp": "権力者達は、奴隷を使った農園を\nやっているんで、その土地を\n守るために城塞を構えたり・・・",
   "en": ""
  },
  {
   "id": "s136:00d7c",
   "op": "14",
   "jp": "自分の勢力を誇示するために傭兵を\n集めたりするんだ・・・・",
   "en": ""
  },
  {
   "id": "s136:00dbe",
   "op": "14",
   "jp": "もっとも、黒い羽の傭兵達は\n大抵自分の雇い主を倒そうと、\n日々腕を磨いているから・・・",
   "en": ""
  },
  {
   "id": "s136:00e1c",
   "op": "14",
   "jp": "いつの間にか\n領主が変わっていたりする事も\n珍しくないんだ・・・",
   "en": ""
  },
  {
   "id": "s136:00e64",
   "op": "14",
   "jp": "だけど、キミ達白き羽の人々が、\n自分のご主人様や黒き羽の人々に\n向かって手を上げることだけは",
   "en": ""
  },
  {
   "id": "s136:00ec8",
   "op": "14",
   "jp": "厳しく禁じられているんだ！！",
   "en": ""
  },
  {
   "id": "s136:00eec",
   "op": "14",
   "jp": "もっともレブさんやガイさん達の\n場合には異端審問官達に\n捕まった時に・・・",
   "en": ""
  },
  {
   "id": "s136:00f3e",
   "op": "14",
   "jp": "自由とか正義って言葉を\n口にしちゃった事の方が、問題だったみたいなんだけど・・・",
   "en": ""
  },
  {
   "id": "s136:00faa",
   "op": "14",
   "jp": "ボクたち黒き羽の一族は・・・、",
   "en": ""
  },
  {
   "id": "s136:00fd0",
   "op": "14",
   "jp": "創世記戦争と呼ばれる戦いで勝利したメフィスト様やリリス様達の直系の\n子孫だと言われてるんだけど・・・",
   "en": ""
  },
  {
   "id": "s136:0103c",
   "op": "14",
   "jp": "長い年月の間にその神秘的な力の\nほとんどは、失われてしまったって\n言われているんだ・・・",
   "en": ""
  },
  {
   "id": "s136:0109c",
   "op": "14",
   "jp": "ところが、そんなボクたちとは違い\n僅かに残った、頭に角が生えた\n大神官と呼ばれる人達だけは・・・",
   "en": ""
  },
  {
   "id": "s136:01104",
   "op": "14",
   "jp": "暗黒魔術と呼ばれる、奇跡の力を\n未だに受け継いでいるんだって・・・",
   "en": ""
  },
  {
   "id": "s136:0114e",
   "op": "14",
   "jp": "風の噂によると彼らの間では、",
   "en": ""
  },
  {
   "id": "s136:01172",
   "op": "14",
   "jp": "「いつの日にか世界を取り戻そうと\n　する大邪神が復活し、それを阻む\n　ために神もまた蘇る！」",
   "en": ""
  },
  {
   "id": "s136:011d6",
   "op": "14",
   "jp": "って言う伝説が、\n真剣に信じられているんだって\n聞いたことがあるけど・・・",
   "en": ""
  },
  {
   "id": "s136:01252",
   "op": "14",
   "jp": "ここの獄長を務めるプラハ様は、\n噂によると、とっても邪悪な人物\nらしくって・・・",
   "en": ""
  },
  {
   "id": "s136:012aa",
   "op": "14",
   "jp": "彼女がきてからは、\n極端に拷問や死刑の数が\n減ってきているんだ・・・・",
   "en": ""
  },
  {
   "id": "s136:012f8",
   "op": "14",
   "jp": "ボクの事も、\nまだ一度も殴った事がないし、",
   "en": ""
  },
  {
   "id": "s136:0132a",
   "op": "14",
   "jp": "他の看守達も職務怠慢だって、\nさんざん陰で文句を言ってたよ！",
   "en": ""
  },
  {
   "id": "s136:01382",
   "op": "14",
   "jp": "ここの獄長を務めるカロン様は、\n他の看守達からすごく評判がよくて",
   "en": ""
  },
  {
   "id": "s136:013ca",
   "op": "14",
   "jp": "憤怒・嫉妬・怠惰・おごり・暴食・\n強欲・欲情といった七つの美徳の\nどれをとっても一級品の・・・",
   "en": ""
  },
  {
   "id": "s136:01430",
   "op": "14",
   "jp": "模範的な人物なんだって！",
   "en": ""
  },
  {
   "id": "s136:01450",
   "op": "14",
   "jp": "彼がココにきてからは、極端に拷問や死刑の数が上がり続けてるんだ！",
   "en": ""
  },
  {
   "id": "s136:014aa",
   "op": "14",
   "jp": "ごめんね・・・・",
   "en": ""
  },
  {
   "id": "s136:014c2",
   "op": "14",
   "jp": "残念だけど、\nボクにはキミのご主人様が\nどこに連れて行かれたかなんて・・・",
   "en": ""
  },
  {
   "id": "s136:01514",
   "op": "14",
   "jp": "想像もつかないよ・・・",
   "en": ""
  },
  {
   "id": "s136:0156e",
   "op": "14",
   "jp": "ボクは囚人。\n白い羽の囚人。",
   "en": ""
  },
  {
   "id": "s136:015ce",
   "op": "14",
   "jp": "昨日は、萌えるゴミの日。",
   "en": ""
  },
  {
   "id": "s136:0162e",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:0163c",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s136:0164c",
   "op": "20",
   "jp": "外に出ますか？",
   "en": ""
  }
 ]
}
