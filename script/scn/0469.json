 "strings": [
  {
   "id": "s469:005ba",
   "op": "14",
   "jp": "おい、お前ら・・・\n家族はいるのか？",
   "en": ""
  },
  {
   "id": "s469:005f2",
   "op": "14",
   "jp": "このバベルの塔を守る、\n俺達上級神官は、",
   "en": ""
  },
  {
   "id": "s469:00622",
   "op": "14",
   "jp": "全てが大天使様達の\n血を強く受け継ぐ両性具有さ！",
   "en": ""
  },
  {
   "id": "s469:0065a",
   "op": "14",
   "jp": "誰かと子供なんて・・・\n作るはずがないだろ！",
   "en": ""
  },
  {
   "id": "s469:0069a",
   "op": "14",
   "jp": "そいつは好都合だぜ・・・！！",
   "en": ""
  },
  {
   "id": "s469:006fe",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s469:00756",
   "op": "14",
   "jp": "解ったじゃろう、\nルピルピ・・・！",
   "en": ""
  },
  {
   "id": "s469:00780",
   "op": "14",
   "jp": "なぜ、わしがお前を、\n受け入れられんのかが・・・",
   "en": ""
  },
  {
