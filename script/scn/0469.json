 "strings": [
  {
   "id": "s469:005ba",
   "op": "14",
   "jp": "おい、お前ら・・・\n家族はいるのか？",
   "en": "Hey, you lot... got family?",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s469:005f2",
   "op": "14",
   "jp": "このバベルの塔を守る、\n俺達上級神官は、",
   "en": "We high-ranking priests who guard this Tower of Babel",
   "box": "17x3",
   "face": 64
  },
  {
   "id": "s469:00622",
   "op": "14",
   "jp": "全てが大天使様達の\n血を強く受け継ぐ両性具有さ！",
   "en": "are all hermaphrodites, with the archangels' blood running strong!",
   "box": "17x3",
   "face": 64
  },
  {
   "id": "s469:0065a",
   "op": "14",
   "jp": "誰かと子供なんて・・・\n作るはずがないだろ！",
   "en": "Why would we ever make children with someone!",
   "box": "17x3",
   "face": 64
  },
  {
   "id": "s469:0069a",
   "op": "14",
   "jp": "そいつは好都合だぜ・・・！！",
   "en": "Now that's convenient...!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s469:006fe",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s469:00756",
   "op": "14",
   "jp": "解ったじゃろう、\nルピルピ・・・！",
   "en": "Now you understand, Rupirupi...!",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s469:00780",
   "op": "14",
   "jp": "なぜ、わしがお前を、\n受け入れられんのかが・・・",
   "en": "why I cannot accept you...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s469:007c6",
