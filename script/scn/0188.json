{
 "source": "d1:SCENARIO/188",
 "copies": [
  "d1:SCENARIO/188",
  "d2:SCENARIO/188"
 ],
 "strings": [
  {
   "id": "s188:008a2",
   "op": "15",
   "jp": "そっ、そんなっ！？\nあの鎧の力が、\nよもやこれほどのモノだとは！！",
   "en": ""
  },
  {
   "id": "s188:00906",
   "op": "15",
   "jp": "大邪神の鎧の強さが解ったのなら、\nそろそろ話してもらおう、",
   "en": ""
  },
  {
   "id": "s188:00952",
   "op": "15",
   "jp": "残りの大邪神の鎧の所在を！",
   "en": ""
  },
  {
   "id": "s188:009d2",
   "op": "15",
   "jp": "何だって！？\n他にも同じような鎧が\nあるってのか！",
   "en": ""
  },
  {
   "id": "s188:00a26",
   "op": "15",
   "jp": "その通り！大邪神の鎧は\n七大邪神の名が指し示すように、",
   "en": ""
  },
  {
   "id": "s188:00a6e",
   "op": "15",
   "jp": "この世界に七つ存在する！！",
   "en": ""
  },
  {
   "id": "s188:00a9a",
   "op": "15",
   "jp": "ユダ、権力に取りつかれた\nお主なら・・その所在を\n調べあげておるはずじゃ！！",
   "en": ""
  },
  {
   "id": "s188:00b06",
   "op": "15",
   "jp": "解った・・話す・・\n話しますよっ！",
   "en": ""
  },
  {
   "id": "s188:00b3a",
   "op": "15",
   "jp": "アタシの知る限りではカナンと\nパンデモニウムの街の支配者が、\n教団から秘密裡に買い上げ・・・",
   "en": ""
  },
  {
   "id": "s188:00baa",
   "op": "15",
   "jp": "その管理をしているはずです。",
   "en": ""
  },
  {
   "id": "s188:00be6",
   "op": "15",
   "jp": "教団？まさかそいつは俺達を\n捕らえていた、",
   "en": ""
  },
  {
   "id": "s188:00c22",
   "op": "15",
   "jp": "この世界の最大結社、\nアンゲルス教団だと言うのか！！",
   "en": ""
  },
  {
   "id": "s188:00c82",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s188:00c9a",
   "op": "15",
   "jp": "おにいちゃん・・・！",
   "en": ""
  },
  {
   "id": "s188:00cc2",
   "op": "15",
   "jp": "ううぅん・・・！\nごめんね！なんでもない・・・",
   "en": ""
  },
  {
   "id": "s188:00d1e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s188:00d4a",
   "op": "15",
   "jp": "だからアタシも、\n上層部の命令で手を付ける事が、\n出来なかったんですよぉ。",
   "en": ""
  },
  {
   "id": "s188:00da6",
   "op": "15",
   "jp": "後は知りません、",
   "en": ""
  },
  {
   "id": "s188:00dca",
   "op": "15",
   "jp": "本当ですってば！！",
   "en": ""
  },
  {
   "id": "s188:00e42",
   "op": "15",
   "jp": "（すげえ・・・！\n　なんてことだ、\n　鎧が手に入ればこの俺も・・・）",
   "en": ""
  },
  {
   "id": "s188:00e9a",
   "op": "15",
   "jp": "（探し求めていた自由を、\n　手に入れられるかもしれねぇ。）",
   "en": ""
  },
  {
   "id": "s188:00f26",
   "op": "15",
   "jp": "それと、もう一つ。",
   "en": ""
  },
  {
   "id": "s188:00f4a",
   "op": "15",
   "jp": "最近、愛を語って\n異端審問官達に捕まった、",
   "en": ""
  },
  {
   "id": "s188:00f86",
   "op": "15",
   "jp": "こいつの飼い主は何処へ\n連れていかれたんだ？！",
   "en": ""
  },
  {
   "id": "s188:00fd6",
   "op": "15",
   "jp": "異端審問会と言えば、\nアンゲルス教の総本山の直轄部隊！",
   "en": ""
  },
  {
   "id": "s188:0101e",
   "op": "15",
   "jp": "しかし総本山の場所は、\nアタシにも解らないんです！",
   "en": ""
  },
  {
   "id": "s188:010a2",
   "op": "15",
   "jp": "何だぁ？その総本山ってぇのは？",
   "en": ""
  },
  {
   "id": "s188:010e2",
   "op": "15",
   "jp": "この大陸にある総ての教会の\n頂点に立つ教皇庁の事じゃ！",
   "en": ""
  },
  {
   "id": "s188:0112a",
   "op": "15",
   "jp": "教会の教えや秩序の全てを、\n管理している所だと、",
   "en": ""
  },
  {
   "id": "s188:0116e",
   "op": "15",
   "jp": "わしも噂だけには聞いておったが、",
   "en": ""
  },
  {
   "id": "s188:011a2",
   "op": "15",
   "jp": "あまり興味がなかったので、\n詳しくは知らんのじゃよ！！",
   "en": ""
  },
  {
   "id": "s188:0125e",
   "op": "15",
   "jp": "元々、この街の神官は、\n自分の研究の事しか、\n頭にありませんモノね！",
   "en": ""
  },
  {
   "id": "s188:012c2",
   "op": "15",
   "jp": "あそこからは・・・",
   "en": ""
  },
  {
   "id": "s188:012e6",
   "op": "15",
   "jp": "教皇と呼ばれる、\nやんごとなきお方の命令が、\nたまに届くだけ、",
   "en": ""
  },
  {
   "id": "s188:01336",
   "op": "15",
   "jp": "これ以上は何も知らないんです、\nもう・・・いいでしょう！？",
   "en": ""
  },
  {
   "id": "s188:014ee",
   "op": "15",
   "jp": "（教皇・・・！）",
   "en": ""
  },
  {
   "id": "s188:01546",
   "op": "15",
   "jp": "おにいちゃん、おにいちゃん！\nあの人もきっとレブと一緒で・・・",
   "en": ""
  },
  {
   "id": "s188:01596",
   "op": "15",
   "jp": "頭に虫を飼ってるんだね！",
   "en": ""
  },
  {
   "id": "s188:015ce",
   "op": "15",
   "jp": "なんだとキサマぁ～！！",
   "en": ""
  },
  {
   "id": "s188:01616",
   "op": "15",
   "jp": "愛を語る坊やの\n大事な人の行方は、\n結局、解らずじまいか・・・",
   "en": ""
  },
  {
   "id": "s188:0166e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s188:01732",
   "op": "15",
   "jp": "決めたぜ！俺はもう少し、\nこいつとつき合う事にした！！",
   "en": ""
  },
  {
   "id": "s188:0177a",
   "op": "15",
   "jp": "そのほうが、\n俺の捜し物も案外早く、\n見つかりそうだからな。",
   "en": ""
  },
  {
   "id": "s188:017d6",
   "op": "15",
   "jp": "何だよ、\nてめぇの、その・・・\n捜し物ってのは？",
   "en": ""
  },
  {
   "id": "s188:01856",
   "op": "15",
   "jp": "筋肉バカのおめぇには、\n永遠に分からねぇ代物さ・・・",
   "en": ""
  },
  {
   "id": "s188:018aa",
   "op": "15",
   "jp": "けっ、どうせ\nろくでもねぇもののくせに、",
   "en": ""
  },
  {
   "id": "s188:01942",
   "op": "15",
   "jp": "や～い！や～い！\n筋肉バカ～！！",
   "en": ""
  },
  {
   "id": "s188:01982",
   "op": "15",
   "jp": "うるさいぞ肉ドロボウ！！",
   "en": ""
  },
  {
   "id": "s188:01a2e",
   "op": "15",
   "jp": "ボクも弱いんだけど・・・\nみんなと一緒に行きたいんだ。",
   "en": ""
  },
  {
   "id": "s188:01aaa",
   "op": "15",
   "jp": "情報を集めるにしろ、\nこやつの御主人を助け出すにしろ、",
   "en": ""
  },
  {
   "id": "s188:01af2",
   "op": "15",
   "jp": "この世は、力こそが全てじゃ！",
   "en": ""
  },
  {
   "id": "s188:01b22",
   "op": "15",
   "jp": "まずは、わし等が強くなる事が\n先決じゃろう！！",
   "en": ""
  },
  {
   "id": "s188:01b62",
   "op": "15",
   "jp": "このままの戦力では、\nみすみす殺されに\n行くようなものじゃからな。",
   "en": ""
  },
  {
   "id": "s188:01c52",
   "op": "15",
   "jp": "アンタはどうする！？",
   "en": ""
  },
  {
   "id": "s188:01c86",
   "op": "15",
   "jp": "アタシは・・・！",
   "en": ""
  },
  {
   "id": "s188:01cbe",
   "op": "15",
   "jp": "ただ単に自分の妹を\n助け出したいだけよ・・・",
   "en": ""
  },
  {
   "id": "s188:01d02",
   "op": "15",
   "jp": "ただ単に自分の弟を\n助け出したいだけよ・・・",
   "en": ""
  },
  {
   "id": "s188:01d42",
   "op": "15",
   "jp": "アンタ達となれ合う気なんか\nさらさらないけど・・・",
   "en": ""
  },
  {
   "id": "s188:01d86",
   "op": "15",
   "jp": "この状況では・・・、\nいたしかたないわね！",
   "en": ""
  },
  {
   "id": "s188:01e0a",
   "op": "15",
   "jp": "だったらよ、俺が昔いた\nパンデモニウムの街にでも、\nみんなで行ってみねぇか！？",
   "en": ""
  },
  {
   "id": "s188:02046",
   "op": "15",
   "jp": "お師匠さまが行く以上、私も、\nもちろん御一緒させて頂きます！",
   "en": ""
  },
  {
   "id": "s188:020d2",
   "op": "15",
   "jp": "いや、しかし、\nお前は身体が・・・",
   "en": ""
  },
  {
   "id": "s188:0210a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s188:0218e",
   "op": "15",
   "jp": "すっ、好きにすれば良かろう！",
   "en": ""
  },
  {
   "id": "s188:022ca",
   "op": "15",
   "jp": "決まりだな！！\nまっ、いつまで続くか分からねぇが",
   "en": ""
  },
  {
   "id": "s188:0230e",
   "op": "15",
   "jp": "道中テメェらの背中ぐれぇは、\n守ってやるからよ！",
   "en": ""
  },
  {
   "id": "s188:023a2",
   "op": "15",
   "jp": "ふっ、まったく\n信用できたもんじゃねぇなぁ。",
   "en": ""
  },
  {
   "id": "s188:023e2",
   "op": "15",
   "jp": "みんなこいつの前にだけは、\n立たない方がイイぜ。",
   "en": ""
  },
  {
   "id": "s188:02432",
   "op": "15",
   "jp": "ちっ、\n疑え深ぇやろうだ。",
   "en": ""
  },
  {
   "id": "s188:0246e",
   "op": "15",
   "jp": "みんながいれば、\nきっと安心だよ！！",
   "en": ""
  },
  {
   "id": "s188:024a6",
   "op": "14",
   "jp": "・・・・・？",
   "en": ""
  },
  {
   "id": "s188:0251a",
   "op": "15",
   "jp": "ねぇねぇ、ガイから\nさっき聞いたんだけど、",
   "en": ""
  },
  {
   "id": "s188:025f6",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s188:0261a",
   "op": "15",
   "jp": "アナタも愛を\n信じてるんですって！？",
   "en": ""
  }
 ]
}
