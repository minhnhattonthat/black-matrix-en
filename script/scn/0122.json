  {
   "id": "s122:000c6",
   "op": "15",
   "jp": "この世界における犯罪の中でも、",
   "en": ""
  },
  {
   "id": "s122:000f6",
   "op": "15",
   "jp": "最も罪が重いとされる\n七つの大罪の一つ、",
   "en": ""
  },
  {
   "id": "s122:00146",
   "op": "15",
   "jp": "愛を口にしてしまった少女は、",
   "en": ""
  },
  {
   "id": "s122:0017a",
   "op": "15",
   "jp": "愛を口にしてしまったご主人様は、",
   "en": ""
  },
  {
   "id": "s122:001ae",
   "op": "15",
   "jp": "異端審問官達の手によって、\n何処かへと連れさられてしまった。",
   "en": ""
  },
  {
   "id": "s122:001fe",
   "op": "15",
   "jp": "記憶を失い、",
   "en": ""
  },
  {
   "id": "s122:0021e",
   "op": "15",
   "jp": "この世界の全てとも言える\n主をも失い、",
   "en": ""
  },
  {
   "id": "s122:00256",
   "op": "15",
   "jp": "絶望の淵にたたされたあなたは、",
   "en": ""
  },
  {
   "id": "s122:00286",
   "op": "15",
   "jp": "反抗奴隷のらく印を押され、",
   "en": ""
  },
  {
   "id": "s122:002b2",
   "op": "15",
   "jp": "ゴルゴダと呼ばれる\n薄暗き牢獄へと連行される",
   "en": ""
  },
  {
   "id": "s122:002f2",
   "op": "15",
   "jp": "この場所こそが、",
   "en": ""
  },
  {
   "id": "s122:00316",
   "op": "15",
   "jp": "これからの過酷な運命を方向づける",
   "en": ""
  },
  {
   "id": "s122:0034a",
   "op": "15",
   "jp": "人生のターニングポイントに\nなるとも知らずに・・・",
   "en": ""
