{
 "source": "d1:SCENARIO/75",
 "copies": [
  "d1:SCENARIO/75",
  "d2:SCENARIO/75"
 ],
 "strings": [
  {
   "id": "s75:003a2",
   "op": "15",
   "jp": "おおっと！\n問題の奴隷が、\n帰ってきたようですね！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s75:0044e",
   "op": "15",
   "jp": "か・・・\n彼の手を離せ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:0048a",
   "op": "15",
   "jp": "我々とて同じ黒い羽のアナタに\n手荒な真似などしたくはない\nのですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:004e2",
   "op": "15",
   "jp": "ただ・・・\nアナタがどうしても奴隷を、\n奴隷らしく扱わず・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00532",
   "op": "15",
   "jp": "首輪もつけずに、\n放し飼いにし続けると\nいうのであれば・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00582",
   "op": "15",
   "jp": "彼には死んでもらう事に\nなりますねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:005ca",
   "op": "15",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:005ee",
   "op": "15",
   "jp": "だいいち周りに聞いた噂によると、\n奴隷をペットとして\n猫っ可愛がりするにしても、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00652",
   "op": "15",
   "jp": "服まで着せるなんて\nやりすぎじゃあないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:006a6",
   "op": "15",
   "jp": "奴隷？！\nペット？！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:006da",
   "op": "15",
   "jp": "こ・・こいつは・・・\nそんなんじゃない！！",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:00726",
   "op": "15",
   "jp": "そりゃ自分の奴隷に\n執着心を持つのは勝手だが！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s75:00776",
   "op": "15",
   "jp": "なるほど！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00796",
   "op": "15",
   "jp": "人から貰った時には\n気にいらなかったコップが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:007d6",
   "op": "15",
   "jp": "毎日使っているうちに、\nだんだん良い物に思えてくるという\nアレですか！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:0083e",
   "op": "15",
   "jp": "ちがうっ！！\nオレは・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:0087a",
   "op": "15",
   "jp": "お・オレはこいつの事を\nかけがえのない友人として\nあ・愛・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:008da",
   "op": "15",
   "jp": "あっ！！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s75:008f6",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s75:0091a",
   "op": "15",
   "jp": "愛だとぉ～！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s75:0093a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00956",
   "op": "15",
   "jp": "それは俗に、\nこの世界でも恋と呼ばれる\n人間の発情期の勘違いですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:009ba",
   "op": "15",
   "jp": "（くっ・・・・！！）",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:009ee",
   "op": "15",
   "jp": "発情期に入るとどんな動物でも\n動ξが激しくなって\n頭に血が上り・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00a46",
   "op": "15",
   "jp": "ときおり訳の分からない事を\n叫んで見たりするものです。",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00a8e",
   "op": "15",
   "jp": "だったらそれこそ、\nアナタが彼を\n好きにすればいいんです！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00ade",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s75:00b0a",
   "op": "15",
   "jp": "自分が奴隷に対して\n欲情した事を\n恥じてはいけませんよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00b56",
   "op": "15",
   "jp": "誰かに欲情するという事は・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00b86",
   "op": "15",
   "jp": "全ての動物にとって\n種族の保存に繋がる\n根元的な行為なのです！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00bd6",
   "op": "15",
   "jp": "だいいちそんな・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00bfe",
   "op": "15",
   "jp": "愛などという、\n実際にはこの世にはありもしない\n妄想を口にすることが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00c56",
   "op": "15",
   "jp": "七つの大罪の一つである事を\nアナタはご存じないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s75:00cb2",
   "op": "15",
   "jp": "き・貴様達のいうように\nオレの想いは・・・\n一方的な物かもしれない・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:00d0e",
   "op": "15",
   "jp": "だっだが！\nそれがどんなに罪深い行為でも\nオレは・・・",
   "en": "",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s75:00d56",
   "op": "15",
   "jp": "オレは、こいつの事を・・くっ！\n愛しているんだぁっつ！！",
   "en": "",
   "box": "17x3",
   "face": 12
  }
 ]
}
