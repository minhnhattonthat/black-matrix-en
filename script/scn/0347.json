{
 "source": "d1:SCENARIO/347",
 "copies": [
  "d1:SCENARIO/347",
  "d2:SCENARIO/347"
 ],
 "strings": [
  {
   "id": "s347:004e6",
   "op": "15",
   "jp": "ご協力、感謝する。",
   "en": ""
  },
  {
   "id": "s347:0050a",
   "op": "15",
   "jp": "あの忌々しい秘密地下組織の\nアジトさえ判れば、",
   "en": ""
  },
  {
   "id": "s347:0054a",
   "op": "15",
   "jp": "俺の私設軍が\n必ず一網打尽にしてくれる！",
   "en": ""
  },
  {
   "id": "s347:00592",
   "op": "15",
   "jp": "せいぜい頑張るんですね、\nアナタ達自警団の活躍には、\n教団も大変注目しているんですよ！",
   "en": ""
  },
  {
   "id": "s347:0060a",
   "op": "15",
   "jp": "よく解っているつもりだ。\n黒き羽の支配に反発するような\n愚劣な奴等には・・・",
   "en": ""
  },
  {
   "id": "s347:0066a",
   "op": "15",
   "jp": "必ずや、地獄の鉄槌を\n落としてくれるわ！",
   "en": ""
  },
  {
   "id": "s347:00716",
   "op": "15",
   "jp": "（くそったれの、マルコめ。）",
   "en": ""
  },
  {
   "id": "s347:00746",
   "op": "15",
   "jp": "行くぞみんな！",
   "en": ""
  },
  {
   "id": "s347:00776",
   "op": "15",
   "jp": "おぉーっ！！",
   "en": ""
  },
  {
   "id": "s347:00876",
   "op": "15",
   "jp": "くっくくくくくっ、\nバアァーーカ共め！",
   "en": ""
  },
  {
   "id": "s347:008d6",
   "op": "15",
   "jp": "それにしても嫉妬が\n産み出す力は、やっぱり偉大よね～！",
   "en": ""
  },
  {
   "id": "s347:0091e",
   "op": "15",
   "jp": "せいぜいユダ様の手の平の上で\n踊るがいいワ！",
   "en": ""
  },
  {
   "id": "s347:00982",
   "op": "15",
   "jp": "（ところで・・・\n　ルカ様の方は\n　うまくいってるのかしら）",
   "en": ""
  }
 ]
}
