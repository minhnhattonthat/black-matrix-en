{
 "source": "d1:SCENARIO/11",
 "copies": [
  "d1:SCENARIO/11",
  "d2:SCENARIO/11"
 ],
 "strings": [
  {
   "id": "s11:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": "(Ow...!)",
   "box": "19x3"
  },
  {
   "id": "s11:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": "(My whole body hurts, somehow...)",
   "box": "19x3"
  },
  {
   "id": "s11:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": "(A dull pain, running all through me...)",
   "box": "19x3"
  },
  {
   "id": "s11:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": "(And under a faint nausea, a throbbing ache in the back of my head...)",
   "box": "19x3"
  },
  {
   "id": "s11:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": "(My arms and legs are completely numb... They won't do a thing I tell them...)",
   "box": "19x3"
  },
  {
   "id": "s11:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": "(This awful weakness...)",
   "box": "19x3"
  },
  {
   "id": "s11:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": "(And... and on top of that... why are my eyelids so heavy...!?)",
   "box": "19x3"
  },
  {
   "id": "s11:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": "(What on earth... ...is wrong... with my body...)",
   "box": "19x3"
  },
  {
   "id": "s11:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": "(Yesterday, I'm sure I... Wait... huh!?)",
   "box": "19x3"
  },
  {
   "id": "s11:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": "(What's today, anyway... ......??)",
   "box": "19x3"
  },
  {
   "id": "s11:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": "(No, hold on,)",
   "box": "19x3"
  },
  {
   "id": "s11:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": "(Who I am, to begin with...)",
   "box": "19x3"
  },
  {
   "id": "s11:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": "(Who am I!?)",
   "box": "19x3"
  },
  {
   "id": "s11:0060e",
   "op": "15",
   "jp": "あっ・！？",
   "en": "Ah...!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0063a",
   "op": "15",
   "jp": "あっ・・・・・！",
   "en": "Ahh.....!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0065e",
   "op": "15",
   "jp": "あああああぁあぁああ・・・っつ！！",
   "en": "Aaaaaaaaaaah...!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00692",
   "op": "15",
   "jp": "うっ・・・",
   "en": "Ugh...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:006ae",
   "op": "15",
   "jp": "うっ・・・\nうわああぁああぁあぁあぁあっ\nあぁああぁああっっぁあっぁあん！",
   "en": "Ugh... Waaaaaaaaaaaaaaah! Aaaaaaaaaaaaah!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0070e",
   "op": "14",
   "jp": "！",
   "en": "!",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:00732",
   "op": "15",
   "jp": "ひっく・・・ひっ・・・！",
   "en": "Hic... hic...!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00752",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00782",
   "op": "15",
   "jp": "も～っ！突然眼を覚ますからぁ・・・",
   "en": "Geez! You wake up out of nowhere, so...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:007b6",
   "op": "15",
   "jp": "ビックリしてそこら辺に\nけっつまずいちゃったじゃな～い！",
   "en": "...I got startled and tripped over my own feet, didn't I!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00802",
   "op": "15",
   "jp": "ぜ・・全っ然、目を覚まさないから、",
   "en": "Y-you weren't waking up at all, so...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00836",
   "op": "15",
   "jp": "そろそろ捨てちゃおうかと\n思ってたんだよぉ～！？",
   "en": "...I was thinking it was about time to throw you out, you know!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0087a",
   "op": "15",
   "jp": "だってさぁ・・・\nキミったら、十ヶ月以上も高熱出してかってに寝込んでんだもん・・・！",
   "en": "I mean, come on... You went and laid yourself up with a fever for over ten months...!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:008e2",
   "op": "14",
   "jp": "・・・・？！",
   "en": "...?!",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:0090e",
   "op": "15",
   "jp": "えっ、何？",
   "en": "Huh, what?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0093a",
   "op": "15",
   "jp": "まだどっか痛むの！？",
   "en": "Does something still hurt!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00962",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:0098e",
   "op": "15",
   "jp": "ん・・何？・・・！？",
   "en": "Hm... what?...!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:009c2",
   "op": "15",
   "jp": "え？ひょっとして・・・",
   "en": "Huh? Could it be...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:009fa",
   "op": "15",
   "jp": "え～～～っ！？\n私の事、忘れちゃったの～～？",
   "en": "Whaaaaat!? You forgot about me?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00a3a",
   "op": "15",
   "jp": "まさか・・・自分の事もぉ～？",
   "en": "Don't tell me... yourself, toooo?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00a6a",
   "op": "15",
   "jp": "ちょっとちょっと・・・\nキミの名前は・・・？",
   "en": "Hey, hey... your name is...?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00b26",
   "op": "15",
   "jp": "な、なぁんだ分かってるじゃん！\nそうだよ！",
   "en": "Oh, s-see, you do know! Yeah, that's it!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00b62",
   "op": "15",
   "jp": "じゃあ・・・\n私の名前は・・・？",
   "en": "Then... what's my name...?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00c12",
   "op": "15",
   "jp": "そう！その通り！！",
   "en": "Yes! That's right!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00c36",
   "op": "15",
   "jp": "なぁんだ、えへへへ！\n肝心の事は覚えてるじゃん！",
   "en": "Oh, see, ehehehe! You do remember the important stuff!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00c7a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:00ca6",
   "op": "15",
   "jp": "じゃあいつものやつ、いくよ！",
   "en": "Okay, here comes the usual!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00ce2",
   "op": "15",
   "jp": "イェ～～ィ！！",
   "en": "Yeaaaaah!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00d12",
   "op": "15",
   "jp": "ここは私と・・・\nヌイグルミさん達だけの家！",
   "en": "This house is just for me... and my plushies!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00d52",
   "op": "15",
   "jp": "他には誰～もいないこの世の\nパラダ～イス！",
   "en": "Nooobody else around, a paradiiise on earth!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00d8e",
   "op": "15",
   "jp": "キミは私が２番目に大切にしている\nヌイグルミさんなのに・・・",
   "en": "You're my second most precious plushie, and yet...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00dde",
   "op": "15",
   "jp": "壊れて・・・\n動かなくなっちゃったんだょぉ！？",
   "en": "you broke... and stopped moving, you know!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00e1e",
   "op": "15",
   "jp": "雨の日に雷が落ちて・・・",
   "en": "Lightning struck, on a rainy day...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00e4a",
   "op": "15",
   "jp": "傷のほころびは手当したんだけど、\nずっと眠ったままなんだもん！",
   "en": "I mended the rips in your wounds, but you just kept on sleeping!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00e9a",
   "op": "15",
   "jp": "とっても心配しちゃったよ！",
   "en": "I was sooo worried!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00ec6",
   "op": "15",
   "jp": "ね～っ！カインく～ん！！",
   "en": "Riiight! Cain-kuuun!!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:00ef2",
   "op": "14",
   "jp": "・・・・！？",
   "en": "...!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:0100a",
   "op": "15",
   "jp": "えっ？何よ、\n人が喋ってんのに・・・",
   "en": "Huh? What, I'm talking here...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:01042",
   "op": "15",
   "jp": "キミどこ見て・・・・",
   "en": "Where are you looking....",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0106a",
   "op": "15",
   "jp": "ひょっとして・・・",
   "en": "Could it be...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0108e",
   "op": "15",
   "jp": "背中の・・・羽？！",
   "en": "The... wings?!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:010b2",
   "op": "15",
   "jp": "ふう～～ん！",
   "en": "Hmmmmm!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:010d2",
   "op": "15",
   "jp": "本っ当～に・・・\n全部忘れちゃったんだぁ！？",
   "en": "You really, reeeally forgot everything, huh!?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:01112",
   "op": "15",
   "jp": "この羽はねぇ！\n誰にでも生えてる物なの！",
   "en": "These wings, see! Everybody's got them!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0114e",
   "op": "15",
   "jp": "キミにも・・・私にも・・・！",
   "en": "You do... and so do I...!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0117e",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:011a6",
   "op": "15",
   "jp": "なっ、なによぉ・・・？\nさっきから黙ったまんまで・・・！",
   "en": "Wh-what...? You've just been sitting there silent this whole time...!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:011f2",
   "op": "15",
   "jp": "ちょっとはなんか喋ったら・・・？",
   "en": "Couldn't you say a little something...?",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:01232",
   "op": "15",
   "jp": "ああ～んもうイイや！\n（ん、もう～！手間かかるなぁ）",
   "en": "Aaah, forget it! (Geez! You're such a handful!)",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0127a",
   "op": "14",
   "jp": "・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s11:012a2",
   "op": "15",
   "jp": "ふん・・・！\nまぁ、しょうがないかぁ・・・！",
   "en": "Hmph...! Well, guess it can't be helped...!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:012e2",
   "op": "15",
   "jp": "じゃあ、順番に思い出していこ！",
   "en": "Okay, let's remember it one piece at a time!",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:01322",
   "op": "15",
   "jp": "（この世界のこと・・・）",
   "en": "(About this world...)",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:0134e",
   "op": "15",
   "jp": "（そして、私達のこと・・・）",
   "en": "(And about us...)",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s11:013d2",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "Continue with Chapter 1!",
   "max": 15
  },
  {
   "id": "s11:013e8",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "Start from Chapter 2!",
   "max": 15
  }
 ]
