{
 "source": "d1:SCENARIO/11",
 "copies": [
  "d1:SCENARIO/11",
  "d2:SCENARIO/11"
 ],
 "strings": [
  {
   "id": "s11:002de",
   "op": "14",
   "jp": "（痛っ・・！）",
   "en": ""
  },
  {
   "id": "s11:002f4",
   "op": "14",
   "jp": "（何だか、体中が痛い・・）",
   "en": ""
  },
  {
   "id": "s11:00316",
   "op": "14",
   "jp": "（身体全体に\n　鈍い痛みが走り・・・）",
   "en": ""
  },
  {
   "id": "s11:00344",
   "op": "14",
   "jp": "（かすかな吐き気に紛れて、\n　後頭部がジクジクと痛む・・・）",
   "en": ""
  },
  {
   "id": "s11:00388",
   "op": "14",
   "jp": "（手足が完全にεれ・・・\n　まったく自分のいうことを\n　聞かないようだ・・・）",
   "en": ""
  },
  {
   "id": "s11:003de",
   "op": "14",
   "jp": "（ひどい脱力感・・・）",
   "en": ""
  },
  {
   "id": "s11:003fc",
   "op": "14",
   "jp": "（そ・・それにしても・・・\n　何てμが重いんだ・・・！？）",
   "en": ""
  },
  {
   "id": "s11:0043e",
   "op": "14",
   "jp": "（いったい・・・\n　・・僕の・体は・・・）",
   "en": ""
  },
  {
   "id": "s11:00470",
   "op": "14",
   "jp": "（昨日は確か・・・\n　って・・あれ！？）",
   "en": ""
  },
  {
   "id": "s11:004a0",
   "op": "14",
   "jp": "（今日は、一体\n　・・・・・・？？）",
   "en": ""
  },
  {
   "id": "s11:004cc",
   "op": "14",
   "jp": "（いや、ちょっと待て、）",
   "en": ""
  },
  {
   "id": "s11:004ec",
   "op": "14",
   "jp": "（大体僕は・・・）",
   "en": ""
  },
  {
   "id": "s11:00506",
   "op": "14",
   "jp": "（僕は誰なんだ！？）",
   "en": ""
  },
  {
   "id": "s11:0060e",
   "op": "15",
   "jp": "あっ・！？",
   "en": ""
  },
  {
   "id": "s11:0063a",
   "op": "15",
   "jp": "あっ・・・・・！",
   "en": ""
  },
  {
   "id": "s11:0065e",
   "op": "15",
   "jp": "あああああぁあぁああ・・・っつ！！",
   "en": ""
  },
  {
   "id": "s11:00692",
   "op": "15",
   "jp": "うっ・・・",
   "en": ""
  },
  {
   "id": "s11:006ae",
   "op": "15",
   "jp": "うっ・・・\nうわああぁああぁあぁあぁあっ\nあぁああぁああっっぁあっぁあん！",
   "en": ""
  },
  {
   "id": "s11:0070e",
   "op": "14",
   "jp": "！",
   "en": ""
  },
  {
   "id": "s11:00732",
   "op": "15",
   "jp": "ひっく・・・ひっ・・・！",
   "en": ""
  },
  {
   "id": "s11:00752",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s11:00782",
   "op": "15",
   "jp": "も～っ！突然眼を覚ますからぁ・・・",
   "en": ""
  },
  {
   "id": "s11:007b6",
   "op": "15",
   "jp": "ビックリしてそこら辺に\nけっつまずいちゃったじゃな～い！",
   "en": ""
  },
  {
   "id": "s11:00802",
   "op": "15",
   "jp": "ぜ・・全っ然、目を覚まさないから、",
   "en": ""
  },
  {
   "id": "s11:00836",
   "op": "15",
   "jp": "そろそろ捨てちゃおうかと\n思ってたんだよぉ～！？",
   "en": ""
  },
  {
   "id": "s11:0087a",
   "op": "15",
   "jp": "だってさぁ・・・\nキミったら、十ヶ月以上も高熱出してかってに寝込んでんだもん・・・！",
   "en": ""
  },
  {
   "id": "s11:008e2",
   "op": "14",
   "jp": "・・・・？！",
   "en": ""
  },
  {
   "id": "s11:0090e",
   "op": "15",
   "jp": "えっ、何？",
   "en": ""
  },
  {
   "id": "s11:0093a",
   "op": "15",
   "jp": "まだどっか痛むの！？",
   "en": ""
  },
  {
   "id": "s11:00962",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s11:0098e",
   "op": "15",
   "jp": "ん・・何？・・・！？",
   "en": ""
  },
  {
   "id": "s11:009c2",
   "op": "15",
   "jp": "え？ひょっとして・・・",
   "en": ""
  },
  {
   "id": "s11:009fa",
   "op": "15",
   "jp": "え～～～っ！？\n私の事、忘れちゃったの～～？",
   "en": ""
  },
  {
   "id": "s11:00a3a",
   "op": "15",
   "jp": "まさか・・・自分の事もぉ～？",
   "en": ""
  },
  {
   "id": "s11:00a6a",
   "op": "15",
   "jp": "ちょっとちょっと・・・\nキミの名前は・・・？",
   "en": ""
  },
  {
   "id": "s11:00b26",
   "op": "15",
   "jp": "な、なぁんだ分かってるじゃん！\nそうだよ！",
   "en": ""
  },
  {
   "id": "s11:00b62",
   "op": "15",
   "jp": "じゃあ・・・\n私の名前は・・・？",
   "en": ""
  },
  {
   "id": "s11:00c12",
   "op": "15",
   "jp": "そう！その通り！！",
   "en": ""
  },
  {
   "id": "s11:00c36",
   "op": "15",
   "jp": "なぁんだ、えへへへ！\n肝心の事は覚えてるじゃん！",
   "en": ""
  },
  {
   "id": "s11:00c7a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s11:00ca6",
   "op": "15",
   "jp": "じゃあいつものやつ、いくよ！",
   "en": ""
  },
  {
   "id": "s11:00ce2",
   "op": "15",
   "jp": "イェ～～ィ！！",
   "en": ""
  },
  {
   "id": "s11:00d12",
   "op": "15",
   "jp": "ここは私と・・・\nヌイグルミさん達だけの家！",
   "en": ""
  },
  {
   "id": "s11:00d52",
   "op": "15",
   "jp": "他には誰～もいないこの世の\nパラダ～イス！",
   "en": ""
  },
  {
   "id": "s11:00d8e",
   "op": "15",
   "jp": "キミは私が２番目に大切にしている\nヌイグルミさんなのに・・・",
   "en": ""
  },
  {
   "id": "s11:00dde",
   "op": "15",
   "jp": "壊れて・・・\n動かなくなっちゃったんだょぉ！？",
   "en": ""
  },
  {
   "id": "s11:00e1e",
   "op": "15",
   "jp": "雨の日に雷が落ちて・・・",
   "en": ""
  },
  {
   "id": "s11:00e4a",
   "op": "15",
   "jp": "傷のほころびは手当したんだけど、\nずっと眠ったままなんだもん！",
   "en": ""
  },
  {
   "id": "s11:00e9a",
   "op": "15",
   "jp": "とっても心配しちゃったよ！",
   "en": ""
  },
  {
   "id": "s11:00ec6",
   "op": "15",
   "jp": "ね～っ！カインく～ん！！",
   "en": ""
  },
  {
   "id": "s11:00ef2",
   "op": "14",
   "jp": "・・・・！？",
   "en": ""
  },
  {
   "id": "s11:0100a",
   "op": "15",
   "jp": "えっ？何よ、\n人が喋ってんのに・・・",
   "en": ""
  },
  {
   "id": "s11:01042",
   "op": "15",
   "jp": "キミどこ見て・・・・",
   "en": ""
  },
  {
   "id": "s11:0106a",
   "op": "15",
   "jp": "ひょっとして・・・",
   "en": ""
  },
  {
   "id": "s11:0108e",
   "op": "15",
   "jp": "背中の・・・羽？！",
   "en": ""
  },
  {
   "id": "s11:010b2",
   "op": "15",
   "jp": "ふう～～ん！",
   "en": ""
  },
  {
   "id": "s11:010d2",
   "op": "15",
   "jp": "本っ当～に・・・\n全部忘れちゃったんだぁ！？",
   "en": ""
  },
  {
   "id": "s11:01112",
   "op": "15",
   "jp": "この羽はねぇ！\n誰にでも生えてる物なの！",
   "en": ""
  },
  {
   "id": "s11:0114e",
   "op": "15",
   "jp": "キミにも・・・私にも・・・！",
   "en": ""
  },
  {
   "id": "s11:0117e",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s11:011a6",
   "op": "15",
   "jp": "なっ、なによぉ・・・？\nさっきから黙ったまんまで・・・！",
   "en": ""
  },
  {
   "id": "s11:011f2",
   "op": "15",
   "jp": "ちょっとはなんか喋ったら・・・？",
   "en": ""
  },
  {
   "id": "s11:01232",
   "op": "15",
   "jp": "ああ～んもうイイや！\n（ん、もう～！手間かかるなぁ）",
   "en": ""
  },
  {
   "id": "s11:0127a",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s11:012a2",
   "op": "15",
   "jp": "ふん・・・！\nまぁ、しょうがないかぁ・・・！",
   "en": ""
  },
  {
   "id": "s11:012e2",
   "op": "15",
   "jp": "じゃあ、順番に思い出していこ！",
   "en": ""
  },
  {
   "id": "s11:01322",
   "op": "15",
   "jp": "（この世界のこと・・・）",
   "en": ""
  },
  {
   "id": "s11:0134e",
   "op": "15",
   "jp": "（そして、私達のこと・・・）",
   "en": ""
  },
  {
   "id": "s11:013d2",
   "op": "1d",
   "jp": "１章を続ける！",
   "en": "",
   "max": 15
  },
  {
   "id": "s11:013e8",
   "op": "1d",
   "jp": "２章から始める！",
   "en": "",
   "max": 15
  }
 ]
}
