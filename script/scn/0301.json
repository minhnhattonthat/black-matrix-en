 "strings": [
  {
   "id": "s301:00bee",
   "op": "15",
   "jp": "みんなダマされるなっ！！",
   "en": "Don't be fooled, everyone!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00c1a",
   "op": "15",
   "jp": "その領主は、とんでもない\n大悪党だぞ！！",
   "en": "That lord's one hell of a crook!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00c76",
   "op": "15",
   "jp": "な、何ッ！！",
   "en": "Wh-what!!",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s301:00ca2",
   "op": "15",
   "jp": "バアルさんよ！\nおめぇらが裏でやってた事は\n見せてもらったぜ！！",
   "en": "Baal-san! I saw what you people have been up to behind the scenes!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00cf6",
   "op": "15",
   "jp": "何が平等だ！\n何が正義だ！",
   "en": "Equality, my ass! Justice, my ass!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00d22",
   "op": "15",
   "jp": "人の命を軽んじやがって！！",
   "en": "You treat human life like nothing!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00d4e",
   "op": "15",
   "jp": "さては貴様・・・！！",
   "en": "So that's it, you bastard...!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00d76",
   "op": "15",
   "jp": "街から解放したと言った\n奴隷たちもすでに・・・",
   "en": "Those slaves you said you freed from the town, they're already...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00db6",
   "op": "15",
   "jp": "殺しちまってるんだろう？！！",
   "en": "You've killed them already, haven't you?!!",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s301:00df2",
   "op": "15",
   "jp": "ガイ！\nそれは本当なの？！",
   "en": "Gai! Is that true?!",
   "box": "17x3",
   "face": 6
  },
