{
 "source": "d1:SCENARIO/395",
 "copies": [
  "d1:SCENARIO/395",
  "d2:SCENARIO/395"
 ],
 "strings": [
  {
   "id": "s395:00dfe",
   "op": "15",
   "jp": "やれやれ、戦いにくかったぜ！",
   "en": ""
  },
  {
   "id": "s395:00ea2",
   "op": "15",
   "jp": "申し訳ありません・・・\n志願兵達が血気にはやりまして、",
   "en": ""
  },
  {
   "id": "s395:00f12",
   "op": "15",
   "jp": "そっ・・それで、\n我々はどうすればいいのです！？",
   "en": ""
  },
  {
   "id": "s395:00f62",
   "op": "15",
   "jp": "ゴモラの者達は、\nいまの所、自ら異端審問会に\n何か言う気はないそうじゃ！",
   "en": ""
  },
  {
   "id": "s395:00fbe",
   "op": "15",
   "jp": "それどころか、\nこの街のあまりにも派手な\n動きやその黒煙が、",
   "en": ""
  },
  {
   "id": "s395:0100e",
   "op": "15",
   "jp": "異端審問会に\n知られるのではと\n心配すらしている様子。",
   "en": ""
  },
  {
   "id": "s395:010ae",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s395:010da",
   "op": "15",
   "jp": "街を大きくする事だけを\n考えるのではなく、",
   "en": ""
  },
  {
   "id": "s395:01116",
   "op": "15",
   "jp": "周りや自然との調和も考えて、\n今後は自重する事じゃな！！",
   "en": ""
  },
  {
   "id": "s395:0116e",
   "op": "15",
   "jp": "働けなくなった人達のことも、\n考えてあげて欲しいんだ。",
   "en": ""
  },
  {
   "id": "s395:011ea",
   "op": "15",
   "jp": "そう言われれば、\n確かに我々は、少し焦りすぎて\nいたのかも知れません。",
   "en": ""
  },
  {
   "id": "s395:0126a",
   "op": "15",
   "jp": "街のみんなと、\nもう一度考え直してみます。",
   "en": ""
  }
 ]
}
