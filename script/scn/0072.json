{
 "source": "d1:SCENARIO/72",
 "copies": [
  "d1:SCENARIO/72",
  "d2:SCENARIO/72"
 ],
 "strings": [
  {
   "id": "s72:003a2",
   "op": "15",
   "jp": "おおっと！\n問題の奴隷が、\n帰ってきたようですね！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s72:0044e",
   "op": "15",
   "jp": "か・・・彼を・・・\n彼の手を離して！！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00496",
   "op": "15",
   "jp": "我々とて同じ黒い羽のアナタに\n手荒な真似などしたくはない\nのですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:004ee",
   "op": "15",
   "jp": "お嬢さん！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:0050a",
   "op": "15",
   "jp": "ただ・・・\nアナタがどうしても奴隷を、\n奴隷らしく扱わず・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:0055a",
   "op": "15",
   "jp": "首輪もつけずに、\n放し飼いにし続けると\nいうのであれば・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:005aa",
   "op": "15",
   "jp": "彼には死んでもらう事に\nなりますねぇ！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:005f2",
   "op": "15",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00616",
   "op": "15",
   "jp": "だいいち周りに聞いた噂によると、\n奴隷をペットとして\n猫っ可愛がりするにしても、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:0067a",
   "op": "15",
   "jp": "服まで着せるなんて\nやりすぎじゃあないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:006ce",
   "op": "15",
   "jp": "奴隷・・・？！\nぺ・・・ペット？！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00712",
   "op": "15",
   "jp": "か・・・彼は\nそんなんじゃないよ！！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00756",
   "op": "15",
   "jp": "そりゃ自分の奴隷に\n執着心を持つのは勝手だが！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s72:007a6",
   "op": "15",
   "jp": "なるほど！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:007c6",
   "op": "15",
   "jp": "人から貰った時には\n気にいらなかったコップが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00806",
   "op": "15",
   "jp": "毎日使っているうちに、\nだんだん良い物に思えてくるという\nアレですか！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:0086e",
   "op": "15",
   "jp": "ちがうっ！！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:0088e",
   "op": "15",
   "jp": "ボ・・ボクは・・・\nボクは彼を・・愛・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:008da",
   "op": "15",
   "jp": "あっ！！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s72:008f6",
   "op": "14",
   "jp": "！？",
   "en": "!?",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s72:0091a",
   "op": "15",
   "jp": "愛だとぉ～！",
   "en": "",
   "box": "17x3",
   "face": 43
  },
  {
   "id": "s72:0093a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00956",
   "op": "15",
   "jp": "それは俗に、\nこの世界でも恋と呼ばれる\n人間の発情期の勘違いですよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:009ae",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:009da",
   "op": "15",
   "jp": "発情期に入るとどんな動物でも\n動ξが激しくなって\n頭に血が上り・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00a32",
   "op": "15",
   "jp": "ときおり訳の分からない事を\n叫んで見たりするものです。",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00a7a",
   "op": "15",
   "jp": "だったらそれこそ、\nアナタが彼を\n好きにすればいいんです！！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00aca",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s72:00af6",
   "op": "15",
   "jp": "自分が奴隷に対して\n欲情した事を\n恥じてはいけませんよ！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00b42",
   "op": "15",
   "jp": "誰かに欲情するという事は・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00b72",
   "op": "15",
   "jp": "全ての動物にとって\n種族の保存に繋がる\n根元的な行為なのです！",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00bc2",
   "op": "15",
   "jp": "だいいちそんな・・・",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00bea",
   "op": "15",
   "jp": "愛などという、\n実際にはこの世にはありもしない\n妄想を口にすることが、",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00c42",
   "op": "15",
   "jp": "七つの大罪の一つである事を\nアナタはご存じないんですか！？",
   "en": "",
   "box": "17x3",
   "face": 97
  },
  {
   "id": "s72:00c9e",
   "op": "15",
   "jp": "あ・・貴方達の言うように・・・\nボクの想いは",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00cde",
   "op": "15",
   "jp": "一方的な物なのかもしれない・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00d12",
   "op": "15",
   "jp": "でも・・・！",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00d32",
   "op": "15",
   "jp": "それが・・どんなに罪深くても・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00d66",
   "op": "15",
   "jp": "ボ・・ボクは・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s72:00d9a",
   "op": "15",
   "jp": "ボクは彼を・・・\n愛しているんだ～！！",
   "en": "",
   "box": "17x3",
   "face": 9
  }
 ]
}
