 "strings": [
  {
   "id": "s284:006ea",
   "op": "15",
   "jp": "すでに三つの大邪神の鎧を\n手に入れているとはいえ",
   "en": ""
  },
  {
   "id": "s284:0072e",
   "op": "15",
   "jp": "教団から送り込まれた異端審問十字軍と\n剣を交えた一行は、",
   "en": ""
  },
  {
   "id": "s284:0077a",
   "op": "15",
   "jp": "結果として、この世界最大にして\n唯一の大教団",
   "en": ""
  },
  {
   "id": "s284:007ba",
   "op": "15",
   "jp": "アンゲルス教を敵に回すことに\nなってしまった。",
   "en": ""
  },
  {
   "id": "s284:0086a",
   "op": "15",
   "jp": "愛するご主人様を救うため、",
   "en": ""
  },
  {
   "id": "s284:00896",
   "op": "15",
   "jp": "また教団に対抗できうる\n唯一の力を求めて、",
   "en": ""
  },
  {
   "id": "s284:008d2",
   "op": "15",
   "jp": "旅を続ける彼らが次に訪れた街は",
   "en": ""
  },
  {
   "id": "s284:00972",
   "op": "15",
   "jp": "偽善渦巻く美食の都\n暴食の街・カナンであった。",
   "en": ""
  },
