{
 "source": "d1:SCENARIO/524",
 "copies": [
  "d1:SCENARIO/524",
  "d2:SCENARIO/524"
 ],
 "strings": [
  {
   "id": "s524:0114e",
   "op": "15",
   "jp": "恐れることは、無いのですよ！？",
   "en": ""
  },
  {
   "id": "s524:0117e",
   "op": "15",
   "jp": "この私の肩に噛み付いたまま\nミイラ化されておられる\nこのお方こそ・・・",
   "en": ""
  },
  {
   "id": "s524:011d6",
   "op": "15",
   "jp": "創世記戦争後の、\nこの世界を治めておられた・・・",
   "en": ""
  },
  {
   "id": "s524:0121a",
   "op": "15",
   "jp": "大善神、ハ・サタン様！！",
   "en": ""
  },
  {
   "id": "s524:01246",
   "op": "15",
   "jp": "そして・・・",
   "en": ""
  },
  {
   "id": "s524:01266",
   "op": "15",
   "jp": "いまや、その鎧を通して、\n貴方の魂の一部となられた・・・",
   "en": ""
  },
  {
   "id": "s524:012b2",
   "op": "15",
   "jp": "メフィスト・フェレス様の\nご遺体なのです！！",
   "en": ""
  },
  {
   "id": "s524:013aa",
   "op": "15",
   "jp": "そんな！？",
   "en": ""
  },
  {
   "id": "s524:013c6",
   "op": "15",
   "jp": "サタン様とメフィスト様が、\n同一人物で・・・",
   "en": ""
  },
  {
   "id": "s524:01406",
   "op": "15",
   "jp": "しかも、すでに亡くなられて\nはったやなんて・・・！？",
   "en": ""
  },
  {
   "id": "s524:01476",
   "op": "15",
   "jp": "今から数年前・・・",
   "en": ""
  },
  {
   "id": "s524:0149a",
   "op": "15",
   "jp": "私の夫であり、\nこの世界を治める神でもあった、",
   "en": ""
  },
  {
   "id": "s524:014da",
   "op": "15",
   "jp": "メフィスト様の肉体が・・・\nついに老衰でお亡くなりに\nなられました・・・",
   "en": ""
  },
  {
   "id": "s524:01536",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01562",
   "op": "15",
   "jp": "強力なる指導者の死はすなわち・・\n秩序の崩壊を意味します！",
   "en": ""
  },
  {
   "id": "s524:015ae",
   "op": "15",
   "jp": "一刻も早く、メフィスト様の魂を\n復活させない事には、この世界に\n崩壊の魔の手が押し寄せる・・・",
   "en": ""
  },
  {
   "id": "s524:0161e",
   "op": "15",
   "jp": "それを恐れた私は、\nメフィスト様の死だけを\nあえてルカ達に伝え・・・",
   "en": ""
  },
  {
   "id": "s524:01676",
   "op": "15",
   "jp": "今までどうり、\nサタン様の御言葉を伝える\n教皇としての役割を・・・",
   "en": ""
  },
  {
   "id": "s524:016ca",
   "op": "15",
   "jp": "続けてきたのです・・・・",
   "en": ""
  },
  {
   "id": "s524:01712",
   "op": "15",
   "jp": "すでに貴方達も知っての通り・・・",
   "en": ""
  },
  {
   "id": "s524:01746",
   "op": "15",
   "jp": "大天使の魂が、新たなる\n依り代の肉体と融合して\n復活を遂げるためには・・・",
   "en": ""
  },
  {
   "id": "s524:017a2",
   "op": "15",
   "jp": "そのお互いの魂の本質が\n同種の物であることが・・・\n不可欠の条件！！",
   "en": ""
  },
  {
   "id": "s524:017fa",
   "op": "15",
   "jp": "その条件を満たさぬ者が、\nたとえあの鎧を着たとしても・・・",
   "en": ""
  },
  {
   "id": "s524:01846",
   "op": "15",
   "jp": "最終的には鎧に、\n喰らい尽くされてしまいます・・・",
   "en": ""
  },
  {
   "id": "s524:0188a",
   "op": "15",
   "jp": "そこでまずは、この世界各地に\n移り住んでいた、メフィスト様と\n私との間に産まれた子供達の中から、",
   "en": ""
  },
  {
   "id": "s524:018fe",
   "op": "15",
   "jp": "依り代・・・",
   "en": ""
  },
  {
   "id": "s524:0191e",
   "op": "15",
   "jp": "つまり、メフィスト様の魂を\n入れるにふさわしい肉体を\n捜し求めていたのですが・・・",
   "en": ""
  },
  {
   "id": "s524:01982",
   "op": "15",
   "jp": "結果的には私の子供達の、\nそのいずれもが・・・",
   "en": ""
  },
  {
   "id": "s524:019c2",
   "op": "15",
   "jp": "メフィスト様の、依り代となるには、不適格だということが判ったのです！",
   "en": ""
  },
  {
   "id": "s524:01a42",
   "op": "15",
   "jp": "有る者は博愛・・・",
   "en": ""
  },
  {
   "id": "s524:01a82",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01aae",
   "op": "15",
   "jp": "また有る者は熱愛・・・",
   "en": ""
  },
  {
   "id": "s524:01af2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01b1e",
   "op": "15",
   "jp": "慈愛・・・",
   "en": ""
  },
  {
   "id": "s524:01b56",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01b82",
   "op": "15",
   "jp": "純愛・・・",
   "en": ""
  },
  {
   "id": "s524:01bba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01be6",
   "op": "15",
   "jp": "溺愛・・・",
   "en": ""
  },
  {
   "id": "s524:01c1e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01c4a",
   "op": "15",
   "jp": "そして友愛・・・",
   "en": ""
  },
  {
   "id": "s524:01c86",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01cb2",
   "op": "15",
   "jp": "私達の子供は皆、\nメフィスト様の魂の神髄である\n感情よりも・・・",
   "en": ""
  },
  {
   "id": "s524:01d06",
   "op": "15",
   "jp": "むしろ私の魂の本質である\n感情の方を強く受け継いで\nしまっていたようです・・・",
   "en": ""
  },
  {
   "id": "s524:01d6a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01d96",
   "op": "15",
   "jp": "そしてそれらの感情も\n元はと言えば、私の心の中に深く\n根付いてしまっていた・・・",
   "en": ""
  },
  {
   "id": "s524:01dfa",
   "op": "15",
   "jp": "メフィスト様に対する\n愛憎という、禁断の感情に、\n起因するものだったのです！！",
   "en": ""
  },
  {
   "id": "s524:01e86",
   "op": "15",
   "jp": "きょ、教皇様！？",
   "en": ""
  },
  {
   "id": "s524:01eaa",
   "op": "15",
   "jp": "何をいいださはるんですか・・・！？",
   "en": ""
  },
  {
   "id": "s524:01ee2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:01f1e",
   "op": "15",
   "jp": "そうして月日が流れたある日・・・",
   "en": ""
  },
  {
   "id": "s524:01f52",
   "op": "15",
   "jp": "このルカの情報から、\n私の子供の一人が\n禁忌を犯して・・・",
   "en": ""
  },
  {
   "id": "s524:01fae",
   "op": "15",
   "jp": "奴隷であるはずの少年と",
   "en": ""
  },
  {
   "id": "s524:01fd6",
   "op": "15",
   "jp": "仲むつまじく暮らしているらしい、\nとの情報を聞き・・・",
   "en": ""
  },
  {
   "id": "s524:0201e",
   "op": "15",
   "jp": "私は異端審問官達を\n現地に差し向けました・・・",
   "en": ""
  },
  {
   "id": "s524:0207e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:020aa",
   "op": "15",
   "jp": "それからずっと・・・",
   "en": ""
  },
  {
   "id": "s524:020d2",
   "op": "15",
   "jp": "我々はアナタ達の生活を・・・\n監視し続けていたのですよ！？",
   "en": ""
  },
  {
   "id": "s524:02122",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:0214e",
   "op": "15",
   "jp": "あの子が見抜いた、\n貴方の中に眠る隠された感情・・・",
   "en": ""
  },
  {
   "id": "s524:02196",
   "op": "15",
   "jp": "そして創世記戦争以前の、\nこの世界を治めていた、\nゴッドに反抗してまで・・・",
   "en": ""
  },
  {
   "id": "s524:02202",
   "op": "15",
   "jp": "サルと呼ばれる羽のない\n人々を助けようとした、\nメフィスト様の魂の本質・・・",
   "en": ""
  },
  {
   "id": "s524:02262",
   "op": "15",
   "jp": "それこそが・・・\n平等という感情だったのです！！",
   "en": ""
  },
  {
   "id": "s524:022ce",
   "op": "15",
   "jp": "さぁ・・・\n今の貴方に選択できる道筋は・・・",
   "en": ""
  },
  {
   "id": "s524:0230e",
   "op": "15",
   "jp": "もはや三つしかありません・・・",
   "en": ""
  },
  {
   "id": "s524:0233e",
   "op": "15",
   "jp": "一つ目は、この世界を崩壊から\n救うために・・・",
   "en": ""
  },
  {
   "id": "s524:0237e",
   "op": "15",
   "jp": "貴方の愛する者の命を、\n諦めるという方法・・・",
   "en": ""
  },
  {
   "id": "s524:023ea",
   "op": "15",
   "jp": "そして二つ目は、\nこのまま私達と戦って\nその戦闘に勝利した後に、",
   "en": ""
  },
  {
   "id": "s524:0243e",
   "op": "15",
   "jp": "新たなるゴッドの役目をにない・・・",
   "en": ""
  },
  {
   "id": "s524:0248a",
   "op": "15",
   "jp": "すべてが崩壊した後の世界で、\n彼女に大邪神ガブリエルの鎧を\n着せて、復活させ・・・",
   "en": ""
  },
  {
   "id": "s524:024f6",
   "op": "15",
   "jp": "すべてが崩壊した後の世界で、\n彼に大邪神ガブリエルの鎧を\n着せて、復活させ・・・",
   "en": ""
  },
  {
   "id": "s524:0255a",
   "op": "15",
   "jp": "この世界を崩壊させても・・・",
   "en": ""
  },
  {
   "id": "s524:0258a",
   "op": "15",
   "jp": "他の味方達全員を犠牲にしたとしても",
   "en": ""
  },
  {
   "id": "s524:025be",
   "op": "15",
   "jp": "二人っきりで、一から\nこの世を創り直すという・・・",
   "en": ""
  },
  {
   "id": "s524:02602",
   "op": "15",
   "jp": "愛する者だけの命を、\n助け出すという方法！",
   "en": ""
  },
  {
   "id": "s524:0266a",
   "op": "15",
   "jp": "そして最後の三つ目は・・・",
   "en": ""
  },
  {
   "id": "s524:02696",
   "op": "15",
   "jp": "この世界を崩壊から救うために、\nこの知恵の実を食べ・・・",
   "en": ""
  },
  {
   "id": "s524:026e2",
   "op": "15",
   "jp": "メフィスト様だった頃の\n記憶を完全に取り戻して、",
   "en": ""
  },
  {
   "id": "s524:02726",
   "op": "15",
   "jp": "新たなる支配者となり・・・",
   "en": ""
  },
  {
   "id": "s524:0276a",
   "op": "15",
   "jp": "この世界の他の大邪神の封印を\n元に戻した後に、この鎧を彼女に\n着せて復活させて・・・",
   "en": ""
  },
  {
   "id": "s524:027d2",
   "op": "15",
   "jp": "サタンの花嫁に\n迎えられるという方法・・・！",
   "en": ""
  },
  {
   "id": "s524:02816",
   "op": "15",
   "jp": "この世界の他の大邪神の封印を\n元に戻した後に、この鎧を彼に\n着せて復活させて・・・",
   "en": ""
  },
  {
   "id": "s524:0287a",
   "op": "15",
   "jp": "サタンの花婿に\n迎えられるという方法・・・！",
   "en": ""
  },
  {
   "id": "s524:028ba",
   "op": "15",
   "jp": "この方法はつまり・・・",
   "en": ""
  },
  {
   "id": "s524:028e2",
   "op": "15",
   "jp": "かつての貴方の味方であった\n他の大邪神達を殺してでも、",
   "en": ""
  },
  {
   "id": "s524:0292a",
   "op": "15",
   "jp": "愛する者を助け出すという方法に\n他なりません・・・！",
   "en": ""
  },
  {
   "id": "s524:0298e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s524:029ba",
   "op": "15",
   "jp": "そして、この後ろ二つの選択は、\nどちらの場合でも・・・",
   "en": ""
  },
  {
   "id": "s524:02a02",
   "op": "15",
   "jp": "貴方が新しいこの世界の神に\nなるという事なのですよ！？",
   "en": ""
  }
 ]
}
