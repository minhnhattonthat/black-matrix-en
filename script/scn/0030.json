 ],
 "strings": [
  {
   "id": "s30:00030",
   "op": "14",
   "jp": "○月×日　はれ",
   "en": ""
  },
  {
   "id": "s30:00046",
   "op": "14",
   "jp": "きょう、かいんおにいちゃんが・・・",
   "en": ""
  },
  {
   "id": "s30:00070",
   "op": "14",
   "jp": "わたしにともだちをくれました・・・",
   "en": ""
  },
  {
   "id": "s30:0009a",
   "op": "14",
   "jp": "かいんくんは、あこがれの\nおにいちゃんがあたしにくれた\nくまさんです！！",
   "en": ""
  },
  {
   "id": "s30:000ea",
   "op": "14",
   "jp": "{0021}はうれしくて・・・",
   "en": ""
  },
  {
   "id": "s30:00106",
   "op": "14",
   "jp": "うれしくてうれしくてうれしくて！",
   "en": ""
  },
  {
   "id": "s30:0012e",
   "op": "14",
   "jp": "とってもだいじにするって、\nおにいちゃんにやくそくしました・・・！",
   "en": ""
  },
  {
   "id": "s30:00178",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s30:0018c",
   "op": "14",
   "jp": "だけどおにいちゃんのことは\nなんでないしょにしなきゃなんて\nいうのかなぁ・・・？",
   "en": ""
  },
  {
   "id": "s30:00204",
   "op": "14",
   "jp": "△月○日　あめ",
   "en": ""
  },
  {
   "id": "s30:0021a",
   "op": "14",
   "jp": "きょう、かいんおにいちゃんに・・・",
   "en": ""
  },
  {
   "id": "s30:00244",
   "op": "14",
   "jp": "わたしとけっこんしてって\nたのんだら・・・ビックリしたかおで、\nけっこんはむりだけど・・・",
   "en": ""
  },
  {
   "id": "s30:002a6",
   "op": "14",
   "jp": "{0021}のどれいにだったら\nなってくれるっていって、\nあたまをなでてくれました・・・",
   "en": ""
  },
  {
   "id": "s30:002fc",
   "op": "14",
   "jp": "だけど、どれいってなんなのかな？\nなんだかよくはわかんないけど・・・",
   "en": ""
  },
  {
   "id": "s30:00348",
   "op": "14",
   "jp": "おにいちゃんの、\nおはねのいろがそうらしいんだって・・・",
   "en": ""
  },
  {
   "id": "s30:00388",
   "op": "14",
   "jp": "って、よくかんがえても、\nよくわかんないや・・・！",
   "en": ""
  },
  {
   "id": "s30:003c2",
   "op": "14",
   "jp": "わたしにはパパもママも\nいないから・・・・・",
   "en": ""
  },
  {
   "id": "s30:003f6",
   "op": "14",
   "jp": "だれもおしえてくれないんだもん・・・",
   "en": ""
  },
  {
   "id": "s30:00440",
   "op": "14",
   "jp": "◇月◎日　くもり",
   "en": ""
  },
  {
   "id": "s30:00458",
   "op": "14",
   "jp": "かいんおにいちゃんが・・・",
   "en": ""
  },
  {
   "id": "s30:0047a",
   "op": "14",
   "jp": "ことしはおまつりで、\nきっといけにえになってみせるって\nにこにこしてました・・・！",
   "en": ""
  },
  {
   "id": "s30:004d4",
   "op": "14",
   "jp": "だけど・・・・",
   "en": ""
  },
  {
   "id": "s30:004ea",
   "op": "14",
   "jp": "いけにえってなんなのか、\nわたしにはわかんないけど・・・",
   "en": ""
  },
  {
   "id": "s30:0052a",
   "op": "14",
   "jp": "おにいちゃんがあんなに\nよろこんでるんだから・・・",
   "en": ""
  },
  {
   "id": "s30:00564",
   "op": "14",
   "jp": "きっととっても\nかっこいいことなんだとおもいます・・・",
   "en": ""
  },
  {
   "id": "s30:005a2",
   "op": "14",
   "jp": "だからおまつりのひに・・・",
   "en": ""
  },
  {
   "id": "s30:005c4",
   "op": "14",
   "jp": "おにいちゃんにわたしを、\nつれてってもらうやくそくを\nしました・・・",
   "en": ""
  },
  {
   "id": "s30:00610",
   "op": "14",
   "jp": "ぜったいぜったい・・・\nやくそくだからね・・・",
   "en": ""
  },
  {
   "id": "s30:00664",
   "op": "14",
   "jp": "□月×日　かみなりあめ",
   "en": ""
  },
  {
   "id": "s30:00682",
   "op": "14",
   "jp": "きょうはやくそくのおまつりのひ・・・",
   "en": ""
  },
  {
   "id": "s30:006ae",
   "op": "14",
   "jp": "おにいちゃんはやくそくをやぶって",
   "en": ""
  },
  {
   "id": "s30:006d6",
   "op": "14",
   "jp": "{0021}をむかえにきて\nくれませんでした・・・",
   "en": ""
  },
  {
   "id": "s30:00706",
   "op": "14",
   "jp": "おにいちゃん、かぜでもひいたの？\nそれとも、{0021}のこと\nきらいになったの・・・・？！",
   "en": ""
  },
  {
   "id": "s30:00760",
   "op": "14",
   "jp": "もしかしたらきょうじゃ\nなかったのかなぁ・・・・",
   "en": ""
  },
  {
   "id": "s30:00798",
   "op": "14",
   "jp": "やくそくしたよね！？",
   "en": ""
  },
  {
   "id": "s30:007b4",
   "op": "14",
   "jp": "やくそくしたよね・・・！？",
   "en": ""
  },
  {
   "id": "s30:007d6",
   "op": "14",
   "jp": "もういいもん・・・",
   "en": ""
  },
  {
   "id": "s30:007f0",
   "op": "14",
   "jp": "・・・・おにいちゃんなんか\nだいっきらいだもん・・・",
   "en": ""
  },
  {
   "id": "s30:0084c",
   "op": "14",
   "jp": "○月■日　あめ",
   "en": ""
  },
  {
   "id": "s30:00862",
   "op": "14",
   "jp": "あれから、いっかげついじょう\nたったのに・・・",
   "en": ""
  },
  {
   "id": "s30:00898",
   "op": "14",
   "jp": "かいんおにいちゃんは\nわたしにあいにきてくれません・・・！",
   "en": ""
  },
  {
   "id": "s30:008da",
   "op": "14",
   "jp": "まわりのひとは、かんたんにひとを\nしんようするからだといって、\nわたしをばかにします・・・",
   "en": ""
  },
  {
   "id": "s30:0093c",
   "op": "14",
   "jp": "おにいちゃんは、やくそくを\nやぶったことをきにして\nあいにきてくれないのかなぁ・・・！？",
   "en": ""
  },
  {
   "id": "s30:0099c",
   "op": "14",
   "jp": "それとも、{0021}のこと、\nきらいになっちゃったの・・・・？！\nいいもん、わたししんじるもん・・・",
   "en": ""
  },
  {
   "id": "s30:00a00",
   "op": "14",
   "jp": "きっとそのうち・・・\nおにいちゃんがわたしをむかえにきて\nくれるって・・・・",
   "en": ""
  }
 ]
}
