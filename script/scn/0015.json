{
 "source": "d1:SCENARIO/15",
 "copies": [
  "d1:SCENARIO/15",
  "d2:SCENARIO/15"
 ],
 "strings": [
  {
   "id": "s15:0020e",
   "op": "15",
   "jp": "目が覚めたからって\nまだ動いちゃダメだよぉ～！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0024e",
   "op": "15",
   "jp": "ずっと眠ったままだったんだから\n体がひっくり返っちゃうよ！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0029e",
   "op": "15",
   "jp": "もし退屈なようだったら、\nあたしがお話してあげるね！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:002e6",
   "op": "15",
   "jp": "おにいちゃんが大ケガをしたあの日、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0031a",
   "op": "15",
   "jp": "あっ言っても覚えてないか！？\nゴメンネ・・・！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0035a",
   "op": "15",
   "jp": "おにいちゃんは、\n病気になっちゃったあたしのために、山に薬草を採りに行ってくれたの！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:003c2",
   "op": "15",
   "jp": "何故医者に行かないのかって？",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:003f2",
   "op": "15",
   "jp": "そ・・それは・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00416",
   "op": "15",
   "jp": "えっと・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00436",
   "op": "15",
   "jp": "あ・あたしそんなにお金・・・\n持って無いんだもん！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0048a",
   "op": "15",
   "jp": "エヘヘ・・・\n（ゴメンネおにいちゃん\n　うまく説明できないや！）",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:004ea",
   "op": "15",
   "jp": "とにかく、山の奥へと\n入って行ったおにいちゃんは、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0052e",
   "op": "15",
   "jp": "何かの事故に\n巻き込まれたみたいなの・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0056a",
   "op": "15",
   "jp": "それは・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0058a",
   "op": "15",
   "jp": "それはとても大きな\n事故だったと思うよ・・・！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0063e",
   "op": "15",
   "jp": "（だって・・・\n　あたしほんとは見たんだもん！）",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00682",
   "op": "15",
   "jp": "（雨が止んだあの日・・・）",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:006ae",
   "op": "15",
   "jp": "（あたしがやっと動けるようになって　入って行った山の中に・・・）",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00702",
   "op": "15",
   "jp": "（おにいちゃんを\n　囲むようにして倒れてる、\n　大勢の兵隊さんの死体を・・・）",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00762",
   "op": "15",
   "jp": "いまにも死にそうだった、\n血だらけのおにいちゃんを見たとき、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:007b2",
   "op": "15",
   "jp": "あたし、その場で５時間も\n泣いちゃったんだから・・・！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:007fa",
   "op": "15",
   "jp": "もしもおにいちゃんが\n先に死んじゃったら、\nあたし・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00846",
   "op": "15",
   "jp": "不安だし、心細いし・・・\nエッ・エッ・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00882",
   "op": "15",
   "jp": "ほっとかれたら泣きすぎで\n死んじゃうよぉおぉぉん・・・！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:008ce",
   "op": "15",
   "jp": "ひっく・・ひっく・・・！！\nおにいちゃん・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0096e",
   "op": "15",
   "jp": "もう、いっしょに寝よ？！\nあたしつかれちゃったよ・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:009b6",
   "op": "15",
   "jp": "早く元気になってね！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:009de",
   "op": "15",
   "jp": "（おにいちゃん・・・\n　大好き・・・・）",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00c5a",
   "op": "15",
   "jp": "おにいちゃんが\n目を覚まさなかったとき・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00c9a",
   "op": "15",
   "jp": "あたし、ほんとはすっごく\n怖かったんだから。",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00cda",
   "op": "15",
   "jp": "ほかの子たちみたいに\nあたしには両親もいないし・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00d22",
   "op": "15",
   "jp": "みんなは、あたしの事\nおかしいってイジメるし・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00d66",
   "op": "15",
   "jp": "おにいちゃんだけが・・・\nあたしの気持ちを分かって\nくれてたのに！？",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00dbe",
   "op": "15",
   "jp": "あたしね・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00dde",
   "op": "15",
   "jp": "おにいちゃんの目が大好きなの！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00e0e",
   "op": "15",
   "jp": "おにいちゃんに見つめられてると、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00e42",
   "op": "15",
   "jp": "なんだか・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00e62",
   "op": "15",
   "jp": "なんだかよく分かんないんだけど、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00e96",
   "op": "15",
   "jp": "胸のあたりがキュンてなるの！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00ed2",
   "op": "15",
   "jp": "おにいちゃんが・・・\nたとえあたしのことキライでも、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00f1a",
   "op": "15",
   "jp": "あたしはおにいちゃんのことが、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00f4a",
   "op": "15",
   "jp": "だあぁぁい好き！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:00f6e",
   "op": "15",
   "jp": "この気持ちは・・・変わらないよ！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01332",
   "op": "15",
   "jp": "お、おにいちゃぁぁん！\nまだ寝てなくて平気！？",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01382",
   "op": "15",
   "jp": "えぇ～～っつ！！\nもう平気なのぉぉお～～！？",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:013ce",
   "op": "15",
   "jp": "目がさめてから、\nまだ一週間しか経ってないのにぃ～！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01416",
   "op": "15",
   "jp": "すごい！すごぉお～～い！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01452",
   "op": "15",
   "jp": "だけど、なんかちょっと\nつまんないの・・・",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0148e",
   "op": "15",
   "jp": "だって、さっきまでは\nあたしがおにいちゃんの\nおくさんみたいだったのにぃ！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:014fa",
   "op": "15",
   "jp": "まっいいか！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0151a",
   "op": "15",
   "jp": "そのうちそのうち！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0153e",
   "op": "15",
   "jp": "あっ、でも無理しちゃ\nダメだよ、おにいちゃん！\nゆっくり直せばいいんだからね！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:015a2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s15:015ce",
   "op": "15",
   "jp": "そ・それと・・・\n一つだけ大事なお願いがあるの、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01612",
   "op": "15",
   "jp": "おにいちゃん、聞いてくれる？",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01642",
   "op": "15",
   "jp": "これは重要な事だから\n絶対に忘れちゃダメだよ！！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01686",
   "op": "15",
   "jp": "おにいちゃんは大ケガをしちゃって、",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:016ba",
   "op": "15",
   "jp": "この世界での思い出を\n全部無くしちゃってるんでしょ？！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01702",
   "op": "15",
   "jp": "だから、あたしがイイって言うまで、勝手に家の外に出ないで欲しいの！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:01756",
   "op": "15",
   "jp": "ねぇ、おにいちゃん一生のお願い！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s15:0178a",
   "op": "15",
   "jp": "あたしといっしょに\nちゃんとリハビリしよ！",
   "en": "",
   "box": "17x3",
   "face": 8
  }
 ]
}
