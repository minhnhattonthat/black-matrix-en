 ],
 "strings": [
  {
   "id": "s537:01642",
   "op": "15",
   "jp": "さすがは、メフィスト様の\n魂を受け継がれし・・・",
   "en": ""
  },
  {
   "id": "s537:016aa",
   "op": "15",
   "jp": "次世代のハ・サタン様！！",
   "en": ""
  },
  {
   "id": "s537:018ba",
   "op": "15",
   "jp": "邪悪なる次世代のゴッド様！！",
   "en": ""
  },
  {
   "id": "s537:01932",
   "op": "15",
   "jp": "それでは貴方に・・・",
   "en": ""
  },
  {
   "id": "s537:0195a",
   "op": "15",
   "jp": "本当にこの世界の新たなる、\nハ・サタン様になられる\n決意が有るのかどうか・・・",
   "en": ""
  },
  {
   "id": "s537:019ba",
   "op": "15",
   "jp": "ここでじっくりと見物させて\n頂きましょう・・・",
   "en": ""
  },
  {
   "id": "s537:019fa",
   "op": "15",
   "jp": "さあ！\n其処にいる大邪神達を滅ぼし・・・",
   "en": ""
  },
  {
   "id": "s537:01a36",
   "op": "15",
   "jp": "この世界の封印を、\nもう一度元に戻すのです！！",
   "en": ""
  },
  {
   "id": "s537:01a8e",
   "op": "15",
   "jp": "それでは貴方が・・・",
   "en": ""
  },
  {
   "id": "s537:01ab6",
   "op": "15",
   "jp": "本当にこの世界の崩壊を、\n阻止する為に自らの命を\n犠牲に出来るのかどうか・・・",
   "en": ""
  },
  {
   "id": "s537:01b16",
   "op": "15",
   "jp": "ここでじっくりと見物させて\n頂きましょう・・・",
   "en": ""
  },
  {
   "id": "s537:01b56",
   "op": "15",
   "jp": "さあ！\n今こそ自らの手で決着をつけ・・・",
   "en": ""
  },
  {
   "id": "s537:01b92",
   "op": "15",
   "jp": "この世界の封印を、\nもう一度元に戻すのです！！",
   "en": ""
  },
  {
   "id": "s537:01bee",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
