{
 "source": "d1:SCENARIO/376",
 "copies": [
  "d1:SCENARIO/376",
  "d2:SCENARIO/376"
 ],
 "strings": [
  {
   "id": "s376:00cca",
   "op": "15",
   "jp": "改めてお礼を\n言わせていただきます。",
   "en": ""
  },
  {
   "id": "s376:00d02",
   "op": "15",
   "jp": "救世主様の御来訪に\n街の者全てが喜んでいます！",
   "en": ""
  },
  {
   "id": "s376:00d9a",
   "op": "15",
   "jp": "これからは、異端審問官達の\n襲撃を恐れなくてもすむなんて！",
   "en": ""
  },
  {
   "id": "s376:00df6",
   "op": "15",
   "jp": "どういう意味じゃな、それは？",
   "en": ""
  },
  {
   "id": "s376:00eb6",
   "op": "15",
   "jp": "はぁ！？マルコ様から\n聞いてはおりませんか！？",
   "en": ""
  },
  {
   "id": "s376:00f06",
   "op": "15",
   "jp": "ちょ、ちょっと待ってください！",
   "en": ""
  },
  {
   "id": "s376:00f5e",
   "op": "15",
   "jp": "僕はただ、この街が\n平等と人権を重視した、",
   "en": ""
  },
  {
   "id": "s376:00f9a",
   "op": "15",
   "jp": "素晴らしい街だと言うことしか\n聞いていませんが？",
   "en": ""
  },
  {
   "id": "s376:0100e",
   "op": "15",
   "jp": "それが問題なのです。",
   "en": ""
  },
  {
   "id": "s376:01036",
   "op": "15",
   "jp": "平等と人権は、\n当然この世界の\n七つの大罪に抵触します！！",
   "en": ""
  },
  {
   "id": "s376:01082",
   "op": "15",
   "jp": "むろん我が街でも、来たるべき\n異端審問官達の来襲に備え、",
   "en": ""
  },
  {
   "id": "s376:010ce",
   "op": "15",
   "jp": "有志を募って\n自警団を組織したり、",
   "en": ""
  },
  {
   "id": "s376:01102",
   "op": "15",
   "jp": "火薬を使った\n新兵器を開発してはいます。",
   "en": ""
  },
  {
   "id": "s376:0113e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:0116a",
   "op": "15",
   "jp": "しかし、所詮我々は\n戦闘のプロではありません。",
   "en": ""
  },
  {
   "id": "s376:011aa",
   "op": "15",
   "jp": "しかも隣街のゴモラの奴らが、\nその事を異端審問会に・・・",
   "en": ""
  },
  {
   "id": "s376:011f6",
   "op": "15",
   "jp": "密告するかもしれないんです！！",
   "en": ""
  },
  {
   "id": "s376:0122a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:01262",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:0129a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:012c6",
   "op": "15",
   "jp": "ケルビムさんからは、\nゴモラも平等な街だと\n聞いていますが？",
   "en": ""
  },
  {
   "id": "s376:01346",
   "op": "15",
   "jp": "あの街はダメです！！",
   "en": ""
  },
  {
   "id": "s376:0136e",
   "op": "15",
   "jp": "平等も所詮は形だけで、\n住人達には自由がありません。",
   "en": ""
  },
  {
   "id": "s376:013b6",
   "op": "15",
   "jp": "さらに住民もまた、\n上からの命令どおりにしか\n動こうとはしない！",
   "en": ""
  },
  {
   "id": "s376:0140a",
   "op": "15",
   "jp": "あの街はそんな\n怠け者の住人を育て上げる、\n腐ったシステムの街なのです！！",
   "en": ""
  },
  {
   "id": "s376:0146a",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s376:0149e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:014d6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:01502",
   "op": "15",
   "jp": "その上、奴等は住民達を強制的に\n兵隊に仕立て上げる、徴兵制\nという制度を使って軍備を増強し、",
   "en": ""
  },
  {
   "id": "s376:01572",
   "op": "15",
   "jp": "奴等の政策に従わない\n我々の街を、攻め滅ぼそうと\n企んでいるのです！！",
   "en": ""
  },
  {
   "id": "s376:015ce",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s376:015fa",
   "op": "15",
   "jp": "救世主様御一行には・・・",
   "en": ""
  },
  {
   "id": "s376:01626",
   "op": "15",
   "jp": "どうか、この街に留まって、\n我々を守って頂きたいのです。",
   "en": ""
  },
  {
   "id": "s376:016d2",
   "op": "15",
   "jp": "それが本当なら、\n許しちゃおけねえな！",
   "en": ""
  },
  {
   "id": "s376:0171a",
   "op": "15",
   "jp": "そうは言っても、\n我々も先を急ぐんじゃが！",
   "en": ""
  },
  {
   "id": "s376:01766",
   "op": "15",
   "jp": "では、せめてゴモラに行って\nよけいな事をさせないように、\n進言しては頂けませんか？",
   "en": ""
  },
  {
   "id": "s376:017f2",
   "op": "15",
   "jp": "彼らも救世主様の言う事なら、\n多分・・・\n聞いてくれることでしょう。",
   "en": ""
  },
  {
   "id": "s376:0189e",
   "op": "15",
   "jp": "私は・・・\nそう信じたい・・・",
   "en": ""
  },
  {
   "id": "s376:018d2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s376:018fe",
   "op": "15",
   "jp": "実際に行って\nご覧になれば解ります！",
   "en": ""
  },
  {
   "id": "s376:0195a",
   "op": "15",
   "jp": "その上で我々の願いに\nついてご一考ください！！",
   "en": ""
  },
  {
   "id": "s376:019ce",
   "op": "15",
   "jp": "行ってみるしか・・\nないじゃろうなぁ・・・",
   "en": ""
  },
  {
   "id": "s376:01a0a",
   "op": "15",
   "jp": "ゴモラの街へ！",
   "en": ""
  },
  {
   "id": "s376:01b6e",
   "op": "15",
   "jp": "さぁて、救世主様御一行とやらは\nどんな判断を\n下すのでしょうか？",
   "en": ""
  }
 ]
}
