{
 "source": "d1:SCENARIO/240",
 "copies": [
  "d1:SCENARIO/240",
  "d2:SCENARIO/240"
 ],
 "strings": [
  {
   "id": "s240:0068e",
   "op": "15",
   "jp": "なっ・・なぜだ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:006ba",
   "op": "15",
   "jp": "なぜ今頃こんな奴らと現れて\nオマエまでが、わしの計画を\n邪魔しようとするんだ・・・？！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00732",
   "op": "15",
   "jp": "そっ・・・\nそんなんじゃないよ父さん・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:0077e",
   "op": "15",
   "jp": "僕はただ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:0079e",
   "op": "15",
   "jp": "父さんの嫌っていた僕の体が\n健康になったから・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:007f2",
   "op": "15",
   "jp": "父さん達に・・・\n父さん達に一目見て欲しくて・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:0083a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00856",
   "op": "15",
   "jp": "ふっ・・ふざけるなピリポ！！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00886",
   "op": "15",
   "jp": "オマエがゴルゴダの牢獄の囚人達と\n脱走し・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:008c6",
   "op": "15",
   "jp": "臆病にも逃げ回っているという噂は\nわしの耳にも届いておるぞ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00912",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:0092e",
   "op": "15",
   "jp": "し・・しかもそんな情けない・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00962",
   "op": "15",
   "jp": "奴隷の姿なんかに・・・\n変わり果ておって・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00a76",
   "op": "15",
   "jp": "アナタ・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00a96",
   "op": "15",
   "jp": "もう止めて下さい！！",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00aca",
   "op": "15",
   "jp": "かっ・・母さん・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:00b92",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s240:00c26",
   "op": "15",
   "jp": "パルタがこの村を出ていってからの\nアナタは、ことある毎にピリポの\n話ばかり・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00c8a",
   "op": "15",
   "jp": "アナタだって本当は・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00cb6",
   "op": "15",
   "jp": "ピリポの事を\n心配していたんでしょう？",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00d8e",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s240:00db2",
   "op": "15",
   "jp": "だっ、誰がそんな邪悪なことを！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00df2",
   "op": "15",
   "jp": "アナタがこの村をわざわざ\nこんな場所に造った\n理由だって・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00e42",
   "op": "15",
   "jp": "元はと言えば、弱者に住みやすい村を造ることが目的だったはずじゃ\nありませんか！？",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:00eba",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:00ed2",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:00efe",
   "op": "15",
   "jp": "だっ、だったらなんで・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:00f2a",
   "op": "15",
   "jp": "なんで父さんは、あんな医者なんかの言うことを・・・！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:00f72",
   "op": "15",
   "jp": "若者や子供の数が減れば減るほど\nこの村が衰退していくのは\n目に見えているっていうのに・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:00fe2",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:0100a",
   "op": "15",
   "jp": "この地方の新しい領主に強欲の\nマモン様がなられて以来・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:01056",
   "op": "15",
   "jp": "今までの何百倍もの年貢が\n取り立てられるようになったのよ",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:010a2",
   "op": "15",
   "jp": "それにアナタの弟のパルタが\n行方しれずになってしまってからは、",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:010f2",
   "op": "15",
   "jp": "この人は、オマエの心配ばかりを\nし始めてねぇ・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:01136",
   "op": "15",
   "jp": "オマエが村民達から弱者の罪に\n問われたりしないようにと\n送り込んだあの場所から・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:0119e",
   "op": "15",
   "jp": "一日も早く、\nオマエを呼び戻せる日が\n来るようにと・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:011ea",
   "op": "15",
   "jp": "父さんはこの村を\n弱者が住みやすい村に\n変えようとしていたんですよ・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:01252",
   "op": "15",
   "jp": "うるさい！！\nオマエは黙っていなさい！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:0128e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:012ba",
   "op": "15",
   "jp": "まあ何にせよ、\nこれだけ子供の数が\n減り続けておるときに、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:01306",
   "op": "15",
   "jp": "老人達の心配ばかりもしては\nいられまいて・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:013c6",
   "op": "15",
   "jp": "だっ・・・だが！",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:013ea",
   "op": "15",
   "jp": "彼らはこの街を造るのに貢献した\n功労者で・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:0143a",
   "op": "15",
   "jp": "まあ待て！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:01456",
   "op": "15",
   "jp": "この世に存在する動植物は全て、\n自分自身の子孫をより多く後世に\n残すことを・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:014ba",
   "op": "15",
   "jp": "最優先にするようにつくられておる！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:014ee",
   "op": "15",
   "jp": "しかるにこの村では、\nこれから先の世の中を\n創っていくべき子供達を・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:0154a",
   "op": "15",
   "jp": "増やす事を、ないがしろに\nしすぎているとは思わんか・・！？",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:0159a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:015c6",
   "op": "15",
   "jp": "まあ、これからの村づくりはせいぜい子供達を産みやすいような政策に\n変えていくにしても・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:01632",
   "op": "15",
   "jp": "それで自分の子孫達が増えていくと\n思えれば、老人達とて無下には\n反対もするまいて・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:0169a",
   "op": "15",
   "jp": "お主自身が、\nなんのかんのと言いながら\n自分の子供を心配しておるのが",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:016f2",
   "op": "15",
   "jp": "その何よりの証拠じゃ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:01726",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 113
  },
  {
   "id": "s240:01752",
   "op": "15",
   "jp": "はたしてそいつはどうかなあ！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s240:01782",
   "op": "15",
   "jp": "黒い羽のジイさん連中なんて・・・\nみんな自分の都合の事しか考えて\nねえからなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s240:017ea",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:01806",
   "op": "15",
   "jp": "だったらそんな輩は、\nお主が切り捨てて\nやればよかろう！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:01852",
   "op": "15",
   "jp": "なにせ、ちまたでは・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:0187e",
   "op": "15",
   "jp": "お主は正義の味方などと\n呼ばれておるらしいからのう・・・！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s240:018ce",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s240:018ee",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s240:0190e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:0193a",
   "op": "15",
   "jp": "ピリポ・・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:0195a",
   "op": "15",
   "jp": "ねっ！\n父さんの気持ちがわかったんなら\nうちに帰っておいで・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:019ae",
   "op": "15",
   "jp": "その白い羽の事だって・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:019da",
   "op": "15",
   "jp": "オマエをかばう為なら父さんは\nなんだってするんだから・・・",
   "en": "",
   "box": "17x3",
   "face": 114
  },
  {
   "id": "s240:01a36",
   "op": "15",
   "jp": "父さん・・母さん・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:01a62",
   "op": "15",
   "jp": "この旅は僕にとって・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:01a8e",
   "op": "15",
   "jp": "自分自身を見つけるための\n旅でもあるような気がするんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:01ade",
   "op": "15",
   "jp": "だけど、この旅が終わったら・・・\n僕は・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:01b2a",
   "op": "15",
   "jp": "僕は必ずこの村に戻ってくるよ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s240:01b5e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s240:01b7e",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  }
 ]
}
