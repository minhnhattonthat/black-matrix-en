{
 "source": "d1:SCENARIO/189",
 "copies": [
  "d1:SCENARIO/189",
  "d2:SCENARIO/189"
 ],
 "strings": [
  {
   "id": "s189:0067e",
   "op": "14",
   "jp": "ここはリベイラの街だ！\nもっとも、他の街の者からは、\n背徳の街と呼ばれとるがな！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00712",
   "op": "14",
   "jp": "お前達、下せんなる白い羽の分際で\nなんで勝手に街をうろついてんだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:0075c",
   "op": "14",
   "jp": "あっ、\nどうも！\nそちらの神官様の奴隷でしたか！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:007ce",
   "op": "14",
   "jp": "この街には、\n数多くの教会がある。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:007f8",
   "op": "14",
   "jp": "その中でも特に凄いのは、\n太陽の神殿なんだが、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:0082e",
   "op": "14",
   "jp": "そこにいた前の大神官のヨハネ様は、なにかヘマをやらかして\n監獄に送られたらしいぜ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:008c2",
   "op": "14",
   "jp": "太陽の神殿の大神官ユダ様は、\nこの街の支配者であらせられる！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00906",
   "op": "14",
   "jp": "ユダ様は、えらく嫉妬深いんで、\nすぐ人を殺しちまうんだ・・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:0094c",
   "op": "14",
   "jp": "嫉妬深いのはいい事なんだけど、\n死ぬのはイヤなんで、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00988",
   "op": "14",
   "jp": "前の支配者だった\nヨハネ様の方が、\n今だに人気が高いけどね・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00a0a",
   "op": "14",
   "jp": "この街の神殿には、かの有名な\n神々達の戦いで産み出された",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00a4a",
   "op": "14",
   "jp": "宗教上の遺跡が眠っている、\nってもっぱらの噂だ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00a82",
   "op": "14",
   "jp": "本当の所は、\n正直、誰にもわからんがね・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00af2",
   "op": "14",
   "jp": "実はこの街には悪魔達が残した\nとんでもない鎧が\nあるって評判なんだが・・・。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00b46",
   "op": "14",
   "jp": "たとえ悪魔の物だろうと。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00b66",
   "op": "14",
   "jp": "強い力を持つ物は使わないと\n絶対損だと思わないか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00bae",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s189:00bce",
   "op": "14",
   "jp": "もっともこの考え方は、\n偉大なる前の支配者、\nヨハネ様の受け売りだがね！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00c5a",
   "op": "14",
   "jp": "あんた達、邪道騎士って\n知ってるかい・・・！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00c90",
   "op": "14",
   "jp": "なんでも、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00ca2",
   "op": "14",
   "jp": "神々の残した鎧を\n身につける事によって、強大な力を\n手に入れたって話らしいぜ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:00d0a",
   "op": "14",
   "jp": "ボク達黒き羽の一族の祖先である\n黒き羽の大天使達は・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00d4a",
   "op": "14",
   "jp": "この大地の地底に住んでいたと\n言われているんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00d86",
   "op": "14",
   "jp": "吹き上がるマグマ、血も凍るような\n極寒の地、乾燥しきった砂漠地帯。",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00dd0",
   "op": "14",
   "jp": "必然的に弱い生命は駆逐される、\n単純明快な弱肉強食の世界！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00e14",
   "op": "14",
   "jp": "そこで、人々が生きていくためには\nいつでも最大限の努力をしなければ\n生き残れないという・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00e78",
   "op": "14",
   "jp": "強い力や不屈の闘志を手に入れるにはまさに打って付けの、\n恵まれた楽園だったんだって、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00ed4",
   "op": "14",
   "jp": "もっともボクにとっては、\nそんな場所・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00f06",
   "op": "14",
   "jp": "地獄以外の何物でも\n無いんだけどね・・・、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00f38",
   "op": "14",
   "jp": "とにかくそんな楽園で暮らしていた\nボク等のご先祖様達は・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00f7c",
   "op": "14",
   "jp": "かの救世主メフィスト・フェレス様のお導きで・・・、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:00fb6",
   "op": "14",
   "jp": "大邪神や悪魔達がばっこしていた\nこの地上へと侵攻して、\n大邪神軍団を滅ぼし・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:0100e",
   "op": "14",
   "jp": "この大陸の地下深くに・・・\nあの神の鎖で封じ込めてたんだって\n教えられているんだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s189:010aa",
   "op": "14",
   "jp": "どうやら太陽の神殿に、\n神官兵達が集まっているらしいな！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:010ea",
   "op": "14",
   "jp": "神官は使う魔法の種類によって、\n七つの系統に分けられるんだそうだ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:01134",
   "op": "14",
   "jp": "あの教会の封印の間は、\n呪われた武具が大量に隠されている、\n宝物庫なんだそうだぜ！。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:011e0",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:01218",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:01230",
   "op": "14",
   "jp": "なんでぃ！\n白い羽の分際で何のようだ？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:0125e",
   "op": "14",
   "jp": "お使いか！\nなにが欲しいんだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:012a4",
   "op": "14",
   "jp": "うちの商品は、どれも値段に見合った極上モンばっかりだぜ！。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:012ec",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:0134a",
   "op": "14",
   "jp": "おわらんぞ～",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:0135e",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:01374",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s189:01432",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s189:01440",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s189:01450",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  }
 ]
}
