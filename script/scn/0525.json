{
 "source": "d1:SCENARIO/525",
 "copies": [
  "d1:SCENARIO/525",
  "d2:SCENARIO/525"
 ],
 "strings": [
  {
   "id": "s525:00032",
   "op": "15",
   "jp": "なんだって！！",
   "en": ""
  },
  {
   "id": "s525:00922",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s525:00942",
   "op": "14",
   "jp": "・・・？",
   "en": ""
  },
  {
   "id": "s525:0096a",
   "op": "15",
   "jp": "ついに現れましたね！！",
   "en": ""
  },
  {
   "id": "s525:00992",
   "op": "15",
   "jp": "我々羽のない人間達を\n大洪水で滅ぼした・・・",
   "en": ""
  },
  {
   "id": "s525:009d2",
   "op": "15",
   "jp": "憎っくき\n大悪神ゴッドの片割れども！！",
   "en": ""
  },
  {
   "id": "s525:00a1a",
   "op": "15",
   "jp": "な、突然何を言ってるんだ？！",
   "en": ""
  },
  {
   "id": "s525:00a66",
   "op": "15",
   "jp": "私はメフィスト様のお力によって、\n不死なる呪いをかけられ・・・",
   "en": ""
  },
  {
   "id": "s525:00ab6",
   "op": "15",
   "jp": "リリス様亡き後の、\n人類を産み出す為に\nあの方の妻となった・・・",
   "en": ""
  },
  {
   "id": "s525:00b0a",
   "op": "15",
   "jp": "黒き聖母と呼ばれし者・・・",
   "en": ""
  },
  {
   "id": "s525:00b36",
   "op": "15",
   "jp": "そして・・・\nかつて箱船を使って、\nあの大洪水を逃れた・・・",
   "en": ""
  },
  {
   "id": "s525:00b86",
   "op": "15",
   "jp": "羽のない人間達の、\n最後の生き残りでもある・・・",
   "en": ""
  },
  {
   "id": "s525:00bca",
   "op": "15",
   "jp": "ノアの娘、ヤペテなのです！！",
   "en": ""
  },
  {
   "id": "s525:00c22",
   "op": "15",
   "jp": "そんな・・・\nあの教皇様までもが・・・",
   "en": ""
  },
  {
   "id": "s525:00c5a",
   "op": "15",
   "jp": "言葉を喋るオサルの\n生き残りやったなんて！？",
   "en": ""
  },
  {
   "id": "s525:00c9a",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s525:00cc2",
   "op": "15",
   "jp": "そもそも、この世界は・・・\n全てを崩壊させなければ\nならないほど・・・",
   "en": ""
  },
  {
   "id": "s525:00d1a",
   "op": "15",
   "jp": "そんなに悪しき世界\nでしたか・・！？",
   "en": ""
  },
  {
   "id": "s525:00d52",
   "op": "15",
   "jp": "一部の金持ち達が・・・\n恵まれない人や地域に住む\n人達を喰いものにしている状況は",
   "en": ""
  },
  {
   "id": "s525:00db6",
   "op": "15",
   "jp": "なにも、今に始まった事では\nありません・・・",
   "en": ""
  },
  {
   "id": "s525:00df6",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s525:00e1e",
   "op": "15",
   "jp": "今日たとえ我々が滅亡し、\nそれから三千年の月日がたった\n今日だったとしても・・・・",
   "en": ""
  },
  {
   "id": "s525:00e82",
   "op": "15",
   "jp": "おそらくは、たった一握りの\n裕福な地域に住む金持ち達は・・・",
   "en": ""
  },
  {
   "id": "s525:00ed2",
   "op": "15",
   "jp": "餓死者や戦争に苦しむ人達を、\nそ知らぬ顔で喰いものにし・・・",
   "en": ""
  },
  {
   "id": "s525:00f22",
   "op": "15",
   "jp": "弱者に劣悪な環境を強いて、\nいるだろう事は・・・",
   "en": ""
  },
  {
   "id": "s525:00f66",
   "op": "15",
   "jp": "簡単に想像が付きます！！",
   "en": ""
  },
  {
   "id": "s525:00f9e",
   "op": "15",
   "jp": "そっ、そんな事は無い！",
   "en": ""
  },
  {
   "id": "s525:00fd6",
   "op": "15",
   "jp": "本当にそうでしょうか！？",
   "en": ""
  },
  {
   "id": "s525:01002",
   "op": "14",
   "jp": "・・・・・・・・",
   "en": ""
  },
  {
   "id": "s525:01032",
   "op": "15",
   "jp": "しかもこの世界に住む、\n多くの黒き羽の人々は・・・",
   "en": ""
  },
  {
   "id": "s525:01076",
   "op": "15",
   "jp": "この天空に位置する、\n約束の地が・・・",
   "en": ""
  },
  {
   "id": "s525:010ae",
   "op": "15",
   "jp": "その頭上から、\nいつ落ちてきてもおかしくない、\nという人類滅亡の恐怖と戦い、",
   "en": ""
  },
  {
   "id": "s525:0110e",
   "op": "15",
   "jp": "普段はソレに気づかぬ振りで、\n毎日を暮らしているのですよ！？",
   "en": ""
  },
  {
   "id": "s525:0115e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s525:0118a",
   "op": "15",
   "jp": "今ならまだ間に合います！",
   "en": ""
  },
  {
   "id": "s525:011b6",
   "op": "15",
   "jp": "貴方達、鎧を着けし\n神の子羊達が死に、",
   "en": ""
  },
  {
   "id": "s525:011ee",
   "op": "15",
   "jp": "再び大邪神達の鎧が\n封印されさえすれば・・・",
   "en": ""
  },
  {
   "id": "s525:0122e",
   "op": "15",
   "jp": "例え悪しき状態のままとはいえ、\n再びこの世界に、\n安定が訪れる・・・！！",
   "en": ""
  },
  {
   "id": "s525:0128a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s525:012b6",
   "op": "15",
   "jp": "貴方達は今すぐ・・・",
   "en": ""
  },
  {
   "id": "s525:012de",
   "op": "15",
   "jp": "自殺すべきなのです！！",
   "en": ""
  },
  {
   "id": "s525:0139e",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s525:013c2",
   "op": "15",
   "jp": "それが忍びないと言うのであれば・・",
   "en": ""
  },
  {
   "id": "s525:013f6",
   "op": "15",
   "jp": "私が直接、\n手をお貸ししましょう。",
   "en": ""
  },
  {
   "id": "s525:0142a",
   "op": "15",
   "jp": "それとも・・・\nメフィスト様の魂を\n受け継ぐ貴方が・・・",
   "en": ""
  },
  {
   "id": "s525:01476",
   "op": "15",
   "jp": "自らの手で、\n決着をお付けになりますか！？",
   "en": ""
  },
  {
   "id": "s525:014b6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s525:014e2",
   "op": "15",
   "jp": "確かにこの世界の人々の全てが\n悪人という訳じゃない・・・",
   "en": ""
  },
  {
   "id": "s525:0153a",
   "op": "15",
   "jp": "仲良く暮らそうと\nしていた人達もいたんだ！！",
   "en": ""
  },
  {
   "id": "s525:01586",
   "op": "15",
   "jp": "くっ、\nどうすりゃいいんだよ？！",
   "en": ""
  },
  {
   "id": "s525:015ba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s525:015e6",
   "op": "15",
   "jp": "さあ・・・\n貴方達にも考える時間を\n差し上げましょう・・・",
   "en": ""
  },
  {
   "id": "s525:01632",
   "op": "15",
   "jp": "どの道、この子に大邪神の鎧を\n着せないかぎり・・・",
   "en": ""
  },
  {
   "id": "s525:01676",
   "op": "15",
   "jp": "この世界にこれ以上の変化は\nありえないのですから・・・",
   "en": ""
  },
  {
   "id": "s525:016d2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  }
 ]
}
