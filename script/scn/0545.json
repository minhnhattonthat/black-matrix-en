{
 "source": "d1:SCENARIO/545",
 "copies": [
  "d1:SCENARIO/545",
  "d2:SCENARIO/545"
 ],
 "strings": [
  {
   "id": "s545:0017e",
   "op": "15",
   "jp": "天界の玉座にある７つの封印が\n解かれない限り・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:001c2",
   "op": "15",
   "jp": "世界は悪しき状態のままに\n継続するが・・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00202",
   "op": "15",
   "jp": "神の子羊が順次その封印を\n解いたとき・・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0024e",
   "op": "15",
   "jp": "様々な災いや死、闘争などが\n世界中へと広がり・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:002a2",
   "op": "15",
   "jp": "地上が未曾有の混乱と災厄\nに見舞われる・・・！",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00302",
   "op": "15",
   "jp": "そして７人のラッパが天使達に\nよって順次吹き鳴らされると・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00362",
   "op": "15",
   "jp": "世界の崩壊をくい止めていた\nタガがはずれて・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:003b2",
   "op": "15",
   "jp": "終末の災いが加速度的に\n世界を襲い始め・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0041a",
   "op": "15",
   "jp": "ついには、７頭１０角の\n火のように赤い竜と・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0045e",
   "op": "15",
   "jp": "悪魔やサタンと\n呼ばれる者が現れ・・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:004a6",
   "op": "15",
   "jp": "天界を代表する戦闘天使ミカエル\n達と戦う・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00592",
   "op": "15",
   "jp": "本来この広い世界には・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:005be",
   "op": "15",
   "jp": "善も悪も存在しません・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:005ea",
   "op": "15",
   "jp": "しかし全てのものには、\n光と影があるように・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0062e",
   "op": "15",
   "jp": "善と呼ばれる考え方を\n存在させるためには・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0066e",
   "op": "15",
   "jp": "悪と呼ばれる考え方を、\n無理にでも、創り出す必要性が\nあったのです！！",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:006c6",
   "op": "15",
   "jp": "そこでこの世界唯一の神は、\nその善神と悪神の\n２つの素顔を使い分ける為に",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00722",
   "op": "15",
   "jp": "黒と白の大天使を\nお創りになられました・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00762",
   "op": "15",
   "jp": "本来、天使とは・・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0078a",
   "op": "15",
   "jp": "マーラークと言う神の影なる面\nという意味を持つ言葉・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:007d6",
   "op": "14",
   "jp": "・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s545:00802",
   "op": "15",
   "jp": "俗に、人々から恐れられている、\nゴッドと呼ばれていた\n大悪神と・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:0085a",
   "op": "15",
   "jp": "サタンと呼ばれる大善神とに、\nご指示を出されているお方は・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:008aa",
   "op": "15",
   "jp": "まったくの同一人物！！",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:008d2",
   "op": "15",
   "jp": "そのお方こそが、この宇宙を\nお造りになられた創造主であり・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00922",
   "op": "15",
   "jp": "この世界唯一の神なのです！！",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00952",
   "op": "15",
   "jp": "そもそもハ・サタンとは神が\n地上の人々を監視するために\n使わした検事総長を意味し、",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:009b6",
   "op": "15",
   "jp": "その意味では、\nただの役職名にすぎません！！",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:009f6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s545:00a22",
   "op": "15",
   "jp": "ベリアル＝サタン",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00a46",
   "op": "15",
   "jp": "ベルゼブブ＝サタン",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00a6a",
   "op": "15",
   "jp": "メフィスト＝サタン",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00a8e",
   "op": "15",
   "jp": "彼らはいずれも、神自身が人々を\n監視するために遣わした、\n選ばれし者達・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00b12",
   "op": "15",
   "jp": "次代のサタンとなるべき\n貴方が・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00b4e",
   "op": "15",
   "jp": "次代のゴッドとなるべき\n貴方が・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00b86",
   "op": "15",
   "jp": "その新しき世界を任せる人物に\n真にふさわしいかどうか・・・",
   "en": "",
   "box": "17x3",
   "face": 19
  },
  {
   "id": "s545:00bd2",
   "op": "15",
   "jp": "神は試されているのですよ！",
   "en": "",
   "box": "17x3",
   "face": 19
  }
 ]
}
