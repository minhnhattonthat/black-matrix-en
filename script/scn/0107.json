   "en": ""
  },
  {
   "id": "s107:000a6",
   "op": "15",
   "jp": "大ケガをして、倒れてる\nおにいちゃんを見つけたとき・・・",
   "en": ""
  },
  {
   "id": "s107:000f2",
   "op": "15",
   "jp": "あたし、ビックリして\n心臓が止まっちゃうかと\n思ったんだから・・・",
   "en": ""
  },
  {
   "id": "s107:00146",
   "op": "15",
   "jp": "ほんとに・・・",
   "en": ""
  },
  {
   "id": "s107:00176",
   "op": "15",
   "jp": "ほんとに朝まで泣いてたんだよ！？",
   "en": ""
  },
  {
   "id": "s107:001aa",
   "op": "15",
   "jp": "おにいちゃんが死んだら・・・",
   "en": ""
  },
  {
   "id": "s107:001da",
   "op": "15",
   "jp": "あたし・・・ひとりぼっちでなんか\n生きていけないよぉ～～！",
   "en": ""
  },
  {
   "id": "s107:00226",
   "op": "15",
   "jp": "おにいちゃんが、側にいてくれれば\n他には何もいらないもん・・・",
