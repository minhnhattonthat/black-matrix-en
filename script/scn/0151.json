 "strings": [
  {
   "id": "s151:000d2",
   "op": "15",
   "jp": "ゴルゴダの牢獄からの脱獄に成功し\nお尋ね者となった一行は・・・",
   "en": ""
  },
  {
   "id": "s151:00122",
   "op": "15",
   "jp": "ヨハネに導かれるようにして、リベイラの街にある、太陽の神殿へと向かった。",
   "en": ""
  },
  {
   "id": "s151:001ea",
   "op": "15",
   "jp": "ご主人様の行方が解るかもしれない\nという、ヨハネの言葉を信じて。",
   "en": ""
  },
  {
   "id": "s151:0023e",
   "op": "15",
   "jp": "しかし、ヨハネには初めから\nある思惑があったのだ。",
   "en": ""
  },
  {
   "id": "s151:002f2",
   "op": "15",
   "jp": "そう、彼自身の野望とも言える、\n極めて個人的・・・",
   "en": ""
  },
  {
   "id": "s151:00336",
   "op": "15",
   "jp": "遠大な思惑が・・・",
   "en": ""
  },
