{
 "source": "d1:SCENARIO/475",
 "copies": [
  "d1:SCENARIO/475",
  "d2:SCENARIO/475"
 ],
 "strings": [
  {
   "id": "s475:0062a",
   "op": "14",
   "jp": "ゴッドがお怒りになり・・・\n下界には大洪水が起こったようだ！",
   "en": ""
  },
  {
   "id": "s475:0066e",
   "op": "14",
   "jp": "あれでは絶対に、\n羽のない生き物達は\n助からないだろうが・・・",
   "en": ""
  },
  {
   "id": "s475:006b4",
   "op": "14",
   "jp": "せめて我々下級天使達との間に\n産まれた子供達だけでも、\n助かって欲しいものだ・・・",
   "en": ""
  },
  {
   "id": "s475:0071a",
   "op": "14",
   "jp": "羽の無い生き物とは\nやはり我々の先祖である・・・",
   "en": ""
  },
  {
   "id": "s475:00752",
   "op": "14",
   "jp": "サル達の事なのでしょうね・・・",
   "en": ""
  },
  {
   "id": "s475:00786",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s475:007d2",
   "op": "14",
   "jp": "黒き羽の大天使である\nメフィストは、",
   "en": ""
  },
  {
   "id": "s475:007fe",
   "op": "14",
   "jp": "あの羽すら無いサル達に\n知恵の実を与えてしまった\nようだけど・・・",
   "en": ""
  },
  {
   "id": "s475:00848",
   "op": "14",
   "jp": "いくら姿形が似ていても",
   "en": ""
  },
  {
   "id": "s475:00866",
   "op": "14",
   "jp": "あんな凶暴なサル達に、やたらと\n知恵なんか与えるべきじゃ\nないと思うの・・・",
   "en": ""
  },
  {
   "id": "s475:008ba",
   "op": "14",
   "jp": "そのうちに、この世界全体を\n滅ぼすような・・・",
   "en": ""
  },
  {
   "id": "s475:008f0",
   "op": "14",
   "jp": "そんないやな予感がするわ！",
   "en": ""
  },
  {
   "id": "s475:0094e",
   "op": "14",
   "jp": "白き天使の連中ときたら、",
   "en": ""
  },
  {
   "id": "s475:0096e",
   "op": "14",
   "jp": "サルには知恵を\n与えちゃいけないなんて\n言っているが・・・",
   "en": ""
  },
  {
   "id": "s475:009b0",
   "op": "14",
   "jp": "奴等の考えは、いつまでも\n我々天使達だけで知恵を\n独占していたいという、",
   "en": ""
  },
  {
   "id": "s475:00a00",
   "op": "14",
   "jp": "浅ましい、腐った根性なんだ！！",
   "en": ""
  },
  {
   "id": "s475:00a26",
   "op": "14",
   "jp": "今のゴッドのように、平気で\n生き物を根絶やしにする\n血も涙もない神ではなく、",
   "en": ""
  },
  {
   "id": "s475:00a7a",
   "op": "14",
   "jp": "もっと慈悲深いメフィスト様の\nような方こそ神と呼ばれるに\nふさわしいのに・・・",
   "en": ""
  },
  {
   "id": "s475:00b0a",
   "op": "14",
   "jp": "サル達はご禁制の品である\n知恵の実を食べて以来、",
   "en": ""
  },
  {
   "id": "s475:00b42",
   "op": "14",
   "jp": "火の使い方を憶えて、瞬く間に\n文明を進化させてしまった・・・",
   "en": ""
  },
  {
   "id": "s475:00b86",
   "op": "14",
   "jp": "しかし、それを怒った\n当時の白き羽の大天使の王\nゴッドは・・・",
   "en": ""
  },
  {
   "id": "s475:00bcc",
   "op": "14",
   "jp": "地上に大洪水をおこして\n可哀想なサル達を、根絶やしに\nしてしまわれたのだ！！",
   "en": ""
  },
  {
   "id": "s475:00c2e",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s475:00c7a",
   "op": "14",
   "jp": "メフィストの奴め・・・",
   "en": ""
  },
  {
   "id": "s475:00c98",
   "op": "14",
   "jp": "奴は最初からこの内乱を利用して、\nゴッドを神の地位から\n引きずりおろし・・・",
   "en": ""
  },
  {
   "id": "s475:00cec",
   "op": "14",
   "jp": "自分が次代のハ・サタン様に\nなろうと、狙っていたに違い\nあるまい！！",
   "en": ""
  },
  {
   "id": "s475:00d72",
   "op": "14",
   "jp": "ネェ・・・",
   "en": ""
  },
  {
   "id": "s475:00d84",
   "op": "14",
   "jp": "僕が、天使のくせに天使の鎧を\n着れないのは、信念って物が\n無いからなんだって・・・",
   "en": ""
  },
  {
   "id": "s475:00e1a",
   "op": "14",
   "jp": "確か僕は、この間の戦いで、\n死んだはずなんだけど\nなんでココにいるんだろう・・・",
   "en": ""
  },
  {
   "id": "s475:00eae",
   "op": "14",
   "jp": "やぁ、いらっしゃい！",
   "en": ""
  },
  {
   "id": "s475:00eca",
   "op": "14",
   "jp": "天使の力が宿った武器は\n今回の戦争で全部\n持って行かれちまってね！",
   "en": ""
  },
  {
   "id": "s475:00f14",
   "op": "14",
   "jp": "だったら、なんでいつまでも\n店なんか開いてるのかって？",
   "en": ""
  },
  {
   "id": "s475:00f68",
   "op": "14",
   "jp": "・・・・・・\n本当は、まだあるんだよね！",
   "en": ""
  },
  {
   "id": "s475:00fb0",
   "op": "14",
   "jp": "さぁ・・・、\n俺にも、わかんないや！",
   "en": ""
  },
  {
   "id": "s475:01016",
   "op": "14",
   "jp": "いらっしゃい・・・・？",
   "en": ""
  },
  {
   "id": "s475:01034",
   "op": "14",
   "jp": "なんていったら、\nショップに行けると思ってる？",
   "en": ""
  },
  {
   "id": "s475:01080",
   "op": "14",
   "jp": "はははははは、あ、あれ・・・",
   "en": ""
  },
  {
   "id": "s475:010a4",
   "op": "14",
   "jp": "きゃっ、え、なにぃ～！！",
   "en": ""
  },
  {
   "id": "s475:01182",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s475:01190",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s475:011a0",
   "op": "20",
   "jp": "先へ進みますか？",
   "en": ""
  }
 ]
}
