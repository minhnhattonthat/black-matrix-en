{
 "source": "d1:SCENARIO/388",
 "copies": [
  "d1:SCENARIO/388",
  "d2:SCENARIO/388"
 ],
 "strings": [
  {
   "id": "s388:00d46",
   "op": "15",
   "jp": "せっかく救世主様達に\nお越し頂けたのに、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:00d82",
   "op": "15",
   "jp": "お恥ずかしい所をお見せして\n申し訳ありません。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:00df6",
   "op": "15",
   "jp": "それどころじゃねぇ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:00e1e",
   "op": "15",
   "jp": "何なんだその\n不平監察官とかいう連中は？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:00e5a",
   "op": "15",
   "jp": "いま連れていったお嬢さんを・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:00e8e",
   "op": "15",
   "jp": "早く解放しやがれ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:00f0a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:00f26",
   "op": "15",
   "jp": "この街では、\n常に住民の平等を\n第一に考えているのですが、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:00f72",
   "op": "15",
   "jp": "未だにああいった\n私情を言う連中がいて\n困っているのです。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:00fbe",
   "op": "15",
   "jp": "全ての人が差別のない\n幸せな生活を送るためには、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01002",
   "op": "15",
   "jp": "私情は極力、\nおさえなければなりません！！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01066",
   "op": "15",
   "jp": "だってそうでしょう？\nみんなが自分の利益\nばかりを優先したら、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:010b6",
   "op": "15",
   "jp": "平等な社会なんて\n出来るはずが\nないじゃありませんか！！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01102",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:0112e",
   "op": "15",
   "jp": "そのためにわざわざ住民の\n仕事のノルマの割り当てから、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01176",
   "op": "15",
   "jp": "街の開発計画に至るまで、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:011a2",
   "op": "15",
   "jp": "全て我々が指導監督して\n実施しているのです。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:011e2",
   "op": "15",
   "jp": "ところがこんな単純な事にも\n賛同できない自分勝手な\n住民も中にはいるので、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0123e",
   "op": "15",
   "jp": "そのような者を取り締まり、\n立派な同志に教育し直すのが、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0128a",
   "op": "15",
   "jp": "ほかならぬ不平監察官なのです！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01372",
   "op": "15",
   "jp": "なるほど・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:013c6",
   "op": "15",
   "jp": "なるほどじゃねえだろう爺さん！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:01406",
   "op": "15",
   "jp": "でもしかし、あながち間違った事も\n言ってはおらんぞ。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:0145a",
   "op": "15",
   "jp": "でも、\n誰か一人を助ける事も出来ないで、\nどうやって全ての人々の幸せを・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s388:0151a",
   "op": "15",
   "jp": "それこそ、子供相手に良く\n使われるΨ弁ですね！！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0156a",
   "op": "15",
   "jp": "全体の幸せを考えた場合には、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:0159a",
   "op": "15",
   "jp": "はたから見て非情な手段を\n取ることもある、\nということじゃな・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:01622",
   "op": "15",
   "jp": "待ってくれよ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:01642",
   "op": "15",
   "jp": "だけどそれじゃあ、\nこの街の連中には、\n自由がないじゃないか！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:01696",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:016b2",
   "op": "15",
   "jp": "無制限な自由は、時として\n途方もない混乱を生み出します！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:016fe",
   "op": "15",
   "jp": "全体の幸せを基盤にして、\n初めて個人の自由と\nいうものが存在する。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0177a",
   "op": "15",
   "jp": "違いますか？",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0179a",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s388:017ea",
   "op": "15",
   "jp": "解って頂けたのでしたら、\n今度はこちらの話を\n聞いて頂きたい。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0183a",
   "op": "15",
   "jp": "すでにマルコ様から\nお聞きの通り、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0186e",
   "op": "15",
   "jp": "我が街を異端審問会と\nソドムの街の魔の手から\n守ってもらいたいのです！！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0193e",
   "op": "15",
   "jp": "ちょっと待ってください！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s388:0196a",
   "op": "15",
   "jp": "僕はただ、この街が、",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s388:01992",
   "op": "15",
   "jp": "平等と弱者を大切にした\n素晴らしい街だということしか\n聞いていませんが・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s388:019fe",
   "op": "15",
   "jp": "それが問題なのです！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01a26",
   "op": "15",
   "jp": "平等と弱者は\nご存じの通り、\n七つの大罪に抵触します。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01a6e",
   "op": "15",
   "jp": "むろん我が街でも、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01a92",
   "op": "15",
   "jp": "来たるべき異端審問官達の\n来襲に備えて、徴兵制を実施し、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01ade",
   "op": "15",
   "jp": "自分達の街を守るために、\n大規模な自警団を組織しました！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01b2a",
   "op": "15",
   "jp": "しかし、所詮我々は\n戦闘のプロではありません。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01b6a",
   "op": "15",
   "jp": "しかも隣街のソドムの奴らは、\nそのことを異端審問会に\n密告するかもしれないのです！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01bde",
   "op": "15",
   "jp": "ソドムの方々も、\n自分たちの街を平等だと\n言われていましたが！？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s388:01c92",
   "op": "15",
   "jp": "あの街はダメです！！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01cba",
   "op": "15",
   "jp": "彼らの言う平等は形だけで、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01ce6",
   "op": "15",
   "jp": "実際は一部の\n限られた権力者だけが\n裕福な生活を送っているのです。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01d3a",
   "op": "15",
   "jp": "そのため、働けなくなった\n弱者や老人達は\n街を追われ、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01d82",
   "op": "15",
   "jp": "ノアという廃αでひっそりと\n暮らしていると聞いています。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01e22",
   "op": "15",
   "jp": "そんなやり方が、\n本当に平等だと言えますか？",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01e7a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s388:01eb2",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s388:01ed2",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s388:01f22",
   "op": "15",
   "jp": "しかもあの黒煙を見て下さい！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:01fe2",
   "op": "15",
   "jp": "なんの長期的な計画も無いまま、",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:02012",
   "op": "15",
   "jp": "共有物であるはずの自然を\n勝手に汚し続けるあの態度！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:0207e",
   "op": "15",
   "jp": "その上、今度は新型の兵器を\n開発して、我々の街を・・・\n攻め滅ぼすつもりなのです！！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:02116",
   "op": "15",
   "jp": "そんなのは、許せないよ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s388:021ca",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 7
  },
  {
   "id": "s388:02202",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s388:02282",
   "op": "15",
   "jp": "しかし彼らの話を聞く限り、\n今の説明だけを全て\n鵜呑みにするわけにはいかん！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:022f2",
   "op": "15",
   "jp": "では、せめてソドムの住人に、\n我々に敵対しないよう\n進言しては頂けませんか？",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:02352",
   "op": "15",
   "jp": "奴らも救世主様の言う事なら、\nたぶん・・・\n聞いてくれる事でしょう。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:023ce",
   "op": "15",
   "jp": "私は・・・そう信じたい。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s388:023fa",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s388:02426",
   "op": "15",
   "jp": "うぅむ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s388:02bca",
   "op": "15",
   "jp": "大変です！！",
   "en": "",
   "box": "17x3",
   "face": 50
  },
  {
   "id": "s388:02c4e",
   "op": "15",
   "jp": "ソドムの街の奴等が、\n我が街の近くまで\n攻め込んできました！！",
   "en": "",
   "box": "17x3",
   "face": 50
  },
  {
   "id": "s388:02ce6",
   "op": "15",
   "jp": "なにぃ！？",
   "en": "",
   "box": "17x3",
   "face": 48
  }
 ]
}
