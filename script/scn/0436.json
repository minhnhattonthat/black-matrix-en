 ],
 "strings": [
  {
   "id": "s436:0255e",
   "op": "15",
   "jp": "こっ、\nこりゃ・・すげぇ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s436:0258e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s436:028f2",
   "op": "15",
   "jp": "モーゼ殿、お主！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s436:02916",
   "op": "15",
   "jp": "皆の者、先を急ぐぞ！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s436:0294a",
   "op": "15",
   "jp": "なんで？\nボクはもう少し見ていたいな。",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s436:02992",
   "op": "15",
   "jp": "この術はそれを唱える者から\n大量の生き血を・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s436:029f2",
   "op": "15",
   "jp": "ヨハネ殿",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02a0e",
   "op": "15",
   "jp": "お心遣いは嬉しいが、\nこの段となりてはそのような\nお心遣いはもはや無用に願います。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02a76",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s436:02aa2",
   "op": "15",
   "jp": "それよりみなさんは不審に思って\nいらっしゃるのでしょう。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02aee",
   "op": "15",
   "jp": "私が何故、このような\n知識を有しているのか。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02b2e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s436:02b5a",
   "op": "15",
   "jp": "私は、黒き羽の神官の\n子として産まれながら、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02b9a",
   "op": "15",
   "jp": "白きコウモリの羽を持って\nこの世に生を受けました・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02bf2",
   "op": "15",
   "jp": "黒き羽の血をひく？",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s436:02c26",
   "op": "15",
   "jp": "白きコウモリの羽？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s436:02c5a",
   "op": "15",
   "jp": "そう、普通なら殺されて\nしかるべき所なのですが\n父はその権力を利用して、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02cb6",
   "op": "15",
   "jp": "私の羽を黒く染めて\n自分の後継者に仕立て上げたのです。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02d02",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s436:02d2e",
   "op": "15",
   "jp": "その結果、私は教団でも、\nかなり上の地位に\n就く事ができました。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02d82",
   "op": "15",
   "jp": "そして、そこで手に入れた\nこの邪道騎士の鎧こそ、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02dc6",
   "op": "15",
   "jp": "天界で起こった全ての記憶を留める\n悪魔ルーイソスの遺品！",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02e12",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s436:02ea6",
   "op": "15",
   "jp": "じゃあ、あんたは\n教皇のことも知ってるのか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s436:02ef2",
   "op": "15",
   "jp": "ですが、\n今お教えできるのは、",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02f22",
   "op": "15",
   "jp": "教皇が黒き羽と白き羽の\n心を持ちあわせた・・・",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02f62",
   "op": "15",
   "jp": "若い女性だという事だけです。",
   "en": "",
   "box": "17x3",
   "face": 53
  },
  {
   "id": "s436:02fbe",
   "op": "15",
   "jp": "教皇が・・若い女・・・？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s436:02ff6",
   "op": "15",
   "jp": "教皇が・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s436:0302e",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
