{
 "source": "d1:SCENARIO/362",
 "copies": [
  "d1:SCENARIO/362",
  "d2:SCENARIO/362"
 ],
 "strings": [
  {
   "id": "s362:01106",
   "op": "15",
   "jp": "あ～ら貴方達\nちょっとお待ちになって！",
   "en": ""
  },
  {
   "id": "s362:0113e",
   "op": "15",
   "jp": "貴方達、あのグザファンを\n倒した人達でしょ？",
   "en": ""
  },
  {
   "id": "s362:0118a",
   "op": "15",
   "jp": "なんだあ？",
   "en": ""
  },
  {
   "id": "s362:011b6",
   "op": "15",
   "jp": "お主、どこでそれを？",
   "en": ""
  },
  {
   "id": "s362:011ea",
   "op": "15",
   "jp": "領主のこの私に、この街で\n知らない事なんてありませんわ！",
   "en": ""
  },
  {
   "id": "s362:01242",
   "op": "15",
   "jp": "それで、その色ボケ領主様が\n一体何の用だい？",
   "en": ""
  },
  {
   "id": "s362:0128e",
   "op": "15",
   "jp": "まぁ、\n素敵な誉め言葉！",
   "en": ""
  },
  {
   "id": "s362:012ba",
   "op": "15",
   "jp": "実はグザファンの事なのですが、\n彼は私設軍隊を利用し・・・",
   "en": ""
  },
  {
   "id": "s362:01306",
   "op": "15",
   "jp": "この街を自分だけのものにしようと\n男達を次々と殺していったのです。",
   "en": ""
  },
  {
   "id": "s362:0135e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:0138a",
   "op": "15",
   "jp": "貴方達のおかげで\n彼の脅威も無くなりました。",
   "en": ""
  },
  {
   "id": "s362:013ca",
   "op": "15",
   "jp": "お礼に貴方達には、\nこの街に永久的に住む権利を\n差し上げましょう・・・",
   "en": ""
  },
  {
   "id": "s362:01422",
   "op": "15",
   "jp": "つまり、この街すべての女性から",
   "en": ""
  },
  {
   "id": "s362:01452",
   "op": "15",
   "jp": "溢れるばかりの情欲を捧げられて\n暮らせるのです・・・",
   "en": ""
  },
  {
   "id": "s362:014ae",
   "op": "14",
   "jp": "・・・・？！",
   "en": ""
  },
  {
   "id": "s362:014da",
   "op": "15",
   "jp": "毎日違う女性と、禁断の愛を\n語ってもよろしいんですよ！",
   "en": ""
  },
  {
   "id": "s362:01532",
   "op": "15",
   "jp": "そ・・そんなの愛じゃないわ！",
   "en": ""
  },
  {
   "id": "s362:0157a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:015b2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:015d2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:015fe",
   "op": "15",
   "jp": "禁断だの何だのって、\nあなた達は愛って言葉で\n遊んでいるだけよ！",
   "en": ""
  },
  {
   "id": "s362:01652",
   "op": "15",
   "jp": "ここにいるこの人はねぇ・・・",
   "en": ""
  },
  {
   "id": "s362:01682",
   "op": "15",
   "jp": "その愛を語ったばかりに\n最愛の人を無くしてしまったの・・・",
   "en": ""
  },
  {
   "id": "s362:016ce",
   "op": "15",
   "jp": "彼は傷つき牢獄に入れられ、",
   "en": ""
  },
  {
   "id": "s362:016fa",
   "op": "15",
   "jp": "自らの羽を失っても\nその愛を貫こうとしている・・・",
   "en": ""
  },
  {
   "id": "s362:01766",
   "op": "15",
   "jp": "アナタ達に・・・\n同じ真似が出来る！？",
   "en": ""
  },
  {
   "id": "s362:017ba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:017f2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:01812",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:01856",
   "op": "15",
   "jp": "貴方も・・\n誰かを愛しているんですね。",
   "en": ""
  },
  {
   "id": "s362:018b6",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s362:01926",
   "op": "15",
   "jp": "解っていました。",
   "en": ""
  },
  {
   "id": "s362:0194a",
   "op": "15",
   "jp": "私たちの愛が\n大邪神の伝説で語られる・・・",
   "en": ""
  },
  {
   "id": "s362:01986",
   "op": "15",
   "jp": "本当の愛ではないってことを。",
   "en": ""
  },
  {
   "id": "s362:019b6",
   "op": "15",
   "jp": "でも仕方がなかったんです。",
   "en": ""
  },
  {
   "id": "s362:019e2",
   "op": "15",
   "jp": "この街を守る為には、外の世界に\n出ていく男達を引き留める、\n繋がりが必要だったんです・・・",
   "en": ""
  },
  {
   "id": "s362:01a4e",
   "op": "15",
   "jp": "貴方達を引き留めるため、\n罪を承知で愛という言葉を\n使いました。",
   "en": ""
  },
  {
   "id": "s362:01aba",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s362:01ae6",
   "op": "15",
   "jp": "ふむ、愛を語ることが罪と承知で、\n尚それを行うとは、",
   "en": ""
  },
  {
   "id": "s362:01b2e",
   "op": "15",
   "jp": "それだけ欲と情が深いという事か。",
   "en": ""
  },
  {
   "id": "s362:01b6e",
   "op": "15",
   "jp": "せめてお礼として、",
   "en": ""
  },
  {
   "id": "s362:01b92",
   "op": "15",
   "jp": "あなた方が捜しているものの\n手がかりを贈らせて下さい・・・",
   "en": ""
  },
  {
   "id": "s362:01bee",
   "op": "15",
   "jp": "何、\nそれはまさか？",
   "en": ""
  },
  {
   "id": "s362:01c22",
   "op": "15",
   "jp": "アンゲルス教団の総本山、\nそれは・・・",
   "en": ""
  },
  {
   "id": "s362:01c5a",
   "op": "15",
   "jp": "ソドムとゴモラの街の向こう、\n悪魔の海峡辺りだと\n伝えられています・・・",
   "en": ""
  },
  {
   "id": "s362:01d32",
   "op": "15",
   "jp": "みんな、まさかまたこんな話を\n鵜呑みにするんじゃねぇだろうな。",
   "en": ""
  },
  {
   "id": "s362:01d86",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s362:01da2",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s362:01dca",
   "op": "1d",
   "jp": "ご主人様の居場所！",
   "en": "",
   "max": 15
  },
  {
   "id": "s362:01de4",
   "op": "1d",
   "jp": "最後の鎧の場所！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s362:01e00",
   "op": "1d",
   "jp": "仲間が欲しい！！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s362:01eaa",
   "op": "15",
   "jp": "そんなお方は・・\n私、知りませんわ！",
   "en": ""
  },
  {
   "id": "s362:01f66",
   "op": "15",
   "jp": "鎧は鎧を呼ぶという\n言い伝え通りなら、",
   "en": ""
  },
  {
   "id": "s362:01f9e",
   "op": "15",
   "jp": "いずれ、\nあなた方の元にあらわれるでしょう。",
   "en": ""
  },
  {
   "id": "s362:02086",
   "op": "15",
   "jp": "そうですねタルシス、\nどうですか・・・",
   "en": ""
  },
  {
   "id": "s362:020ce",
   "op": "15",
   "jp": "はい、\nわたくしでよろしければ・・・",
   "en": ""
  },
  {
   "id": "s362:02138",
   "op": "14",
   "jp": "タルシスが仲間になった！！",
   "en": ""
  },
  {
   "id": "s362:02192",
   "op": "15",
   "jp": "じゃあな、\nすべてが終わったらこの街に\nやってくるかもしれないぜ！",
   "en": ""
  },
  {
   "id": "s362:021f6",
   "op": "15",
   "jp": "ボクも、また\n来てもいい・・・！？",
   "en": ""
  },
  {
   "id": "s362:0223a",
   "op": "15",
   "jp": "喜んでお待ちしますわ！",
   "en": ""
  },
  {
   "id": "s362:02272",
   "op": "15",
   "jp": "どっかで強そうな奴らがいたら、\nここの事を紹介しといてやるよ。",
   "en": ""
  },
  {
   "id": "s362:022d2",
   "op": "15",
   "jp": "ええ、\n有り難う御座います。",
   "en": ""
  },
  {
   "id": "s362:02482",
   "op": "15",
   "jp": "ところでお嬢さん、",
   "en": ""
  },
  {
   "id": "s362:024a6",
   "op": "15",
   "jp": "貴方本当に、その相手に対して\n欲情しているだけじゃないって\n言い切れる・・・？クスッ。",
   "en": ""
  },
  {
   "id": "s362:02532",
   "op": "15",
   "jp": "では、\nいくかのうルピルピ。",
   "en": ""
  },
  {
   "id": "s362:025ca",
   "op": "15",
   "jp": "あ、は・はい！！",
   "en": ""
  },
  {
   "id": "s362:02606",
   "op": "15",
   "jp": "そんなこと言われたって・・・ねぇ！",
   "en": ""
  }
 ]
}
