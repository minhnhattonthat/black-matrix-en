{
 "source": "d1:SCENARIO/209",
 "copies": [
  "d1:SCENARIO/209",
  "d2:SCENARIO/209"
 ],
 "strings": [
  {
   "id": "s209:00642",
   "op": "14",
   "jp": "くそっ！今日もおけらだ！\nあんな奴にかけるんじゃ\nなかったぜ！！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:0068c",
   "op": "14",
   "jp": "！\nお前ら強そうだな！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:006e6",
   "op": "14",
   "jp": "そこの栗毛のアンタ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00702",
   "op": "14",
   "jp": "アンタはなかなかスタミナが\nありそうな、いい筋肉を\nしているぜ・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:0074e",
   "op": "14",
   "jp": "へへっ・・・どうだい！\n俺と一緒に剣闘を\nやってみる気はねえか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00798",
   "op": "14",
   "jp": "なんならいい奴を紹介するぜ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:007ca",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00816",
   "op": "14",
   "jp": "強そうな剣闘士を見分けるコツは、\nまずは筋肉の張りを見分けること！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00860",
   "op": "14",
   "jp": "そして、コズミと呼ばれる筋肉痛や\n震え、発汗やふらつきが無いか\nどうかを調べるのが筋ってもんだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00902",
   "op": "14",
   "jp": "おい・・・\nアンタまさか・・・！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:0092c",
   "op": "14",
   "jp": "数年前に引退した\n伝説の七冠人・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00966",
   "op": "14",
   "jp": "うるせえ！\n関係ねえからあっちいってろ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:009a2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s209:009ee",
   "op": "14",
   "jp": "なんだって！？\nこの街の領主はどこかだって・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00a26",
   "op": "14",
   "jp": "そんなの剣闘士のオーナー達が集まるＶＩＰルームに決まってるだろ！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00aaa",
   "op": "14",
   "jp": "アンタ随分ボロボロの身なりをして\nいるなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00ae2",
   "op": "14",
   "jp": "だからってボロをボロボロ\nこぼしたりはしないでくれよ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00b32",
   "op": "14",
   "jp": "・・・？？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s209:00b7e",
   "op": "14",
   "jp": "なんだ・・・！？\n次の試合の予想が聞きたいんなら\nこの、週刊剣闘士新聞を買え！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00bd6",
   "op": "14",
   "jp": "直接コーチを受けたいんだったら、\nそうだなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00c10",
   "op": "14",
   "jp": "当たった賞金の１０割増しでなら\n教えてやるよ・・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00c5a",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s209:00cb6",
   "op": "14",
   "jp": "あら、いらっしゃい！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00cd2",
   "op": "14",
   "jp": "なあに！？どの剣闘士の券を\n買うつもりなの・・・！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00d1a",
   "op": "14",
   "jp": "やめておけ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00d30",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00d42",
   "op": "14",
   "jp": "この博打にイカサマはねえが、\nその変わり、物凄い額のテラ銭が\n加えられているんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00dae",
   "op": "14",
   "jp": "テラ銭！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s209:00dce",
   "op": "14",
   "jp": "ああ、博打の配当から差し引かれる\n場所代のようなもんさ・・・！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00e14",
   "op": "14",
   "jp": "つまりは勝っても負けても・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00e3a",
   "op": "14",
   "jp": "最終的には客が儲からないように\n出来ていやがるのさ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s209:00e86",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s209:00e98",
   "op": "14",
   "jp": "（やって、みたかったな・・・）",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s209:00f12",
   "op": "14",
   "jp": "へへへっ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00f56",
   "op": "14",
   "jp": "いらっしゃい！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:00fb2",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:0104a",
   "op": "14",
   "jp": "なんだなんだキサマ達は・・・\nこれより先はＶＩＰルームや、\n選手の控室に繋がっている為、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:010aa",
   "op": "14",
   "jp": "武装した者達は通せない事に\nなっている・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:010de",
   "op": "14",
   "jp": "それとも次の試合の・・・\n出場選手団かなにかなのか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:01136",
   "op": "1d",
   "jp": "そうだ、出場選手だ！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s209:01154",
   "op": "1d",
   "jp": "そんなんじゃない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s209:01186",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:01198",
   "op": "14",
   "jp": "くっくっくっ馬鹿な奴らめ・・・\nそれなら通ってもいいぞ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s209:01212",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  }
 ]
}
