{
 "source": "d1:SCENARIO/402",
 "copies": [
  "d1:SCENARIO/402",
  "d2:SCENARIO/402"
 ],
 "strings": [
  {
   "id": "s402:00d3a",
   "op": "15",
   "jp": "何だぁ！？この大海原の何処に\n総本山があるってんだ！",
   "en": ""
  },
  {
   "id": "s402:00d9e",
   "op": "15",
   "jp": "組織の人たちが調べた地図に\nよると、確かにこの辺で\nいいはずなんですが！？",
   "en": ""
  },
  {
   "id": "s402:00e1a",
   "op": "15",
   "jp": "えーっ！ここまで来て\nどうしようもないなんて・・・",
   "en": ""
  },
  {
   "id": "s402:00fce",
   "op": "15",
   "jp": "ななな・・ななな・・な・な、\nな・・・・何が揺れてるの！？",
   "en": ""
  },
  {
   "id": "s402:0102a",
   "op": "15",
   "jp": "気を付けろ、\n落ちたら終わりだぞ！",
   "en": ""
  },
  {
   "id": "s402:010a6",
   "op": "15",
   "jp": "ふぅ、すげえ揺れだったな。\nあんなでかい地震初めてだぜ",
   "en": ""
  },
  {
   "id": "s402:0129a",
   "op": "15",
   "jp": "み、見て下さい！！",
   "en": ""
  },
  {
   "id": "s402:012de",
   "op": "15",
   "jp": "ソドムとゴモラの街を、\n業火が覆い尽くしています！！",
   "en": ""
  },
  {
   "id": "s402:0136a",
   "op": "15",
   "jp": "こっちもだ！！",
   "en": ""
  },
  {
   "id": "s402:013aa",
   "op": "15",
   "jp": "俺達がたどった街にまで、\n無数の火の手が上がってるぜ！",
   "en": ""
  },
  {
   "id": "s402:01412",
   "op": "15",
   "jp": "地震なんて滅多に起こらないのに、\n日記に書いておかなきゃ！",
   "en": ""
  },
  {
   "id": "s402:01492",
   "op": "15",
   "jp": "確かに、この規模の地震は、\nこれまでに例のないものじゃ！",
   "en": ""
  },
  {
   "id": "s402:0152a",
   "op": "14",
   "jp": "？！",
   "en": ""
  },
  {
   "id": "s402:01542",
   "op": "15",
   "jp": "貴様なに者だ！？",
   "en": ""
  },
  {
   "id": "s402:018f6",
   "op": "15",
   "jp": "この大地震こそ、\nまさに破滅への序曲！！",
   "en": ""
  },
  {
   "id": "s402:01932",
   "op": "15",
   "jp": "今まさに！\n万物が流転しようとしているのだ！！",
   "en": ""
  }
 ]
}
