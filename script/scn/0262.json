 "strings": [
  {
   "id": "s262:0067e",
   "op": "14",
   "jp": "なんだお前らは・・・！？\nなにか聞きたいんなら\n金をよこしな！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00702",
   "op": "14",
   "jp": "この街では、何をするにも\n山ほどお金が必要で、\nもう私達は暮らしていけません！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00792",
   "op": "14",
   "jp": "ここはパンデモニウムの街だ！\n教えてやったんだから\n金をおくれよ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:0081a",
   "op": "14",
   "jp": "忙しいんだから話しかけるなよ。\nそれとも頼み事かい、\nなら安くしとくぜ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:008a6",
   "op": "14",
   "jp": "うちの品物はなんでも高いよぉ！！\nさあ、買った買った！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:008e4",
   "op": "14",
   "jp": "安く買って、\n高く売るのが商売ってモンだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00916",
   "op": "14",
   "jp": "金さえ払えば、\n白い羽にだって売ってやるよ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00992",
   "op": "14",
   "jp": "・・・・・？",
   "en": "...?",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:009a6",
   "op": "14",
   "jp": "うちの品物は安いよ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:009c4",
   "op": "14",
   "jp": "売り切れたけどね・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00a1e",
   "op": "14",
   "jp": "なんだなんだお前達は・・・！？\nあっ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00a4c",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00a60",
   "op": "14",
   "jp": "・・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00a74",
   "op": "14",
   "jp": "うちに泊まっていく気なのか？\n宿泊費は・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00aa8",
   "op": "14",
   "jp": "有り金全部だ・・・・！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00b02",
   "op": "14",
   "jp": "この街じゃ銭が全てなのさ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00b24",
   "op": "14",
   "jp": "どんなに強い奴でも\nお金がなけりゃ、\nこの街ではやっていけないよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00b6e",
   "op": "14",
   "jp": "昔は俺達も\n暮らしやすかったんだけど、\n新しい領主になってからは、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00bb8",
   "op": "14",
   "jp": "そりゃあひどいもんさ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00c12",
   "op": "14",
   "jp": "あぁ～忙しい・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00c66",
   "op": "14",
   "jp": "街の真ん中に、宮殿みたいな\n豪邸があるだろう・・・！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00ca4",
   "op": "14",
   "jp": "あれが新領主マモン様の\nお屋敷さ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00cd0",
   "op": "14",
   "jp": "マモン様はその金の力で、\n大勢の戦士を雇っているようだ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s262:00d10",
   "op": "14",
   "jp": "お前さん達ならもしかすると\n高給で雇って貰える\nかもしれないぜ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
