{
 "source": "d1:SCENARIO/289",
 "copies": [
  "d1:SCENARIO/289",
  "d2:SCENARIO/289"
 ],
 "strings": [
  {
   "id": "s289:0073e",
   "op": "14",
   "jp": "うぉーっ！腹が減ったぁっ！\nなにか喰わせろぉぉおおっ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:007ba",
   "op": "14",
   "jp": "この街はいいところだよぉ。\n何より、食い物がうまい！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00832",
   "op": "14",
   "jp": "この街の支配者は、\nバアル様だぁ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:0085e",
   "op": "14",
   "jp": "とっても邪悪な気のいい紳士で、\nおらも食事に招待された事が\nあるんだぁ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:008ae",
   "op": "14",
   "jp": "ヨロイ！？\n知らないなぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:008d4",
   "op": "14",
   "jp": "トリュフなら知ってるけど\n食い物じゃないよねぇ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:0090c",
   "op": "14",
   "jp": "なに？黒い羽の女性\nその辺探せば\n沢山いるだろう？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00982",
   "op": "14",
   "jp": "この街では、ほとんど白い羽の\n奴隷を見かけないだろぉう！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:009c4",
   "op": "14",
   "jp": "この街の奴等は、\n金が無くなると自分達の奴隷を\nバアル様に差し出して、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00a12",
   "op": "14",
   "jp": "その代わりに食い物を\n手に入れているのさ・・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00a4a",
   "op": "14",
   "jp": "でも俺には金も差し出す奴隷も\nもういないから\n食い物がもらえないんだぁ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00ad6",
   "op": "14",
   "jp": "白すぎだぞ・・・！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00b2a",
   "op": "14",
   "jp": "わんわん",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00b76",
   "op": "14",
   "jp": "シッシッ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00b8a",
   "op": "14",
   "jp": "ここはお前達のような\n奴隷が入れる場所じゃない！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00bfe",
   "op": "14",
   "jp": "はい、この街の黒き羽の人たちは、\n働かないどころか\nほとんど動こうともしません！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00c56",
   "op": "14",
   "jp": "ですから、街の人の食べ物は、\n毎日私が出前をしているんです！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00c9a",
   "op": "14",
   "jp": "ちなみに、私以外の白い羽の\n人達は、バアル様のお屋敷で\n働いているらしいのですが、",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00cf4",
   "op": "14",
   "jp": "何をしているのか\n誰にも解らないんです。",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00d24",
   "op": "14",
   "jp": "だって、屋敷から帰ってきた\n人達は、誰一人いないから！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00d62",
   "op": "14",
   "jp": "だけど、バアル様は邪悪な人ですよ！私達にも優しい言葉を\nかけてくださいますし・・・",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00dbc",
   "op": "14",
   "jp": "食料は一週間ごとに\nバアル様の所から、\n届けられてくるんです！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00e26",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s289:00e46",
   "op": "14",
   "jp": "またいらしてくださいね！",
   "en": "",
   "box": "17x3",
   "face": 22
  },
  {
   "id": "s289:00e8a",
   "op": "14",
   "jp": "オ・・・オラにも一口・・・",
   "en": "",
   "box": "17x3",
   "face": 110
  },
  {
   "id": "s289:00ef6",
   "op": "14",
   "jp": "なんだい客かい！？珍しいねぇ、\nわざわざ歩いて来るなんてぇ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00f50",
   "op": "14",
   "jp": "ハッ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00f60",
   "op": "14",
   "jp": "さては、その眼付き\nアンタかなりの食通と見た！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00f96",
   "op": "14",
   "jp": "この街の喰いもんはぁ、\n抜群にうまいぜぇ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:00fca",
   "op": "14",
   "jp": "何ならココでぇ\n味見をしていくかい？！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01012",
   "op": "1d",
   "jp": "味見する！？",
   "en": "",
   "max": 15
  },
  {
   "id": "s289:01028",
   "op": "1d",
   "jp": "味見しない！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s289:01062",
   "op": "14",
   "jp": "こっこれは！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:01078",
   "op": "14",
   "jp": "まったりとして、サッパリとして、\nそれでいて、少しも味がくどく\nないばかりか、",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:010ce",
   "op": "14",
   "jp": "ハンナリとして、\nもちもちっとした食感が、\n口の中全体に広がったかと思うと、",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:01122",
   "op": "14",
   "jp": "淡雪のような強烈な清涼感が舌の\n上全体に広がり、甘くて豊潤な\n肉の旨味だけが後味として・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:01186",
   "op": "14",
   "jp": "とにかく抜群にうまかった！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:011b6",
   "op": "14",
   "jp": "料理のおかわりを頼みますか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:011f6",
   "op": "1d",
   "jp": "おかわりする！",
   "en": "",
   "max": 15
  },
  {
   "id": "s289:0120c",
   "op": "1d",
   "jp": "遠慮する！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s289:01232",
   "op": "14",
   "jp": "こっこれは！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:01248",
   "op": "14",
   "jp": "先ほど食べたばかりだというのに、\nシャキッとした深みのある、香りの\n五重奏が一瞬鼻先にたなびいて、",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:012b2",
   "op": "14",
   "jp": "その食欲を一気に極限まで高めたかと思うと、そのぷりぷりっとした\n濃厚で上品な食感がふっくらとした",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:0131a",
   "op": "14",
   "jp": "肉の味と引き合い、むしろその味に\nドッシリとした土台を与えて、\n妙に人の心を惹き付けたかと思うと、",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:01384",
   "op": "14",
   "jp": "ズバーンとした、その得も言われぬ\n鮮烈な香ばしさが両方の旨味を増大\nさせて、なんとも瑞々しい・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:013ec",
   "op": "14",
   "jp": "とにかく滅茶苦茶うまかった！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s289:01422",
   "op": "14",
   "jp": "ふん！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01430",
   "op": "14",
   "jp": "目の前にある料理の味見もせず、\n実際に食べてみもしないうちから、\n物知り顔で帰ろうだなんて、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01494",
   "op": "14",
   "jp": "しょせん食通ぶってはいても\nたんなる貧乏人か！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:014f2",
   "op": "14",
   "jp": "おっと、食べた分の金は\nちゃんとおいて行けよぉ～！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01544",
   "op": "14",
   "jp": "まいどぉおぉおぉーっ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01580",
   "op": "14",
   "jp": "キ、キサマー！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:015e2",
   "op": "14",
   "jp": "いらっしゃい！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:015f8",
   "op": "14",
   "jp": "この店の食料は、\n他の街から仕入れてきた、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:0162a",
   "op": "14",
   "jp": "保存に適した品揃えばかりだよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01650",
   "op": "14",
   "jp": "うちの品物は味よりも、\n長持ちする質にこだわってるんだ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01692",
   "op": "14",
   "jp": "しこたま金を稼いで、\nバアル様印の\n美味しい物を食べるのさ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:016d6",
   "op": "14",
   "jp": "さあ、\n何を買うんだい！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01722",
   "op": "14",
   "jp": "まだ買うかい？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01772",
   "op": "14",
   "jp": "キサマ等！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01784",
   "op": "14",
   "jp": "ウチの組のなわばりに\nなんのようだ！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s289:01866",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s289:01874",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s289:01884",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  }
 ]
}
