{
 "source": "d1:SCENARIO/316",
 "copies": [
  "d1:SCENARIO/316",
  "d2:SCENARIO/316"
 ],
 "strings": [
  {
   "id": "s316:0129e",
   "op": "15",
   "jp": "私のお昼休みの間に、\nこの屋敷の中で充分に遊んで\n頂けたようですねぇ～！",
   "en": ""
  },
  {
   "id": "s316:012fa",
   "op": "15",
   "jp": "気に入って頂けましたかな！？",
   "en": ""
  },
  {
   "id": "s316:01366",
   "op": "15",
   "jp": "バカ言ってるんじゃねぇ！",
   "en": ""
  },
  {
   "id": "s316:01392",
   "op": "15",
   "jp": "っていうか、\nだいたいお前は誰なん・・だって、",
   "en": ""
  },
  {
   "id": "s316:013d2",
   "op": "15",
   "jp": "おい！\nお前まさか・・・",
   "en": ""
  },
  {
   "id": "s316:014ba",
   "op": "15",
   "jp": "バアルの野郎かっ！！",
   "en": ""
  },
  {
   "id": "s316:014e2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s316:015be",
   "op": "15",
   "jp": "さては・・貴様っ！！",
   "en": ""
  },
  {
   "id": "s316:015e6",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s316:016ea",
   "op": "15",
   "jp": "もう逃げられんぞ！！",
   "en": ""
  },
  {
   "id": "s316:01726",
   "op": "15",
   "jp": "おとなしく大邪神の鎧を渡し\n連れ去られた、娘の居場所を\n教えるんじゃ！",
   "en": ""
  },
  {
   "id": "s316:01786",
   "op": "15",
   "jp": "おとなしく大邪神の鎧を渡し\n連れ去られた、居場所を\n教えるんじゃ！",
   "en": ""
  },
  {
   "id": "s316:017ea",
   "op": "15",
   "jp": "いいでしょう！",
   "en": ""
  },
  {
   "id": "s316:0180a",
   "op": "15",
   "jp": "お腹がいっぱいになった\nいまの私を倒すことが\nできるのならばねぇ・・・！",
   "en": ""
  },
  {
   "id": "s316:01866",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s316:0188a",
   "op": "15",
   "jp": "ただし、彼女らが先に\n自らの意志であなた達と\n戦いたいんだそうです！！",
   "en": ""
  },
  {
   "id": "s316:018f2",
   "op": "15",
   "jp": "さあ、やってしまうのです！",
   "en": ""
  },
  {
   "id": "s316:0192e",
   "op": "15",
   "jp": "許してください、\n貴方達を殺さないと、\n私たちの家族が・・・",
   "en": ""
  },
  {
   "id": "s316:0197e",
   "op": "15",
   "jp": "バアルは私たちの大事な家族を\n人質にとっているんです！！",
   "en": ""
  },
  {
   "id": "s316:019d6",
   "op": "15",
   "jp": "私はまだ死にたくないの・・・",
   "en": ""
  },
  {
   "id": "s316:01a12",
   "op": "15",
   "jp": "バアル様に逆らったら\nこの街では生きていけないの！",
   "en": ""
  },
  {
   "id": "s316:01c96",
   "op": "15",
   "jp": "私の、私の息子がぁ！",
   "en": ""
  },
  {
   "id": "s316:01e3a",
   "op": "15",
   "jp": "何故、何故抵抗しないの！？",
   "en": ""
  },
  {
   "id": "s316:01e76",
   "op": "15",
   "jp": "自分の大切な者のために、",
   "en": ""
  },
  {
   "id": "s316:01ea2",
   "op": "15",
   "jp": "命を投げ出そうとする\nお前達の気持ちが\n俺には痛いほど分かるからさ！",
   "en": ""
  },
  {
   "id": "s316:01efa",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s316:01f22",
   "op": "15",
   "jp": "だからこそ、俺はお前達を！！",
   "en": ""
  },
  {
   "id": "s316:01f5e",
   "op": "15",
   "jp": "でも、\nそれじゃアナタが！！",
   "en": ""
  },
  {
   "id": "s316:01f9a",
   "op": "15",
   "jp": "そうだぜ、こんなところで\n無駄死にする必要なんか無い！！",
   "en": ""
  },
  {
   "id": "s316:0216a",
   "op": "15",
   "jp": "みんな、やめろぉーっ！！",
   "en": ""
  },
  {
   "id": "s316:021ba",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s316:021e2",
   "op": "15",
   "jp": "お願いだ\n彼女達を殺さないでやってくれ！",
   "en": ""
  },
  {
   "id": "s316:0221e",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s316:02246",
   "op": "15",
   "jp": "こいつは確かに俺自身の\n偽善って奴かもしれないが、",
   "en": ""
  },
  {
   "id": "s316:0228a",
   "op": "15",
   "jp": "俺はこいつらを\nどうしても助けてやりたいんだ！",
   "en": ""
  },
  {
   "id": "s316:0237a",
   "op": "15",
   "jp": "くっくっくっくっ・・・",
   "en": ""
  },
  {
   "id": "s316:023ca",
   "op": "15",
   "jp": "これだから邪神の力などを\n信じる邪教徒どもは・・・\n馬鹿だと言うんです！！",
   "en": ""
  },
  {
   "id": "s316:02426",
   "op": "15",
   "jp": "正義がどうとか、\n平等がどうしたとか。",
   "en": ""
  },
  {
   "id": "s316:0245e",
   "op": "15",
   "jp": "初めから、この世の何処にも\nありはしないものを信じ込み、",
   "en": ""
  },
  {
   "id": "s316:024aa",
   "op": "15",
   "jp": "自分の命を投げ出してまで\nくだらん奴隷を助けようとする！",
   "en": ""
  },
  {
   "id": "s316:024f6",
   "op": "15",
   "jp": "すでに、その相手が\n自らの意志など\n持ち合わせてはおらんと言うのに。",
   "en": ""
  },
  {
   "id": "s316:0255a",
   "op": "15",
   "jp": "なにっ！！",
   "en": ""
  },
  {
   "id": "s316:02622",
   "op": "15",
   "jp": "美しき恐怖をともない、",
   "en": ""
  },
  {
   "id": "s316:0264a",
   "op": "15",
   "jp": "冥界の血河を渡りて、",
   "en": ""
  },
  {
   "id": "s316:02672",
   "op": "15",
   "jp": "大神サタンに捧げし\n暗黒のその命、",
   "en": ""
  },
  {
   "id": "s316:026a6",
   "op": "15",
   "jp": "真紅の死者となりて今こそ、\nその黄泉の力を示せ！！",
   "en": ""
  },
  {
   "id": "s316:028f2",
   "op": "15",
   "jp": "ぎゃあぁぁあぁぁぁぁぁぁっ！",
   "en": ""
  },
  {
   "id": "s316:0292e",
   "op": "15",
   "jp": "我に\n逆らう者達に死を！！",
   "en": ""
  },
  {
   "id": "s316:0295a",
   "op": "15",
   "jp": "ハアッハッハッハッハッ！！",
   "en": ""
  },
  {
   "id": "s316:02996",
   "op": "15",
   "jp": "やはりアヤツ等も\nすでに吸血鬼化しておったか！",
   "en": ""
  },
  {
   "id": "s316:029e6",
   "op": "15",
   "jp": "どうすりゃいいんだ！？\nあいつら、無差別に\n攻撃しようとしてくるぜ！？",
   "en": ""
  },
  {
   "id": "s316:02a4e",
   "op": "15",
   "jp": "彼女らはもう元には戻れん！\n殺してやる事だけが、\n唯一の救いの道なのじゃ！！",
   "en": ""
  },
  {
   "id": "s316:02b02",
   "op": "15",
   "jp": "ダメだ。",
   "en": ""
  },
  {
   "id": "s316:02b2a",
   "op": "15",
   "jp": "本当はバアルを倒してしまうのが\n一番手っ取り早いんじゃが・・・",
   "en": ""
  },
  {
   "id": "s316:02b8a",
   "op": "15",
   "jp": "彼女らを倒さない限り\nあいつに攻撃できそうもないわ。",
   "en": ""
  },
  {
   "id": "s316:02c4a",
   "op": "15",
   "jp": "ダメだ",
   "en": ""
  },
  {
   "id": "s316:02c72",
   "op": "15",
   "jp": "しかたねぇ、やるぜ！",
   "en": ""
  },
  {
   "id": "s316:02ca6",
   "op": "15",
   "jp": "ダメだぁぁぁぁぁっ！！",
   "en": ""
  },
  {
   "id": "s316:02f0a",
   "op": "15",
   "jp": "なっ！？",
   "en": ""
  },
  {
   "id": "s316:02f32",
   "op": "15",
   "jp": "バカ野郎！\n何をする気だ！！",
   "en": ""
  },
  {
   "id": "s316:02f6e",
   "op": "15",
   "jp": "おおっ！！",
   "en": ""
  },
  {
   "id": "s316:02f9a",
   "op": "15",
   "jp": "あやつにも・・・\n邪神の光が・・・！？",
   "en": ""
  },
  {
   "id": "s316:02fe2",
   "op": "15",
   "jp": "俺にも、この鎧を・・・\n着る資格がある、というのか！？",
   "en": ""
  },
  {
   "id": "s316:0302a",
   "op": "15",
   "jp": "彼女達を救う・・力・・・",
   "en": ""
  },
  {
   "id": "s316:03056",
   "op": "15",
   "jp": "それを与えてくれると\nいうのならば・・・",
   "en": ""
  },
  {
   "id": "s316:030b6",
   "op": "15",
   "jp": "ならば・・・着よう・・・",
   "en": ""
  },
  {
   "id": "s316:030e2",
   "op": "15",
   "jp": "たとえこの身が・・・\n朽ち果てようとも！",
   "en": ""
  },
  {
   "id": "s316:032c6",
   "op": "15",
   "jp": "奇跡じゃ・・・",
   "en": ""
  },
  {
   "id": "s316:032f6",
   "op": "15",
   "jp": "バッ、バカなっ！！\n認めん、断じて認めるものかっ！",
   "en": ""
  },
  {
   "id": "s316:03382",
   "op": "15",
   "jp": "正義などというおためごかしを、\nその心の内に秘めておる人間など、\n絶対にいてはならんのだ！！",
   "en": ""
  },
  {
   "id": "s316:033f2",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s316:0341a",
   "op": "15",
   "jp": "出て来いっ！！",
   "en": ""
  },
  {
   "id": "s316:0343a",
   "op": "15",
   "jp": "あ奴等を、一人残らず\nブチ殺すのだぁーっ！！",
   "en": ""
  }
 ]
}
