{
 "source": "d1:SCENARIO/69",
 "copies": [
  "d1:SCENARIO/69",
  "d2:SCENARIO/69"
 ],
 "strings": [
  {
   "id": "s69:00282",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s69:0039e",
   "op": "15",
   "jp": "最近は顔色もいいし\n食欲もばっちりじゃないか！",
   "en": ""
  },
  {
   "id": "s69:003de",
   "op": "15",
   "jp": "すっかり元気になったな。",
   "en": ""
  },
  {
   "id": "s69:0040a",
   "op": "15",
   "jp": "いつかは言い出すんじゃ\nないかと・・・",
   "en": ""
  },
  {
   "id": "s69:00442",
   "op": "15",
   "jp": "そうは、思ってはいたんだが・・・",
   "en": ""
  },
  {
   "id": "s69:00476",
   "op": "15",
   "jp": "やっぱり・・・\nそろそろ外へ出たいか？",
   "en": ""
  },
  {
   "id": "s69:004be",
   "op": "15",
   "jp": "（そうだ・・・）",
   "en": ""
  },
  {
   "id": "s69:004e2",
   "op": "15",
   "jp": "（オマエを縛ることなんて\n　誰にもできないんだ・・・）",
   "en": ""
  },
  {
   "id": "s69:0052a",
   "op": "15",
   "jp": "（外に出るのだってオマエの自由）",
   "en": ""
  },
  {
   "id": "s69:0055e",
   "op": "15",
   "jp": "（だけど・・・）",
   "en": ""
  },
  {
   "id": "s69:00582",
   "op": "15",
   "jp": "（オレの気持ちは・・・！？）",
   "en": ""
  },
  {
   "id": "s69:005a6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s69:005d2",
   "op": "15",
   "jp": "本当に外に出たいのか・・・？",
   "en": ""
  },
  {
   "id": "s69:0060e",
   "op": "1d",
   "jp": "外へ出たい！",
   "en": "",
   "max": 15
  },
  {
   "id": "s69:00624",
   "op": "1d",
   "jp": "外へ出たくない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s69:0065a",
   "op": "15",
   "jp": "そうだな、オマエが記憶を早く\n取り戻すためにも・・・",
   "en": ""
  },
  {
   "id": "s69:006a2",
   "op": "15",
   "jp": "それに・・・\nオマエはオレのカゴの鳥なんかじゃ、無いもんな・・・！",
   "en": ""
  },
  {
   "id": "s69:006fa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s69:00726",
   "op": "15",
   "jp": "だが外に出るなら・・・\nこれだけは覚えておいてくれ！",
   "en": ""
  },
  {
   "id": "s69:0076e",
   "op": "15",
   "jp": "街にはいろんな連中が居るけど、\n羽の色が黒い人間には\n乱暴な奴等が多いから・・・",
   "en": ""
  },
  {
   "id": "s69:007d2",
   "op": "15",
   "jp": "くれぐれも気を付けろよ！",
   "en": ""
  },
  {
   "id": "s69:007fe",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s69:0082a",
   "op": "15",
   "jp": "それからこのネックレスは\nお守りだと思って・・・\nかならず身に着けておいてくれ！",
   "en": ""
  },
  {
   "id": "s69:008b6",
   "op": "15",
   "jp": "そうだな・・・\nまだ早いよな！",
   "en": ""
  },
  {
   "id": "s69:008ea",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s69:0090a",
   "op": "15",
   "jp": "なんだかこのまま・・・\nオマエと別れ別れになりそうな\n気がして・・・",
   "en": ""
  },
  {
   "id": "s69:00962",
   "op": "15",
   "jp": "なんか心配だったんだ・・・！",
   "en": ""
  },
  {
   "id": "s69:00992",
   "op": "15",
   "jp": "でも、もしも・・・\nもしも外に出たくなったら・・・！",
   "en": ""
  },
  {
   "id": "s69:009e6",
   "op": "15",
   "jp": "そ・・・そうだな！",
   "en": ""
  },
  {
   "id": "s69:00a0a",
   "op": "15",
   "jp": "オレにあんまり・・・\n心配させるんじゃねえぞ！！",
   "en": ""
  }
 ]
}
