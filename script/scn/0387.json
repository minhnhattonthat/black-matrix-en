{
 "source": "d1:SCENARIO/387",
 "copies": [
  "d1:SCENARIO/387",
  "d2:SCENARIO/387"
 ],
 "strings": [
  {
   "id": "s387:00f02",
   "op": "15",
   "jp": "この街の連中の話し方は、\nなんか煮えきらねえなぁ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:00f56",
   "op": "15",
   "jp": "確かにここの住人には、\n生きていると言う\n活力が感じられませんわ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s387:00fde",
   "op": "15",
   "jp": "そんなことないよ！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s387:01002",
   "op": "15",
   "jp": "サボってるアイツ等が悪いだけで、\nこの街はいい街だよ！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s387:010be",
   "op": "15",
   "jp": "（おっ・・・！なんてキレイな\n　ねーちゃんなんだ！）",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:016b6",
   "op": "15",
   "jp": "どうしたんです、お嬢さん。\n何を・・泣いているんですか？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:0175a",
   "op": "15",
   "jp": "旅の方・・・ですか？\nいえ、何でも・・ないんです。",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:01812",
   "op": "15",
   "jp": "笑顔に涙は似合いませんよ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:019d2",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:019ee",
   "op": "14",
   "jp": "・・・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s387:01ab2",
   "op": "15",
   "jp": "笑顔に涙が似合うわけ\nねぇだろ。バァ～カ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s387:01b16",
   "op": "15",
   "jp": "やぁ～い！頭の虫が\n耳から飛び出てるぅ～！",
   "en": "",
   "box": "17x3",
   "face": 8
  },
  {
   "id": "s387:01b7a",
   "op": "15",
   "jp": "アンタ・・・\nそれ本当に正気で言ってるの！？",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s387:01c02",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:01cbe",
   "op": "15",
   "jp": "いえ、\n本当に大したことは・・・",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:01d0e",
   "op": "15",
   "jp": "ただ、住んでた家が公園を\n造るために、壊されてしまって・・・",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:01da2",
   "op": "15",
   "jp": "大したことだよ、それは！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:01dde",
   "op": "15",
   "jp": "白き羽だからなのですか？！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s387:01e0a",
   "op": "15",
   "jp": "酷い話ですね。",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s387:01e7e",
   "op": "15",
   "jp": "羽の色は関係ありません、\n街で決まった事なんです。",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:01ed2",
   "op": "15",
   "jp": "街って\n誰の事を言っているの？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s387:01f1e",
   "op": "15",
   "jp": "街・・・つまり・・・",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:01f8e",
   "op": "15",
   "jp": "あなたには可哀想ですが、\nその発言は感心できませんね。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s387:020de",
   "op": "15",
   "jp": "えっ！？ああっ！\n領主のベルフェ様！！",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:02572",
   "op": "15",
   "jp": "あなた一人が我慢するだけで、\n街の人々が快適な空間を\n共有することができるのです！",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s387:025d6",
   "op": "15",
   "jp": "それにあなたには、\n均等な間取りの共同住居が\n一室与えられているはずです。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s387:02686",
   "op": "15",
   "jp": "でも、ここには\n死んだ母さんのお墓や\nたくさんの思い出が・・・！",
   "en": "",
   "box": "17x3",
   "face": 26
  },
  {
   "id": "s387:02716",
   "op": "15",
   "jp": "今のあなたの発言内容には、\n街に対するあきらかな\n不平の意志が見受けられます！",
   "en": "",
   "box": "17x3",
   "face": 49
  },
  {
   "id": "s387:02776",
   "op": "15",
   "jp": "街の戒律に従い、\n我ら不平監察官に\nご同行願いましょう！",
   "en": "",
   "box": "17x3",
   "face": 49
  },
  {
   "id": "s387:02822",
   "op": "15",
   "jp": "おいおい、\nどういうことだよ！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s387:02862",
   "op": "15",
   "jp": "とりあえず、この街の\n領主公邸にお越しください。",
   "en": "",
   "box": "17x3",
   "face": 48
  },
  {
   "id": "s387:028a6",
   "op": "15",
   "jp": "お話はそこで・・・",
   "en": "",
   "box": "17x3",
   "face": 48
  }
 ]
}
