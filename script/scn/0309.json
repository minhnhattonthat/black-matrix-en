 "strings": [
  {
   "id": "s309:00b2e",
   "op": "15",
   "jp": "バアルの野郎、\nどこに隠れていようと\n必ず見つけだしてやる！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s309:00bb2",
   "op": "15",
   "jp": "簡単に言うが、\n何かあてはあんのかよ？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s309:00bfa",
   "op": "15",
   "jp": "あぁ、\nあの屋敷を歩いていた時に\n地下らしき入り口を見た。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s309:00c62",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 12
  },
  {
   "id": "s309:00c9a",
   "op": "14",
   "jp": "・・・・・",
   "en": "...",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s309:00cc6",
   "op": "15",
   "jp": "ふむ、ひょっとすると・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s309:00d4a",
   "op": "15",
   "jp": "大邪神の鎧も、そこに！？",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s309:00d76",
   "op": "15",
   "jp": "しかしお師匠さま、\nそうなると当然ワナも・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s309:00e2e",
   "op": "15",
   "jp": "だろうな！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s309:00e72",
   "op": "15",
   "jp": "怖いんだったら\n別に来なくてもイイんだぜ？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s309:00ed2",
   "op": "15",
   "jp": "なっ？！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s309:00efa",
   "op": "15",
   "jp": "まぁ待て、\nすでにお尋ね者の我々じゃ、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s309:00f32",
   "op": "15",
   "jp": "バラバラになったところで\nあのアンゲルス教団に\n立ち向かって生き残る術はない。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s309:00fa2",
   "op": "15",
   "jp": "力を手に入れねぇと、\n俺達に自由はねぇんだ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s309:00ff2",
   "op": "15",
   "jp": "そう・・・\nそれこそがこの世の\n真理じゃからな！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s309:01066",
   "op": "15",
   "jp": "無駄死には嫌ですわ\nでも・・・",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s309:010be",
   "op": "15",
   "jp": "危険な賭をしなければ、\n生き残ることも出来ない。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s309:01132",
   "op": "15",
   "jp": "僕たちの旅はそういう旅なんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s309:0116a",
   "op": "14",
   "jp": "・・・・・",
