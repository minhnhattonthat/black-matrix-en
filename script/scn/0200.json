 "strings": [
  {
   "id": "s200:000c2",
   "op": "15",
   "jp": "創世記戦争と呼ばれる神々達の戦いで\n死んだはずの七人の大邪神達・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:0011a",
   "op": "15",
   "jp": "その屍となった魂は、朽ち果てた今も\n鎧の中に宿り続け・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:00166",
   "op": "15",
   "jp": "それを手にした者達に、神自身の力をも\n与えると伝えられている・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:00236",
   "op": "15",
   "jp": "自らの信じる欲望・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:0025e",
   "op": "15",
   "jp": "自由・・・正義・・・平等・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:0028e",
   "op": "15",
   "jp": "そして愛・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:002ae",
   "op": "15",
   "jp": "そのいずれもが、目には見えない\n不確かな物だったとしても・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:002fe",
   "op": "15",
   "jp": "人は時として、全てを犠牲に\nそれを望む・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:003ba",
   "op": "15",
   "jp": "たとえそれが・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:003de",
   "op": "15",
   "jp": "絶えず生き血を喰らい・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s200:0040a",
   "op": "15",
   "jp": "着た者の命をも奪う呪われた\n生きた鎧だったとしても・・・",
   "en": "",
   "box": "19x2"
  },
  {
