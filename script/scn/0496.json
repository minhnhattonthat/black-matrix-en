   "box": "19x2"
  },
  {
   "id": "s496:00256",
   "op": "15",
   "jp": "最愛の人の屍だった・・・",
   "en": "",
   "box": "19x2"
  },
  {
   "id": "s496:002c6",
   "op": "15",
   "jp": "７つの美徳",
