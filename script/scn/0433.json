{
 "source": "d1:SCENARIO/433",
 "copies": [
  "d1:SCENARIO/433",
  "d2:SCENARIO/433"
 ],
 "strings": [
  {
   "id": "s433:00b86",
   "op": "15",
   "jp": "どうやら、この方の発作は\nおさまったようですね。",
   "en": ""
  },
  {
   "id": "s433:00bd6",
   "op": "15",
   "jp": "すまぬ、面倒をかけたようじゃ。",
   "en": ""
  },
  {
   "id": "s433:00c16",
   "op": "15",
   "jp": "単刀直入に聞きたいんだが、",
   "en": ""
  },
  {
   "id": "s433:00c42",
   "op": "15",
   "jp": "教団の総本山とやらは、\nいったい何処にあるんだ？",
   "en": ""
  },
  {
   "id": "s433:00c92",
   "op": "15",
   "jp": "バベルの塔のはるか上空、",
   "en": ""
  },
  {
   "id": "s433:00cbe",
   "op": "15",
   "jp": "厚い雲の上を浮遊する\n約束の地、ディアボロスに\n総本山は存在します。",
   "en": ""
  },
  {
   "id": "s433:00d4a",
   "op": "15",
   "jp": "何だってぇ！？",
   "en": ""
  },
  {
   "id": "s433:00d6e",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s433:00de6",
   "op": "15",
   "jp": "どおりで、誰も\n詳しい事を知らないはずだぜ。",
   "en": ""
  },
  {
   "id": "s433:00e32",
   "op": "15",
   "jp": "あの場所へは、教皇の許しが\n無ければ、何人たりとも\n立ち入る事は出来ません。",
   "en": ""
  },
  {
   "id": "s433:00e92",
   "op": "15",
   "jp": "そう、たった一つの\n例外を除いては・・・",
   "en": ""
  },
  {
   "id": "s433:00ece",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:00efa",
   "op": "15",
   "jp": "アナタ方に、ぜひ\nお見せしたい物があります。",
   "en": ""
  },
  {
   "id": "s433:0112e",
   "op": "15",
   "jp": "世界の中心にあるバベルの塔、",
   "en": ""
  },
  {
   "id": "s433:0115e",
   "op": "15",
   "jp": "そして天空へと連なる\n七つの鎖。",
   "en": ""
  },
  {
   "id": "s433:01192",
   "op": "15",
   "jp": "この世界は、バベルの塔に\n捧げられた生Γと、",
   "en": ""
  },
  {
   "id": "s433:011d2",
   "op": "15",
   "jp": "大邪神を封じた\n七つの鎖によって支えられる\nと言われています。",
   "en": ""
  },
  {
   "id": "s433:01532",
   "op": "15",
   "jp": "だ、だけどオイ！",
   "en": ""
  },
  {
   "id": "s433:01556",
   "op": "15",
   "jp": "その肝心の鎖ってやつは\nすでに５本も\n切れちまってるじゃねぇか！？",
   "en": ""
  },
  {
   "id": "s433:015ba",
   "op": "15",
   "jp": "天界の玉座にある七つの封印が\n解かれない限り、",
   "en": ""
  },
  {
   "id": "s433:015fa",
   "op": "15",
   "jp": "世界は悪しき状態の\nままに継続するが・・・",
   "en": ""
  },
  {
   "id": "s433:01636",
   "op": "15",
   "jp": "神の子羊が順次その\n封印を解いたとき、",
   "en": ""
  },
  {
   "id": "s433:0166e",
   "op": "15",
   "jp": "さまざまな災いや死、\n闘争などが\n世界中へと広がる・・・",
   "en": ""
  },
  {
   "id": "s433:016ba",
   "op": "15",
   "jp": "ハルマゲドンと呼ばれる\nアンゲルス教の聖典によれば\nこの鎖の封印が解かれるとき、",
   "en": ""
  },
  {
   "id": "s433:0171e",
   "op": "15",
   "jp": "未曾有の大災害がこの世界を\n襲うと伝えられています",
   "en": ""
  },
  {
   "id": "s433:01776",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:017a2",
   "op": "15",
   "jp": "そして私が調べた限りでは、\nアナタ方が・・・",
   "en": ""
  },
  {
   "id": "s433:017e2",
   "op": "15",
   "jp": "その大邪神の鎧を解放したと\nほぼ同時期にあの鎖が切れ、",
   "en": ""
  },
  {
   "id": "s433:0182a",
   "op": "15",
   "jp": "それ以来、大規模な洪水や\n干ばつ、大地震などが\n世界を襲い始めたのです！！",
   "en": ""
  },
  {
   "id": "s433:0189e",
   "op": "14",
   "jp": "！！",
   "en": ""
  },
  {
   "id": "s433:018c2",
   "op": "15",
   "jp": "それじゃあ、これまでに\n起こった大地震も・・・",
   "en": ""
  },
  {
   "id": "s433:0192a",
   "op": "15",
   "jp": "俺達が鎧の封印を\n解いちまったせいだってぇのか！？",
   "en": ""
  },
  {
   "id": "s433:01a56",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s433:01a92",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:01aca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:01b02",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:01b3a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:01b72",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:01baa",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s433:01bd6",
   "op": "15",
   "jp": "この事実こそ、アナタ方が\nアンゲルス教の聖典にある",
   "en": ""
  },
  {
   "id": "s433:01c1a",
   "op": "15",
   "jp": "破壊と創造をもたらす\nさまよえる民である証！！",
   "en": ""
  },
  {
   "id": "s433:01cee",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s433:01d1a",
   "op": "15",
   "jp": "アナタ方が伝説の\nさまよえる民である以上、",
   "en": ""
  },
  {
   "id": "s433:01d56",
   "op": "15",
   "jp": "この石板にかかれた\n古の盟約に従って、",
   "en": ""
  },
  {
   "id": "s433:01d8e",
   "op": "15",
   "jp": "私が、この命に代えようとも\n必ずや、約束の地へ\nお連れします。",
   "en": ""
  },
  {
   "id": "s433:01e22",
   "op": "15",
   "jp": "アタシも・・是が非でも・・\n連れていって貰いますわよ・・・",
   "en": ""
  },
  {
   "id": "s433:01f5e",
   "op": "15",
   "jp": "ルピルピ！",
   "en": ""
  },
  {
   "id": "s433:01f8a",
   "op": "15",
   "jp": "そうじゃなきゃ、ア、アタシの\n日記に、みんなの名前を\n書きこんじゃうから。",
   "en": ""
  }
 ]
}
