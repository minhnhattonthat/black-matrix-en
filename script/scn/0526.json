   "jp": "プリカと話す",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:003be",
   "op": "1d",
   "jp": "クレージュと話す",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:003fe",
   "op": "1d",
   "jp": "ミシェットと話す",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:0043e",
   "op": "1d",
   "jp": "プラハと話す",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:0047a",
   "op": "1d",
   "jp": "ゼロと話す",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:0048c",
   "op": "1d",
   "jp": "決まった！？",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:004be",
   "op": "14",
   "jp": "この決着をどうするかの判断は・・・お前に任せるぜ・・・",
   "en": ""
  },
  {
   "id": "s526:0051e",
   "op": "14",
   "jp": "悪いがこの選択だけは・・・\nお前自身で、答えを出すべきだ・・・",
   "en": ""
  },
  {
   "id": "s526:00586",
   "op": "14",
   "jp": "いったい・・・\nどうなっちゃうのかなぁ・・・",
   "en": ""
  },
  {
   "id": "s526:005de",
   "op": "14",
   "jp": "わしは、どの道・・・お主の判断に\n任せるつもりだったのじゃ・・・・",
   "en": ""
  },
  {
   "id": "s526:0064a",
   "op": "14",
   "jp": "難しい・・選択ですね・・・・",
   "en": ""
  },
  {
   "id": "s526:006aa",
   "op": "14",
   "jp": "もしもサタン様になるのも、\n仲間を殺すのも、",
   "en": ""
  },
  {
   "id": "s526:006de",
   "op": "14",
   "jp": "世界を崩壊させるのも\n嫌だというのなら\nこのまま、ココを出ていって・・・",
   "en": ""
  },
  {
   "id": "s526:0072e",
   "op": "14",
   "jp": "地上で平凡な生活を続けるというのも一つの手なんじゃないのかしら！？",
   "en": ""
  },
  {
   "id": "s526:007b2",
   "op": "14",
   "jp": "ねぇねぇお兄ちゃん！\nこのままおうちに帰って・・・",
   "en": ""
  },
  {
   "id": "s526:007ec",
   "op": "14",
   "jp": "プリカと二人で\n一緒に暮らそうよぉ～～！！",
   "en": ""
  },
  {
   "id": "s526:0085a",
   "op": "14",
   "jp": "このリンゴみたいな\n木の実を食べると・・・",
   "en": ""
  },
  {
   "id": "s526:0088c",
   "op": "14",
   "jp": "過去の記憶が蘇るんだよねぇ！？",
   "en": ""
  },
  {
   "id": "s526:008c8",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s526:008d8",
   "op": "14",
   "jp": "ボクも昔の記憶を\n無くしたままだから・・・",
   "en": ""
  },
  {
   "id": "s526:0090a",
   "op": "14",
   "jp": "知恵の実を\n分けて貰おうかなっ・・・と！？",
   "en": ""
  },
  {
   "id": "s526:0093c",
   "op": "14",
   "jp": "うん！別に毒とかは、\n入ってないみたいだよ！？",
   "en": ""
  },
  {
   "id": "s526:009be",
   "op": "14",
   "jp": "アンタ本当に・・・\nカイン君なの～っ！？",
   "en": ""
  },
  {
   "id": "s526:009ee",
   "op": "14",
   "jp": "だったらぁ～～！",
   "en": ""
  },
  {
   "id": "s526:00a06",
   "op": "14",
   "jp": "早くサタン様に\nなっちゃえばいいのに～～！？",
   "en": ""
  },
  {
   "id": "s526:00a76",
   "op": "14",
   "jp": "ふん！\nアンタ・・・バカじゃないの！？",
   "en": ""
  },
  {
   "id": "s526:00aa4",
   "op": "14",
   "jp": "サタン様になるのも、\n仲間を殺すのも・・・",
   "en": ""
  },
  {
   "id": "s526:00ad6",
   "op": "14",
   "jp": "世界を崩壊させるのも\nイヤならば・・・",
   "en": ""
  },
  {
   "id": "s526:00b04",
   "op": "14",
   "jp": "自分が自殺してこの世を\n救えばいいのよ・・・！！",
   "en": ""
  },
  {
   "id": "s526:00b3c",
   "op": "14",
   "jp": "それが一番・・・\nあの子も・・喜ぶわ・・・！",
   "en": ""
  },
  {
   "id": "s526:00baa",
   "op": "14",
   "jp": "こういった、人の人生を\n左右するような問題は・・・",
   "en": ""
  },
  {
   "id": "s526:00be4",
   "op": "14",
   "jp": "他人の意見ではなく、\n自分自身で・・・",
   "en": ""
  },
  {
   "id": "s526:00c12",
   "op": "14",
   "jp": "答えを出すべきだ！！",
   "en": ""
  },
  {
   "id": "s526:00c2e",
   "op": "14",
   "jp": "もっとも、オレ自身の腹は、\nとうに決まっているんだが・・・",
   "en": ""
  },
  {
   "id": "s526:00c92",
   "op": "14",
   "jp": "なんも考えるような事と\nちゃうやろが・・・！？",
   "en": ""
  },
  {
   "id": "s526:00cc8",
   "op": "14",
   "jp": "（それにしても・・・）",
   "en": ""
  },
  {
   "id": "s526:00ce6",
   "op": "14",
   "jp": "（うちらが、今までサタン様の\n　お言葉だと信じていたものが）",
   "en": ""
  },
  {
   "id": "s526:00d2a",
   "op": "14",
   "jp": "（実は教皇様の\n　作り話やったなんて・・・）",
   "en": ""
  },
  {
   "id": "s526:00d76",
   "op": "14",
   "jp": "その隠し階段は・・・\n地上世界へと繋がる、\n教皇専用の最短ルートです・・・",
   "en": ""
  },
  {
   "id": "s526:00dfe",
   "op": "15",
   "jp": "そうですね・・・",
   "en": ""
  },
  {
   "id": "s526:00e22",
   "op": "15",
   "jp": "答えを出す前に、今の地上を\n少し見ておくのも\nいいかもしれませんね？！",
   "en": ""
  },
  {
   "id": "s526:00e8a",
   "op": "1d",
   "jp": "一旦地上に戻る",
   "en": "",
   "max": 15
  },
  {
   "id": "s526:00ea0",
   "op": "1d",
   "jp": "戻らない",
   "en": "",
   "max": 15
  }
 ]
}
