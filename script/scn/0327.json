 "strings": [
  {
   "id": "s327:006ea",
   "op": "15",
   "jp": "暴食の街・カナンの\n領主バアルは、",
   "en": ""
  },
  {
   "id": "s327:0071e",
   "op": "15",
   "jp": "ご主人様のいる総本山が、",
   "en": ""
  },
  {
   "id": "s327:0074a",
   "op": "15",
   "jp": "「この地上の何処にも存在しない！」\nという、",
   "en": ""
  },
  {
   "id": "s327:0078a",
   "op": "15",
   "jp": "謎の言葉を残して、\n静かに息を引き取った。",
   "en": ""
  },
  {
   "id": "s327:00836",
   "op": "15",
   "jp": "着実に味方が戦力を増強して\nいるとはいえ・・・・",
   "en": ""
  },
  {
   "id": "s327:0087a",
   "op": "15",
   "jp": "肝心の総本山への手がかりを\n完全に見失った一行は、",
   "en": ""
  },
  {
   "id": "s327:008be",
   "op": "15",
   "jp": "まずは情報を得る事こそ、\n最優先だと考え・・・",
   "en": ""
  },
  {
   "id": "s327:008fe",
   "op": "15",
   "jp": "欲情の街・ベギルドの\n近くまで歩みを進めた・・・",
   "en": ""
  },
  {
   "id": "s327:009ae",
   "op": "15",
   "jp": "その一面に水仙の花が咲き乱れる、\n困難な道程の中で・・・、",
   "en": ""
  },
  {
   "id": "s327:009fa",
   "op": "15",
   "jp": "まさか再び奴等と出くわす事に\nなるとは、露とも知らずに・・・",
   "en": ""
  },
  {
