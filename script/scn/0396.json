{
 "source": "d1:SCENARIO/396",
 "copies": [
  "d1:SCENARIO/396",
  "d2:SCENARIO/396"
 ],
 "strings": [
  {
   "id": "s396:00dbe",
   "op": "15",
   "jp": "やはり、我々と共に、",
   "en": ""
  },
  {
   "id": "s396:00de6",
   "op": "15",
   "jp": "ソドムの奴らと戦う決心を\nして頂けたのですね！！",
   "en": ""
  },
  {
   "id": "s396:00ede",
   "op": "15",
   "jp": "いや、わしらはお主達のやり方に\n賛同できんと判断したのじゃ！",
   "en": ""
  },
  {
   "id": "s396:00f2e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s396:00f4a",
   "op": "15",
   "jp": "いやはや救世主などと\n呼ばれていながら大局を\n見ることが出来ないとは・・・",
   "en": ""
  },
  {
   "id": "s396:01052",
   "op": "15",
   "jp": "解りました、\nソドムの事は我々で解決します！",
   "en": ""
  },
  {
   "id": "s396:010f2",
   "op": "15",
   "jp": "どうするつもりだ！？",
   "en": ""
  },
  {
   "id": "s396:0115e",
   "op": "15",
   "jp": "異端審問会に\n奴らのことを密告し、",
   "en": ""
  },
  {
   "id": "s396:01192",
   "op": "15",
   "jp": "その代わりにこの街のことには\n目をつぶって貰います！",
   "en": ""
  },
  {
   "id": "s396:01242",
   "op": "15",
   "jp": "そんな事は、この俺が許さん！",
   "en": ""
  },
  {
   "id": "s396:0127e",
   "op": "15",
   "jp": "私は私の街と同志達を、",
   "en": ""
  },
  {
   "id": "s396:012a6",
   "op": "15",
   "jp": "そして私の理想を守るため\nならば何でもしますよ！",
   "en": ""
  },
  {
   "id": "s396:012ea",
   "op": "15",
   "jp": "たとえ、救世主様達と\n戦うことになってもね！！",
   "en": ""
  },
  {
   "id": "s396:0133a",
   "op": "15",
   "jp": "やはり力づくで\n止めなければならないのか！",
   "en": ""
  }
 ]
}
