{
 "source": "d1:SCENARIO/229",
 "copies": [
  "d1:SCENARIO/229",
  "d2:SCENARIO/229"
 ],
 "strings": [
  {
   "id": "s229:0077a",
   "op": "14",
   "jp": "この村ほど安全な村は、\n他には有るまい・・・",
   "en": ""
  },
  {
   "id": "s229:007ae",
   "op": "14",
   "jp": "なにせ村の創立以来、\n一度も戦争に巻き込まれた事が\n無いんじゃからな！",
   "en": ""
  },
  {
   "id": "s229:00836",
   "op": "14",
   "jp": "この村の住民達は皆、過去に\n他の街で名を上げた\n力のある連中ばかりじゃ・・・",
   "en": ""
  },
  {
   "id": "s229:0088a",
   "op": "14",
   "jp": "その意味では、この村の住民こそ\n真の選ばれた強者の子孫だと\n言えるじゃろうて・・・",
   "en": ""
  },
  {
   "id": "s229:0091e",
   "op": "14",
   "jp": "暇じゃ・・とにかく暇じゃ・・・",
   "en": ""
  },
  {
   "id": "s229:00944",
   "op": "14",
   "jp": "仕事？！そんな物は若い者や、\n白い羽の者がするものじゃ！",
   "en": ""
  },
  {
   "id": "s229:00984",
   "op": "14",
   "jp": "わし等はただ、毎日を怠惰に\n過ごせるよう努力しておる！",
   "en": ""
  },
  {
   "id": "s229:009c2",
   "op": "14",
   "jp": "とはいうものの・・・\nだからこそ、とにかく暇なんじゃ！",
   "en": ""
  },
  {
   "id": "s229:00a3a",
   "op": "14",
   "jp": "それでなくても世間では、\n病気や戦争で子供の数が\n減り続けておるというのに・・・",
   "en": ""
  },
  {
   "id": "s229:00a92",
   "op": "14",
   "jp": "この村が、戦争に巻き込まれづらい\nという噂を聞きつけて、世界中から\n金持ちの老人達が集まってきおった。",
   "en": ""
  },
  {
   "id": "s229:00b00",
   "op": "14",
   "jp": "そのおかげで、この村の９割方の\n人間が老人達ばかりに\nなってしまったんじゃ・・・",
   "en": ""
  },
  {
   "id": "s229:00b92",
   "op": "14",
   "jp": "なんじゃいお前達！！",
   "en": ""
  },
  {
   "id": "s229:00bae",
   "op": "14",
   "jp": "いい若いもんが、昼間っから\n仕事もせんで、遊んでばかり\n居おって・・・！！",
   "en": ""
  },
  {
   "id": "s229:00c00",
   "op": "14",
   "jp": "わし等老人が怠惰な生活を\n送れるように・・・\nもっと死ぬ気で働くんじゃ～！！",
   "en": ""
  },
  {
   "id": "s229:00c62",
   "op": "14",
   "jp": "なぁおい・・・",
   "en": ""
  },
  {
   "id": "s229:00c78",
   "op": "14",
   "jp": "このジジイ・・・\n斬り殺しちゃだめかなぁ・・・？",
   "en": ""
  },
  {
   "id": "s229:00cbe",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s229:00d0a",
   "op": "14",
   "jp": "村の周りの墓石の値段が・・・\nここのところめっきり上がってきて\n困っているんじゃ・・・",
   "en": ""
  },
  {
   "id": "s229:00d68",
   "op": "14",
   "jp": "とはいっても、別段戦争があった\n訳でも病気が流行っている訳でも\nないんじゃが・・・",
   "en": ""
  },
  {
   "id": "s229:00dfe",
   "op": "14",
   "jp": "この村の医療技術は世界一じゃ！",
   "en": ""
  },
  {
   "id": "s229:00e24",
   "op": "14",
   "jp": "大陸中から集まった老人どもに\n引き寄せられて・・・、",
   "en": ""
  },
  {
   "id": "s229:00e60",
   "op": "14",
   "jp": "強欲を志す医者どもが\n山ほど集まってきおった・・・！！",
   "en": ""
  },
  {
   "id": "s229:00e9e",
   "op": "14",
   "jp": "じゃが心配しなくとも、\nこの村の医療費は全部若い連中が\n払う事になっておるから・・・",
   "en": ""
  },
  {
   "id": "s229:00efa",
   "op": "14",
   "jp": "わし等は全額タダなんじゃよ！",
   "en": ""
  },
  {
   "id": "s229:00f1e",
   "op": "14",
   "jp": "この村のはずれには、年貢を払えない若者や白い羽の者のために・・・",
   "en": ""
  },
  {
   "id": "s229:00f66",
   "op": "14",
   "jp": "無料の診療所をやっている\n変わり者が住んでおる・・・",
   "en": ""
  },
  {
   "id": "s229:00fa2",
   "op": "14",
   "jp": "おかげで他の医者からは、\nいつもひどい嫌がらせを\n受けておるようじゃ・・・",
   "en": ""
  },
  {
   "id": "s229:00ff4",
   "op": "14",
   "jp": "まあ、当然といえば当然じゃがな！",
   "en": ""
  },
  {
   "id": "s229:01056",
   "op": "14",
   "jp": "が、からぁああああ～！",
   "en": ""
  },
  {
   "id": "s229:010ae",
   "op": "14",
   "jp": "ふざけやがって！！",
   "en": ""
  },
  {
   "id": "s229:010c8",
   "op": "14",
   "jp": "こんな年貢の高い村になんかに\n住んでられるかってんだ！！",
   "en": ""
  },
  {
   "id": "s229:01108",
   "op": "14",
   "jp": "オイ！お前達もこんな村には\n長居しない方がいいぜ・・・！！",
   "en": ""
  },
  {
   "id": "s229:0114a",
   "op": "14",
   "jp": "なにせ収入の８割方を\n爺さん達の病院代に\n取り上げられちまうんだからな・・",
   "en": ""
  },
  {
   "id": "s229:0119c",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s229:011ea",
   "op": "14",
   "jp": "今は話しかけないで下さい・・・",
   "en": ""
  },
  {
   "id": "s229:01210",
   "op": "14",
   "jp": "この村では、子供が産まれると、\n子供達の数だけ、大人と同じ額の\n年貢を取り立てるんです・・・",
   "en": ""
  },
  {
   "id": "s229:01274",
   "op": "14",
   "jp": "だから子供が増えると、どんどん\n貧乏になっていく・・・",
   "en": ""
  },
  {
   "id": "s229:012b2",
   "op": "14",
   "jp": "この子を産もうかどうしようか、\n今真剣に悩んでるんです・・・",
   "en": ""
  },
  {
   "id": "s229:01332",
   "op": "14",
   "jp": "この村の若い連中はみんな、\n村を捨てて出ていってしまったんだ！",
   "en": ""
  },
  {
   "id": "s229:01378",
   "op": "14",
   "jp": "いいよな黒い羽の連中は・・・",
   "en": ""
  },
  {
   "id": "s229:0139c",
   "op": "14",
   "jp": "俺かい！？\n奴隷の俺が逃亡なんか\n出来るわけが無いじゃないか・・・",
   "en": ""
  },
  {
   "id": "s229:013f2",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s229:0143e",
   "op": "14",
   "jp": "この村の老人達は・・・",
   "en": ""
  },
  {
   "id": "s229:0145c",
   "op": "14",
   "jp": "暇だ暇だ！って、いつもみんなで\nブツブツいってるのに・・・",
   "en": ""
  },
  {
   "id": "s229:0149e",
   "op": "14",
   "jp": "誰一人として働こうとしないんだ！",
   "en": ""
  },
  {
   "id": "s229:01502",
   "op": "14",
   "jp": "いらっしゃい！って・・ああっ！！\n若いお客さんなんて、\nえらいひさしぶりだなぁ・・・",
   "en": ""
  },
  {
   "id": "s229:0155e",
   "op": "14",
   "jp": "いったい、何が欲しいんだ！？",
   "en": ""
  },
  {
   "id": "s229:0167e",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s229:0168c",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s229:0169c",
   "op": "20",
   "jp": "村を出ますか？",
   "en": ""
  }
 ]
}
