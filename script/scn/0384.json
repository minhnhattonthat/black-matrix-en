{
 "source": "d1:SCENARIO/384",
 "copies": [
  "d1:SCENARIO/384",
  "d2:SCENARIO/384"
 ],
 "strings": [
  {
   "id": "s384:00636",
   "op": "14",
   "jp": "ここは学校です。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:0064e",
   "op": "14",
   "jp": "ここでは羽の色に関係なく、\nタダで同じ教育を\n受けられるようにしてるんです！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:006a2",
   "op": "14",
   "jp": "子供の教育こそ、\n豊かな社会の基本ですからね！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00712",
   "op": "14",
   "jp": "我が街では病院や学校といった\nみんなが使う施設は、\n全て無料になっています！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00766",
   "op": "14",
   "jp": "あのいまいましいソドムの街では、\n金持ちだけが十分な医療を\n受けられ、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:007b4",
   "op": "14",
   "jp": "貧乏人は、大した医療も\n受けられずに死んでいくと\n聞きます・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:007fc",
   "op": "14",
   "jp": "そんなやり方が、はたして\n平等と言えるでしょうか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00872",
   "op": "14",
   "jp": "この街の運営は、\nこの街を創るのに尽力した\n素晴らしい人格者達が話し合い",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:008c2",
   "op": "14",
   "jp": "みんなが生きていきやすい\n街作りを長期的な計画で\n進めています。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:0090a",
   "op": "14",
   "jp": "ソドムの街のように、\n行き当たりばったりで\n街の指導者が代わってしまっては、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:0095e",
   "op": "14",
   "jp": "長期的な街の運営など\n出来るわけがありません！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00994",
   "op": "14",
   "jp": "この備蓄倉庫の中には、\nたとえ今後１０年間\n大飢Ωが続いたとしても、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:009e0",
   "op": "14",
   "jp": "全ての住人が食べていけるだけの\n食料の蓄えがあります。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00a1e",
   "op": "14",
   "jp": "長期的な生産計画を立て、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00a3e",
   "op": "14",
   "jp": "全ての労働者が協力して\n初めてこれだけの生産性を\nあげる事が出来るのです。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00aca",
   "op": "14",
   "jp": "全ての人達が平等に\n街の為に働き、その集めた\nお金を公平に分配する。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00b16",
   "op": "14",
   "jp": "全ての労働には何の差別も無く、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00b3c",
   "op": "14",
   "jp": "好ましいとか\n格好悪い職業など\nといった間違った感覚など",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00b7c",
   "op": "14",
   "jp": "この街には一切ありません。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00b9e",
   "op": "14",
   "jp": "全ての労働者の汗は、\nみな同じように美しいのです！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00c16",
   "op": "14",
   "jp": "ここは平和の街ゴモラです！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00c38",
   "op": "14",
   "jp": "ここを怠惰の街なんて\n呼ぶ奴もおりますが・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00c6e",
   "op": "14",
   "jp": "この街は、大変いい所です！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00c90",
   "op": "14",
   "jp": "みんなが本当に\n平等に暮らしています！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00cfa",
   "op": "14",
   "jp": "ここではパン屋さん、\n掃除のおばさんから、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00d2c",
   "op": "14",
   "jp": "学校の先生や\nお医者さんまで、",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00d52",
   "op": "14",
   "jp": "同じ街の公務員として、\n同じ給料が貰えるんです。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00d8a",
   "op": "14",
   "jp": "これってすごく\n平等だと思いませんか！？",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00df6",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00e42",
   "op": "14",
   "jp": "見つけたぞ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00e56",
   "op": "14",
   "jp": "こんな所に紛れ込んで\nやがったのか！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00ede",
   "op": "14",
   "jp": "なぜ働かないのかって？\n今日のノルマはこなしたよ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00f18",
   "op": "14",
   "jp": "働こうがさぼろうが、結局は\n同じ程度の生活が出来るんだ。",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00f58",
   "op": "14",
   "jp": "一生懸命働くなんて\nバカみたいじゃないか！！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:00f8c",
   "op": "14",
   "jp": "もういけよ、\nサボってるのがバレちゃうだろ！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s384:0106e",
   "op": "1d",
   "jp": "は　い",
   "en": "",
   "max": 15
  },
  {
   "id": "s384:0107c",
   "op": "1d",
   "jp": "いいえ",
   "en": "",
   "max": 15
  },
  {
   "id": "s384:0108c",
   "op": "20",
   "jp": "街を出ますか？",
   "en": ""
  }
 ]
}
