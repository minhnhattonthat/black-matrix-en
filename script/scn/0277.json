 ],
 "strings": [
  {
   "id": "s277:00846",
   "op": "15",
   "jp": "あの女、戦いもしねぇで、\n逃げやがった！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:008a2",
   "op": "15",
   "jp": "さすがに異端審問官ですね！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s277:008ce",
   "op": "15",
   "jp": "そこらの街の神官とは\n強さが違います！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s277:0096a",
   "op": "15",
   "jp": "でも、パルタが残してくれた、\nこの鎧のおかげで・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s277:009b2",
   "op": "15",
   "jp": "こんな弱虫のボクでも\n生き残ることが出来たんだ。",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s277:00a56",
   "op": "15",
   "jp": "だけどよぉ、どんなに強い力を\n手に入れたって・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s277:00aaa",
   "op": "15",
   "jp": "大丈夫ですよ。",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s277:00aca",
   "op": "15",
   "jp": "強いってことは、\nこの世では絶対的に\n正しいことなんですから！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s277:00b1e",
   "op": "15",
   "jp": "総本山の人々も、\nいずれ解ってくれますよ！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s277:00b5e",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s277:00b96",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 10
  },
  {
   "id": "s277:00bce",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 11
  },
  {
   "id": "s277:00c06",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 9
  },
  {
   "id": "s277:00c32",
   "op": "15",
   "jp": "さっ、みんなぁ、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s277:00c56",
   "op": "15",
   "jp": "そんな暗い顔してちゃダメだよ。",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s277:00c86",
   "op": "15",
   "jp": "彼のご主人様のことは、\n何も分からなかったけど、\n元気を出して早く調べに行こうよ！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s277:00cee",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s277:00d1a",
   "op": "15",
   "jp": "そうだな。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:00d36",
   "op": "15",
   "jp": "鎧が手に入ったとはいえ、\nまだ教団にΣ抗できるほどじゃ\nねぇんだ。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:00d9a",
   "op": "15",
   "jp": "ガイの言う通りじゃ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s277:00dc6",
   "op": "15",
   "jp": "各々の探し求めるものを\n見つけるためにも、",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s277:00e02",
   "op": "15",
   "jp": "ましてや生き残るためにも、\nここで立ち止まってはおれん。",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s277:00e4e",
   "op": "15",
   "jp": "ガイの言葉を借りれば・・・\nまさにわし等は、前門の虎後門の狼、といったところじゃからな！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s277:00ec6",
   "op": "15",
   "jp": "やれやれ年寄りの冷や水に\nならなきゃいいが。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:0102e",
   "op": "15",
   "jp": "ハッ！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:0108e",
   "op": "15",
   "jp": "今のも日記に\n書いとかなくっちゃ！！",
   "en": "",
   "box": "17x3",
   "face": 6
  },
  {
   "id": "s277:01896",
   "op": "15",
   "jp": "どうしたんだ、\nオマエは逃げないのか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:018de",
   "op": "15",
   "jp": "だってアタシ・・・\n一人では何もできないし。",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:0191e",
   "op": "15",
   "jp": "逃げたところで・・・\n捕まって、また奴隷として\n競売にかけられるだけです！！",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:0198a",
   "op": "15",
   "jp": "そんなことはない！\n自分の力で未来を切り開き、\nしたいことをすりゃいいのさ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:019f6",
   "op": "15",
   "jp": "でも・・・\nアタシ一人じゃあ・・・",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:01a3a",
   "op": "15",
   "jp": "どうする、\n一緒に連れてくか？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:01a7a",
   "op": "1d",
   "jp": "連れていく！！",
   "en": "",
   "max": 15
  },
  {
   "id": "s277:01a90",
   "op": "1d",
   "jp": "連れていかない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s277:01ac6",
   "op": "15",
   "jp": "本当にいいんですか！？",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:01aee",
   "op": "15",
   "jp": "アタシお金を\n拾うことぐらいしか、\nできないんですけど・・・",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:01b4a",
   "op": "15",
   "jp": "いやっ、まあ、いいんじゃねぇか、\nあいつが良いって言ってるんだし？！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s277:01bb0",
   "op": "14",
   "jp": "アークエンが仲間になった！",
   "en": "",
   "box": "17x3",
   "face": 104
  },
  {
   "id": "s277:01c1a",
   "op": "15",
   "jp": "そうですよね！",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:01c3a",
   "op": "15",
   "jp": "いつまでも人に頼ってばかりじゃ、\n駄目ですよね。",
   "en": "",
   "box": "17x3",
   "face": 21
  },
  {
   "id": "s277:01c7e",
   "op": "15",
   "jp": "アタシ、自分自身の力で\nやりたい事を見つけてみせます！",
   "en": "",
   "box": "17x3",
   "face": 21
  }
 ]
}
