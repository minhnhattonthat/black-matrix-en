{
 "source": "d1:SCENARIO/548",
 "copies": [
  "d1:SCENARIO/548",
  "d2:SCENARIO/548"
 ],
 "strings": [
  {
   "id": "s548:00702",
   "op": "15",
   "jp": "俺の本当の名は、\nざん悔を称える大天使\nウリエル！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:0074a",
   "op": "15",
   "jp": "どのみち、\nこの世界は既に崩壊しちまったんだ。",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:0078a",
   "op": "15",
   "jp": "こいつが、お前を\n新しき世界の創造主にする為の、\n試練だっていうんなら・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:007ea",
   "op": "15",
   "jp": "遠慮なく行かせて貰うぜ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:0084e",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s548:0092e",
   "op": "15",
   "jp": "へへっ・・・\nやっぱりな！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:0095a",
   "op": "15",
   "jp": "あんだけ強さや力にこだわってた、\nこの俺が・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:0099e",
   "op": "15",
   "jp": "なんでかな・・・\n負けたってのに、\nちっとも悔しくないぜ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s548:00a22",
   "op": "14",
   "jp": "・・・・・・・！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s548:00b2a",
   "op": "15",
   "jp": "今度はボクの番だね！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00b52",
   "op": "15",
   "jp": "ボクの本名は、\n高貴なる死の大天使\nサリエル！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00b96",
   "op": "15",
   "jp": "人は、目の前の逆境から・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00bc6",
   "op": "15",
   "jp": "逃げていてはダメなんだ！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00c72",
   "op": "15",
   "jp": "この強さは・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00c96",
   "op": "15",
   "jp": "キミが思い出させてくれたんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00cca",
   "op": "15",
   "jp": "キミに出会えたおかげで、",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00cf6",
   "op": "15",
   "jp": "本当に・・幸せ、\nだった・・・",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s548:00d5e",
   "op": "14",
   "jp": "・・・・・！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s548:00e62",
   "op": "15",
   "jp": "次は、\n僕の番ですね！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:00e8a",
   "op": "15",
   "jp": "僕の本当の名は、\n復讐の大天使\nラグエル！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:00eca",
   "op": "15",
   "jp": "僕はあなたこそ、親友セラフィムの\n理想を受け継ぐべき人だと・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:00f1e",
   "op": "15",
   "jp": "ですから・・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:00f3e",
   "op": "15",
   "jp": "手なんかぬきませんよ！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:00fe6",
   "op": "15",
   "jp": "ご一緒出来たのは、\nほんの短い間でしたが",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:01022",
   "op": "15",
   "jp": "僕はあなたを・・・\n二人目の親友だと・・",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:0105e",
   "op": "15",
   "jp": "思っています！！",
   "en": "",
   "box": "17x3",
   "face": 4
  },
  {
   "id": "s548:010b6",
   "op": "14",
   "jp": "・・・・・！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s548:011ba",
   "op": "15",
   "jp": "やれやれ、\nやっとわしの出番か！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:011ee",
   "op": "15",
   "jp": "わしの本名は、\nすでに知っておるとおり・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:0123a",
   "op": "15",
   "jp": "破滅と生命の大天使ラファエル！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:0126a",
   "op": "15",
   "jp": "わしを爺いと思って、\n甘く見るなよ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:012a2",
   "op": "15",
   "jp": "なにせ１５０億年も、\n生きとるんじゃからな！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:01362",
   "op": "14",
   "jp": "わしと最初に出会った時の事を・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:0138c",
   "op": "14",
   "jp": "お主は、はたして、\n覚えておるのかな・・・？！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:013c2",
   "op": "14",
   "jp": "お主達の農園で分けて貰った・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:013ea",
   "op": "14",
   "jp": "リンゴは、すこぶる旨かったぞ！！",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:0141e",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s548:01442",
   "op": "15",
   "jp": "ルピルピよ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:01466",
   "op": "15",
   "jp": "わしもやっと使命を果たせたので・・すぐに、そっちにいくぞ・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:014ba",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 5
  },
  {
   "id": "s548:015ba",
   "op": "15",
   "jp": "さあて・・・、\nやっと真打ちの登場か・・・！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:015fa",
   "op": "15",
   "jp": "力なき正義は無効であり、\n正義なき力は圧制である。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0163e",
   "op": "15",
   "jp": "俺の名は最も邪悪なる大天使、\nミカエル！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0167a",
   "op": "15",
   "jp": "どうやらはじめから俺とオマエは、\n戦う運命を・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:016be",
   "op": "15",
   "jp": "背負わされていたみたいだな。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:016ee",
   "op": "15",
   "jp": "だが、他の連中を倒せたからと\nいって・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0172a",
   "op": "15",
   "jp": "俺達大天使の生命力を\n甘く見るんじゃないぜ！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0176a",
   "op": "15",
   "jp": "俺も天界を代表する、\n戦闘天使とうたわれた以上・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:017b2",
   "op": "15",
   "jp": "俺の信じる正義の力は、",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:017da",
   "op": "15",
   "jp": "ちょっとやそっとのもんじゃないぜ！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0188e",
   "op": "15",
   "jp": "なぁ、\n俺が結構ルピルピの事・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:018c2",
   "op": "15",
   "jp": "気に入って・・たって・・・\n気づい・・てたか・・・！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0190a",
   "op": "15",
   "jp": "あいつの日記にさ・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:01932",
   "op": "15",
   "jp": "こんどは先にめぐり逢えたら・・・\nいいのにね・・・\nとか書いてありやがった。",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:0199e",
   "op": "15",
   "jp": "ふふっ\n笑っちまうだろ",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s548:019c6",
   "op": "15",
   "jp": "おい、\n聞いてるか・・・？",
   "en": "",
   "box": "17x3",
   "face": 1
  }
 ]
}
