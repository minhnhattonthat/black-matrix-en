{
 "source": "d1:SCENARIO/171",
 "copies": [
  "d1:SCENARIO/171",
  "d2:SCENARIO/171"
 ],
 "strings": [
  {
   "id": "s171:0067e",
   "op": "14",
   "jp": "ここはリベイラの街だ！\nもっとも、他の街の者からは、\n背徳の街と呼ばれとるがな！",
   "en": ""
  },
  {
   "id": "s171:00712",
   "op": "14",
   "jp": "お前達、下せんなる白い羽の分際で\nなんで勝手に街をうろついてんだ！",
   "en": ""
  },
  {
   "id": "s171:0075c",
   "op": "14",
   "jp": "あっ、\nどうも！\nそちらの神官様の奴隷でしたか！",
   "en": ""
  },
  {
   "id": "s171:007ce",
   "op": "14",
   "jp": "この街には、\n数多くの教会がある。",
   "en": ""
  },
  {
   "id": "s171:007f8",
   "op": "14",
   "jp": "その中でも特に凄いのは、\n太陽の神殿なんだが、",
   "en": ""
  },
  {
   "id": "s171:0082e",
   "op": "14",
   "jp": "そこにいた前の大神官のヨハネ様は、なにかヘマをやらかして\n監獄に送られたらしいぜ！",
   "en": ""
  },
  {
   "id": "s171:008c2",
   "op": "14",
   "jp": "太陽の神殿の大神官ユダ様は、\nこの街の支配者であらせられる！",
   "en": ""
  },
  {
   "id": "s171:00906",
   "op": "14",
   "jp": "ユダ様は、えらく嫉妬深いんで、\nすぐ人を殺しちまうんだ・・・！",
   "en": ""
  },
  {
   "id": "s171:0094c",
   "op": "14",
   "jp": "嫉妬深いのはいい事なんだけど、\n死ぬのはイヤなんで、",
   "en": ""
  },
  {
   "id": "s171:00988",
   "op": "14",
   "jp": "前の支配者だった\nヨハネ様の方が、\n今だに人気が高いけどね・・・",
   "en": ""
  },
  {
   "id": "s171:00a0a",
   "op": "14",
   "jp": "この街の神殿には、かの有名な\n神々達の戦いで産み出された",
   "en": ""
  },
  {
   "id": "s171:00a4a",
   "op": "14",
   "jp": "遺跡が眠っているって\nもっぱらの噂よ！",
   "en": ""
  },
  {
   "id": "s171:00a78",
   "op": "14",
   "jp": "本当の所は、\n正直、誰にもわからないけど・・・",
   "en": ""
  },
  {
   "id": "s171:00aea",
   "op": "14",
   "jp": "実はこの街には悪魔達が残した\nとんでもない鎧が\nあるって評判なんだが・・・。",
   "en": ""
  },
  {
   "id": "s171:00b3e",
   "op": "14",
   "jp": "たとえ悪魔の物だろうと、",
   "en": ""
  },
  {
   "id": "s171:00b5e",
   "op": "14",
   "jp": "強い力を持つ物は使わないと\n絶対損だと思わないか！？",
   "en": ""
  },
  {
   "id": "s171:00ba6",
   "op": "14",
   "jp": "・・・・",
   "en": ""
  },
  {
   "id": "s171:00bc6",
   "op": "14",
   "jp": "もっともこの考え方は、\n偉大なる前の支配者、\nヨハネ様の受け売りだがね！",
   "en": ""
  },
  {
   "id": "s171:00c52",
   "op": "14",
   "jp": "あんた達、邪道騎士って\n知ってるかい・・・！？",
   "en": ""
  },
  {
   "id": "s171:00c88",
   "op": "14",
   "jp": "なんでも、神々の残した鎧を\n身につける事によって、強大な力を\n手に入れたって話らしいぜ・・・",
   "en": ""
  },
  {
   "id": "s171:00cfa",
   "op": "14",
   "jp": "ボク達黒き羽の一族の祖先である\n黒き羽の大天使達は・・・",
   "en": ""
  },
  {
   "id": "s171:00d3a",
   "op": "14",
   "jp": "この大地の地底に住んでいたと\n言われているんだ・・・",
   "en": ""
  },
  {
   "id": "s171:00d76",
   "op": "14",
   "jp": "吹き上がるマグマ、血も凍るような\n極寒の地、乾燥しきった砂漠地帯。",
   "en": ""
  },
  {
   "id": "s171:00dc0",
   "op": "14",
   "jp": "必然的に弱い生命は駆逐される、\n単純明快な弱肉強食の世界！！",
   "en": ""
  },
  {
   "id": "s171:00e04",
   "op": "14",
   "jp": "そこで、人々が生きていくためには\nいつでも最大限の努力をしなければ\n生き残れないという・・・",
   "en": ""
  },
  {
   "id": "s171:00e68",
   "op": "14",
   "jp": "強い力や不屈の闘志を手に入れるにはまさに打って付けの、\n恵まれた楽園だったんだって、",
   "en": ""
  },
  {
   "id": "s171:00ec4",
   "op": "14",
   "jp": "もっともボクにとっては、\nそんな場所・・・",
   "en": ""
  },
  {
   "id": "s171:00ef6",
   "op": "14",
   "jp": "地獄以外の何物でも\n無いんだけどね・・・、",
   "en": ""
  },
  {
   "id": "s171:00f28",
   "op": "14",
   "jp": "とにかくそんな楽園で暮らしていた\nボク等のご先祖様達は・・・",
   "en": ""
  },
  {
   "id": "s171:00f6c",
   "op": "14",
   "jp": "かの救世主メフィスト・フェレス様のお導きで・・・、",
   "en": ""
  },
  {
   "id": "s171:00fa6",
   "op": "14",
   "jp": "大邪神や悪魔達がばっこしていた\nこの地上へと侵攻して、\n大邪神軍団を滅ぼし・・・",
   "en": ""
  },
  {
   "id": "s171:00ffe",
   "op": "14",
   "jp": "この大陸の地下深くに・・・\nあの神の鎖で封じ込めてたんだって\n教えられているんだけど・・・",
   "en": ""
  },
  {
   "id": "s171:0109a",
   "op": "14",
   "jp": "どうやら太陽の神殿に、\n神官兵達が集まっているらしいな！",
   "en": ""
  },
  {
   "id": "s171:010da",
   "op": "14",
   "jp": "ちなみに\n一口に神官魔法といっても・・・",
   "en": ""
  },
  {
   "id": "s171:0110a",
   "op": "14",
   "jp": "その神官の専門分野によって、\n人それぞれ使える魔法に違いが\nあるんだそうだ！",
   "en": ""
  },
  {
   "id": "s171:0115e",
   "op": "14",
   "jp": "まあコレばっかりは、実際に\n攻撃でも喰らわない限り、\n外からじゃ見分けがつかんがね！",
   "en": ""
  },
  {
   "id": "s171:011ba",
   "op": "14",
   "jp": "あの教会の封印の間には、\n白き悪魔達が使っていた大量の武具が隠されているらしい・・・",
   "en": ""
  },
  {
   "id": "s171:01216",
   "op": "14",
   "jp": "もっともその大半の武具は\n呪われているって噂だが・・・",
   "en": ""
  },
  {
   "id": "s171:012a4",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": ""
  },
  {
   "id": "s171:012dc",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": ""
  },
  {
   "id": "s171:012f4",
   "op": "14",
   "jp": "なんでぃ！\n白い羽の分際で何のようだ？",
   "en": ""
  },
  {
   "id": "s171:01322",
   "op": "14",
   "jp": "お使いか！\nなにが欲しいんだ！",
   "en": ""
  },
  {
   "id": "s171:01368",
   "op": "14",
   "jp": "うちの商品は、どれも値段に見合った極上モンばっかりだぜ！。",
   "en": ""
  },
  {
   "id": "s171:013b0",
   "op": "14",
   "jp": "いらっしゃ・・・",
   "en": ""
  },
  {
   "id": "s171:0140e",
   "op": "14",
   "jp": "おわらんぞ～",
   "en": ""
  },
  {
   "id": "s171:01422",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s171:01438",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s171:014f6",
   "op": "1d",
   "jp": "行く！",
   "en": "",
   "max": 15
  },
  {
   "id": "s171:01504",
   "op": "1d",
   "jp": "行かない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s171:01518",
   "op": "20",
   "jp": "太陽の神殿に行きますか？",
   "en": ""
  }
 ]
}
