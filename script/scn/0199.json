 "strings": [
  {
   "id": "s199:006ea",
   "op": "15",
   "jp": "創世記戦争と呼ばれる神々達の戦いで\n死んだはずの七人の大邪神達・・・",
   "en": ""
  },
  {
   "id": "s199:00742",
   "op": "15",
   "jp": "その屍となった魂は、朽ち果てた今も\n鎧の中に宿り続け・・・",
   "en": ""
  },
  {
   "id": "s199:0078e",
   "op": "15",
   "jp": "それを手にした者達に、神自身の力をも\n与えると伝えられている・・・",
   "en": ""
  },
  {
   "id": "s199:0085e",
   "op": "15",
   "jp": "自らの信じる欲望・・・",
   "en": ""
  },
  {
   "id": "s199:00886",
   "op": "15",
   "jp": "自由・・・正義・・・平等・・・",
   "en": ""
  },
  {
   "id": "s199:008b6",
   "op": "15",
   "jp": "そして愛・・・",
   "en": ""
  },
  {
   "id": "s199:008d6",
   "op": "15",
   "jp": "そのいずれもが、目には見えない\n不確かな物だったとしても・・・",
   "en": ""
  },
  {
   "id": "s199:00926",
   "op": "15",
   "jp": "人は時として、全てを犠牲に\nそれを望む・・・",
   "en": ""
  },
  {
   "id": "s199:009e2",
   "op": "15",
   "jp": "たとえそれが・・・",
   "en": ""
  },
  {
   "id": "s199:00a06",
   "op": "15",
   "jp": "絶えず生き血を喰らい・・・",
   "en": ""
  },
  {
   "id": "s199:00a32",
   "op": "15",
   "jp": "着た者の命をも奪う呪われた\n生きた鎧だったとしても・・・",
   "en": ""
  },
