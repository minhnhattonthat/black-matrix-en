{
 "source": "d1:SCENARIO/130",
 "copies": [
  "d1:SCENARIO/130",
  "d2:SCENARIO/130"
 ],
 "strings": [
  {
   "id": "s130:00652",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:00696",
   "op": "15",
   "jp": "眠れないの！？",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00782",
   "op": "15",
   "jp": "ずいぶんとうなされたんで、\n心配したんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:007c2",
   "op": "15",
   "jp": "アンタはいい人なのに、\nどうして、こんな所に\n入れられたの・・・！？",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:0089a",
   "op": "15",
   "jp": "そっかぁ・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:008ba",
   "op": "15",
   "jp": "アンタのご主人様は、\nボクらと同じ黒き羽なのに、",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:008fe",
   "op": "15",
   "jp": "白き羽の奴隷である\nアンタの事を、\n好きになっちゃったんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00952",
   "op": "15",
   "jp": "異端審問官の目の前で・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:0097e",
   "op": "15",
   "jp": "愛なんて言葉を恐れもせず\n口にだしちゃうなんて・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:009c6",
   "op": "15",
   "jp": "そんな勇気、ボクには\n想像もつかないよ・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00a06",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:00a32",
   "op": "15",
   "jp": "それって本当に発情でも・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00a62",
   "op": "15",
   "jp": "執着心でも所有欲でもない\n特別な感情なんだよねぇ？！",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00aaa",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:00ad6",
   "op": "15",
   "jp": "黒い羽のボクらの間でも・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00b06",
   "op": "15",
   "jp": "ごくまれに親兄弟なんかの間で\nそれに似たような感情が芽生える\nって聞いたことがあるけど・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00b76",
   "op": "15",
   "jp": "それだって、自分の子孫を\n後世に残す為の\n単なる種族保存本能なんだって",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00bce",
   "op": "15",
   "jp": "ボクらは、教わってきたんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00c02",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:00c2a",
   "op": "15",
   "jp": "自分のご主人様が心配で・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00c5a",
   "op": "15",
   "jp": "それで、アンタはここを出たいのか。",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00c9e",
   "op": "15",
   "jp": "ボクには・・・その",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00cc2",
   "op": "15",
   "jp": "愛とかいう物が、\nなんだか良くは\nわかんないんだけど・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00d0e",
   "op": "15",
   "jp": "なんか、羨ましい話だ。",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00d72",
   "op": "15",
   "jp": "ボクは比較的、裕福な黒き羽の家に\n生まれたおかげで、",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00dba",
   "op": "15",
   "jp": "今はまだ七つの大罪の一つ、\n弱者の罪には、\n問われないでいるけれど、",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00e12",
   "op": "15",
   "jp": "生まれつき体の弱かったボクを\n両親は周りの人達に\n見られたくなくって・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00e6e",
   "op": "15",
   "jp": "ワザとこの陽のあたらない\n地下牢の看守にしたんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00eb6",
   "op": "15",
   "jp": "ボクの事を知られたら・・・\n自分達が困るから・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00efe",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:00f4a",
   "op": "15",
   "jp": "ねぇ！？\n愛って・・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00f76",
   "op": "15",
   "jp": "愛って本当に、\nこの世にあるのかな！？",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:00fbe",
   "op": "15",
   "jp": "（ちっ・・・！）",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:0143e",
   "op": "15",
   "jp": "早く・・・逃げなよ！！",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:014b6",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:01786",
   "op": "15",
   "jp": "さっき、ボクがみんなに\n虐められていたとき・・・\nキミだけが、",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:017d6",
   "op": "15",
   "jp": "キミだけがボクを笑わなかった。",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01806",
   "op": "15",
   "jp": "他の看守や・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:0182a",
   "op": "15",
   "jp": "黒い羽の囚人達だって相手にも\nしやしない、臆病で、体の弱い\nこのボクの話を・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:0188e",
   "op": "15",
   "jp": "キミだけが真剣に聞いて\nくれたんだ・・・！！",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:018ce",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:018fa",
   "op": "15",
   "jp": "ボクみたいな意気地無しは、\nほっといたって、そのうち\nみんなに、なぶり殺される・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01962",
   "op": "15",
   "jp": "両親も初めからそれを望んで\nボクをこの場所に入れたんだ！",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:019ae",
   "op": "14",
   "jp": "・・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:019da",
   "op": "15",
   "jp": "なんだか・・・\nキミが羨ましい・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01a12",
   "op": "15",
   "jp": "もしもボクが・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01a36",
   "op": "15",
   "jp": "キミ達みたいに健康な体に\n生まれ変われて、",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01a72",
   "op": "15",
   "jp": "それでボクにも愛する\nご主人様が現れるんなら・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01ab6",
   "op": "15",
   "jp": "たとえキミ達のような奴隷階級の\n白い羽に生まれ変わったとしても・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01b0a",
   "op": "15",
   "jp": "きっとボクは・・・\n後悔しないのに！",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01b42",
   "op": "14",
   "jp": "・・・・",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:01b6a",
   "op": "15",
   "jp": "ねぇ！\n愛って、・・・",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:01b92",
   "op": "15",
   "jp": "愛って、・・・\n本当にこの世にあるのかなぁ？",
   "en": "",
   "box": "17x3",
   "face": 95
  },
  {
   "id": "s130:024ee",
   "op": "15",
   "jp": "なっ！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:0250a",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 0
  },
  {
   "id": "s130:0252e",
   "op": "15",
   "jp": "おおう！！",
   "en": "",
   "box": "17x3",
   "face": 29
  },
  {
   "id": "s130:0254a",
   "op": "15",
   "jp": "ま・・・間違いない！\nあれこそは邪神の・・・、",
   "en": "",
   "box": "17x3",
   "face": 29
  },
  {
   "id": "s130:0258a",
   "op": "15",
   "jp": "大邪神の復活を表す\n救世主の証し！！",
   "en": "",
   "box": "17x3",
   "face": 29
  },
  {
   "id": "s130:025c2",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s130:025da",
   "op": "14",
   "jp": "！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:025fe",
   "op": "15",
   "jp": "あ・あれだけ痛かった体のキズが、\n・・・完全に治ってる！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:0265a",
   "op": "15",
   "jp": "おい・・ピリポ！！",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s130:0267e",
   "op": "15",
   "jp": "お、お前・・・、\nその背中・・・",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s130:026b2",
   "op": "15",
   "jp": "羽の色が真っ白に\nなっちまってるぞ！？",
   "en": "",
   "box": "17x3",
   "face": 1
  },
  {
   "id": "s130:026fa",
   "op": "15",
   "jp": "ボ・・ボクは、\nど・どうしちゃったのかな！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:02746",
   "op": "15",
   "jp": "何をしておる！\n早くそこから出るんじゃ！！",
   "en": "",
   "box": "17x3",
   "face": 29
  },
  {
   "id": "s130:02782",
   "op": "15",
   "jp": "急いで逃げださんと\n他の看守どもが・・・\nすぐにやってくるぞ！！",
   "en": "",
   "box": "17x3",
   "face": 29
  },
  {
   "id": "s130:027e2",
   "op": "15",
   "jp": "なにが、どうすれば！？\nボクはどうしたらいいんだろう？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:0283a",
   "op": "15",
   "jp": "そんな事決まってンだろう！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02866",
   "op": "15",
   "jp": "お前も一緒に脱獄すんだよ！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02892",
   "op": "15",
   "jp": "こんな所で白い羽に\n変わっちまったお前を見つけて",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:028d6",
   "op": "15",
   "jp": "あの看守どもが、黙って放っておく\nワケがねぇだろうが！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02922",
   "op": "15",
   "jp": "いいから早く、\n他の牢も全部開けろ！！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:0295a",
   "op": "15",
   "jp": "俺達だけじゃあ、\n流石に手が足らねえ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:029a6",
   "op": "15",
   "jp": "だけど！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:029c2",
   "op": "15",
   "jp": "ボクにわあわわわぁわ！？",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:029fa",
   "op": "15",
   "jp": "お前も俺と一緒に\nコイツのご主人様とやらを\n助け出して・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02a4a",
   "op": "15",
   "jp": "その顔を見てぇとは\n思わねぇのか・・・！？",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02a8a",
   "op": "14",
   "jp": "！！",
   "en": "",
   "box": "17x3",
   "face": 3
  },
  {
   "id": "s130:02aae",
   "op": "15",
   "jp": "コイツの飼い主だってんだ・・・",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02ade",
   "op": "15",
   "jp": "さぞかし邪悪な顔つきをしてる\nこったろうぜ・・・！",
   "en": "",
   "box": "17x3",
   "face": 2
  },
  {
   "id": "s130:02bc6",
   "op": "15",
   "jp": "気を引き締めよ！\n奴等現れおったぞ！！",
   "en": "",
   "box": "17x3",
   "face": 29
  }
 ]
}
