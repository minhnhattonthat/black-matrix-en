{
 "source": "d1:SCENARIO/49",
 "copies": [
  "d1:SCENARIO/49",
  "d2:SCENARIO/49"
 ],
 "strings": [
  {
   "id": "s49:0007a",
   "op": "15",
   "jp": "あら、ど・どうしたの・・・？",
   "en": ""
  },
  {
   "id": "s49:000b6",
   "op": "15",
   "jp": "体の具合が悪いんなら・・・\nちゃんとアタシに言いなさい！\n分かったの・・・？！",
   "en": ""
  },
  {
   "id": "s49:0012e",
   "op": "15",
   "jp": "ふん！\n何を甘えてるのかしら・・・？",
   "en": ""
  },
  {
   "id": "s49:00172",
   "op": "15",
   "jp": "なまけずにリハビリしないと、\n別の意味で足腰立たなくなって\n貰うわよ！！",
   "en": ""
  },
  {
   "id": "s49:00222",
   "op": "15",
   "jp": "春はあけぼの・・・\nふん！アンタにいっても\nわからないでしょうね！",
   "en": ""
  },
  {
   "id": "s49:002a6",
   "op": "15",
   "jp": "おはよう。お返事は？\nふん！今日もちゃんと\nリハビリするのよ！",
   "en": ""
  },
  {
   "id": "s49:00326",
   "op": "15",
   "jp": "おはよう。今日も暑くなりそうだから手際よく働きなさい・・・",
   "en": ""
  },
  {
   "id": "s49:00382",
   "op": "15",
   "jp": "わかったの？！",
   "en": ""
  },
  {
   "id": "s49:003d2",
   "op": "15",
   "jp": "お・は・よ・う・・・",
   "en": ""
  },
  {
   "id": "s49:003fa",
   "op": "15",
   "jp": "昨日は暑くるしくって、\nちゃんと眠れなかったわ・・・！",
   "en": ""
  },
  {
   "id": "s49:00452",
   "op": "15",
   "jp": "アンタ、聞いてるの？",
   "en": ""
  },
  {
   "id": "s49:004a6",
   "op": "15",
   "jp": "やっとすずしくなってきたわ！\nいい季節ねぇ・・・",
   "en": ""
  },
  {
   "id": "s49:004f6",
   "op": "15",
   "jp": "べ、別にアンタに話しかけてる\nわけじゃないのよ！",
   "en": ""
  },
  {
   "id": "s49:00566",
   "op": "15",
   "jp": "そろそろ寒くなるから・・・\n冬の支度を始めなさい！",
   "en": ""
  },
  {
   "id": "s49:005ba",
   "op": "15",
   "jp": "いいわね！アタシの命令よ！！",
   "en": ""
  },
  {
   "id": "s49:00616",
   "op": "15",
   "jp": "今日は雪でも降りそうな雰囲気ねぇ、",
   "en": ""
  },
  {
   "id": "s49:0065a",
   "op": "15",
   "jp": "ふん！いいこと？\nアンタは家でおとなしくしてるのよ！",
   "en": ""
  },
  {
   "id": "s49:006a2",
   "op": "15",
   "jp": "また風邪でもひかれたら、\nこっちがたまらないわ・・・！",
   "en": ""
  },
  {
   "id": "s49:0071a",
   "op": "15",
   "jp": "うううう・・・\nこ・こう寒くっちゃあ・・・",
   "en": ""
  },
  {
   "id": "s49:00756",
   "op": "15",
   "jp": "外で仕事をする気になんか、\nなりゃしない・・・！",
   "en": ""
  },
  {
   "id": "s49:0079a",
   "op": "15",
   "jp": "アンタも今日は、家の中で・・・\nおとなしくしてなさい・・・！",
   "en": ""
  }
 ]
}
