{
 "source": "d1:SCENARIO/478",
 "copies": [
  "d1:SCENARIO/478",
  "d2:SCENARIO/478"
 ],
 "strings": [
  {
   "id": "s478:01396",
   "op": "15",
   "jp": "この長いバベルの塔を\nはい上がって来るとは・・・",
   "en": ""
  },
  {
   "id": "s478:013da",
   "op": "15",
   "jp": "確かにたいしたもんやわ！",
   "en": ""
  },
  {
   "id": "s478:01436",
   "op": "15",
   "jp": "けっ、ちぃと時間が\nかかっちまったがな。",
   "en": ""
  },
  {
   "id": "s478:014e6",
   "op": "15",
   "jp": "せやなあ！来るんが、ちぃ～っと\n遅すぎたのかもしれへんなぁ～！",
   "en": ""
  },
  {
   "id": "s478:0153a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:01566",
   "op": "15",
   "jp": "なにせうちらは、\n６人の大天使の鎧を\nきっちりとそろえ終わり・・・",
   "en": ""
  },
  {
   "id": "s478:015ba",
   "op": "15",
   "jp": "すでに本格的な覚醒を始める\n準備も終わらせてしもうたんよ！",
   "en": ""
  },
  {
   "id": "s478:01622",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:0165a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:01692",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:016ca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:016f6",
   "op": "15",
   "jp": "せやけど、全国各地に散らばった\n大神官達を集めて、誰が誰かを\n判別するのんは・・・",
   "en": ""
  },
  {
   "id": "s478:0175a",
   "op": "15",
   "jp": "えらい大変やったんぇ～！？",
   "en": ""
  },
  {
   "id": "s478:01786",
   "op": "15",
   "jp": "なにせ、いっぺん転生した\n大天使は、自らの鎧を再び\n手に入れるまで・・・",
   "en": ""
  },
  {
   "id": "s478:017e2",
   "op": "15",
   "jp": "記憶を無くした、ただの大神官に\n成り下がってしまう\nさかいになぁ・・・",
   "en": ""
  },
  {
   "id": "s478:0183e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:0186a",
   "op": "15",
   "jp": "すでに、ご自分でも気がついて\nおられるのでしょう？",
   "en": ""
  },
  {
   "id": "s478:018ae",
   "op": "15",
   "jp": "この世界に七人しかいない\n大神官達の中で・・・",
   "en": ""
  },
  {
   "id": "s478:018ee",
   "op": "15",
   "jp": "残された大神官は\n唯一・・・ただ一人・・・",
   "en": ""
  },
  {
   "id": "s478:0192a",
   "op": "15",
   "jp": "ヨハネ殿・・・\nアナタこそがメフィスト様の\n真の生まれ変わりなのです！！",
   "en": ""
  },
  {
   "id": "s478:01b12",
   "op": "15",
   "jp": "教皇様より直々に、\n大邪神の鎧をお預かりに\nなられていた事こそ、",
   "en": ""
  },
  {
   "id": "s478:01b66",
   "op": "15",
   "jp": "その何よりの証し！！",
   "en": ""
  },
  {
   "id": "s478:01b8e",
   "op": "15",
   "jp": "今回の一連の行動も全ては・・・",
   "en": ""
  },
  {
   "id": "s478:01bbe",
   "op": "15",
   "jp": "大邪神達を復活させかねないような\n忌まわしき危険人物共を\n一ヶ所に集め・・・",
   "en": ""
  },
  {
   "id": "s478:01c1e",
   "op": "15",
   "jp": "彼らが真の覚醒をおこさぬ前に\n速やかに叩きつぶそうという、\n素晴らしき御計画・・・",
   "en": ""
  },
  {
   "id": "s478:01c82",
   "op": "15",
   "jp": "さあ、こちらに来られて・・・",
   "en": ""
  },
  {
   "id": "s478:01cb2",
   "op": "15",
   "jp": "ご一緒にそのメタトロンの鎧を\n取り返しましょうぞ！！",
   "en": ""
  },
  {
   "id": "s478:01d6e",
   "op": "15",
   "jp": "くっくっくっ、\nハッハッハッハッハッ・・・",
   "en": ""
  },
  {
   "id": "s478:01dd2",
   "op": "15",
   "jp": "かつて、特に大天使と言う名で\n呼ばれて恐れられていた・・・",
   "en": ""
  },
  {
   "id": "s478:01e1e",
   "op": "15",
   "jp": "強大な魔力を持った\n天使達が存在した・・・・！！",
   "en": ""
  },
  {
   "id": "s478:01e62",
   "op": "15",
   "jp": "いまや、黒き羽の守護神となった\n自信とごう慢を司る大天使\nメフィストを筆頭に・・・",
   "en": ""
  },
  {
   "id": "s478:01ec6",
   "op": "15",
   "jp": "かつてのアダムの最初の妻で、\n娯楽と怠惰を司る\n黒き羽の大天使・リリス！！",
   "en": ""
  },
  {
   "id": "s478:0201e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:0204a",
   "op": "15",
   "jp": "全ての空飛ぶ生き物の頂点に立つ\n向上心と嫉妬を司る\n大天使・ベルゼブブ！！",
   "en": ""
  },
  {
   "id": "s478:021a2",
   "op": "14",
   "jp": "・・・・・・・・",
   "en": ""
  },
  {
   "id": "s478:021d2",
   "op": "15",
   "jp": "メフィストの海軍を率いる\n希望と強欲を司る\n大天使・ベヒーモス！！",
   "en": ""
  },
  {
   "id": "s478:02322",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:0234e",
   "op": "15",
   "jp": "生けにえを要求する収穫神で\n成長と暴食を司る\n大天使・モーロック！！",
   "en": ""
  },
  {
   "id": "s478:024a2",
   "op": "14",
   "jp": "・・・・・・・・・",
   "en": ""
  },
  {
   "id": "s478:024d6",
   "op": "15",
   "jp": "元々は美の女神で、\n恋心と欲情を司る\n大天使・ベルフェゴール！！",
   "en": ""
  },
  {
   "id": "s478:02626",
   "op": "14",
   "jp": "・・・・・・・",
   "en": ""
  },
  {
   "id": "s478:02656",
   "op": "15",
   "jp": "あっ、・・・・\nアナタは・・・・！？",
   "en": ""
  },
  {
   "id": "s478:0268e",
   "op": "15",
   "jp": "欲情の街・ベギルドの\nアスタルテさん・・？",
   "en": ""
  },
  {
   "id": "s478:026da",
   "op": "15",
   "jp": "天変地異を巻き起こす、荒ぶる神で\n集中力と怨念を司る\n大天使・アラストル！！",
   "en": ""
  },
  {
   "id": "s478:02836",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:02892",
   "op": "15",
   "jp": "そっ、そんな！？",
   "en": ""
  },
  {
   "id": "s478:028c2",
   "op": "15",
   "jp": "あっ、ありゃあ秘密地下組織の\nケルビムの親爺じゃねえか！？",
   "en": ""
  },
  {
   "id": "s478:0291e",
   "op": "15",
   "jp": "かつてのサタンの使徒が、\nこれで揃ったというわけか！！\nウハハハハハッハッハッ・・・",
   "en": ""
  },
  {
   "id": "s478:02baa",
   "op": "15",
   "jp": "ヨ、ヨハネさん！？",
   "en": ""
  },
  {
   "id": "s478:02c02",
   "op": "15",
   "jp": "だがしかし・・・",
   "en": ""
  },
  {
   "id": "s478:02c26",
   "op": "15",
   "jp": "わしが誰かも知らんとは\nお主達、よっぽど教皇に\n信用が無いようじゃのう！？",
   "en": ""
  },
  {
   "id": "s478:02c92",
   "op": "15",
   "jp": "な、何やて？！",
   "en": ""
  },
  {
   "id": "s478:02cc2",
   "op": "15",
   "jp": "わしこそは、この目で\n創世記戦争を見届けた\n唯一残されし者！",
   "en": ""
  },
  {
   "id": "s478:02d12",
   "op": "15",
   "jp": "わしは、転生など\n一度もしては、おらん！！",
   "en": ""
  },
  {
   "id": "s478:02f82",
   "op": "15",
   "jp": "そもそも、お主達は未だに\n大邪神などと呼んでおるが・・・",
   "en": ""
  },
  {
   "id": "s478:02fce",
   "op": "15",
   "jp": "あの大戦に敗れ大邪神などと\n呼ばれるようになってしまった、",
   "en": ""
  },
  {
   "id": "s478:0301a",
   "op": "15",
   "jp": "正義を司る大天使\nミカエル",
   "en": ""
  },
  {
   "id": "s478:0304a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:03076",
   "op": "15",
   "jp": "自由を司る大天使\nウリエル",
   "en": ""
  },
  {
   "id": "s478:030a6",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:030d2",
   "op": "15",
   "jp": "勇気を司る大天使\nサリエル",
   "en": ""
  },
  {
   "id": "s478:03102",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:0312e",
   "op": "15",
   "jp": "友情を司る大天使\nラグエル",
   "en": ""
  },
  {
   "id": "s478:0315e",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:0318a",
   "op": "15",
   "jp": "人権を司る大天使\nラファエル",
   "en": ""
  },
  {
   "id": "s478:031ba",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:031e6",
   "op": "15",
   "jp": "愛情を司る大天使\nガブリエル",
   "en": ""
  },
  {
   "id": "s478:0322e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:03266",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:0329e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:032d6",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:0330e",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:03346",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s478:03372",
   "op": "15",
   "jp": "そして、数ある大天使達の中でも\n最も謎めいた大天使・・・",
   "en": ""
  },
  {
   "id": "s478:033be",
   "op": "15",
   "jp": "平等を司る大天使\nメタトロン！！",
   "en": ""
  },
  {
   "id": "s478:033f2",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:0341e",
   "op": "15",
   "jp": "元をただせば、彼らも全て・・・",
   "en": ""
  },
  {
   "id": "s478:0344e",
   "op": "15",
   "jp": "同じ神に仕える\n大天使だったはずじゃ！！",
   "en": ""
  },
  {
   "id": "s478:0348a",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s478:034b6",
   "op": "15",
   "jp": "だいいち、その様子では\nお主達はまだメフィストの正体とて\nつかめてはおるまい・・・！？",
   "en": ""
  },
  {
   "id": "s478:0351e",
   "op": "15",
   "jp": "このルピルピの助力を\n得ながらも・・・",
   "en": ""
  },
  {
   "id": "s478:03556",
   "op": "15",
   "jp": "結局はメタトロンの鎧に宿る\nその魂すら復活させることが\n出来なかったこのわしが・・・",
   "en": ""
  },
  {
   "id": "s478:035be",
   "op": "15",
   "jp": "メフィスト・フェレスの\n生まれ変わりだなどとは\n片腹痛いわ！！",
   "en": ""
  },
  {
   "id": "s478:03632",
   "op": "15",
   "jp": "お師匠さま！！",
   "en": ""
  },
  {
   "id": "s478:03662",
   "op": "15",
   "jp": "グッ・・・",
   "en": ""
  },
  {
   "id": "s478:0367e",
   "op": "15",
   "jp": "（ということはヨハネではなく、\n　あいつが・・・！？）",
   "en": ""
  },
  {
   "id": "s478:036c6",
   "op": "15",
   "jp": "（うっ・・・この感覚は・・・\n　これは覚醒を促すために\n　食べた先ほどの・・・）",
   "en": ""
  },
  {
   "id": "s478:0372a",
   "op": "15",
   "jp": "（知恵の実の影響！？）",
   "en": ""
  },
  {
   "id": "s478:03752",
   "op": "15",
   "jp": "（また・・遠い昔の\n　リリスの記憶が・・・）",
   "en": ""
  },
  {
   "id": "s478:03792",
   "op": "15",
   "jp": "（あかん、認められへん！\n　だってそれは７つの・・・）",
   "en": ""
  },
  {
   "id": "s478:03a62",
   "op": "15",
   "jp": "ふん！\nまぁ、よろしおすわ。",
   "en": ""
  },
  {
   "id": "s478:03a92",
   "op": "15",
   "jp": "あんはんがメフィスト様の\n生まれ変わりと違うても、",
   "en": ""
  },
  {
   "id": "s478:03ad6",
   "op": "15",
   "jp": "メタトロンの鎧さえ手に入れれば\n同じこと・・・",
   "en": ""
  },
  {
   "id": "s478:03b26",
   "op": "15",
   "jp": "ルカ様、ここは教団最強の\n邪道騎士を以て当たるのが、\nよろしいかと。",
   "en": ""
  },
  {
   "id": "s478:03b8a",
   "op": "15",
   "jp": "ヨハネが仲間でないと分かった以上\nアレの始末を優先しなければ。",
   "en": ""
  },
  {
   "id": "s478:03bde",
   "op": "14",
   "jp": "！？",
   "en": ""
  },
  {
   "id": "s478:03c02",
   "op": "15",
   "jp": "ケルビムさん！！",
   "en": ""
  },
  {
   "id": "s478:03c32",
   "op": "15",
   "jp": "フフフフ・・・",
   "en": ""
  },
  {
   "id": "s478:03c52",
   "op": "15",
   "jp": "メフィスト様が居ない今・・・",
   "en": ""
  },
  {
   "id": "s478:03c82",
   "op": "15",
   "jp": "悪いがここで創世記戦争を\n繰り返すわけにはいかんのでね！",
   "en": ""
  },
  {
   "id": "s478:03e56",
   "op": "15",
   "jp": "（あのケルビムさんが\n　どうして！？）",
   "en": ""
  }
 ]
}
