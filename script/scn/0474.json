 "strings": [
  {
   "id": "s474:001de",
   "op": "15",
   "jp": "ここは！？",
   "en": ""
  },
  {
   "id": "s474:0020a",
   "op": "15",
   "jp": "こここそが、全ての始まりの場所、\n約束の地ディアボロスじゃ！",
   "en": ""
  },
  {
   "id": "s474:00266",
   "op": "15",
   "jp": "ここが！？",
   "en": ""
  },
  {
   "id": "s474:00282",
   "op": "15",
   "jp": "（神話の中にしか存在しない\n　伝説の場所だと\n　思っていたのに！？）",
   "en": ""
  },
  {
   "id": "s474:002e6",
   "op": "15",
   "jp": "ひ、人が居るけど\n何か変なカンジだな。",
   "en": ""
  },
  {
   "id": "s474:0032e",
   "op": "15",
   "jp": "確かに変だな、\nあいつらからは精気が全く\n感じられねぇ！？",
   "en": ""
  },
  {
   "id": "s474:0038a",
   "op": "15",
   "jp": "ひょっとして\nあれは昔の人達の魂！？",
   "en": ""
  },
  {
   "id": "s474:003ce",
   "op": "15",
   "jp": "そのようじゃ・・・",
   "en": ""
  },
  {
   "id": "s474:003f2",
   "op": "15",
   "jp": "彼らは死しても、\nその魂の行き処が\nどこにもないのじゃ・・・",
   "en": ""
  },
  {
   "id": "s474:00442",
   "op": "15",
   "jp": "（悠久の時を経ても\n　ここはあの時のままなのか・・・）",
   "en": ""
  }
 ]
}
