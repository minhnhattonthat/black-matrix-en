  "d2:SCENARIO/64"
 ],
 "strings": [
  {
   "id": "s64:00282",
   "op": "14",
   "jp": "・・・・・・",
   "en": ""
  },
  {
   "id": "s64:0039e",
   "op": "15",
   "jp": "最近は顔色もいいし、\n食欲もばっちり！",
   "en": ""
  },
  {
   "id": "s64:003d6",
   "op": "15",
   "jp": "すっかり元気になったわね！",
   "en": ""
  },
  {
   "id": "s64:00402",
   "op": "15",
   "jp": "いつかは言い出すんじゃないか・・・そう思ってはいたんだけど・・・",
   "en": ""
  },
  {
   "id": "s64:00456",
   "op": "15",
   "jp": "そう・・・",
   "en": ""
  },
  {
   "id": "s64:00468",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s64:00486",
   "op": "15",
   "jp": "アナタを縛ることなんて\n誰にも出来ないもの・・・",
   "en": ""
  },
  {
   "id": "s64:004ca",
   "op": "15",
   "jp": "外に出るのだってアナタの自由・・・",
   "en": ""
  },
  {
   "id": "s64:004fe",
   "op": "15",
   "jp": "でも、\n私の気持ちも・・・！",
   "en": ""
  },
  {
   "id": "s64:0052e",
   "op": "15",
   "jp": "ごめんなさい。\n本当に出たい？",
   "en": ""
  },
  {
   "id": "s64:0056e",
   "op": "1d",
   "jp": "外へ出たい！",
   "en": "",
   "max": 15
  },
  {
   "id": "s64:00584",
   "op": "1d",
   "jp": "外へ出たくない！",
   "en": "",
   "max": 15
  },
  {
   "id": "s64:005ba",
   "op": "15",
   "jp": "そうよね、\nアナタが記憶を早く\n取り戻すためにも・・・",
   "en": ""
  },
  {
   "id": "s64:00602",
   "op": "15",
   "jp": "それに・・・",
   "en": ""
  },
  {
   "id": "s64:00622",
   "op": "15",
   "jp": "アナタは私のカゴの鳥なんかじゃ\n無いもんね・・・",
   "en": ""
  },
  {
   "id": "s64:00666",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s64:00692",
   "op": "15",
   "jp": "でもね・・・\nお外に出るなら、\nこれだけは覚えておいて！",
   "en": ""
  },
  {
   "id": "s64:006de",
   "op": "15",
   "jp": "街にはいろんな人が居るけど、\n羽の色が黒い人達には、\n乱暴な人が多いから、",
   "en": ""
  },
  {
   "id": "s64:0073a",
   "op": "15",
   "jp": "くれぐれも気を付けて・・・",
   "en": ""
  },
  {
   "id": "s64:0076a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s64:00796",
   "op": "15",
   "jp": "それから、このネックレスは\nお守りだと思って、\n必ず身に着けておいてね！",
   "en": ""
  },
  {
   "id": "s64:007f2",
   "op": "15",
   "jp": "やっぱり・・・\n外へ出たい？",
   "en": ""
  },
  {
   "id": "s64:0084a",
   "op": "15",
   "jp": "そうよね、\nまだ早いわよね。",
   "en": ""
  },
  {
   "id": "s64:0087a",
   "op": "15",
   "jp": "ああ良かった。",
   "en": ""
  },
  {
   "id": "s64:0089a",
   "op": "15",
   "jp": "なんだかアナタと\n離ればなれになりそうな気がして、",
   "en": ""
  },
  {
   "id": "s64:008ee",
   "op": "15",
   "jp": "ちょっと心配だったの。",
   "en": ""
  },
  {
   "id": "s64:00926",
   "op": "15",
   "jp": "でも・・・\nもしも外に出たくなったら・・・",
   "en": ""
  },
  {
   "id": "s64:00962",
   "op": "15",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s64:0097e",
   "op": "15",
   "jp": "もう・・・\n心配させちゃ嫌だよ！",
   "en": ""
  }
 ]
}
