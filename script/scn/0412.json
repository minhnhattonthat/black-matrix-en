{
 "source": "d1:SCENARIO/412",
 "copies": [
  "d1:SCENARIO/412",
  "d2:SCENARIO/412"
 ],
 "strings": [
  {
   "id": "s412:00bb2",
   "op": "15",
   "jp": "我が名は、邪道騎士モーゼ。",
   "en": ""
  },
  {
   "id": "s412:00bfe",
   "op": "15",
   "jp": "さまよえる民を\n約束の地へと導きし者！",
   "en": ""
  },
  {
   "id": "s412:00c6a",
   "op": "15",
   "jp": "（私と同じ邪道騎士？）",
   "en": ""
  },
  {
   "id": "s412:00ca2",
   "op": "15",
   "jp": "おそらく・・・",
   "en": ""
  },
  {
   "id": "s412:00cc2",
   "op": "15",
   "jp": "我こそがアナタ方の\n疑問をひも解く、唯一の道標",
   "en": ""
  },
  {
   "id": "s412:00d12",
   "op": "15",
   "jp": "それでは、\n総本山の場所や、",
   "en": ""
  },
  {
   "id": "s412:00d4e",
   "op": "15",
   "jp": "今の大地震の原因さえも！？",
   "en": ""
  },
  {
   "id": "s412:00d8a",
   "op": "15",
   "jp": "真理はアナタ方の意志の力に\n委ねられています・・・",
   "en": ""
  },
  {
   "id": "s412:00df2",
   "op": "15",
   "jp": "何じゃと！？",
   "en": ""
  },
  {
   "id": "s412:00e12",
   "op": "15",
   "jp": "しかしなぜじゃ？",
   "en": ""
  },
  {
   "id": "s412:00e36",
   "op": "15",
   "jp": "その角を見るかぎり\nお主も元は、\n黒き羽の神官であろう！",
   "en": ""
  },
  {
   "id": "s412:00e82",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s412:00eae",
   "op": "15",
   "jp": "なぜあえて、\nわし等にそれを示す！？",
   "en": ""
  },
  {
   "id": "s412:00ef2",
   "op": "15",
   "jp": "どうやらアナタ方こそが、\n私が導くべき、さまよえる民だと\n確信するに至ったからです。",
   "en": ""
  },
  {
   "id": "s412:00f5a",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s412:00f92",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s412:00fca",
   "op": "14",
   "jp": "・・・・・",
   "en": ""
  },
  {
   "id": "s412:00ff6",
   "op": "15",
   "jp": "ソドムとゴモラでの、\nアナタ方の行動は拝見しました。",
   "en": ""
  },
  {
   "id": "s412:0103e",
   "op": "15",
   "jp": "彼の状況におけるアナタ方の\n判断はある意味では\n正しかったと言えるでしょう。",
   "en": ""
  },
  {
   "id": "s412:0109e",
   "op": "15",
   "jp": "世界の変革を興すには、\n様々な可能性を\n模索するものなのです。",
   "en": ""
  },
  {
   "id": "s412:010ee",
   "op": "15",
   "jp": "しかしアナタ方がその答えに\n見合うか否か！？",
   "en": ""
  },
  {
   "id": "s412:0112e",
   "op": "15",
   "jp": "私にお見せ頂きたい・・・\nよろしいですか？",
   "en": ""
  },
  {
   "id": "s412:0117a",
   "op": "15",
   "jp": "おおっ！！\nいくらでも試してもらおうか！！",
   "en": ""
  },
  {
   "id": "s412:011c6",
   "op": "15",
   "jp": "一度始まったこの戦いは、\n最終最後の敵を倒すまで、\n逃げる事などかないませんよ！",
   "en": ""
  },
  {
   "id": "s412:01236",
   "op": "15",
   "jp": "上等だ！！\n誰が\n逃げたりするか！！",
   "en": ""
  },
  {
   "id": "s412:0127a",
   "op": "15",
   "jp": "血の盟約に仕えし\nさまよえる民よ、今こそ\n我が問いに答えるがよい！",
   "en": ""
  }
 ]
}
